// Copy to Secrets.xcconfig and fill in your values.
// Secrets.xcconfig is gitignored — never commit real keys.

TMDB_API_KEY = YOUR_TMDB_API_KEY
SENTRY_DSN =
SIMKL_CLIENT_ID =
OMDB_API_KEY =

// Push notification environment for entitlements (development | production)
APS_ENVIRONMENT = development

// Optional: override the Xcode development team (defaults to project setting)
// DEVELOPMENT_TEAM = YOUR_TEAM_ID
