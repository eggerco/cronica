            "value": "Το Cronica μπορεί να αποθηκεύει εικόνες στη βιβλιοθήκη φωτογραφιών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica puede guardar imágenes en tu biblioteca de fotos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica voi tallentaa kuvia valokuvakirjastoosi."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica તમારી ફોટો લાઇબ્રેરીમાં છબીઓ સાચવી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica יכול לשמור תמונות בספריית התמונות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica आपकी फ़ोटो लाइब्रेरी में चित्र सहेज सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica može spremati slike u tvoju biblioteku fotografija."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica képeket menthet a fotókönyvtáradba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dapat menyimpan gambar ke perpustakaan foto Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaは写真ライブラリに画像を保存できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ನಿಮ್ಮ ಫೋಟೋ ಲೈಬ್ರರಿಗೆ ಚಿತ್ರಗಳನ್ನು ಉಳಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica는 사진 보관함에 이미지를 저장할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ന് നിങ്ങളുടെ ഫോട്ടോ ലൈബ്രറിയിലേക്ക് ചിത്രങ്ങൾ സംരക്ഷിക്കാൻ കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica तुमच्या फोटो लायब्ररीमध्ये प्रतिमा जतन करू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica boleh menyimpan imej ke pustaka foto anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan lagre bilder i bildebiblioteket ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan afbeeldingen opslaan in je fotobibliotheek."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ଆପଣଙ୍କ ଫଟୋ ଲାଇବ୍ରେରୀରେ ପ୍ରତିଛବିଗୁଡ଼ିକୁ ସଂରକ୍ଷଣ କରିପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਤੁਹਾਡੀ ਫੋਟੋ ਲਾਇਬ੍ਰੇਰੀ ਵਿੱਚ ਤਸਵੀਰਾਂ ਨੂੰ ਸੁਰੱਖਿਅਤ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica może zapisywać obrazy w bibliotece zdjęć."
