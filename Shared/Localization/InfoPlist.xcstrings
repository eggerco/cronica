        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica מוסיף הפצות קרובות מרשימת הצפייה ללוח שנה ייעודי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica आपकी वॉचलिस्ट से आगामी रिलीज़ एक समर्पित कैलेंडर में जोड़ता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dodaje nadolazeća izdanja s tvoje liste u poseban kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica a listádon lévő közelgő megjelenéseket egy külön naptárhoz adja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica menambahkan rilis mendatang dari watchlist Anda ke kalender khusus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaはウォッチリストの今後の公開予定を専用カレンダーに追加します。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಯಿಂದ ಮುಂಬರುವ ಬಿಡುಗಡೆಗಳನ್ನು ಮೀಸಲಾದ ಕ್ಯಾಲೆಂಡರ್‌ಗೆ ಸೇರಿಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica는 관심 목록의 예정된 출시를 전용 캘린더에 추가합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാച്ച് ലിസ്റ്റിൽ നിന്ന് വരാനിരിക്കുന്ന റിലീസുകൾ Cronica ഒരു സമർപ്പിത കലണ്ടറിലേക്ക് ചേർക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica तुमच्या वॉचलिस्टमधील आगामी रिलीज एका खास कॅलेंडरमध्ये जोडतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica menambah keluaran akan datang dari senarai tontonan anda ke kalendar khas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica legger kommende utgivelser fra ønskelisten din til en egen kalender."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica voegt aankomende releases van je watchlist toe aan een speciale kalender."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ଆପଣଙ୍କ ୱାଚଲିଷ୍ଟରୁ ଆଗାମୀ ରିଲିଜଗୁଡ଼ିକୁ ଏକ ଉତ୍ସର୍ଗୀକୃତ କ୍ୟାଲେଣ୍ଡରରେ ଯୋଡେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਤੁਹਾਡੀ ਵਾਚਲਿਸਟ ਤੋਂ ਆਉਣ ਵਾਲੀਆਂ ਰਿਲੀਜ਼ਾਂ ਨੂੰ ਇੱਕ ਸਮਰਪਿਤ ਕੈਲੰਡਰ ਵਿੱਚ ਜੋੜਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dodaje nadchodzące premiery z Twojej listy do osobnego kalendarza."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica adaugă lansările viitoare de pe listă într-un calendar dedicat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica добавляет ближайшие релизы из вашего списка в отдельный календарь."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica doda prihajajoče izdaje z vašega seznama za spremljanje v namenski koledar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica lägger till kommande premiärer från din watchlist i en särskild kalender."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica உங்கள் கண்காணிப்புப் பட்டியலில் உள்ள வரவிருக்கும் வெளியீடுகளை ஒரு பிரத்யேக நாட்காட்டியில் சேர்க்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica మీ వాచ్‌లిస్ట్‌లోని రాబోయే విడుదలలను ఒక ప్రత్యేక క్యాలెండర్‌కు జోడిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica จะเพิ่มภาพยนตร์หรือซีรีส์ที่จะเข้าฉายในอนาคตจากรายการที่คุณติดตามไปยังปฏิทินเฉพาะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica, izleme listenizdeki yaklaşan yayınları özel bir takvime ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica додає найближчі релізи з вашого списку до окремого календаря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica آپ کی واچ لسٹ سے آنے والی ریلیز کو ایک وقف شدہ کیلنڈر میں شامل کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica thêm các bản phát hành sắp tới từ danh sách theo dõi của bạn vào một lịch riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 会将片单中的即将上映内容添加到专用日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 會將片單中的即將上映內容加入專用日曆。"
          }
        }
      }
    },
