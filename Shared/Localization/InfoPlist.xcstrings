    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف Cronica الإصدارات القادمة من قائمة المشاهدة إلى تقويم مخصص."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica přidává nadcházející vydání ze seznamu do vyhrazeného kalendáře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica tilføjer kommende udgivelser fra din watchlist til en dedikeret kalender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica fügt bevorstehende Veröffentlichungen von deiner Watchlist einem eigenen Kalender hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Cronica προσθέτει επερχόμενες κυκλοφορίες από τη λίστα σου σε αποκλειστικό ημερολόγιο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica adds upcoming releases from your watchlist to a dedicated calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica añade los próximos estrenos de tu lista a un calendario dedicado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica agrega los próximos estrenos de tu lista a un calendario dedicado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica lisää katselulistan tulevat julkaisut erilliseen kalenteriin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica ajoute les prochaines sorties de votre liste à un calendrier dédié."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica מוסיף הפצות קרובות מרשימת הצפייה ללוח שנה ייעודי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica आपकी वॉचलिस्ट से आगामी रिलीज़ एक समर्पित कैलेंडर में जोड़ता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica dodaje nadolazeća izdanja s tvoje liste u poseban kalendar."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Cronica a listádon lévő közelgő megjelenéseket egy külön naptárhoz adja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica menambahkan rilis mendatang dari watchlist Anda ke kalender khusus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica aggiunge le prossime uscite della watchlist a un calendario dedicato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronicaはウォッチリストの今後の公開予定を専用カレンダーに追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica는 관심 목록의 예정된 출시를 전용 캘린더에 추가합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica menambah keluaran akan datang dari senarai tontonan anda ke kalendar khas."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica legger kommende utgivelser fra ønskelisten din til en egen kalender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica voegt aankomende releases van je watchlist toe aan een speciale kalender."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica dodaje nadchodzące premiery z Twojej listy do osobnego kalendarza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cronica adiciona os próximos lançamentos da sua lista a um calendário dedicado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica adaugă lansările viitoare de pe listă într-un calendar dedicat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica добавляет ближайшие релизы из вашего списка в отдельный календарь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica pridáva nadchádzajúce vydania zo zoznamu do vyhradeného kalendára."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica lägger till kommande premiärer från din watchlist i en särskild kalender."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica, izleme listenizdeki yaklaşan yayınları özel bir takvime ekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica додає найближчі релізи з вашого списку до окремого календаря."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica 会将片单中的即将上映内容添加到专用日历。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica 會將片單中的即將上映內容加入專用日曆。"
          }
        }
      }
    },
