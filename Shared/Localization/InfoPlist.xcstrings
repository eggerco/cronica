        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan spara bilder i ditt fotobibliotek."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica உங்கள் புகைப்பட நூலகத்தில் படங்களைச் சேமிக்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica మీ ఫోటో లైబ్రరీలో చిత్రాలను భద్రపరచగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica สามารถบันทึกภาพลงในคลังภาพของคุณได้"
