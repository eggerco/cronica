{
  "sourceLanguage": "en",
  "strings": {
    "NSSiriUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica uses Siri to add titles, mark episodes watched, and check what's up next on your watchlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica nutzt Siri, um Titel hinzuzufügen, Episoden als gesehen zu markieren und Als Nächstes auf deiner Watchlist zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica utilise Siri pour ajouter des titres, marquer des épisodes comme vus et vérifier À suivre dans votre liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica usa Siri per aggiungere titoli, segnare episodi come visti e controllare In programma nella watchlist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cronica usa a Siri para adicionar títulos, marcar episódios como assistidos e ver A seguir na sua lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica usa Siri para adicionar títulos, marcar episódios assistidos e verificar o que vem a seguir na sua lista de favoritos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica používa Siri na pridávanie titulov, označovanie epizód a kontrolu Ďalej vo vašom zozname."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica usa Siri para agregar títulos, marcar episodios como vistos y ver A continuación en tu lista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Cronica Siri لإضافة عناوين وتعليم الحلقات كمشاهَدة والاطلاع على التالي في قائمة المشاهدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ব্যবহার করে আপনি টাইটেল যোগ করতে, দেখা পর্বগুলো চিহ্নিত করতে এবং আপনার ওয়াচলিস্টে এরপর কী আছে তা দেখতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica utilitza Siri per afegir títols, marcar els episodis vistos i comprovar què hi ha a continuació a la teva llista de seguiment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica používá Siri k přidávání titulů, označování epizod a kontrole Další ve vašem seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica bruger Siri til at tilføje titler, markere episoder som set og tjekke Næste på din watchlist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cronica χρησιμοποιεί το Siri για προσθήκη τίτλων, σήμανση επεισοδίων και έλεγχο των Επόμενων στη λίστα σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica usa Siri para añadir títulos, marcar episodios como vistos y ver A continuación en tu lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica käyttää Siriä nimien lisäämiseen, jaksojen merkitsemiseen ja Seuraavaksi-listan tarkistamiseen."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica શીર્ષકો ઉમેરવા, જોયેલા એપિસોડને ચિહ્નિત કરવા અને તમારી વોચલિસ્ટમાં આગળ શું છે તે તપાસવા માટે Siri નો ઉપયોગ કરે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica משתמש ב־Siri כדי להוסיף כותרות, לסמן פרקים כנצפים ולבדוק את הבא בתור ברשימה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica शीर्षक जोड़ने, एपिसोड देखा गया चिह्नित करने और वॉचलिस्ट पर आगे क्या जाँचने के लिए Siri का उपयोग करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica koristi Siri za dodavanje naslova, označavanje epizoda i pregled Sljedećeg na tvojoj listi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica a Sirit használja címek hozzáadásához, epizódok megjelöléséhez és a Következők ellenőrzéséhez a listádon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica menggunakan Siri untuk menambahkan judul, menandai episode ditonton, dan memeriksa Selanjutnya di watchlist Anda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CronicaはSiriを使って作品の追加、エピソードの視聴済み、ウォッチリストの次に観る確認を行います。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ಶೀರ್ಷಿಕೆಗಳನ್ನು ಸೇರಿಸಲು, ವೀಕ್ಷಿಸಿದ ಕಂತುಗಳನ್ನು ಗುರುತಿಸಲು ಮತ್ತು ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಯಲ್ಲಿ ಮುಂದೆ ಏನಿದೆ ಎಂಬುದನ್ನು ಪರಿಶೀಲಿಸಲು Siri ಅನ್ನು ಬಳಸುತ್ತದೆ."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica는 Siri로 작품을 추가하고, 에피소드를 시청함으로 표시하며, 관심 목록의 다음에 볼 것을 확인합니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശീർഷകങ്ങൾ ചേർക്കാനും, കണ്ട എപ്പിസോഡുകൾ അടയാളപ്പെടുത്താനും, നിങ്ങളുടെ വാച്ച് ലിസ്റ്റിൽ അടുത്തതായി എന്താണ് ഉള്ളതെന്ന് പരിശോധിക്കാനും Cronica Siri ഉപയോഗിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica हे टायटल्स जोडण्यासाठी, पाहिलेले एपिसोड म्हणून मार्क करण्यासाठी आणि तुमच्या वॉचलिस्टवर पुढे काय आहे हे तपासण्यासाठी Siri चा वापर करते."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica menggunakan Siri untuk menambah tajuk, menanda episod ditonton, dan menyemak Seterusnya dalam senarai tontonan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica bruker Siri til å legge til titler, merke episoder som sett og sjekke Neste på ønskelisten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica gebruikt Siri om titels toe te voegen, afleveringen als bekeken te markeren en Hierna op je watchlist te controleren."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ଟାଇଟଲ୍ ଯୋଡ଼ିବା, ଦେଖାଯାଇଥିବା ଏପିସୋଡ୍ ଚିହ୍ନିତ କରିବା ଏବଂ ଆପଣଙ୍କ ୱାଚଲିଷ୍ଟରେ ପରବର୍ତ୍ତୀ କଣ ଅଛି ତାହା ଯାଞ୍ଚ କରିବା ପାଇଁ Siri ବ୍ୟବହାର କରେ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਸਿਰਲੇਖ ਜੋੜਨ, ਦੇਖੇ ਗਏ ਐਪੀਸੋਡਾਂ ਨੂੰ ਚਿੰਨ੍ਹਿਤ ਕਰਨ, ਅਤੇ ਤੁਹਾਡੀ ਵਾਚਲਿਸਟ ਵਿੱਚ ਅੱਗੇ ਕੀ ਹੈ ਇਸਦੀ ਜਾਂਚ ਕਰਨ ਲਈ Siri ਦੀ ਵਰਤੋਂ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica używa Siri do dodawania tytułów, oznaczania odcinków i sprawdzania Dalej na Twojej liście."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica folosește Siri pentru a adăuga titluri, a marca episoade și a verifica Urmează pe lista ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica использует Siri, чтобы добавлять названия, отмечать эпизоды и проверять «Дальше» в вашем списке."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica uporablja Siri za dodajanje naslovov, označevanje ogledanih epizod in preverjanje naslednjega na vašem seznamu za spremljanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica använder Siri för att lägga till titlar, markera avsnitt som sett och kolla Härnäst på din watchlist."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்புகளைச் சேர்க்கவும், பார்த்த அத்தியாயங்களைக் குறிக்கவும், உங்கள் கண்காணிப்புப் பட்டியலில் அடுத்து என்ன இருக்கிறது என்பதைச் சரிபார்க்கவும் Cronica, Siri-ஐப் பயன்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica, టైటిల్‌లను జోడించడానికి, ఎపిసోడ్‌లను చూసినట్లుగా గుర్తించడానికి, మరియు మీ వాచ్‌లిస్ట్‌లో తదుపరి ఏమి రాబోతుందో తనిఖీ చేయడానికి Siriను ఉపయోగిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ใช้ Siri ในการเพิ่มชื่อเรื่อง ทำเครื่องหมายตอนที่รับชมแล้ว และตรวจสอบรายการถัดไปในรายการเฝ้าดูของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica; başlık eklemek, bölümleri izlendi işaretlemek ve izleme listendeki Sıradakiler’e bakmak için Siri’yi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica використовує Siri, щоб додавати назви, позначати епізоди та перевіряти «Далі» у вашому списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica عنوانات شامل کرنے، دیکھے گئے ایپی سوڈز کو نشان زد کرنے، اور آپ کی واچ لسٹ میں آگے کیا ہونے والا ہے چیک کرنے کے لیے Siri کا استعمال کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica sử dụng Siri để thêm tiêu đề, đánh dấu các tập đã xem và kiểm tra những tập tiếp theo trong danh sách theo dõi của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 使用 Siri 添加作品、标记已看剧集，并查看片单中的接下来内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 使用 Siri 加入作品、標記已看劇集，並查看片單中的接下來內容。"
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica can add a reminder for the next release or episode of a watchlist title."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kann eine Erinnerung für die nächste Veröffentlichung oder Episode eines Watchlist-Titels hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica peut ajouter un rappel pour la prochaine sortie ou le prochain épisode d’un titre de votre liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica può aggiungere un promemoria per la prossima uscita o episodio di un titolo della watchlist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cronica pode adicionar um lembrete para o próximo lançamento ou episódio de um título da lista."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica pode adicionar um lembrete para o próximo lançamento ou episódio de um título da sua lista de favoritos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica môže pridať pripomienku na nasledujúce vydanie alebo epizódu titulu zo zoznamu."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica puede agregar un recordatorio para el próximo estreno o episodio de un título de tu lista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Cronica إضافة تذكير بالإصدار أو الحلقة التالية لعنوان في قائمة المشاهدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ওয়াচলিস্টে থাকা কোনো টাইটেলের পরবর্তী রিলিজ বা এপিসোডের জন্য রিমাইন্ডার যোগ করতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica pot afegir un recordatori per al proper llançament o episodi d'un títol de la llista de seguiment."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica může přidat připomínku dalšího vydání nebo epizody titulu ze seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan tilføje en påmindelse om næste udgivelse eller episode for en titel på watchlisten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cronica μπορεί να προσθέσει υπενθύμιση για την επόμενη κυκλοφορία ή επεισόδιο ενός τίτλου της λίστας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica puede añadir un recordatorio para el próximo estreno o episodio de un título de tu lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica voi lisätä muistutuksen katselulistan nimen seuraavasta julkaisusta tai jaksosta."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica વોચલિસ્ટ શીર્ષકના આગામી પ્રકાશન અથવા એપિસોડ માટે રિમાઇન્ડર ઉમેરી શકે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica יכול להוסיף תזכורת להפצה או לפרק הבא של כותרת ברשימת הצפייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica वॉचलिस्ट शीर्षक की अगली रिलीज़ या एपिसोड के लिए रिमाइंडर जोड़ सकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica može dodati podsjetnik za sljedeće izdanje ili epizodu naslova s liste."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica emlékeztetőt adhat a listán szereplő cím következő megjelenéséhez vagy epizódjához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dapat menambahkan pengingat untuk rilis atau episode berikutnya dari judul di watchlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaはウォッチリストの作品の次の公開またはエピソードのリマインダーを追加できます。"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ಮುಂದಿನ ಬಿಡುಗಡೆ ಅಥವಾ ವಾಚ್‌ಲಿಸ್ಟ್ ಶೀರ್ಷಿಕೆಯ ಸಂಚಿಕೆಗೆ ಜ್ಞಾಪನೆಯನ್ನು ಸೇರಿಸಬಹುದು."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica는 관심 목록 작품의 다음 출시 또는 에피소드에 대한 미리 알림을 추가할 수 있습니다."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica-ന് അടുത്ത റിലീസിനോ വാച്ച് ലിസ്റ്റ് ശീർഷകത്തിന്റെ എപ്പിസോഡിനോ ഒരു ഓർമ്മപ്പെടുത്തൽ ചേർക്കാൻ കഴിയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica वॉचलिस्टमधील टायटलच्या पुढील रिलीज किंवा एपिसोडसाठी रिमाइंडर लावू शकतो."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica boleh menambah peringatan untuk keluaran atau episod seterusnya bagi tajuk dalam senarai tontonan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan legge til en påminnelse for neste utgivelse eller episode for en tittel på ønskelisten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan een herinnering toevoegen voor de volgende release of aflevering van een titel op je watchlist."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ଏକ ୱାଚଲିଷ୍ଟ ଟାଇଟଲର ପରବର୍ତ୍ତୀ ରିଲିଜ୍ କିମ୍ବା ଏପିସୋଡ୍ ପାଇଁ ଏକ ରିମାଇଣ୍ଡର ଯୋଡିପାରିବ।"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਇੱਕ ਵਾਚਲਿਸਟ ਟਾਈਟਲ ਦੇ ਅਗਲੇ ਰਿਲੀਜ਼ ਜਾਂ ਐਪੀਸੋਡ ਲਈ ਇੱਕ ਰੀਮਾਈਂਡਰ ਜੋੜ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica może dodać przypomnienie o kolejnej premierze lub odcinku tytułu z listy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica poate adăuga un memento pentru următoarea lansare sau episod al unui titlu de pe listă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica может добавить напоминание о следующем релизе или эпизоде названия из списка."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica lahko doda opomnik za naslednjo izdajo ali epizodo naslova s seznama za spremljanje."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan lägga till en påminnelse om nästa premiär eller avsnitt för en titel i watchlisten."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica, பார்க்க வேண்டிய பட்டியலில் உள்ள ஒரு தலைப்பின் அடுத்த வெளியீடு அல்லது அத்தியாயத்திற்கான நினைவூட்டலைச் சேர்க்க முடியும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica వాచ్‌లిస్ట్ టైటిల్ యొక్క తదుపరి విడుదల లేదా ఎపిసోడ్ కోసం రిమైండర్‌ను జోడించగలదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica สามารถเพิ่มการแจ้งเตือนสำหรับการออกฉายหรือตอนต่อไปของรายการที่ต้องการติดตามได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica, izleme listesindeki bir yapımın sonraki yayın veya bölümü için anımsatıcı ekleyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica може додати нагадування про наступний реліз або епізод назви зі списку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica واچ لسٹ ٹائٹل کی اگلی ریلیز یا ایپیسوڈ کے لیے ایک یاد دہانی شامل کر سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica có thể thêm lời nhắc cho lần phát hành hoặc tập tiếp theo của một tựa phim hoặc chương trình trong danh sách theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 可为片单中作品的下次上映或下一集添加提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 可為片單中作品的下次上映或下一集加入提醒。"
          }
        }
      }
    },
