          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifique quando um novo episódio de uma Série em sua lista for lançado."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorniť na vydanie novej epizódy seriálu z tvojho zoznamu sledovaných."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
