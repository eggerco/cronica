        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica trenger tilgang til Påminnelser for å opprette en påminnelse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica heeft toegang tot Herinneringen nodig om een herinnering te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica potrzebuje dostępu do Przypomnień, aby utworzyć przypomnienie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cronica precisa de acesso aos Lembretes para criar um lembrete."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica are nevoie de acces la Memento-uri pentru a crea un memento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica нужен доступ к Напоминаниям, чтобы создать напоминание."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica potrebuje prístup k Pripomienkam na vytvorenie pripomienky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica behöver åtkomst till Påminnelser för att skapa en påminnelse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica anımsatıcı oluşturmak için Anımsatıcılar erişimine ihtiyaç duyar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica потрібен доступ до Нагадувань, щоб створити нагадування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 需要“提醒事项”权限才能创建提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 需要「提醒事項」權限才能建立提醒。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica একটি অনুস্মারক তৈরি করতে অনুস্মারক অ্যাক্সেস প্রয়োজন৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica necessita accés a Recordatoris per crear un recordatori."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રિમાઇન્ડર બનાવવા માટે Cronica ને Reminders ની ઍક્સેસ જોઈએ છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಜ್ಞಾಪನೆಯನ್ನು ರಚಿಸಲು Cronica ಗೆ ಜ್ಞಾಪನೆಗಳ ಪ್ರವೇಶದ ಅಗತ್ಯವಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു റിമൈൻഡർ സൃഷ്‌ടിക്കാൻ Cronica-ന് റിമൈൻഡർ ആക്‌സസ് ആവശ്യമാണ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मरणपत्र तयार करण्यासाठी Cronica ला स्मरणपत्र प्रवेश आवश्यक आहे."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ସ୍ମାରକ ସୃଷ୍ଟି କରିବାକୁ Cronica ରିମାଇଣ୍ଡର୍ସ ଆକ୍ସେସ୍ ଆବଶ୍ୟକ କରେ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cronica precisa de acesso aos Lembretes para criar um lembrete."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਨੂੰ ਰੀਮਾਈਂਡਰ ਬਣਾਉਣ ਲਈ ਰੀਮਾਈਂਡਰ ਐਕਸੈਸ ਦੀ ਲੋੜ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica potrebuje dostop do Opomnikov za ustvarjanje opomnika."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நினைவூட்டலை உருவாக்க Cronica க்கு நினைவூட்டல் அணுகல் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రిమైండర్‌ని సృష్టించడానికి Cronicaకి రిమైండర్‌ల యాక్సెస్ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ต้องการการเข้าถึงการแจ้งเตือนเพื่อสร้างการแจ้งเตือน"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica کو یاد دہانی بنانے کے لیے یاد دہانیوں تک رسائی کی ضرورت ہے ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica cần quyền truy cập Lời nhắc để tạo lời nhắc."
          }
        }
      }
    },
