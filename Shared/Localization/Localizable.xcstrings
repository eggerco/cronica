    "Add this title to your watchlist first, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف هذا العنوان إلى قائمة المشاهدة أولاً، ثم حاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív přidej tento titul do watchlistu a zkus to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj denne titel til din watchlist først, og prøv derefter igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diesen Titel zuerst deiner Watchlist hinzu und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε πρώτα αυτόν τον τίτλο στη λίστα παρακολούθησης και δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add this title to your watchlist first, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade este título a tu lista primero y vuelve a intentarlo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega este título a tu lista primero e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tämä nimike ensin katselulistallesi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute d’abord ce titre à ta liste, puis réessaie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף כותרת זו לרשימת הצפייה קודם, ואז נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इस शीर्षक को अपनी वॉचलिस्ट में जोड़ें, फिर दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo dodaj ovaj naslov na popis, pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először adja hozzá ezt a címet a figyelőlistához, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan judul ini ke watchlist dulu, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima questo titolo alla tua lista e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこの作品をウォッチリストに追加してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 작품을 워치리스트에 추가한 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tajuk ini ke watchlist dahulu, kemudian cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til denne tittelen i watchlisten din først, og prøv deretter på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg deze titel eerst toe aan je watchlist en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw dodaj ten tytuł do listy do obejrzenia, a potem spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este título à sua lista primeiro e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă mai întâi titlul pe watchlist, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала добавь это название в список, затем попробуй снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv pridaj tento titul do svojho zoznamu a skús to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till den här titeln i din watchlist först och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu başlığı izleme listene ekle, sonra tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку додай цю назву до списку, а потім спробуй знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先将此标题添加到观看清单，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先將此標題加入觀看清單，然後再試一次。"
          }
        }
      }
    },
    "Add titles on iPhone, then they appear here.": {
