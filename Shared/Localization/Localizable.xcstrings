    "Favorite lists appear first when adding titles and on Home.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritenlisten erscheinen zuerst beim Hinzufügen und auf dem Home-Bildschirm."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite lists appear first when adding titles and on Home."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas favoritas aparecen primero al agregar títulos y en Inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes favorites apparaissent en premier lors de l’ajout et sur l’accueil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le liste preferite compaiono per prime quando aggiungi titoli e in Home."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas favoritas aparecem primeiro ao adicionar títulos e na Início."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obľúbené zoznamy sa zobrazia ako prvé pri pridávaní titulov a na Domov."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر القوائم المفضلة أولاً عند إضافة العناوين وفي الرئيسية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené seznamy se zobrazí jako první při přidávání titulů a na Domů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritlister vises først, når du tilføjer titler og på startsiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγαπημένες λίστες εμφανίζονται πρώτες κατά την προσθήκη τίτλων και στην αρχική."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas favoritas aparecen primero al añadir títulos y en Inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosikkilistat näkyvät ensin lisättäessä nimikkeitä ja etusivulla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימות מועדפות מופיעות ראשונות בעת הוספת כותרות ובבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक जोड़ते समय और होम पर पसंदीदा सूचियाँ पहले दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiljeni popisi pojavljuju se prvi pri dodavanju naslova i na Početnoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kedvenc listák elsőként jelennek meg címek hozzáadásakor és a kezdőlapon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar favorit muncul pertama saat menambahkan judul dan di Beranda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りリストは作品追加時とホームで最初に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 목록은 작품 추가 시와 홈에서 먼저 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai kegemaran muncul dahulu apabila menambah tajuk dan di Laman Utama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorittlister vises først når du legger til titler og på hjem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriete lijsten verschijnen eerst bij het toevoegen van titels en op Start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione listy pojawiają się jako pierwsze przy dodawaniu tytułów i na ekranie głównym."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listele favorite apar primele la adăugarea titlurilor și pe Acasă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранные списки отображаются первыми при добавлении названий и на главной."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritlistor visas först när du lägger till titlar och på hem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori listeler başlık eklerken ve Ana sayfada önce görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрані списки з’являються першими під час додавання назв і на головній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加标题和在首页时，收藏列表会优先显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入標題和在首頁時，收藏列表會優先顯示。"
          }
        }
      }
    },
