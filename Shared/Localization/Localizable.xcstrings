          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlandıktan sonra bu bölümü izlendi işaretleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після ефіру можна позначити епізод як переглянутий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
