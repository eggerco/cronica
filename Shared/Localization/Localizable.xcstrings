    "Start watching to get recommendations...": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ المشاهدة للحصول على توصيات..."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začni sledovat a získej doporučení…"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynd at se for at få anbefalinger..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit dem Ansehen, um Empfehlungen zu erhalten …"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε παρακολούθηση για προτάσεις…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start watching to get recommendations..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a ver contenido para recibir recomendaciones..."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a mirar para obtener recomendaciones..."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aloita katselu saadaksesi suosituksia..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à regarder pour obtenir des recommandations..."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחל לצפות כדי לקבל המלצות..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
