          "stringUnit": {
            "state": "translated",
            "value": "Päivitä vetämällä tai yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez pour actualiser ou réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משוך לרענון או נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिफ्रेश करने के लिए खींचें या फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za osvježavanje ili pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza le a frissítéshez, vagy próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik untuk memperbarui atau coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per aggiornare o riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引っ張って更新するか、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당겨서 새로고침하거나 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik untuk muat semula atau cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å oppdatere, eller prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek om te vernieuwen of probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby odświeżyć, lub spróbuj ponownie."
