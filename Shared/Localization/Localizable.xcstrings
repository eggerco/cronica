    "Nothing up next. Add TV shows in Cronica.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing up next. Add TV shows in Cronica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts als Nächstes. Füge Serien in Cronica hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à suivre. Ajoute des séries dans Cronica."
          }
        },
