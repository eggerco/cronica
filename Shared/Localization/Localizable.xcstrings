    "Anonymous crash reports may be processed by our error monitoring provider. Email support@cronica.watch to request removal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Absturzberichte können von unserem Fehlerüberwachungsanbieter verarbeitet werden. Schreib an support@cronica.watch, um die Löschung zu beantragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous crash reports may be processed by our error monitoring provider. Email support@cronica.watch to request removal."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes anónimos de fallos pueden ser procesados por nuestro proveedor de monitoreo de errores. Envía un correo a support@cronica.watch para solicitar la eliminación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rapports d’incident anonymes peuvent être traités par notre fournisseur de surveillance des erreurs. Envoie un e-mail à support@cronica.watch pour demander la suppression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni anonime di crash possono essere elaborate dal nostro provider di monitoraggio errori. Invia un’e-mail a support@cronica.watch per richiedere la rimozione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatórios anônimos de falhas podem ser processados pelo nosso provedor de monitoramento de erros. Envie um e-mail a support@cronica.watch para solicitar a remoção."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymné hlásenia o pádoch môže spracovať náš poskytovateľ monitorovania chýb. Na odstránenie napíš na support@cronica.watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تُعالَج تقارير الأعطال المجهولة بواسطة مزود مراقبة الأخطاء. راسل support@cronica.watch لطلب الحذف."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymní hlášení o pádech může zpracovávat náš poskytovatel monitoringu chyb. Napiš na support@cronica.watch a požádej o odstranění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme nedbrudsrapporter kan behandles af vores fejlovervågningsudbyder. Send en e-mail til support@cronica.watch for at anmode om sletning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανώνυμες αναφορές σφαλμάτων ενδέχεται να επεξεργάζονται από τον πάροχο παρακολούθησης σφαλμάτων. Στείλτε email στο support@cronica.watch για αίτηση διαγραφής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los informes de fallos anónimos pueden ser procesados por nuestro proveedor de monitorización de errores. Escribe a support@cronica.watch para solicitar su eliminación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyymejä kaatumisraportteja voidaan käsitellä virheiden seurantapalvelussamme. Pyydä poistoa sähköpostitse osoitteeseen support@cronica.watch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דוחות קריסה אנונימיים עשויים להיות מעובדים על ידי ספק ניטור השגיאות. שלח מייל ל-support@cronica.watch לבקשת הסרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अज्ञात क्रैश रिपोर्ट हमारे त्रुटि निगरानी प्रदाता द्वारा संसाधित हो सकती हैं। हटाने के लिए support@cronica.watch पर ईमेल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimna izvješća o padovima mogu obrađivati naš pružatelj praćenja grešaka. Pošalji e-mail na support@cronica.watch za uklanjanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A névtelen összeomlási jelentéseket hibakövető szolgáltatónk feldolgozhatja. Törlés kéréséhez írjon a support@cronica.watch címre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan crash anonim dapat diproses oleh penyedia pemantauan error kami. Email support@cronica.watch untuk meminta penghapusan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名のクラッシュレポートはエラー監視プロバイダーによって処理される場合があります。削除を希望する場合は support@cronica.watch までメールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익명 충돌 보고서는 오류 모니터링 제공업체에서 처리될 수 있습니다. 삭제를 요청하려면 support@cronica.watch로 이메일을 보내세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Laporan ranap anonim mungkin diproses oleh pembekal pemantauan ralat kami. E-mel support@cronica.watch untuk meminta pemadaman."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme krasjrapporter kan behandles av vår feilovervåkingsleverandør. Send e-post til support@cronica.watch for å be om sletting."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonieme crashrapporten kunnen worden verwerkt door onze foutmonitoringprovider. E-mail support@cronica.watch om verwijdering aan te vragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonimowe raporty o awariach mogą być przetwarzane przez naszego dostawcę monitoringu błędów. Napisz na support@cronica.watch, aby poprosić o usunięcie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapoartele anonime de crash pot fi procesate de furnizorul nostru de monitorizare a erorilor. Scrie la support@cronica.watch pentru ștergere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонимные отчёты о сбоях могут обрабатываться нашим провайдером мониторинга ошибок. Напиши на support@cronica.watch для удаления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyma kraschrapporter kan behandlas av vår felövervakningsleverantör. Mejla support@cronica.watch för att begära borttagning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonim çökme raporları hata izleme sağlayıcımız tarafından işlenebilir. Silme için support@cronica.watch adresine e-posta gönder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Анонімні звіти про збої можуть оброблятися нашим постачальником моніторингу помилок. Напиши на support@cronica.watch, щоб видалити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名崩溃报告可能会由我们的错误监控服务商处理。如需删除，请发送邮件至 support@cronica.watch。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匿名當機報告可能會由我們的錯誤監控服務商處理。如需刪除，請寄信至 support@cronica.watch。"
          }
        }
      }
    },
