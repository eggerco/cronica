    "Follow Cronica on X (Twitter) to stay updated about new features.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع Cronica على X (Twitter) للبقاء على اطلاع بالميزات الجديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj Cronica na X (Twitter), abys měl/a přehled o nových funkcích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg Cronica på X (Twitter) for at holde dig opdateret om nye funktioner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen Sie Cronica auf X (Twitter), um über neue Funktionen auf dem Laufenden zu bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολουθήστε το Cronica στο X (Twitter) για ενημερώσεις σχετικά με νέες λειτουργίες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Cronica on X (Twitter) to stay updated about new features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a Cronica en X (Twitter) para estar al día de las novedades."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a Cronica en X (Twitter) para mantenerte actualizado sobre las nuevas funciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa Cronicaa X:ssä (Twitter) pysyäksesi ajan tasalla uusista ominaisuuksista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez Cronica sur X (Twitter) pour rester informé des nouvelles fonctionnalités."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחר Cronica ב-X (Twitter) כדי להישאר מעודכן על תכונות חדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई सुविधाओं की जानकारी के लिए X (Twitter) पर Cronica को फ़ॉलो करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati Cronica na X (Twitter) za novosti o novim značajkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesse a Cronicát az X (Twitter) oldalon az új funkciókról szóló frissítésekért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti Cronica di X (Twitter) untuk update fitur baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui Cronica su X (Twitter) per rimanere aggiornato sulle nuove funzionalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X（Twitter）でCronicaをフォローして、新機能の情報を受け取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "X(Twitter)에서 Cronica를 팔로우하여 새 기능 소식을 받아보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti Cronica di X (Twitter) untuk kekal dikemas kini tentang ciri baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg Cronica på X (Twitter) for å holde deg oppdatert om nye funksjoner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volg Cronica op X (Twitter) om op de hoogte te blijven van nieuwe functies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwuj Cronica na X (Twitter), aby być na bieżąco z nowymi funkcjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga o Cronica no X (Twitter) para se manter atualizado sobre novos recursos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește Cronica pe X (Twitter) pentru noutăți despre funcții noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписывайся на Cronica в X (Twitter), чтобы узнавать о новых функциях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte Cronica na X (Twitter), aby ste boli informovaní o nových funkciách."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ Cronica på X (Twitter) för att hålla dig uppdaterad om nya funktioner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni özelliklerden haberdar olmak için X (Twitter)'da Cronica'yı takip et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідкуй за Cronica в X (Twitter), щоб дізнаватися про нові функції."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 X (Twitter) 上关注 Cronica，获取新功能更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 X (Twitter) 上追蹤 Cronica，取得新功能更新。"
          }
        }
      }
    },
