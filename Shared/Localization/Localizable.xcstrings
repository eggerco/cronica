        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ દરેક સેવાની લિંક્સ સાથે TMDb વેબસાઇટ ખોલશે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे प्रत्येक सेवेच्या लिंकसह TMDb वेबसाइट उघडेल."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso abrirá o site do TMDb com os links para cada serviço."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਹਰੇਕ ਸੇਵਾ ਦੇ ਲਿੰਕਾਂ ਦੇ ਨਾਲ TMDb ਵੈੱਬਸਾਈਟ ਖੋਲ੍ਹੇਗਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To odpre spletno mesto TMDb s povezavami do posameznih storitev."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇത് ഓരോ സേവനത്തിലേക്കും ലിങ്കുകൾക്കൊപ്പം TMDb വെബ്സൈറ്റ് തുറക്കും."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่จะเป็นการเปิดเว็บไซต์ TMDb พร้อมลิงก์ไปยังแต่ละบริการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ mở trang web TMDb với các liên kết đến từng dịch vụ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি TMDb ওয়েবসাইটটি খুলবে, যেখানে প্রতিটি পরিষেবার লিঙ্ক রয়েছে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇದು ಪ್ರತಿಯೊಂದು ಸೇವೆಗೆ ಲಿಂಕ್‌ಗಳೊಂದಿಗೆ TMDb ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ತೆರೆಯುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହା ପ୍ରତ୍ୟେକ ସେବାର ଲିଙ୍କ ସହିତ TMDb ୱେବସାଇଟ୍ ଖୋଲିବ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது ஒவ்வொரு சேவைக்குமான இணைப்புகளுடன் TMDb வலைத்தளத்தைத் திறக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది ప్రతి సేవకు సంబంధించిన లింక్‌లతో TMDb వెబ్‌సైట్‌ను తెరుస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے ہر سروس کے لنکس کے ساتھ TMDb ویب سائٹ کھل جائے گی۔"
          }
        }
      }
    },
