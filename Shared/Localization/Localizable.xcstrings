    "The app will adapt watch providers based on your region": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App passt die Streaming-Anbieter je nach deiner Region an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app will adapt watch providers based on your region"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación adaptará a los proveedores de relojes en función de su región"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application adaptera les fournisseurs de contenus en fonction de votre région"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app adatterà i fornitori di contenuti basandoti sulla tua regione"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo adaptará os provedores de conteúdo com base na sua região"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apka prispôsobí poskytovateľov na základe tvojho regiónu"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتكيف التطبيق مع مزودي المشاهدة حسب منطقتك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace přizpůsobí poskytovatele sledování podle tvého regionu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen tilpasser streamingtjenester baseret på din region"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή θα προσαρμόσει τους παρόχους παρακολούθησης ανάλογα με την περιοχή σας"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app adaptará los proveedores de visionado según tu región"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus mukauttaa suoratoistopalvelut alueesi mukaan"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה תתאים ספקי צפייה לפי האזור שלך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप आपके क्षेत्र के अनुसार वॉच प्रोवाइडर अनुकूलित करेगा"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacija prilagođava pružatelje gledanja prema tvojoj regiji"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás a régiója alapján igazítja a megtekintési szolgáltatókat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi menyesuaikan penyedia tonton berdasarkan wilayahmu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは地域に応じて視聴プロバイダーを調整します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 지역에 따라 시청 제공업체를 조정합니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi menyesuaikan penyedia tonton mengikut wilayah anda"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen tilpasser strømmetjenester basert på regionen din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De app past streamingdiensten aan op basis van je regio"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja dostosuje dostawców oglądania do twojego regionu"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicația adaptează furnizorii de vizionare după regiunea ta"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение адаптирует провайдеров просмотра под твой регион"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen anpassar streamningstjänster baserat på din region"
          }
        },
        "tr": {
