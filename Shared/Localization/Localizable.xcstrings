    "To remind yourself about a specific title, use Add to Reminders on its detail page.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To remind yourself about a specific title, use Add to Reminders on its detail page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine Erinnerung zu einem bestimmten Titel nutze „Zu Erinnerungen hinzufügen“ auf der Detailseite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous rappeler un titre précis, utilisez Ajouter aux Rappels sur sa page de détail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricordarti un titolo specifico, usa Aggiungi a Promemoria nella pagina dei dettagli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lembrar de um título específico, use Adicionar aos Lembretes na página de detalhes."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pripomenutie konkrétneho titulu použite Pridať do Pripomienok na stránke podrobností."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recordarte un título específico, usa Agregar a Recordatorios en su página de detalles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recordarte un título concreto, usa Añadir a Recordatorios en su página de detalles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتذكير نفسك بعنوان معيّن، استخدم إضافة إلى التذكيرات في صفحة التفاصيل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro připomenutí konkrétního titulu použijte Přidat do Připomínek na stránce podrobností."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at huske en bestemt titel skal du bruge Føj til Påmindelser på detaljesiden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για υπενθύμιση συγκεκριμένου τίτλου, χρησιμοποίησε Προσθήκη στα Υπενθυμίσεις στη σελίδα λεπτομερειών."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistuttaaksesi tietystä nimestä käytä Lisää Muistutuksiin -toimintoa tiedoissa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להזכיר לעצמך כותרת ספציפית, השתמש ב״הוסף לתזכורות״ בדף הפרטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी विशिष्ट शीर्षक की याद दिलाने के लिए उसकी विवरण पृष्ठ पर रिमाइंडर में जोड़ें का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za podsjetnik o određenom naslovu koristi Dodaj u Podsjetnike na stranici detalja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy adott cím emlékeztetőjéhez használd a Hozzáadás az Emlékeztetőkhöz gombot a részleteknél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengingatkan judul tertentu, gunakan Tambahkan ke Pengingat di halaman detail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の作品のリマインダーは、詳細画面の「リマインダーに追加」を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "특정 작품 미리 알림은 상세 화면의 미리 알림에 추가를 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengingatkan tajuk tertentu, guna Tambah ke Peringatan pada halaman butiran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å minne deg på en bestemt tittel, bruk Legg til i Påminnelser på detaljsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een herinnering aan een specifieke titel gebruik je Toevoegen aan Herinneringen op de detailpagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przypomnieć sobie o konkretnym tytule, użyj Dodaj do Przypomnień na stronie szczegółów."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a-ți aminti un titlu anume, folosește Adaugă în Memento-uri pe pagina de detalii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы напомнить о конкретном названии, используйте «Добавить в Напоминания» на странице подробностей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att påminna dig om en specifik titel, använd Lägg till i Påminnelser på detaljsidan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli bir yapım için hatırlatıcı oluşturmak üzere ayrıntı sayfasında Anımsatıcılara ekle’yi kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб нагадати собі про конкретну назву, скористайтеся «Додати до Нагадувань» на сторінці деталей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要提醒自己关注某部作品，请在详情页使用“添加到提醒事项”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要提醒自己關注某部作品，請在詳細頁使用「加入提醒事項」。"
          }
        }
      }
    },
    "Reminders aren't available on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders aren't available on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen sind auf diesem Gerät nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les Rappels ne sont pas disponibles sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Promemoria non sono disponibili su questo dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Lembretes não estão disponíveis neste dispositivo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripomienky nie sú na tomto zariadení dostupné."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Recordatorios no están disponibles en este dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Recordatorios no están disponibles en este dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التذكيرات غير متاحة على هذا الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připomínky nejsou na tomto zařízení dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelser er ikke tilgængelige på denne enhed."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα Υπενθυμίσεις δεν είναι διαθέσιμα σε αυτή τη συσκευή."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutukset eivät ole käytettävissä tällä laitteella."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תזכורות אינן זמינות במכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर रिमाइंडर उपलब्ध नहीं हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici nisu dostupni na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Emlékeztetők nem érhetők el ezen az eszközön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengingat tidak tersedia di perangkat ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではリマインダーを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 미리 알림을 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan tidak tersedia pada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelser er ikke tilgjengelig på denne enheten."
          }
        },
        "nl": {
