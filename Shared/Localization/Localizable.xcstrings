    "Please say which title you mean.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تحديد العنوان المقصود."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekněte, který titul máte na mysli."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig venligst hvilken titel du mener."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte sage, welchen Titel du meinst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πες ποιος τίτλος εννοείς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please say which title you mean."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di a qué título te refieres."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Di qué título quieres decir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kerro, mitä nimeä tarkoitat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez préciser quel titre vous voulez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אנא אמור לאיזו כותרת התכוונת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया बताएं आप किस शीर्षक की बात कर रहे हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci koji naslov misliš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondd meg, melyik címre gondolsz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan judul yang Anda maksud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica quale titolo intendi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの作品か教えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 작품인지 말씀해 주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila nyatakan tajuk yang dimaksudkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si hvilken tittel du mener."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg welke titel je bedoelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj, który tytuł masz na myśli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga qual título você quer dizer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune ce titlu ai în vedere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточните, какое название вы имеете в виду."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Povedzte, ktorý titul myslíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säg vilken titel du menar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi yapımı kastettiğini söyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточніть, яку назву ви маєте на увазі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请说明你指的是哪部作品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請說明你指的是哪部作品。"
          }
        }
      }
    },
    "Please, open the app of the service on your Apple TV to watch this content.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى فتح تطبيق الخدمة على Apple TV لمشاهدة هذا المحتوى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři prosím aplikaci služby na Apple TV, abys mohl/a sledovat tento obsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn venligst tjenestens app på dit Apple TV for at se dette indhold."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte öffnen Sie die App des Dienstes auf Ihrem Apple TV, um diesen Inhalt anzusehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την εφαρμογή της υπηρεσίας στο Apple TV σας για να παρακολουθήσετε αυτό το περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, open the app of the service on your Apple TV to watch this content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app del servicio en tu Apple TV para ver este contenido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, abre la aplicación del servicio en tu Apple TV para ver este contenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa palvelun sovellus Apple TV:lläsi katsoaksesi tämän sisällön."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez ouvrir l'application du service sur votre Apple TV pour regarder ce contenu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את אפליקציית השירות ב-Apple TV כדי לצפות בתוכן זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सामग्री देखने के लिए Apple TV पर सेवा का ऐप खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori aplikaciju usluge na Apple TV-u za gledanje ovog sadržaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, nyissa meg a szolgáltatás alkalmazását Apple TV-jén a tartalom megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi layanan di Apple TV untuk menonton konten ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, apri l'app del servizio sulla tua Apple TV per vedere questo contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツを視聴するには、Apple TVでサービスのアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠를 시청하려면 Apple TV에서 서비스 앱을 열어주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi perkhidmatan pada Apple TV untuk menonton kandungan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst åpne tjenestens app på Apple TV-en din for å se dette innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app van de dienst op je Apple TV om deze content te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz aplikację usługi na Apple TV, aby obejrzeć tę treść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, abra o aplicativo do serviço na sua Apple TV para assistir a este conteúdo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide aplicația serviciului pe Apple TV pentru a viziona acest conținut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой приложение сервиса на Apple TV, чтобы смотреть этот контент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete sledovať tento obsah, otvorte si aplikáciu služby na Apple TV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna tjänstens app på din Apple TV för att titta på det här innehållet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içeriği izlemek için Apple TV'de hizmet uygulamasını aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий застосунок сервісу на Apple TV, щоб дивитися цей контент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Apple TV 上打开相应服务的 App 来观看此内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Apple TV 上開啟相應服務的 App 來觀看此內容。"
          }
        }
      }
    },
