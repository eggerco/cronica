    "Mark what you’ve watched and pick up right where you left off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ما شاهدته وتابع من حيث توقفت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označuj, co jsi viděl/a, a pokračuj přesně tam, kde jsi skončil/a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér, hvad du har set, og fortsæt, hvor du slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere, was du gesehen hast, und mach genau dort weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε τι έχετε παρακολουθήσει και συνεχίστε από εκεί που σταματήσατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark what you’ve watched and pick up right where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo que has visto y retoma justo donde lo dejaste."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo visto y continúa donde lo dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse katsomasi ja jatka siitä, mihin jäit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez ce que vous avez vu et reprenez où vous en étiez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן מה צפית והמשך בדיוק מהמקום שעצרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो देखा है उसे चिह्नित करें और वहीं से जारी रखें जहाँ छोड़ा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označuj što si gledao i nastavi točno gdje si stao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg, amit megtekintett, és folytassa ott, ahol abbahagyta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai yang sudah ditonton dan lanjutkan dari tempat terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna ciò che hai visto e riprendi da dove avevi interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴した作品を記録して、中断したところから再開しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청한 작품을 기록하고 중단한 곳에서 이어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan apa yang ditonton dan sambung dari tempat anda berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker det du har sett, og fortsett der du slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer wat je hebt bekeken en ga verder waar je was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczaj obejrzane tytuły i wracaj dokładnie tam, gdzie skończyłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que assistiu e continue de onde parou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează ce ai vizionat și continuă de unde ai rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечай просмотренное и продолжай с того места, где остановился."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označ, čo si pozrel, a pokračuj presne tam, kde si skončil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera vad du har sett och fortsätt där du slutade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediklerini işaretle ve kaldığın yerden devam et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначай переглянуте й продовжуй саме там, де зупинився."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你看过的内容，并从上次中断的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄你看過的內容，並從上次中斷的地方繼續。"
          }
        }
      }
    },
    "Mark your next episode as watched in Cronica.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم حلقتك التالية كمشاهَدة في Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte další epizodu jako zhlédnutou v Cronica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér din næste episode som set i Cronica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere deine nächste Episode in Cronica als gesehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μάρκαρε το επόμενο επεισόδιό σου ως προβληθέν στο Cronica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark your next episode as watched in Cronica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca tu próximo episodio como visto en Cronica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca tu próximo episodio como visto en Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse seuraava jaksosi katsotuksi Cronicassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez votre prochain épisode comme vu dans Cronica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן את הפרק הבא שלך כנצפה ב־Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica में अपना अगला एपिसोड देखा गया चिह्नित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi sljedeću epizodu kao pogledanu u Cronica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelöld megnézettként a következő epizódodat a Cronicában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai episode berikutnya sebagai ditonton di Cronica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna il prossimo episodio come visto in Cronica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaで次のエピソードを視聴済みにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica에서 다음 에피소드를 시청함으로 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda episod seterusnya anda sebagai ditonton dalam Cronica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Merk neste episode som sett i Cronica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer je volgende aflevering als bekeken in Cronica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz kolejny odcinek jako obejrzany w Cronica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque seu próximo episódio como assistido no Cronica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează următorul episod ca vizionat în Cronica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте следующий эпизод как просмотренный в Cronica."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte ďalšiu epizódu ako pozretú v Cronica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera ditt nästa avsnitt som sett i Cronica."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica’da sonraki bölümünüzü izlendi olarak işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте наступний епізод як переглянутий у Cronica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cronica 中将下一集标记为已看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cronica 中將下一集標記為已看。"
          }
        }
      }
    },
