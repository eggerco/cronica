        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probiere einen anderen Filter oder füge Titel über die Suche hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try another filter, or add more titles from Search."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro filtro o agrega más títulos desde Buscar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essaie un autre filtre ou ajoute des titres via Recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altro filtro o aggiungi titoli da Cerca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro filtro ou adicione títulos pela Busca."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skús iný filter alebo pridaj viac titulov cez Vyhľadávanie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب فلتراً آخر، أو أضف المزيد من العناوين من البحث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkus jiný filtr nebo přidej další tituly z Vyhledávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv et andet filter, eller tilføj flere titler fra Søgning."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δοκιμάστε άλλο φίλτρο ή προσθέστε περισσότερους τίτλους από την Αναζήτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro filtro o añade más títulos desde Buscar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile toista suodatinta tai lisää nimikkeitä hausta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסה מסנן אחר, או הוסף עוד כותרות מחיפוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई और फ़िल्टर आज़माएँ, या खोज से और शीर्षक जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokušaj s drugim filtrom ili dodaj više naslova iz Pretrage."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbáljon más szűrőt, vagy adjon hozzá több címet a Keresésből."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba filter lain, atau tambahkan lebih banyak judul dari Pencarian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のフィルターを試すか、検索から作品を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 필터를 시도하거나 검색에서 더 많은 작품을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuba penapis lain, atau tambah lebih banyak tajuk dari Carian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv et annet filter, eller legg til flere titler fra Søk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een ander filter of voeg meer titels toe via Zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj innego filtra lub dodaj więcej tytułów z Wyszukiwania."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă alt filtru sau adaugă mai multe titluri din Căutare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуй другой фильтр или добавь больше названий из Поиска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova ett annat filter eller lägg till fler titlar från Sök."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir filtre dene veya Arama'dan daha fazla başlık ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуй інший фільтр або додай більше назв з Пошуку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试其他筛选，或从搜索中添加更多标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試其他篩選，或從搜尋中加入更多標題。"
          }
        }
      }
    },
