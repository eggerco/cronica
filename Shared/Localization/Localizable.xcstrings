    "Watched titles grouped by type, with estimated viewing time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عناوين مشاهدة مجمّعة حسب النوع، مع وقت مشاهدة مقدّر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhlédnuté tituly seskupené podle typu s odhadovaným časem sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete titler grupperet efter type med estimeret seertid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesehene Titel nach Typ gruppiert, mit geschätzter Sehdauer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθημένοι τίτλοι ομαδοποιημένοι ανά τύπο, με εκτιμώμενο χρόνο παρακολούθησης."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watched titles grouped by type, with estimated viewing time."
          }
        },
