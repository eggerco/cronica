    "Get notified when new movies and episodes arrive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich benachrichtigen, wenn neue Filme und Episoden erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get notified when new movies and episodes arrive."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos cuando lleguen nuevas películas y episodios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez des notifications pour les nouveautés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi notifiche per film ed episodi nuovi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba avisos quando novos filmes e episódios chegarem."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávaj upozornenia, keď vyjdú nové filmy a epizódy."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إشعار عند وصول أفلام وحلقات جديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávej upozornění, když dorazí nové filmy a epizody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når nye film og afsnit udkommer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε ειδοποίηση όταν φτάνουν νέες ταινίες και επεισόδια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos cuando lleguen nuevas películas y episodios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun uusia elokuvia ja jaksoja julkaistaan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל התראה כשמגיעים סרטים ופרקים חדשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई फ़िल्में और एपिसोड आने पर सूचना पाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primaj obavijesti o novim filmovima i epizodama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítést kap, amikor új filmek és epizódok érkeznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan notifikasi saat film dan episode baru tiba."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい映画やエピソードが届いたら通知を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 영화와 에피소드가 공개되면 알림을 받습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan pemberitahuan apabila filem dan episod baharu tiba."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få varsler når nye filmer og episoder kommer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding wanneer nieuwe films en afleveringen verschijnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia o nowych filmach i odcinkach."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primește notificări când apar filme și episoade noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получай уведомления о новых фильмах и эпизодах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få avisering när nya filmer och avsnitt kommer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni filmler ve bölümler geldiğinde bildirim al."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуй сповіщення про нові фільми та епізоди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新电影和剧集上线时接收通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新電影和集數上線時接收通知。"
          }
        }
      }
    },
