    "Cronica can only show where the content is streaming, it cannot link you to the content page on the service's app right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica يمكنه فقط إظهار أين يُبث المحتوى، ولا يمكنه ربطك بصفحة المحتوى في تطبيق الخدمة حالياً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ti ukáže, kde je obsah k dispozici ke streamování, ale zatím tě nemůže přesměrovat na stránku obsahu v aplikaci služby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan kun vise, hvor indholdet streames, men kan ikke linke til indholdssiden i tjenestens app lige nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kann nur anzeigen, wo der Inhalt gestreamt wird, es kann Sie derzeit nicht mit der Inhaltsseite in der App des Dienstes verknüpfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cronica μπορεί μόνο να δείξει πού μεταδίδεται το περιεχόμενο· δεν μπορεί αυτή τη στιγμή να σας συνδέσει με τη σελίδα περιεχομένου στην εφαρμογή της υπηρεσίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica can only show where the content is streaming, it cannot link you to the content page on the service's app right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica solo puede mostrar dónde se transmite el contenido; de momento no puede enlazarte a la página del contenido en la app del servicio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica solo puede mostrar dónde se transmite el contenido, no puede vincularlo a la página de contenido en la aplicación del servicio en este momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica voi vain näyttää, missä sisältö suoratoistetaan, eikä se voi tällä hetkellä linkittää palvelun sovelluksen sisältösivulle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ne peut qu'indiquer l'endroit où le contenu est diffusé, il ne peut pas vous lier à la page du contenu sur l'app du service pour l'instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica יכול רק להראות היכן התוכן זמין לסטרימינג, ולא יכול לקשר אותך לדף התוכן באפליקציית השירות כרגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica केवल दिखा सकता है कि सामग्री कहाँ स्ट्रीम हो रही है; अभी सेवा के ऐप में सामग्री पेज का लिंक नहीं दे सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica može pokazati gdje je sadržaj dostupan za streaming, ali te trenutačno ne može preusmjeriti na stranicu sadržaja u aplikaciji usluge."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica csak megmutatja, hol érhető el a tartalom streamelve; jelenleg nem tud linkelni a szolgáltatás alkalmazásában lévő tartalomoldalra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica hanya bisa menunjukkan di mana konten distreaming; saat ini tidak bisa menautkan ke halaman konten di aplikasi layanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica può solo mostrare dove il contenuto è trasmesso, non può indirizzarti attualmente alla pagina del contenuto nell'applicazione che lo trasmette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaはコンテンツの配信先を表示できますが、現在サービスのアプリ内のコンテンツページにはリンクできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica는 콘텐츠 스트리밍 위치만 표시할 수 있으며, 현재 서비스 앱의 콘텐츠 페이지로 연결할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica hanya boleh tunjuk di mana kandungan distrim; buat masa ini tidak boleh paut ke halaman kandungan dalam aplikasi perkhidmatan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan bare vise hvor innholdet strømmes, og kan ikke lenke deg til innholdssiden i tjenestens app akkurat nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan alleen tonen waar de content wordt gestreamd; het kan je nu niet doorverwijzen naar de contentpagina in de app van de dienst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica może pokazać, gdzie treść jest dostępna do streamingu, ale na razie nie może przekierować do strony treści w aplikacji usługi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica só pode mostrar onde o conteúdo está sendo transmitido, não pode vinculá-lo à página de conteúdo no aplicativo do serviço no momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica poate arăta unde este disponibil conținutul pentru streaming, dar deocamdată nu te poate redirecționa către pagina conținutului din aplicația serviciului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica может показать, где контент доступен для стриминга, но пока не может перейти на страницу контента в приложении сервиса."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dokáže zobraziť iba miesto, kde sa obsah streamuje, momentálne vás nedokáže prepojiť so stránkou obsahu v aplikácii služby."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kan bara visa var innehållet streamas, den kan inte länka till innehållssidan i tjänstens app just nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica yalnızca içeriğin nerede yayınlandığını gösterebilir; şu an hizmetin uygulamasındaki içerik sayfasına bağlantı veremez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica може показати, де контент доступний для стримінгу, але поки не може перейти на сторінку контенту в застосунку сервісу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 只能显示内容的流媒体平台，目前无法链接到各服务平台 App 中的内容页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica 只能顯示內容的串流平台，目前無法連結至各服務平台 App 中的內容頁面。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica শুধুমাত্র কন্টেন্টটি কোথায় স্ট্রিমিং হচ্ছে তা দেখাতে পারে, এটি আপনাকে এই মুহূর্তে পরিষেবার অ্যাপের কন্টেন্ট পেজের সাথে লিঙ্ক করতে পারবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica només pot mostrar on s’emet el contingut; ara mateix no et pot enllaçar a la pàgina del contingut a l’app del servei."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica માત્ર એ જ બતાવી શકે છે કે કન્ટેન્ટ ક્યાં સ્ટ્રીમ થઈ રહ્યું છે, તે તમને અત્યારે સેવાની એપ પરના કન્ટેન્ટ પેજ સાથે લિંક કરી શકતું નથી."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica-ന് ഉള്ളടക്കം എവിടെയാണ് സ്ട്രീം ചെയ്യുന്നതെന്ന് കാണിക്കാൻ മാത്രമേ കഴിയൂ, ഇപ്പോൾ സേവനത്തിൻ്റെ ആപ്പിലെ ഉള്ളടക്ക പേജിലേക്ക് നിങ്ങളെ ലിങ്ക് ചെയ്യാൻ അതിന് കഴിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica केवळ सामग्री कोठे प्रवाहित होत आहे हे दर्शवू शकते, ते आत्ता सेवेच्या ॲपवरील सामग्री पृष्ठाशी तुम्हाला लिंक करू शकत नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica କେବଳ ଦେଖାଇପାରେ ଯେ ବିଷୟବସ୍ତୁ କେଉଁଠାରେ ଷ୍ଟ୍ରିମିଂ ହେଉଛି, ଏହା ଆପଣଙ୍କୁ ବର୍ତ୍ତମାନ ସେବା ଆପରେ ଥିବା ବିଷୟବସ୍ତୁ ପୃଷ୍ଠା ସହିତ ଲିଙ୍କ କରିପାରିବ ନାହିଁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica só pode mostrar onde o conteúdo está sendo transmitido, não pode vinculá-lo à página de conteúdo no aplicação do serviço no momento."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਸਿਰਫ਼ ਇਹ ਦਿਖਾ ਸਕਦਾ ਹੈ ਕਿ ਸਮੱਗਰੀ ਕਿੱਥੇ ਸਟ੍ਰੀਮ ਹੋ ਰਹੀ ਹੈ, ਇਹ ਤੁਹਾਨੂੰ ਇਸ ਵੇਲੇ ਸੇਵਾ ਦੇ ਐਪ 'ਤੇ ਸਮੱਗਰੀ ਪੰਨੇ ਨਾਲ ਲਿੰਕ ਨਹੀਂ ਕਰ ਸਕਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica lahko pokaže le, kje je vsebina na voljo, trenutno pa te ne more povezati s stranjo vsebine v aplikaciji storitve."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளடக்கம் எங்கு ஸ்ட்ரீமிங் செய்கிறது என்பதை மட்டுமே Cronica காட்ட முடியும், இப்போது சேவையின் பயன்பாட்டில் உள்ள உள்ளடக்கப் பக்கத்துடன் உங்களை இணைக்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica కంటెంట్ ఎక్కడ స్ట్రీమింగ్ అవుతుందో మాత్రమే చూపుతుంది, ఇది ప్రస్తుతం సేవ యొక్క యాప్‌లోని కంటెంట్ పేజీకి మిమ్మల్ని లింక్ చేయదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica สามารถแสดงเฉพาะที่ที่เนื้อหากำลังสตรีมเท่านั้น ไม่สามารถเชื่อมโยงคุณไปยังหน้าเนื้อหาในแอปของบริการได้ในขณะนี้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica صرف یہ دکھا سکتا ہے کہ مواد کہاں سٹریم ہو رہا ہے، یہ فی الحال آپ کو سروس کی ایپ پر موجود مواد کے صفحے سے لنک نہیں کر سکتا ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica chỉ có thể hiển thị nơi nội dung đang phát trực tuyến, nó không thể liên kết bạn với trang nội dung trên ứng dụng của dịch vụ ngay bây giờ."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ವಿಷಯವು ಎಲ್ಲಿ ಸ್ಟ್ರೀಮಿಂಗ್ ಆಗುತ್ತಿದೆ ಎಂಬುದನ್ನು ಮಾತ್ರ ತೋರಿಸಬಲ್ಲದು, ಅದು ಇದೀಗ ಸೇವೆಯ ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿರುವ ವಿಷಯ ಪುಟಕ್ಕೆ ನಿಮ್ಮನ್ನು ಲಿಂಕ್ ಮಾಡಲು ಸಾಧ್ಯವಿಲ್ಲ."
          }
        }
      }
    },
