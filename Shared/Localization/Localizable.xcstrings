          "stringUnit": {
            "state": "translated",
            "value": "Confirmă marcarea ca vizionat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждать отметку как просмотренное"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Požiadať o potvrdenie označenia ako sledované"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be om bekräftelse för att markera som sedd"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlendi işaretlemeden önce onay iste"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджувати позначку як переглянуте"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记为已观看前请求确认"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標記為已觀看前要求確認"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখা হয়েছে হিসাবে চিহ্নিত করতে নিশ্চিতকরণ জিজ্ঞাসা করুন"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Demana confirmació per marcar com a vist"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જોયેલું તરીકે ચિહ્નિત કરવા માટે પુષ્ટિ પૂછો"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಲು ದೃಢೀಕರಣವನ್ನು ಕೇಳಿ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണ്ടതായി അടയാളപ്പെടുത്താൻ സ്ഥിരീകരണം ആവശ്യപ്പെടുക"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पाहिले म्हणून चिन्हांकित करण्यासाठी पुष्टीकरण विचारा"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦେଖାଯାଇଥିବା ପରି ଚିହ୍ନିତ କରିବାକୁ ନିଶ୍ଚିତକରଣ ପଚାରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir confirmação para marcar como visto"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੇਖੇ ਗਏ ਵਜੋਂ ਨਿਸ਼ਾਨਦੇਹੀ ਕਰਨ ਲਈ ਪੁਸ਼ਟੀ ਨੂੰ ਪੁੱਛੋ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahtevajte potrditev, da označite kot gledano"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பார்த்ததாகக் குறிக்க உறுதிப்படுத்தலைக் கேட்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వీక్షించినట్లు గుర్తించడానికి నిర్ధారణను అడగండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ยืนยันเพื่อทำเครื่องหมายว่าดูแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu xác nhận đánh dấu là đã xem"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھا گیا کے طور پر نشان زد کرنے کے لئے توثیق سے پوچھیں"
          }
        }
      }
