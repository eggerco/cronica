        }
      }
    },
    "Add items with future release dates to your watchlist to see them here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Titel mit zukünftigen Veröffentlichungsdaten zu deiner Watchlist hinzu, um sie hier zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add items with future release dates to your watchlist to see them here."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega títulos con fechas de estreno futuras a tu lista para verlos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des titres avec des dates de sortie futures à ta liste pour les voir ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
