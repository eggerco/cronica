    "You can mark this as watched after it has been released.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحديده كمشاهد بعد إصداره."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vydání to můžeš označit jako zhlédnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere dette som set, efter det er udgivet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dies als gesehen markieren, sobald es veröffentlicht ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να το σημειώσετε ως παρακολουθημένο αφού κυκλοφορήσει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can mark this as watched after it has been released."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes marcarlo como visto después de su estreno."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes marcarlo como visto después de que se estrene."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit merkitä tämän katsotuksi sen julkaisun jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras le marquer comme vu une fois qu’il sera sorti."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לסמן כנצפה אחרי ששוחרר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ होने के बाद इसे देखा चिह्नित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon izlaska možeš označiti kao pogledano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenés után megtekintettként jelölheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa tandai ditonton setelah dirilis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi segnarlo come visto dopo che sarà uscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開後に視聴済みにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 후 시청함으로 표시할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh tandakan ditonton selepas dikeluarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere dette som sett etter at det er utgitt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit als bekeken markeren nadat het is uitgebracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po premierze możesz oznaczyć to jako obejrzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode marcá-lo como assistido depois que for lançado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Po lansare poți marca ca vizionat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выхода можно отметить как просмотренное."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžeš to označiť ako pozreté po uvedení."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markera detta som sedd efter att det har släppts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlandıktan sonra izlendi olarak işaretleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після виходу можна позначити як переглянуте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上映后你可以将其标记为已观看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上映後你可以將其標記為已觀看。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots marcar-ho com a vist un cop s’hagi estrenat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે તેને રીલીઝ થયા પછી જોયેલું તરીકે ચિહ્નિત કરી શકો છો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज झाल्यानंतर तुम्ही हे पाहिले म्हणून चिन्हांकित करू शकता."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pode marcá-lo como assistido depois que for lançado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਿਲੀਜ਼ ਹੋਣ ਤੋਂ ਬਾਅਦ ਤੁਸੀਂ ਇਸਨੂੰ ਵੇਖਿਆ ਚਿੰਨ੍ਹਿਤ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To lahko označiš kot ogledano, ko izide."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถทำเครื่องหมายสิ่งนี้ว่าดูแล้วหลังจากเผยแพร่แล้ว"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি প্রকাশিত হওয়ার পর আপনি এটিকে 'দেখা হয়েছে' হিসেবে চিহ্নিত করতে পারেন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬಿಡುಗಡೆಯಾದ ನಂತರ ನೀವು ಇದನ್ನು ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "റിലീസ് ചെയ്തുകഴിഞ്ഞാൽ, നിങ്ങൾക്ക് ഇത് കണ്ടതായി അടയാളപ്പെടുത്താം."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହାକୁ ରିଲିଜ୍ ହେବା ପରେ ଆପଣ ଏହାକୁ ଦେଖାଯାଇଛି ଭାବରେ ଚିହ୍ନିତ କରିପାରିବେ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இது வெளியான பிறகு, நீங்கள் இதைப் பார்த்ததாகக் குறித்துக்கொள்ளலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది విడుదలైన తర్వాత మీరు దీనిని చూసినట్లుగా గుర్తించవచ్చు."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đánh dấu là đã xem sau khi phim được phát hành."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری ہونے کے بعد آپ اسے دیکھے ہوئے کے طور پر نشان زد کر سکتے ہیں۔"
          }
        }
      }
    },
    "You can mark this episode as watched after it has aired.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحديد هذه الحلقة كمشاهدة بعد بثها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po odvysílání můžeš tuto epizodu označit jako zhlédnutou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere dette afsnit som set, efter det er sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Episode als gesehen markieren, sobald sie ausgestrahlt wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να σημειώσετε αυτό το επεισόδιο ως παρακολουθημένο αφού μεταδοθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can mark this episode as watched after it has aired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes marcar este episodio como visto después de su emisión."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes marcar este episodio como visto después de que se emita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit merkitä tämän jakson katsotuksi sen esityksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras marquer cet épisode comme vu une fois qu’il sera diffusé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לסמן פרק זה כנצפה אחרי ששודר."
          }
        },
        "hi": {
