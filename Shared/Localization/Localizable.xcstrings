        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרות אלה נשארות מחוץ ל-Up Next עד שתציג אותן שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये श्रृंखलाएँ तब तक Up Next से बाहर रहती हैं जब तक आप फिर न दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove serije ostaju izvan Sljedeće dok ih ponovno ne prikažeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a sorozatok a Következőből rejtve maradnak, amíg újra meg nem jeleníti őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Serial ini tetap tidak di Berikutnya sampai kamu tampilkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste serie restano nascoste da In coda finché non le mostri di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのシリーズは再度表示するまで次に見るから非表示のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시리즈는 다시 표시할 때까지 다음 시청에서 숨겨집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ini kekal luar Seterusnya sehingga anda tunjukkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse seriene forblir skjult fra Neste til du viser dem igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze series blijven verborgen in Hierna totdat je ze opnieuw toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te seriale pozostaną ukryte w Następne, dopóki ich ponownie nie pokażesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas séries ficam fora de A seguir até você mostrá-las novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste seriale rămân ascunse din Urmează până le afișezi din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сериалы останутся вне Далее, пока ты не покажешь их снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto série zostanú mimo Ďalej, kým ich znova nezobrazíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa serier förblir dolda från Nästa tills du visar dem igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu diziler tekrar gösterene kadar Sonraki'den gizli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці серіали залишаться поза Далі, доки ти їх знову не покажеш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些剧集会保持从“接下来观看”中隐藏，直到你再次显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些影集會保持從「接下來觀看」中隱藏，直到你再次顯示。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquestes sèries queden fora d’A continuació fins que les tornis a mostrar."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યાં સુધી તમે તેને ફરીથી બતાવશો નહીં ત્યાં સુધી આ સીરિઝ અપ નેક્સ્ટ બંધ રહેશે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही त्या पुन्हा दाखवेपर्यंत या मालिका Up Next बंद राहतील."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas séries ficam fora de A seguir até tu mostrá-las novamente."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਸੀਰੀਜ਼ ਉਦੋਂ ਤੱਕ ਬੰਦ ਰਹਿੰਦੀਆਂ ਹਨ ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਉਹਨਾਂ ਨੂੰ ਦੁਬਾਰਾ ਨਹੀਂ ਦਿਖਾਉਂਦੇ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te serije ostanejo izključene iz Naprej, dokler jih znova ne pokažeš."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ അവ വീണ്ടും കാണിക്കുന്നത് വരെ ഈ സീരീസ് അടുത്തത് തുടരില്ല."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซีรีส์เหล่านี้จะอยู่ในรายการถัดไปจนกว่าคุณจะแสดงอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những loạt bài này sẽ không hiển thị Up Next cho đến khi bạn hiển thị lại."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সিরিজগুলো আপনি আবার না দেখানো পর্যন্ত 'আপ নেক্সট' থেকে দূরে থাকবে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಅವುಗಳನ್ನು ಮತ್ತೆ ತೋರಿಸುವವರೆಗೆ ಈ ಸರಣಿಗಳು ಅಪ್ ನೆಕ್ಸ್ಟ್‌ನಲ್ಲಿರುವುದಿಲ್ಲ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଧାରାବାହିକଗୁଡ଼ିକ ଆପଣ ପୁଣି ନଦେଖାଇବା ପର୍ଯ୍ୟନ୍ତ \"ଅପ୍ ନେକ୍ସଟ୍\" ରୁହନ୍ତି।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அவற்றை மீண்டும் ஒளிபரப்பும் வரை, இந்தத் தொடர்கள் 'அடுத்து வருபவை' பட்டியலில் இடம்பெறாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వాటిని మళ్లీ ప్రసారం చేసేంత వరకు ఈ సిరీస్‌లు 'అప్ నెక్స్ట్'లో ఉండవు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ سیریز اس وقت تک بند رہیں گی جب تک آپ انہیں دوبارہ نہ دکھائیں۔"
          }
        }
      }
    },
    "These titles stay off your main Watchlist until you unhide them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى هذه العناوين خارج قائمة المشاهدة الرئيسية حتى تُظهرها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto tituly zůstanou mimo hlavní watchlist, dokud je neodkryješ."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse titler forbliver skjult fra din watchlist, indtil du viser dem igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Titel bleiben aus deiner Haupt-Watchlist, bis du sie wieder einblendest."
