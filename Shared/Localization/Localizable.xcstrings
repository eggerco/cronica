        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在其他 SIMKL 应用中已暂停的标题。Cronica 不是完整媒体播放器，因此不使用实时开始/暂停 scrobbling。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在其他 SIMKL 應用程式中已暫停的標題。Cronica 不是完整媒體播放器，因此不使用即時開始/暫停 scrobbling。"
          }
        }
      }
    },
    "Sign-in opens SIMKL in a secure browser session. Cronica never stores your SIMKL password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تسجيل الدخول SIMKL في جلسة متصفح آمنة. لا يخزّن Cronica كلمة مرور SIMKL أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení otevře SIMKL v zabezpečeném prohlížeči. Cronica nikdy neukládá tvé heslo SIMKL."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login åbner SIMKL i en sikker browsersession. Cronica gemmer aldrig din SIMKL-adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung öffnet SIMKL in einer sicheren Browser-Sitzung. Cronica speichert dein SIMKL-Passwort nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση ανοίγει το SIMKL σε ασφαλή περίοδο λειτουργίας προγράμματος περιήγησης. Το Cronica δεν αποθηκεύει ποτέ τον κωδικό SIMKL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in opens SIMKL in a secure browser session. Cronica never stores your SIMKL password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión abre SIMKL en una sesión segura del navegador. Cronica nunca guarda tu contraseña de SIMKL."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión abre SIMKL en una sesión segura del navegador. Cronica nunca guarda tu contraseña de SIMKL."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuminen avaa SIMKL:n suojatussa selainistunnossa. Cronica ei koskaan tallenna SIMKL-salasanaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion ouvre SIMKL dans une session navigateur sécurisée. Cronica ne stocke jamais votre mot de passe SIMKL."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתחברות פותחת את SIMKL בסשן דפדפן מאובטח. Cronica לעולם אינו שומר את סיסמת SIMKL שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन-इन सुरक्षित ब्राउज़र सत्र में SIMKL खोलता है। Cronica कभी आपका SIMKL पासवर्ड संग्रहीत नहीं करता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava otvara SIMKL u sigurnoj sesiji preglednika. Cronica nikad ne pohranjuje tvoju SIMKL lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés biztonságos böngészőmunkamenetben nyitja meg a SIMKL-t. A Cronica soha nem tárolja a SIMKL-jelszavadat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk membuka SIMKL di sesi browser yang aman. Cronica tidak pernah menyimpan kata sandi SIMKL Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso apre SIMKL in una sessione browser sicura. Cronica non memorizza mai la password SIMKL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは安全なブラウザセッションでSIMKLを開きます。CronicaはSIMKLのパスワードを保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 보안 브라우저 세션에서 SIMKL을 엽니다. Cronica는 SIMKL 비밀번호를 저장하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Log masuk membuka SIMKL dalam sesi pelayar yang selamat. Cronica tidak pernah menyimpan kata laluan SIMKL anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pålogging åpner SIMKL i en sikker nettleserøkt. Cronica lagrer aldri SIMKL-passordet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanmelden opent SIMKL in een beveiligde browsersessie. Cronica bewaart je SIMKL-wachtwoord nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie otwiera SIMKL w bezpiecznej sesji przeglądarki. Cronica nigdy nie przechowuje hasła SIMKL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início de sessão abre o SIMKL em uma sessão segura do navegador. O Cronica nunca armazena sua senha do SIMKL."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea deschide SIMKL într-o sesiune de browser securizată. Cronica nu stochează niciodată parola ta SIMKL."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход открывает SIMKL в безопасном сеансе браузера. Cronica никогда не хранит ваш пароль SIMKL."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie otvorí SIMKL v zabezpečenom prehliadači. Cronica nikdy neukladá tvoje heslo SIMKL."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggning öppnar SIMKL i en säker webbläsarsession. Cronica lagrar aldrig ditt SIMKL-lösenord."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma, SIMKL’yi güvenli bir tarayıcı oturumunda açar. Cronica SIMKL parolanızı asla saklamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід відкриває SIMKL у безпечному сеансі браузера. Cronica ніколи не зберігає ваш пароль SIMKL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录会在安全的浏览器会话中打开 SIMKL。Cronica 从不存储你的 SIMKL 密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入會在安全的瀏覽器工作階段中開啟 SIMKL。Cronica 從不儲存你的 SIMKL 密碼。"
          }
        }
      }
    },
