    "See in what platforms the content is available on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على المنصات التي يتوفر عليها المحتوى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívej se, na jakých platformách je obsah dostupný."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se, hvilke platforme indholdet er tilgængeligt på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehe, auf welchen Plattformen der Inhalt verfügbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε σε ποιες πλατφόρμες είναι διαθέσιμο το περιεχόμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See which platforms the content is available on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta en qué plataformas está disponible el contenido."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea en qué plataformas está disponible el contenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso, millä alustoilla sisältö on saatavilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voir sur quelles plateformes le contenu est disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ראה באילו פלטפורמות התוכן זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें कि सामग्री किन प्लेटफ़ॉर्म पर उपलब्ध है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledaj na kojim je platformama sadržaj dostupan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekintse meg, mely platformokon érhető el a tartalom."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat di platform mana konten tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi in quali piattaforme il contenuto è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツが利用可能なプラットフォームを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠를 이용할 수 있는 플랫폼을 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat platform mana kandungan tersedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hvilke plattformer innholdet er tilgjengelig på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk op welke platforms de content beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, na jakich platformach dostępna jest treść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja em quais plataformas o conteúdo está disponível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi pe ce platforme e disponibil conținutul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотри, на каких платформах доступен контент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zistiť, na ktorých platformách je obsah k dispozícii."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vilka plattformar innehållet finns på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçeriğin hangi platformlarda olduğunu gör."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Подивись, на яких платформах доступний контент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
