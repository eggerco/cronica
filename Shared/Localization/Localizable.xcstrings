    "These series stay off Up Next until you show them again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى هذه المسلسلات خارج التالي حتى تعرضها مجدداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto seriály zůstanou mimo Další na řadě, dokud je znovu nezobrazíš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse serier forbliver skjult fra Næste, indtil du viser dem igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Serien bleiben aus „Als Nächstes“ ausgeblendet, bis du sie wieder anzeigst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτές οι σειρές παραμένουν εκτός Επόμενου μέχρι να τις εμφανίσετε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These series stay off Up Next until you show them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas series permanecen ocultas en A continuación hasta que las muestres de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas series no aparecen en A continuación hasta que las muestres de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä sarjat pysyvät poissa Seuraavaksi-listalta, kunnes näytät ne uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces séries restent masquées de À suivre jusqu’à ce que vous les affichiez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סדרות אלה נשארות מחוץ ל-Up Next עד שתציג אותן שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये श्रृंखलाएँ तब तक Up Next से बाहर रहती हैं जब तक आप फिर न दिखाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ove serije ostaju izvan Sljedeće dok ih ponovno ne prikažeš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a sorozatok a Következőből rejtve maradnak, amíg újra meg nem jeleníti őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Serial ini tetap tidak di Berikutnya sampai kamu tampilkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste serie restano nascoste da In coda finché non le mostri di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのシリーズは再度表示するまで次に見るから非表示のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시리즈는 다시 표시할 때까지 다음 시청에서 숨겨집니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri ini kekal luar Seterusnya sehingga anda tunjukkan semula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse seriene forblir skjult fra Neste til du viser dem igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze series blijven verborgen in Hierna totdat je ze opnieuw toont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te seriale pozostaną ukryte w Następne, dopóki ich ponownie nie pokażesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas séries ficam fora de A seguir até você mostrá-las novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste seriale rămân ascunse din Urmează până le afișezi din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сериалы останутся вне Далее, пока ты не покажешь их снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieto série zostanú mimo Ďalej, kým ich znova nezobrazíte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa serier förblir dolda från Nästa tills du visar dem igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu diziler tekrar gösterene kadar Sonraki'den gizli kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці серіали залишаться поза Далі, доки ти їх знову не покажеш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些剧集会保持从“接下来观看”中隐藏，直到你再次显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些影集會保持從「接下來觀看」中隱藏，直到你再次顯示。"
          }
        }
      }
    },
