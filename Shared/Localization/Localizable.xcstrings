    "Restart Cronica. If this keeps happening, contact support.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تشغيل Cronica. إذا استمر ذلك، تواصل مع الدعم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Restartuj Cronica. Pokud se to opakuje, kontaktuj podporu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Genstart Cronica. Hvis det fortsætter, kontakt support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Cronica neu. Wenn das weiterhin passiert, kontaktiere den Support."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επανεκκινήστε το Cronica. Αν συνεχίζεται, επικοινωνήστε με την υποστήριξη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart Cronica. If this keeps happening, contact support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Cronica. Si sigue ocurriendo, contacta con soporte."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Cronica. Si esto sigue ocurriendo, contacta al soporte."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käynnistä Cronica uudelleen. Jos ongelma jatkuu, ota yhteyttä tukeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarre Cronica. Si cela continue, contacte l’assistance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל מחדש את Cronica. אם זה ממשיך, פנה לתמיכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica पुनः प्रारंभ करें। यदि यह जारी रहे, तो सहायता से संपर्क करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno pokreni Cronica. Ako se ponavlja, kontaktiraj podršku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Indítsa újra a Cronicát. Ha továbbra is fennáll, lépjen kapcsolatba az ügyfélszolgálattal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai ulang Cronica. Jika terus terjadi, hubungi dukungan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riavvia Cronica. Se continua a succedere, contatta l’assistenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaを再起動してください。問題が続く場合はサポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica를 다시 시작하세요. 문제가 계속되면 지원팀에 문의하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulakan semula Cronica. Jika berterusan, hubungi sokongan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Cronica på nytt. Hvis dette fortsetter, kontakt support."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Cronica opnieuw. Neem contact op met support als dit blijft gebeuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom ponownie Cronica. Jeśli problem się powtarza, skontaktuj się z pomocą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Cronica. Se isso continuar acontecendo, entre em contato com o suporte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Repornește Cronica. Dacă persistă, contactează suportul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапусти Cronica. Если проблема повторяется, свяжись с поддержкой."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Reštartuj Cronica. Ak sa to bude opakovať, kontaktuj podporu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta om Cronica. Om det fortsätter, kontakta support."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica'yı yeniden başlat. Devam ederse destekle iletişime geç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапусти Cronica. Якщо проблема повторюється, звернісь до підтримки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新启动 Cronica。如果问题持续，请联系支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重新啟動 Cronica。如果問題持續，請聯絡支援。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia Cronica. Si continua passant, contacta amb el suport."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica પુનઃપ્રારંભ કરો. જો આવું થતું રહે, તો સપોર્ટનો સંપર્ક કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica रीस्टार्ट करा. असे होत राहिल्यास, सपोर्टशी संपर्क साधा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ପୁନ Rest ଆରମ୍ଭ କରନ୍ତୁ | ଯଦି ଏହା ଘଟୁଛି, ସମର୍ଥନକୁ ଯୋଗାଯୋଗ କରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie o Cronica. Se isso continuar acontecendo, entre em contato com o suporte."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਰੀਸਟਾਰਟ ਕਰੋ। ਜੇਕਰ ਅਜਿਹਾ ਹੁੰਦਾ ਰਹਿੰਦਾ ਹੈ, ਤਾਂ ਸਹਾਇਤਾ ਨਾਲ ਸੰਪਰਕ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova zaženi Cronica. Če se to ponavlja, kontaktiraj podporo."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica പുനരാരംഭിക്കുക. ഇത് തുടരുകയാണെങ്കിൽ, പിന്തുണയുമായി ബന്ധപ്പെടുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีสตาร์ท Cronica หากยังเกิดเหตุการณ์นี้อยู่ โปรดติดต่อฝ่ายสนับสนุน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động lại Cronica. Nếu điều này tiếp tục xảy ra, hãy liên hệ với bộ phận hỗ trợ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica পুনরায় চালু করুন। যদি এটি বারবার ঘটতে থাকে, তাহলে সাপোর্টে যোগাযোগ করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ಅನ್ನು ಮರುಪ್ರಾರಂಭಿಸಿ. ಇದು ಹೀಗೆಯೇ ಆಗುತ್ತಿದ್ದರೆ, ಬೆಂಬಲವನ್ನು ಸಂಪರ್ಕಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica-ஐ மறுதொடக்கம் செய்யவும். இது தொடர்ந்தால், ஆதரவுக் குழுவைத் தொடர்பு கொள்ளவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaను పునఃప్రారంభించండి. ఇలాగే కొనసాగితే, సపోర్ట్‌ను సంప్రదించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica کو دوبارہ شروع کریں۔ اگر ایسا ہوتا رہتا ہے تو سپورٹ سے رابطہ کریں۔"
          }
        }
      }
    },
