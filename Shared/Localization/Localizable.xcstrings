    "Follow Cronica on X (Twitter) to stay updated about new features.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen Sie Cronica auf X (Twitter), um über neue Funktionen auf dem Laufenden zu bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Cronica on X (Twitter) to stay updated about new features."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a Cronica en X (Twitter) para mantenerte actualizado sobre las nuevas funciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez Cronica sur X (Twitter) pour rester informé des nouvelles fonctionnalités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui Cronica su X (Twitter) per rimanere aggiornato sulle nuove funzionalità."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga o Cronica no X (Twitter) para se manter atualizado sobre novos recursos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte Cronica na X (Twitter), aby ste boli informovaní o nových funkciách."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع Cronica على X (Twitter) للبقاء على اطلاع بالميزات الجديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj Cronica na X (Twitter), abys měl/a přehled o nových funkcích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg Cronica på X (Twitter) for at holde dig opdateret om nye funktioner."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακολουθήστε το Cronica στο X (Twitter) για ενημερώσεις σχετικά με νέες λειτουργίες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue a Cronica en X (Twitter) para estar al día de las novedades."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa Cronicaa X:ssä (Twitter) pysyäksesi ajan tasalla uusista ominaisuuksista."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחר Cronica ב-X (Twitter) כדי להישאר מעודכן על תכונות חדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई सुविधाओं की जानकारी के लिए X (Twitter) पर Cronica को फ़ॉलो करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati Cronica na X (Twitter) za novosti o novim značajkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesse a Cronicát az X (Twitter) oldalon az új funkciókról szóló frissítésekért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti Cronica di X (Twitter) untuk update fitur baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X（Twitter）でCronicaをフォローして、新機能の情報を受け取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "X(Twitter)에서 Cronica를 팔로우하여 새 기능 소식을 받아보세요."
