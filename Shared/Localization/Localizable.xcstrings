    "Remove From Pin when item is  marked as watched": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den Pinnwand entfernen, wenn das Element als gesehen markiert wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from pin when item is marked as watched"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar del pin cuando el elemento está marcado como observado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer l'épingle lorsque l'élément est marqué comme vu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi da Fissato quando l'elemento è segnato come visto"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover do Fixado quando o item estiver marcado como assistido"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrániť z pripnutých po označení ako pozreté"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة من التثبيت عند تحديد العنصر كمشاهد"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat z připnutí po označení jako zhlédnuté"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern fra fastgørelse, når element markeres som set"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαίρεση από καρφίτσωμα όταν το στοιχείο σημειωθεί ως παρακολουθημένο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitar de fijados cuando el elemento se marca como visto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista kiinnityksestä, kun kohde merkitään katsotuksi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסר מהצמדה כשפריט מסומן כנצפה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइटम देखा चिह्नित होने पर पिन से हटाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloni s prikvačenih kad je označeno kao pogledano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítás a rögzítésből, ha az elem megtekintettként van jelölve"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus dari semat saat item ditandai ditonton"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴済みにしたときピン留めから削除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청함으로 표시 시 고정에서 제거"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buang dari semat apabila item ditandakan ditonton"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern fra fest når element markeres som sett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Losmaken wanneer item als bekeken is gemarkeerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń z przypiętych po oznaczeniu jako obejrzane"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină din fixate când e marcat ca vizionat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убрать из закреплённых при отметке как просмотренное"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort från fäst när objekt markeras som sedd"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğe izlendi işaretlendiğinde sabitlemeden kaldır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибрати з закріплених після позначення як переглянуте"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
