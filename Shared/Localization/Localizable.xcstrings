    "Use Siri and the Shortcuts app to add titles, mark episodes watched, check what's up next, and open movies or shows in Cronica.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Siri وتطبيق الاختصارات لإضافة عناوين وتعليم الحلقات كمشاهَدة والاطلاع على التالي وفتح أفلام أو مسلسلات في Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte Siri a aplikaci Zkratky k přidávání titulů, označování epizod, kontrole Další a otevírání filmů či seriálů v Cronica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Siri og appen Genveje til at tilføje titler, markere episoder som set, tjekke Næste og åbne film eller serier i Cronica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Siri und die Kurzbefehle-App, um Titel hinzuzufügen, Episoden als gesehen zu markieren, Als Nächstes zu prüfen und Filme oder Serien in Cronica zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποίησε το Siri και την εφαρμογή Συντομεύσεις για να προσθέσεις τίτλους, να μαρκάρεις επεισόδια, να δεις τα Επόμενα και να ανοίξεις ταινίες ή σειρές στο Cronica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Siri and the Shortcuts app to add titles, mark episodes watched, check what's up next, and open movies or shows in Cronica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Siri y la app Atajos para añadir títulos, marcar episodios como vistos, ver A continuación y abrir películas o series en Cronica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Siri y la app Atajos para agregar títulos, marcar episodios como vistos, ver A continuación y abrir películas o series en Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä Siriä ja Pikakomennot-sovellusta nimien lisäämiseen, jaksojen merkitsemiseen, Seuraavaksi-listan tarkistamiseen sekä elokuvien ja sarjojen avaamiseen Cronicassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Siri et l’app Raccourcis pour ajouter des titres, marquer des épisodes comme vus, voir À suivre et ouvrir films ou séries dans Cronica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש ב־Siri ובאפליקציית קיצורי הדרך כדי להוסיף כותרות, לסמן פרקים כנצפים, לבדוק את הבא בתור ולפתוח סרטים או סדרות ב־Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक जोड़ने, एपिसोड देखा गया चिह्नित करने, आगे क्या जाँचने और Cronica में फ़िल्में या शो खोलने के लिए Siri और शॉर्टकट ऐप का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi Siri i aplikaciju Prečaci za dodavanje naslova, označavanje epizoda, pregled Sljedećeg i otvaranje filmova ili serija u Cronica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használd a Sirit és a Parancsok appot címek hozzáadásához, epizódok megjelöléséhez, a Következők ellenőrzéséhez, valamint filmek és sorozatok megnyitásához a Cronicában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Siri dan app Pintasan untuk menambahkan judul, menandai episode ditonton, memeriksa Selanjutnya, dan membuka film atau acara di Cronica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Siri e l’app Comandi per aggiungere titoli, segnare episodi come visti, controllare In programma e aprire film o serie in Cronica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriとショートカットアプリで作品の追加、エピソードの視聴済み、次に観るの確認、Cronicaでの映画やドラマの表示ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri와 단축어 앱으로 작품을 추가하고, 에피소드를 시청함으로 표시하며, 다음에 볼 것을 확인하고, Cronica에서 영화나 프로그램을 여세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Siri dan app Pintasan untuk menambah tajuk, menanda episod ditonton, menyemak Seterusnya, dan membuka filem atau rancangan dalam Cronica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Siri og Snarveier-appen til å legge til titler, merke episoder som sett, sjekke Neste og åpne filmer eller serier i Cronica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Siri en de app Opdrachten om titels toe te voegen, afleveringen als bekeken te markeren, Hierna te bekijken en films of series in Cronica te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj Siri i aplikacji Skróty, aby dodawać tytuły, oznaczać odcinki, sprawdzać Dalej oraz otwierać filmy i seriale w Cronica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Siri e o app Atalhos para adicionar títulos, marcar episódios como assistidos, ver A seguir e abrir filmes ou séries no Cronica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește Siri și app-ul Comenzi rapide pentru a adăuga titluri, a marca episoade, a verifica Urmează și a deschide filme sau seriale în Cronica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте Siri и приложение «Команды», чтобы добавлять названия, отмечать эпизоды, смотреть «Дальше» и открывать фильмы или сериалы в Cronica."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite Siri a aplikáciu Skrátené príkazy na pridávanie titulov, označovanie epizód, kontrolu Ďalej a otváranie filmov či seriálov v Cronica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Siri och appen Genvägar för att lägga till titlar, markera avsnitt som sett, kolla Härnäst och öppna filmer eller serier i Cronica."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlık eklemek, bölümleri izlendi işaretlemek, Sıradakiler’e bakmak ve Cronica’da film veya dizi açmak için Siri ve Kısayollar uygulamasını kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте Siri та програму «Команди», щоб додавати назви, позначати епізоди, перевіряти «Далі» та відкривати фільми чи серіали в Cronica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Siri 和“快捷指令”应用添加作品、标记已看剧集、查看接下来，并在 Cronica 中打开电影或剧集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Siri 與「捷徑」App 加入作品、標記已看劇集、查看接下來，並在 Cronica 中打開電影或劇集。"
          }
        }
      }
    },
