        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cronica 中将电影或剧集标记为已看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cronica 中將電影或劇集標記為已看。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una pel·lícula o sèrie com a vista a Cronica."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica માં જોયેલી મૂવી અથવા ટીવી શોને ચિહ્નિત કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica मध्ये पाहिल्याप्रमाणे चित्रपट किंवा टीव्ही शो चिन्हांकित करा."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque um filme ou série como assistido no Cronica."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਮੂਵੀ ਜਾਂ ਟੀਵੀ ਸ਼ੋਅ ਨੂੰ Cronica ਵਿੱਚ ਦੇਖੇ ਗਏ ਵਜੋਂ ਚਿੰਨ੍ਹਿਤ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite film ali TV-oddajo kot ogledano v Cronica."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു സിനിമയോ ടിവി ഷോയോ Cronica-ൽ കണ്ടതായി അടയാളപ്പെടുത്തുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายภาพยนตร์หรือรายการทีวีว่ารับชมใน Cronica"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica میں دیکھی گئی فلم یا ٹی وی شو کو نشان زد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu một bộ phim hoặc chương trình truyền hình là đã xem trong Cronica."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica-এ কোনো সিনেমা বা টিভি শো-কে দেখা হয়েছে বলে চিহ্নিত করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ನಲ್ಲಿ ಚಲನಚಿತ್ರ ಅಥವಾ ಟಿವಿ ಕಾರ್ಯಕ್ರಮವನ್ನು ವೀಕ್ಷಿಸಿದಂತೆ ಗುರುತಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ରେ ଦେଖାଯାଇଥିବା ଭାବରେ ଏକ ସିନେମା କିମ୍ବା ଟିଭି ଶୋ’କୁ ଚିହ୍ନିତ କରନ୍ତୁ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica-இல் ஒரு திரைப்படம் அல்லது தொலைக்காட்சி நிகழ்ச்சியைப் பார்த்ததாகக் குறிக்கவும்."
          }
