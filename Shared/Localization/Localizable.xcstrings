        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, napauta avataksesi listan asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, appuyer pour ouvrir les options de la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, הקש לפתיחת אפשרויות הרשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, सूची विकल्प खोलने के लिए टैप करें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dodirni za opcije popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, koppintson a lista beállításainak megnyitásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ketuk untuk membuka opsi daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tocca per aprire la lista delle opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、タップしてリストのオプションを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 탭하여 목록 옵션을 엽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ketik untuk buka pilihan senarai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, trykk for å åpne listealternativer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tik om lijstopties te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dotknij, aby otworzyć opcje listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, toque para abrir as opções da lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, atinge pentru opțiunile listei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, нажми, чтобы открыть параметры списка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ťuknutím otvoríš možnosti zoznamu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tryck för att öppna listalternativ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, liste seçeneklerini açmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, торкнись, щоб відкрити параметри списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，点按以打开列表选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，點按以開啟列表選項。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, toca per obrir les opcions de la llista."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, સૂચિ વિકલ્પો ખોલવા માટે ટેપ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ಪಟ್ಟಿ ಆಯ್ಕೆಗಳನ್ನು ತೆರೆಯಲು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ലിസ്റ്റ് ഓപ്ഷനുകൾ തുറക്കാൻ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, सूची पर्याय उघडण्यासाठी टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ତାଲିକା ବିକଳ୍ପ ଖୋଲିବାକୁ ଟ୍ୟାପ୍ କରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, toque para abrir as opções da lista."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ਸੂਚੀ ਵਿਕਲਪਾਂ ਨੂੰ ਖੋਲ੍ਹਣ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tapnite, da odprete možnosti seznama."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, பட்டியல் விருப்பங்களைத் திறக்க தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, జాబితా ఎంపికలను తెరవడానికి నొక్కండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ แตะเพื่อเปิดตัวเลือกรายการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, nhấn để mở các tùy chọn danh sách."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، فہرست کے آپشنز کھولنے کے لیے ٹیپ کریں ۔"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, তালিকার বিকল্পগুলো খুলতে ট্যাপ করুন।"
          }
        }
      }
    },
