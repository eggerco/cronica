    "Pinned and in-progress titles from your watchlist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned and in-progress titles from your watchlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angepinnte und laufende Titel aus deiner Watchlist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres épinglés et en cours depuis ta liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli fissati e in corso dalla tua lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos fixados e em andamento da sua lista."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripnuté a rozpracované tituly z tvojho zoznamu."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos fijados y en progreso de tu lista."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين المثبتة وقيد المشاهدة من قائمة المشاهدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připnuté a rozdělané tituly z watchlistu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgjorte og igangværende titler fra din watchlist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καρφιτσωμένοι και σε εξέλιξη τίτλοι από τη λίστα παρακολούθησής σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos fijados y en progreso de tu lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitetyt ja kesken olevat nimikkeet katselulistaltasi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרות מוצמדות ובתהליך מרשימת הצפייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉचलिस्ट से पिन और प्रगति में शीर्षक।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikvačeni i u tijeku naslovi s popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzített és folyamatban lévő címek a figyelőlistájáról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul disematkan dan sedang ditonton dari watchlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチリストのピン留めと視聴中の作品。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치리스트의 고정 및 시청 중인 작품."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk disemat dan sedang ditonton dari watchlist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Festede og pågående titler fra watchlisten din."
