    "Notify when a movie on your watchlist is released.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغني عند إصدار فيلم في قائمة المشاهدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornit, když film z watchlistu vyjde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når en film på din watchlist udkommer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn ein Film auf deiner Watchlist veröffentlicht wird."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ειδοποίηση όταν κυκλοφορεί ταινία από τη λίστα παρακολούθησής σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when a movie on your watchlist is released."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso cuando se estrene una película de tu lista."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifica cuando se estrene una película en tu lista de seguimiento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun katselulistasi elokuva julkaistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier la sortie d'un film figurant sur votre liste de visionnage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודע כשסרט ברשימת הצפייה משוחרר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉचलिस्ट की फ़िल्म रिलीज़ होने पर सूचित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti kad film s popisa bude objavljen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítés, ha megjelenik egy film a figyelőlistáján."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu saat film di watchlist dirilis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifica l'uscita di un Film nella tua Watchlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチリストの映画が公開されたら通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치리스트의 영화가 공개되면 알림을 보냅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklum apabila filem dalam watchlist dikeluarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få varsel når en film i watchlisten din utgis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding wanneer een film op je watchlist wordt uitgebracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadom, gdy film z listy zostanie wydany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifique quando um filme na sua lista for lançado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifică când se lansează un film din watchlist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять, когда выходит фильм из списка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozorniť na vydanie filmu zo zoznamu sledovaných."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få avisering när en film i din watchlist släpps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme listendeki bir film yayınlandığında bildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли виходить фільм зі списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当观看清单中的电影上映时通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當觀看清單中的電影上映時通知你。"
          }
        }
      }
    },
