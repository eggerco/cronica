    "This permanently removes your personal data from Cronica on this device. It cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden deine persönlichen Daten dauerhaft von Cronica auf diesem Gerät entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your personal data from Cronica on this device. It cannot be undone."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tus datos personales de Cronica en este dispositivo. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement tes données personnelles de Cronica sur cet appareil. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove permanentemente i tuoi dati personali da Cronica su questo dispositivo. Non puoi annullare questa azione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente seus dados pessoais do Cronica neste dispositivo. Isso não pode ser desfeito."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Týmto sa natrvalo odstránia tvoje osobné údaje z Cronica na tomto zariadení. Nie je možné to vrátiť späť."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا بياناتك الشخصية من Cronica على هذا الجهاز نهائياً. لا يمكن التراجع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím trvale odstraníš svá osobní data Cronica na tomto zařízení. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent dine personlige data fra Cronica på denne enhed. Det kan ikke fortrydes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί μόνιμα τα προσωπικά σας δεδομένα από το Cronica σε αυτή τη συσκευή. Δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tus datos personales de Cronica en este dispositivo. No se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi henkilökohtaiset tietosi Cronicasta tältä laitteelta. Toimintoa ei voi perua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה מסיר לצמיתות את הנתונים האישיים שלך מ-Cronica במכשיר זה. לא ניתן לבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Cronica से इस डिवाइस पर आपका व्यक्तिगत डेटा स्थायी रूप से हटाता है। पूर्ववत नहीं हो सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno uklanja tvoje osobne Cronica podatke s ovog uređaja. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolítja személyes adatait a Cronicából ezen az eszközön. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus data pribadimu dari Cronica di perangkat ini secara permanen. Tidak bisa dibatalkan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのCronicaから個人データが完全に削除されます。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 Cronica에서 개인 데이터가 영구적으로 제거됩니다. 되돌릴 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membuang data peribadi anda daripada Cronica pada peranti ini secara kekal. Tidak boleh dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent dine personlige data fra Cronica på denne enheten. Det kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert permanent je persoonlijke gegevens van Cronica op dit apparaat. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usuwa twoje dane osobiste Cronica z tego urządzenia. Tej operacji nie można cofnąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină permanent datele tale personale Cronica de pe acest dispozitiv. Acțiunea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит твои личные данные Cronica на этом устройстве. Это нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort dina personuppgifter från Cronica på den här enheten. Det kan inte ångras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Cronica'daki kişisel verilerini bu cihazdan kalıcı olarak siler. Geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить твої особисті дані Cronica на цьому пристрої. Це не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久移除此设备上 Cronica 中的个人数据。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將永久移除此裝置上 Cronica 中的個人資料。此操作無法復原。"
          }
        }
      }
    },
    "This permanently removes your watchlist, lists, progress, notifications, calendar events, preferences, and any SIMKL or TMDB sign-in from this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل هذا نهائيًا قائمتك والقوائم والتقدّم والإشعارات وأحداث التقويم والتفضيلات وأي تسجيل دخول لـ SIMKL أو TMDB من هذا الجهاز."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto trvale odstraní seznam, seznamy, průběh, oznámení, události kalendáře, preference a jakékoli přihlášení SIMKL nebo TMDB z tohoto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent din liste, lister, fremskridt, notifikationer, kalenderbegivenheder, præferencer og ethvert SIMKL- eller TMDB-login fra denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies entfernt dauerhaft Merkliste, Listen, Fortschritt, Mitteilungen, Kalenderereignisse, Einstellungen und jede SIMKL- oder TMDB-Anmeldung von diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό αφαιρεί οριστικά τη λίστα, τις λίστες, την πρόοδο, τις ειδοποιήσεις, τα γεγονότα ημερολογίου, τις προτιμήσεις και κάθε σύνδεση SIMKL ή TMDB από αυτή τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your watchlist, lists, progress, notifications, calendar events, preferences, and any SIMKL or TMDB sign-in from this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu lista, listas, progreso, notificaciones, eventos del calendario, preferencias y cualquier inicio de sesión de SIMKL o TMDB de este dispositivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente tu lista, listas, progreso, notificaciones, eventos del calendario, preferencias y cualquier inicio de sesión de SIMKL o TMDB de este dispositivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi watchlistan, listat, edistymisen, ilmoitukset, kalenteritapahtumat, asetukset sekä SIMKL- tai TMDB-kirjautumisen tältä laitteelta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre liste, listes, progression, notifications, événements calendrier, préférences et toute connexion SIMKL ou TMDB de cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה לצמיתות את הרשימה, הרשימות, ההתקדמות, ההתראות, אירועי היומן, ההעדפות וכל התחברות SIMKL או TMDB ממכשיר זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस से आपकी वॉचलिस्ट, सूचियाँ, प्रगति, सूचनाएँ, कैलेंडर इवेंट, प्राथमिकताएँ और कोई भी SIMKL या TMDB साइन-इन स्थायी रूप से हटा देता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno uklanja popis, popise, napredak, obavijesti, događaje kalendara, postavke i svaku SIMKL ili TMDB prijavu s ovog uređaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez véglegesen eltávolítja a listát, listákat, előrehaladást, értesítéseket, naptáreseményeket, beállításokat és minden SIMKL- vagy TMDB-bejelentkezést erről az eszközről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus secara permanen daftar tonton, daftar, progres, notifikasi, acara kalender, preferensi, dan setiap masuk SIMKL atau TMDB dari perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove definitivamente watchlist, liste, progressi, notifiche, eventi calendario, preferenze e qualsiasi accesso SIMKL o TMDB da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、ウォッチリスト、リスト、進捗、通知、カレンダー予定、設定、およびこのデバイス上のSIMKLまたはTMDBのサインインが完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 워치리스트, 목록, 진행 상황, 알림, 캘린더 이벤트, 환경설정, SIMKL 또는 TMDB 로그인이 영구적으로 제거됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini mengalih keluar secara kekal senarai tontonan, senarai, kemajuan, pemberitahuan, acara kalendar, pilihan dan sebarang log masuk SIMKL atau TMDB daripada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner permanent listen, lister, fremdrift, varsler, kalenderhendelser, preferanser og all SIMKL- eller TMDB-pålogging fra denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert permanent je watchlist, lijsten, voortgang, meldingen, agenda-items, voorkeuren en elke SIMKL- of TMDB-aanmelding van dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usuwa listę, listy, postęp, powiadomienia, wydarzenia kalendarza, preferencje oraz każde logowanie SIMKL lub TMDB z tego urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove permanentemente sua lista, listas, progresso, notificações, eventos do calendário, preferências e qualquer início de sessão do SIMKL ou TMDB deste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină definitiv lista, listele, progresul, notificările, evenimentele din calendar, preferințele și orice autentificare SIMKL sau TMDB de pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удаляет список, списки, прогресс, уведомления, события календаря, настройки и любой вход SIMKL или TMDB с этого устройства."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto natrvalo odstráni zoznam, zoznamy, priebeh, oznámenia, udalosti kalendára, preferencie a akékoľvek prihlásenie SIMKL alebo TMDB z tohto zariadenia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort din lista, listor, förlopp, aviseringar, kalenderhändelser, preferenser och all SIMKL- eller TMDB-inloggning från den här enheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, izleme listenizi, listelerinizi, ilerlemenizi, bildirimleri, takvim etkinliklerini, tercihleri ve bu cihazdaki tüm SIMKL veya TMDB oturumlarını kalıcı olarak kaldırır."
