    "When enabled, watches, ratings, archive, and removals in Cronica are queued and sent to SIMKL. Off by default.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل تُرسل المشاهدات والتقييمات والأرشفة والحذف في Cronica إلى SIMKL. معطّل افتراضيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je zapnuto, zhlédnutí, hodnocení, archiv a odstranění v Cronice se odesílají na SIMKL. Ve výchozím stavu vypnuto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er slået til, sendes set, vurderinger, arkiv og fjernelser i Cronica til SIMKL. Fra som standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Gesehenes, Bewertungen, Archiv und Entfernungen in Cronica an SIMKL gesendet. Standardmäßig aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ενεργό, προβολές, βαθμολογίες, αρχείο και αφαιρέσεις στο Cronica αποστέλλονται στο SIMKL. Απενεργοποιημένο από προεπιλογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, watches, ratings, archive, and removals in Cronica are queued and sent to SIMKL. Off by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, visionados, valoraciones, archivo y eliminaciones en Cronica se envían a SIMKL. Desactivado por defecto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, visualizaciones, calificaciones, archivo y eliminaciones en Cronica se envían a SIMKL. Desactivado por defecto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käytössä, katselut, arviot, arkisto ja poistot Cronicassa lähetetään SIMKL:ään. Oletuksena pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, visionnages, notes, archive et suppressions dans Cronica sont envoyés à SIMKL. Désactivé par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמופעל, צפיות, דירוגים, ארכיון והסרות ב‑Cronica נשלחים ל‑SIMKL. כבוי כברירת מחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर, Cronica में देखे गए टाइटल, रेटिंग, आर्काइव और हटाए गए कंटेंट को कतार में लगाकर SIMKL को भेज दिया जाता है। यह डिफ़ॉल्ट रूप से बंद रहता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, gledanja, ocjene, arhiva i uklanjanja u Cronica šalju se na SIMKL. Zadano isključeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha be van kapcsolva, a megnézések, értékelések, archívum és eltávolítások a Cronicában a SIMKL-re kerülnek. Alapból ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diaktifkan, tontonan, rating, arsip, dan penghapusan di Cronica dikirim ke SIMKL. Nonaktif secara default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, visioni, valutazioni, archivio e rimozioni in Cronica vengono inviati a SIMKL. Disattivato di default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Cronicaの視聴、評価、アーカイブ、削除がSIMKLに送信されます。既定ではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하면 Cronica의 시청, 평점, 보관함, 삭제가 SIMKL로 전송됩니다. 기본값은 꺼짐입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila didayakan, tontonan, rating, arkib dan penyingkiran dalam Cronica dihantar ke SIMKL. Dimatikan secara lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når aktivert sendes sett, vurderinger, arkiv og fjerninger i Cronica til SIMKL. Av som standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld worden bekeken, beoordelingen, archief en verwijderingen in Cronica naar SIMKL gestuurd. Standaard uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu obejrzane, oceny, archiwum i usunięcia w Cronica są wysyłane do SIMKL. Domyślnie wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, assistidos, avaliações, arquivo e remoções no Cronica são enviados ao SIMKL. Desativado por padrão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este activat, vizionările, evaluările, arhiva și eliminările din Cronica sunt trimise la SIMKL. Dezactivat implicit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, просмотры, оценки, архив и удаления в Cronica отправляются в SIMKL. По умолчанию выкл."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je zapnuté, sledovania, hodnotenia, archív a odstránenia v Cronice sa odosielajú na SIMKL. Predvolene vypnuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det är aktiverat skickas tittat, betyg, arkiv och borttagningar i Cronica till SIMKL. Av som standard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde Cronica’daki izlemeler, puanlar, arşiv ve kaldırmalar SIMKL’ye gönderilir. Varsayılan kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено, перегляди, оцінки, архів і видалення в Cronica надсилаються до SIMKL. Типово вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Cronica 中的观看、评分、归档和移除会排队发送到 SIMKL。默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，Cronica 中的觀看、評分、封存和移除會排程傳送到 SIMKL。預設關閉。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan està activat, els títols vistos, les classificacions, l'arxiu i les eliminacions a Cronica es posen en cua i s'envien a SIMKL. Desactivat per defecte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે સક્ષમ હોય, ત્યારે Cronicaમાં જોયેલા શીર્ષકો, રેટિંગ્સ, આર્કાઇવ અને દૂર કરવા કતારમાં મૂકવામાં આવે છે અને SIMKL પર મોકલવામાં આવે છે. ડિફૉલ્ટ રૂપે બંધ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम केल्यावर, क्रोनिकामधील पाहिलेली शीर्षके, रेटिंग्ज, संग्रह आणि काढून टाकलेली शीर्षके रांगेत लावली जातात आणि SIMKL कडे पाठवली जातात. डीफॉल्टनुसार बंद असते."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativada, a função adiciona títulos assistidos, classificações, arquivos e remoções do Cronica à fila e os envia para o SIMKL. Desativada por padrão."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਸਮਰੱਥ ਬਣਾਇਆ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਕਰੋਨਿਕਾ ਵਿੱਚ ਦੇਖੇ ਗਏ ਸਿਰਲੇਖ, ਰੇਟਿੰਗਾਂ, ਪੁਰਾਲੇਖ ਅਤੇ ਹਟਾਉਣ ਨੂੰ ਕਤਾਰ ਵਿੱਚ ਰੱਖਿਆ ਜਾਂਦਾ ਹੈ ਅਤੇ SIMKL ਨੂੰ ਭੇਜਿਆ ਜਾਂਦਾ ਹੈ। ਡਿਫੌਲਟ ਤੌਰ 'ਤੇ ਬੰਦ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je omogočeno, se gledani naslovi, ocene, arhiv in odstranitve v Cronica uvrstijo v čakalno vrsto in pošljejo v SIMKL. Privzeto izklopljeno."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തനക്ഷമമാക്കുമ്പോൾ, ക്രോണിക്കയിലെ കണ്ട ശീർഷകങ്ങൾ, റേറ്റിംഗുകൾ, ആർക്കൈവ്, നീക്കംചെയ്യലുകൾ എന്നിവ ക്യൂവിലാക്കി SIMKL-ലേക്ക് അയയ്ക്കും. ഡിഫോൾട്ടായി ഓഫാണ്."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งาน รายการที่รับชม การให้คะแนน การเก็บถาวร และการลบใน Cronica จะถูกจัดคิวและส่งไปยัง SIMKL โดยค่าเริ่มต้นจะปิดใช้งานอยู่"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালু করা হলে, Cronica-তে দেখা শিরোনাম, রেটিং, আর্কাইভ এবং অপসারণগুলি সারিবদ্ধ করা হয় এবং SIMKL-এ পাঠানো হয়। ডিফল্টরূপে এটি বন্ধ থাকে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, ಕ್ರೋನಿಕಾದಲ್ಲಿ ವೀಕ್ಷಿಸಿದ ಶೀರ್ಷಿಕೆಗಳು, ರೇಟಿಂಗ್‌ಗಳು, ಆರ್ಕೈವ್ ಮತ್ತು ತೆಗೆದುಹಾಕುವಿಕೆಗಳನ್ನು ಸರದಿಯಲ್ಲಿ ಇರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು SIMKL ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ಡೀಫಾಲ್ಟ್ ಆಗಿ ಆಫ್ ಆಗುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସକ୍ଷମ ହେଲେ, କ୍ରୋନିକାରେ ଦେଖାଯାଇଥିବା ଶୀର୍ଷକ, ମୂଲ୍ୟାଙ୍କନ, ସଂଗ୍ରହ ଏବଂ ଅପସାରଣକୁ ଧାଡ଼ିରେ ରଖାଯାଇଛି ଏବଂ SIMKL କୁ ପଠାଯାଇଛି। ଡିଫଲ୍ଟ ଭାବରେ ବନ୍ଦ ଅଛି।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டால், Cronica-வில் பார்க்கப்பட்ட தலைப்புகள், மதிப்பீடுகள், காப்பகம் மற்றும் நீக்கங்கள் வரிசைப்படுத்தப்பட்டு SIMKL-க்கு அனுப்பப்படும். இயல்புநிலையாக முடக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎనేబుల్ చేసినప్పుడు, Cronicaలో చూసిన టైటిల్స్, రేటింగ్‌లు, ఆర్కైవ్ మరియు తొలగింపులు క్యూలో ఉంచబడి SIMKLకు పంపబడతాయి. డిఫాల్ట్‌గా ఆఫ్ చేయబడి ఉంటుంది."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi được bật, các tựa phim đã xem, xếp hạng, kho lưu trữ và các mục đã xóa trong Cronica sẽ được xếp vào hàng đợi và gửi đến SIMKL. Mặc định là tắt."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال ہونے پر، Cronica میں دیکھے گئے عنوانات، درجہ بندی، محفوظ شدہ دستاویزات، اور ہٹانے کو قطار میں لگا کر SIMKL کو بھیج دیا جاتا ہے۔ بطور ڈیفالٹ آف۔"
          }
        }
      }
    },
    "When enabled, watchlist, favorites, and ratings in Cronica are queued and sent to TMDB. Marking watched removes the title from your TMDB watchlist (TMDB has no watched-history API). Off by default.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التفعيل تُرسل القائمة والمفضلات والتقييمات في Cronica إلى TMDB. وضع علامة مشاهدة يزيل العنوان من قائمة TMDB (لا توجد واجهة لتاريخ المشاهدة). معطّل افتراضيًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokud je zapnuto, seznam, oblíbené a hodnocení v Cronice se odesílají na TMDB. Označení jako zhlédnuté odstraní titul ze seznamu TMDB (žádné API historie). Ve výchozím stavu vypnuto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er slået til, sendes liste, favoritter og vurderinger i Cronica til TMDB. Markering som set fjerner titlen fra TMDB-listen (ingen sehistorik-API). Fra som standard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Merkliste, Favoriten und Bewertungen in Cronica an TMDB gesendet. Als gesehen markieren entfernt den Titel von der TMDB-Merkliste (TMDB hat keine Sehverlauf-API). Standardmäßig aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ενεργό, λίστα, αγαπημένα και βαθμολογίες στο Cronica αποστέλλονται στο TMDB. Η σήμανση ως προβληθέν αφαιρεί τον τίτλο από τη λίστα TMDB (χωρίς API ιστορικού). Απενεργοποιημένο από προεπιλογή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, watchlist, favorites, and ratings in Cronica are queued and sent to TMDB. Marking watched removes the title from your TMDB watchlist (TMDB has no watched-history API). Off by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la lista, favoritos y valoraciones de Cronica se envían a TMDB. Marcar como visto quita el título de la lista de TMDB (sin API de historial). Desactivado por defecto."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, la lista, favoritos y calificaciones de Cronica se envían a TMDB. Marcar como visto quita el título de la lista de TMDB (sin API de historial). Desactivado por defecto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun käytössä, Cronican watchlista, suosikit ja arviot lähetetään TMDB:hen. Katsotuksi merkitseminen poistaa nimen TMDB-listalta (ei katseluhistorian API:a). Oletuksena pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, la liste, les favoris et les notes de Cronica sont envoyés à TMDB. Marquer comme vu retire le titre de la liste TMDB (pas d’API d’historique). Désactivé par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשמופעל, רשימה, מועדפים ודירוגים ב‑Cronica נשלחים ל‑TMDB. סימון כנצפה מסיר את הכותר מרשימת TMDB (אין API להיסטוריה). כבוי כברירת מחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम होने पर Cronica में वॉचलिस्ट, पसंदीदा और रेटिंग TMDB को भेजी जाती हैं। वॉच्ड चिह्नित करने पर शीर्षक TMDB वॉचलिस्ट से हट जाता है (कोई वॉच्ड-इतिहास API नहीं)। डिफ़ॉल्ट रूप से बंद।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad je uključeno, popis, favoriti i ocjene u Cronica šalju se na TMDB. Označavanje kao gledano uklanja naslov s TMDB popisa (nema API-ja povijesti). Zadano isključeno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha be van kapcsolva, a Cronica lista, kedvencek és értékelések a TMDB-re kerülnek. A megnézettként jelölés eltávolítja a címet a TMDB-listáról (nincs előzmény-API). Alapból ki."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diaktifkan, daftar tonton, favorit, dan rating di Cronica dikirim ke TMDB. Menandai ditonton menghapus judul dari daftar TMDB (tidak ada API riwayat). Nonaktif secara default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, watchlist, preferiti e valutazioni di Cronica vengono inviati a TMDB. Segnare come visto rimuove il titolo dalla watchlist TMDB (nessuna API storica). Disattivato di default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、Cronicaのウォッチリスト、お気に入り、評価がTMDBに送信されます。視聴済みにするとTMDBのウォッチリストから削除されます（視聴履歴APIなし）。既定ではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하면 Cronica의 워치리스트, 즐겨찾기, 평점이 TMDB로 전송됩니다. 시청 완료로 표시하면 TMDB 워치리스트에서 제거됩니다(시청 기록 API 없음). 기본값은 꺼짐입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apabila didayakan, senarai tontonan, kegemaran dan rating dalam Cronica dihantar ke TMDB. Menanda ditonton mengalih keluar tajuk daripada senarai TMDB (tiada API sejarah). Dimatikan secara lalai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når aktivert sendes liste, favoritter og vurderinger i Cronica til TMDB. Merking som sett fjerner tittelen fra TMDB-listen (ingen historie-API). Av som standard."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld worden watchlist, favorieten en beoordelingen in Cronica naar TMDB gestuurd. Als bekeken markeren verwijdert de titel van je TMDB-watchlist (geen kijkgeschiedenis-API). Standaard uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu lista, ulubione i oceny w Cronica są wysyłane do TMDB. Oznaczenie jako obejrzane usuwa tytuł z listy TMDB (brak API historii). Domyślnie wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, lista, favoritos e avaliações do Cronica são enviados ao TMDB. Marcar como assistido remove o título da lista do TMDB (sem API de histórico). Desativado por padrão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când este activat, lista, favoritele și evaluările din Cronica sunt trimise la TMDB. Marcarea ca vizionat elimină titlul din lista TMDB (fără API de istoric). Dezactivat implicit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, список, избранное и оценки в Cronica отправляются в TMDB. Отметка «просмотрено» убирает название из списка TMDB (нет API истории). По умолчанию выкл."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak je zapnuté, zoznam, obľúbené a hodnotenia v Cronice sa odosielajú na TMDB. Označenie ako sledované odstráni titul zo zoznamu TMDB (TMDB nemá API histórie sledovania). Predvolene vypnuté."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det är aktiverat skickas lista, favoriter och betyg i Cronica till TMDB. Markera som sett tar bort titeln från TMDB-listan (inget historik-API). Av som standard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde Cronica’daki liste, favoriler ve puanlar TMDB’ye gönderilir. İzlendi olarak işaretlemek başlığı TMDB listesinden kaldırır (izleme geçmişi API’si yok). Varsayılan kapalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ввімкнено, список, вибране та оцінки в Cronica надсилаються до TMDB. Позначення «переглянуто» прибирає назву зі списку TMDB (немає API історії). Типово вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Cronica 中的待看列表、收藏和评分会排队发送到 TMDB。标记为已看会从 TMDB 待看列表中移除该标题（TMDB 无观看历史 API）。默认关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，Cronica 中的待看清單、收藏和評分會排程傳送到 TMDB。標記為已看會從 TMDB 待看清單中移除該標題（TMDB 無觀看歷史 API）。預設關閉。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Quan està activat, la Watchlist, els preferits i les puntuacions de Cronica s’envien a la cua cap a TMDB. Marcar com a vist elimina el títol de la Watchlist de TMDB (TMDB no té API d’historial de visionat). Desactivat per defecte."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે સક્ષમ હોય, ત્યારે Cronica માં જોવાની સૂચિ, મનપસંદ અને રેટિંગ્સ કતારમાં મૂકવામાં આવે છે અને TMDB પર મોકલવામાં આવે છે. જોયેલું ચિહ્નિત કરવાથી તમારી TMDB વૉચલિસ્ટમાંથી શીર્ષક દૂર થઈ જાય છે (TMDB પાસે કોઈ જોવાયેલ-ઇતિહાસ API નથી). મૂળભૂત રીતે બંધ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्षम केल्यावर, Cronica मधील वॉचलिस्ट, आवडी आणि रेटिंग रांगेत आहेत आणि TMDB वर पाठवले जातात. पाहिलेले चिन्हांकित केल्याने तुमच्या TMDB वॉचलिस्टमधून शीर्षक काढून टाकले जाते (TMDB चा पाहिला-इतिहास API नाही). डीफॉल्टनुसार बंद."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, lista, favoritos e avaliações do Cronica são enviados ao TMDB. Marcar como assistido remove o título da lista do TMDB (sem API de histórico). Desativado por padrão."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਚਾਲੂ ਹੋਵੇ, Cronica ਵਿੱਚ ਵਾਚਲਿਸਟ, ਮਨਪਸੰਦ ਅਤੇ ਰੇਟਿੰਗਾਂ TMDB ਨੂੰ ਭੇਜੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਵੇਖਿਆ ਚਿੰਨ੍ਹਿਤ ਕਰਨ ’ਤੇ ਸਿਰਲੇਖ TMDB ਵਾਚਲਿਸਟ ਤੋਂ ਹਟਦਾ ਹੈ (TMDB ਕੋਲ ਵੇਖੀ ਗਈ ਹਿਸਟਰੀ API ਨਹੀਂ)। ਡਿਫਾਲਟ ਤੌਰ ’ਤੇ ਬੰਦ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je omogočeno, se watchlist, priljubljeni in ocene v Cronica uvrstijo v vrsto in pošljejo na TMDB. Označitev kot ogledano odstrani naslov s TMDB watchlist (TMDB nima API-ja zgodovine ogledov). Privzeto izključeno."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดใช้งาน รายการเฝ้าดู รายการโปรด และการให้คะแนนใน Cronica จะถูกจัดคิวและส่งไปที่ TMDB การทำเครื่องหมายดูแล้วจะเป็นการลบชื่อเรื่องออกจากรายการเฝ้าดู TMDB ของคุณ (TMDB ไม่มี API ประวัติการดู) ปิดโดยค่าเริ่มต้น"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সক্রিয় করা হলে, Cronica-এর ওয়াচলিস্ট, ফেভারিট এবং রেটিংগুলো কিউতে যুক্ত হয়ে TMDB-এ পাঠানো হয়। 'ওয়াচড' হিসেবে চিহ্নিত করলে শিরোনামটি আপনার TMDB ওয়াচলিস্ট থেকে মুছে যায় (TMDB-এর কোনো ওয়াচড-হিস্ট্রি এপিআই নেই)। ডিফল্টরূপে এটি বন্ধ থাকে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಕ್ರಿಯಗೊಳಿಸಿದಾಗ, Cronica ನಲ್ಲಿ ವೀಕ್ಷಣೆಪಟ್ಟಿ, ಮೆಚ್ಚಿನವುಗಳು ಮತ್ತು ರೇಟಿಂಗ್‌ಗಳನ್ನು ಸರದಿಯಲ್ಲಿ ಇರಿಸಲಾಗುತ್ತದೆ ಮತ್ತು TMDB ಗೆ ಕಳುಹಿಸಲಾಗುತ್ತದೆ. ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸುವುದರಿಂದ ನಿಮ್ಮ TMDB ವೀಕ್ಷಣೆಪಟ್ಟಿಯಿಂದ ಶೀರ್ಷಿಕೆಯನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ (TMDB ವೀಕ್ಷಿಸಿದ-ಇತಿಹಾಸದ API ಅನ್ನು ಹೊಂದಿಲ್ಲ). ಪೂರ್ವನಿಯೋಜಿತವಾಗಿ ಆಫ್ ಆಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പ്രവർത്തനക്ഷമമാക്കുമ്പോൾ, Cronica-ലെ വാച്ച്‌ലിസ്റ്റ്, പ്രിയപ്പെട്ടവ, റേറ്റിംഗുകൾ എന്നിവ ക്യൂവിലാക്കി TMDB-ലേക്ക് അയയ്ക്കും. കണ്ടതായി അടയാളപ്പെടുത്തുന്നത് നിങ്ങളുടെ TMDB വാച്ച്‌ലിസ്റ്റിൽ നിന്ന് ശീർഷകം നീക്കം ചെയ്യും (TMDB-ന് കണ്ട-ചരിത്ര API ഇല്ല). സ്ഥിരസ്ഥിതിയായി ഓഫാണ്."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସକ୍ଷମ ହେଲେ, Cronica ରେ ଥିବା ୱାଚଲିଷ୍ଟ, ପସନ୍ଦିତା ଏବଂ ମୂଲ୍ୟାଙ୍କନଗୁଡ଼ିକୁ ଧାଡ଼ିରେ ରଖାଯାଇଛି ଏବଂ TMDB କୁ ପଠାଯାଇଛି। ୱାଚଡ୍ ଭାବରେ ଚିହ୍ନିତ କରିବା ଦ୍ୱାରା ଆପଣଙ୍କର TMDB ୱାଚଲିଷ୍ଟରୁ ଶୀର୍ଷକ ହଟିଯାଏ (TMDB ର କୌଣସି ୱାଚଡ୍-ଇତିହାସ API ନାହିଁ)। ଡିଫଲ୍ଟ ଭାବରେ ବନ୍ଦ ହୋଇଯାଏ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டிருக்கும்போது, Cronica-இல் உள்ள கண்காணிப்புப் பட்டியல், விருப்பமானவை மற்றும் மதிப்பீடுகள் வரிசைப்படுத்தப்பட்டு TMDB-க்கு அனுப்பப்படும். பார்த்ததாகக் குறிப்பது, உங்கள் TMDB கண்காணிப்புப் பட்டியலிலிருந்து அந்தத் தலைப்பை நீக்கிவிடும் (TMDB-இல் பார்த்த-வரலாறு API இல்லை). இயல்பாக முடக்கப்பட்டுள்ளது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎనేబుల్ చేసినప్పుడు, Cronicaలోని వాచ్‌లిస్ట్, ఫేవరెట్స్ మరియు రేటింగ్‌లు క్యూలో ఉంచబడి TMDBకి పంపబడతాయి. చూసినట్లుగా గుర్తించడం వలన ఆ టైటిల్ మీ TMDB వాచ్‌లిస్ట్ నుండి తీసివేయబడుతుంది (TMDBకి వాచ్డ్-హిస్టరీ API లేదు). డిఫాల్ట్‌గా ఆఫ్ చేయబడి ఉంటుంది."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi được bật, danh sách theo dõi, mục yêu thích và xếp hạng trong Cronica sẽ được xếp vào hàng đợi và gửi đến TMDB. Đánh dấu đã xem sẽ xóa tiêu đề khỏi danh sách theo dõi TMDB của bạn (TMDB không có API lịch sử đã xem). Mặc định là tắt."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال ہونے پر، Cronica میں واچ لسٹ، پسندیدہ اور ریٹنگز قطار میں لگ جاتی ہیں اور TMDB کو بھیجی جاتی ہیں۔ دیکھے ہوئے کو نشان زد کرنے سے آپ کی TMDB واچ لسٹ سے ٹائٹل ہٹ جاتا ہے (TMDB کی کوئی دیکھی ہوئی تاریخ API نہیں ہے)۔ بطور ڈیفالٹ آف۔"
          }
        }
      }
    },
