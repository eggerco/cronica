    "Downloads your TMDB watchlist, ratings, and favorites. Existing Cronica titles are updated; nothing is deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينزّل قائمة TMDB وتقييماتك ومفضلاتك. تُحدَّث عناوين Cronica الحالية؛ ولا يُحذف شيء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne tvůj seznam, hodnocení a oblíbené z TMDB. Existující tituly v Cronice se aktualizují; nic se nemaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter din TMDB-liste, vurderinger og favoritter. Eksisterende Cronica-titler opdateres; intet slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt deine TMDB-Merkliste, Bewertungen und Favoriten herunter. Vorhandene Cronica-Titel werden aktualisiert; nichts wird gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατεβάζει τη λίστα, βαθμολογίες και αγαπημένα TMDB. Οι υπάρχοντες τίτλοι Cronica ενημερώνονται· τίποτα δεν διαγράφεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads your TMDB watchlist, ratings, and favorites. Existing Cronica titles are updated; nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga tu lista, valoraciones y favoritos de TMDB. Los títulos de Cronica existentes se actualizan; no se elimina nada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga tu lista, calificaciones y favoritos de TMDB. Los títulos de Cronica existentes se actualizan; no se elimina nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa TMDB-watchlistan, arviot ja suosikit. Olemassa olevat Cronica-nimet päivitetään; mitään ei poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge votre liste TMDB, notes et favoris. Les titres Cronica existants sont mis à jour ; rien n’est supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוריד את רשימת TMDB, הדירוגים והמועדפים. כותרים קיימים ב‑Cronica מתעדכנים; דבר אינו נמחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके TMDB वॉच लिस्ट, रेटिंग और पसंदीदा कंटेंट को डाउनलोड करता है। मौजूदा Cronica टाइटल अपडेट हो जाते हैं; कुछ भी डिलीट नहीं होता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzima tvoj TMDB popis, ocjene i favorite. Postojeći Cronica naslovi se ažuriraju; ništa se ne briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letölti a TMDB-listát, értékeléseket és kedvenceket. A meglévő Cronica-címek frissülnek; semmi sem törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh daftar tonton, rating, dan favorit TMDB. Judul Cronica yang ada diperbarui; tidak ada yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica watchlist, valutazioni e preferiti TMDB. I titoli Cronica esistenti vengono aggiornati; non si elimina nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDBのウォッチリスト、評価、お気に入りをダウンロードします。既存のCronicaタイトルは更新され、削除はされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB 워치리스트, 평점, 즐겨찾기를 다운로드합니다. 기존 Cronica 작품은 업데이트되며 삭제되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat turun senarai tontonan, rating dan kegemaran TMDB. Tajuk Cronica sedia ada dikemas kini; tiada yang dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster ned TMDB-listen, vurderinger og favoritter. Eksisterende Cronica-titler oppdateres; ingenting slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt je TMDB-watchlist, beoordelingen en favorieten. Bestaande Cronica-titels worden bijgewerkt; er wordt niets verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera listę, oceny i ulubione z TMDB. Istniejące tytuły w Cronica są aktualizowane; nic nie jest usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa sua lista, avaliações e favoritos do TMDB. Títulos existentes no Cronica são atualizados; nada é excluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă lista, evaluările și favoritele TMDB. Titlurile Cronica existente sunt actualizate; nimic nu este șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивает список, оценки и избранное TMDB. Существующие названия в Cronica обновляются; ничего не удаляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahne tvoj zoznam, hodnotenia a obľúbené z TMDB. Existujúce tituly v Cronice sa aktualizujú; nič sa nemáže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar din TMDB-lista, betyg och favoriter. Befintliga Cronica-titlar uppdateras; inget raderas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB izleme listenizi, puanlarınızı ve favorilerinizi indirir. Mevcut Cronica başlıkları güncellenir; hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує список, оцінки та вибране TMDB. Існуючі назви в Cronica оновлюються; нічого не видаляється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载你的 TMDB 待看列表、评分和收藏。已有 Cronica 标题会更新；不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載你的 TMDB 待看清單、評分和收藏。既有 Cronica 標題會更新；不會刪除任何內容。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার TMDB ওয়াচ লিস্ট, রেটিং এবং ফেভারিট ডাউনলোড করে। বিদ্যমান Cronica টাইটেলগুলো আপডেট করা হয়; কিছুই মুছে ফেলা হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega la teva llista de seguiment, les classificacions i els preferits de TMDB. Els títols de Cronica existents s'actualitzen; no s'elimina res."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી TMDB વોચ લિસ્ટ, રેટિંગ અને મનપસંદ ડાઉનલોડ કરે છે. હાલના Cronica ટાઇટલ અપડેટ કરવામાં આવે છે; કંઈપણ ડિલીટ કરવામાં આવતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ TMDB ವೀಕ್ಷಣಾ ಪಟ್ಟಿ, ರೇಟಿಂಗ್‌ಗಳು ಮತ್ತು ಮೆಚ್ಚಿನವುಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡುತ್ತದೆ. ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಕ್ರೋನಿಕಾ ಶೀರ್ಷಿಕೆಗಳನ್ನು ನವೀಕರಿಸಲಾಗುತ್ತದೆ; ಯಾವುದನ್ನೂ ಅಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ TMDB വാച്ച് ലിസ്റ്റ്, റേറ്റിംഗുകൾ, പ്രിയപ്പെട്ടവ എന്നിവ ഡൗൺലോഡ് ചെയ്യുന്നു. നിലവിലുള്ള ക്രോണിക്ക ശീർഷകങ്ങൾ അപ്‌ഡേറ്റ് ചെയ്യുന്നു; ഒന്നും ഇല്ലാതാക്കില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची TMDB वॉच लिस्ट, रेटिंग्ज आणि फेव्हरिट्स डाउनलोड होतात. आधीपासून अस्तित्वात असलेले क्रोनिका टायटल्स अपडेट केले जातात; काहीही डिलीट केले जात नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର TMDB ୱାଚ୍ ଲିଷ୍ଟ, ରେଟିଂ ଏବଂ ପସନ୍ଦିତଗୁଡ଼ିକୁ ଡାଉନଲୋଡ୍ କରେ। ବିଦ୍ୟମାନ କ୍ରୋନିକା ଟାଇଟଲ୍ ଅପଡେଟ୍ କରାଯାଇଛି; କିଛି ବି ଡିଲିଟ୍ କରାଯାଇ ନାହିଁ।"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz o download da sua lista de filmes e séries assistidos, avaliações e favoritos do TMDB. Os títulos já cadastrados no Cronica são atualizados; nada é excluído."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ TMDB ਵਾਚ ਲਿਸਟ, ਰੇਟਿੰਗਾਂ, ਅਤੇ ਮਨਪਸੰਦ ਡਾਊਨਲੋਡ ਕਰਦਾ ਹੈ। ਮੌਜੂਦਾ ਕਰੋਨਿਕਾ ਸਿਰਲੇਖ ਅੱਪਡੇਟ ਕੀਤੇ ਜਾਂਦੇ ਹਨ; ਕੁਝ ਵੀ ਨਹੀਂ ਮਿਟਾਇਆ ਜਾਂਦਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenese vaš seznam za spremljanje, ocene in priljubljene v TMDB. Obstoječi naslovi Cronica se posodobijo; nič se ne izbriše."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் TMDB பார்க்க வேண்டிய படங்களின் பட்டியல், மதிப்பீடுகள் மற்றும் விருப்பமானவற்றைப் பதிவிறக்குகிறது. ஏற்கனவே உள்ள குரோனிகா தலைப்புகள் புதுப்பிக்கப்படுகின்றன; எதுவும் நீக்கப்படுவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ TMDB వాచ్ లిస్ట్, రేటింగ్‌లు మరియు ఫేవరెట్‌లను డౌన్‌లోడ్ చేస్తుంది. ఇప్పటికే ఉన్న Cronica టైటిల్స్ అప్‌డేట్ చేయబడతాయి; ఏదీ తొలగించబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดาวน์โหลดรายการเฝ้าดู การให้คะแนน และรายการโปรดของคุณจาก TMDB รายการที่มีอยู่ของ Cronica จะได้รับการอัปเดต ไม่มีการลบข้อมูลใดๆ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی TMDB واچ لسٹ، ریٹنگز اور پسندیدہ ڈاؤن لوڈ کرتا ہے۔ موجودہ Cronica کے عنوانات کو اپ ڈیٹ کر دیا گیا ہے۔ کچھ بھی حذف نہیں ہے."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải xuống danh sách phim bạn đã xem trên TMDB, xếp hạng và phim yêu thích. Các phim hiện có trên Cronica được cập nhật; không có phim nào bị xóa."
          }
        }
      }
    },
    "Drag to reorder. Turn off a section to hide it from Home. Catalog lists load from TMDB.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لإعادة الترتيب. أوقف قسماً لإخفائه من الرئيسية. قوائم الكatalog تُحمَّل من TMDB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhni pro změnu pořadí. Vypni sekci, abys ji skryl z Domů. Katalogové seznamy se načítají z TMDB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at omarrangere. Slå en sektion fra for at skjule den fra startsiden. Kataloglister indlæses fra TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Sortieren. Schalte einen Bereich aus, um ihn auf Home auszublenden. Kataloglisten werden von TMDB geladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για αναδιάταξη. Απενεργοποιήστε μια ενότητα για να την κρύψετε από την αρχική. Οι κατάλογοι φορτώνονται από TMDB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Turn off a section to hide it from Home. Catalog lists load from TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva una sección para ocultarla de Inicio. Las listas del catálogo se cargan desde TMDB."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva una sección para ocultarla de Inicio. Las listas del catálogo se cargan desde TMDB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä vetämällä. Piilota osio etusivulta poistamalla se käytöstä. Luettelolistat ladataan TMDB:stä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser. Désactive une section pour la masquer de l’accueil. Les listes du catalogue proviennent de TMDB."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור לסידור מחדש. כבה מקטע כדי להסתיר אותו מהבית. רשימות קטalog נטענות מ-TMDB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए खींचें। होम से छिपाने के लिए सेक्शन बंद करें। कैटलॉग सूचियाँ TMDB से लोड होती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za promjenu redoslijeda. Isključi odjeljak da ga sakriješ s Početne. Kataloški popisi učitavaju se iz TMDB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza az átrendezéshez. Kapcsoljon ki egy szekciót, hogy elrejtse a kezdőlapról. A katalóguslisták a TMDB-ből töltődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengurutkan ulang. Matikan bagian untuk menyembunyikannya dari Beranda. Daftar katalog dimuat dari TMDB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Disattiva una sezione per nasconderla da Home. Le liste del catalogo provengono da TMDB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。セクションをオフにするとホームから非表示になります。カタログリストはTMDBから読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경하세요. 섹션을 끄면 홈에서 숨겨집니다. 카탈로그 목록은 TMDB에서 불러옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula. Matikan bahagian untuk sembunyikannya dari Laman Utama. Senarai katalog dimuatkan dari TMDB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å endre rekkefølge. Slå av en seksjon for å skjule den fra hjem. Kataloglister lastes fra TMDB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herschikken. Schakel een sectie uit om deze te verbergen op Start. Cataloguslijsten worden geladen van TMDB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Wyłącz sekcję, aby ukryć ją na ekranie głównym. Listy katalogowe ładują się z TMDB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Desative uma seção para ocultá-la do Início. As listas do catálogo vêm do TMDB."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pentru a reordona. Dezactivează o secțiune ca s-o ascunzi de pe Acasă. Listele din catalog se încarcă din TMDB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи для изменения порядка. Отключи раздел, чтобы скрыть его с главной. Каталоги загружаются из TMDB."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahni pre zmenenie poradia. Vypni sekciu, ak ju chceš skryť z Domova. Katalógové zoznamy sa načítavajú z TMDB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ordna om. Stäng av en sektion för att dölja den från hem. Kataloglistor laddas från TMDB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden sıralamak için sürükle. Ana sayfadan gizlemek için bir bölümü kapat. Katalog listeleri TMDB'den yüklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни, щоб змінити порядок. Вимкни розділ, щоб приховати його з головної. Каталожні списки завантажуються з TMDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。关闭某个分区即可在首页隐藏。目录列表从 TMDB 加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳以重新排序。關閉某個區塊即可在首頁隱藏。目錄列表從 TMDB 載入。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরায় সাজাতে টেনে আনুন। হোম থেকে লুকানোর জন্য একটি বিভাগ বন্ধ করুন। ক্যাটালগ তালিকা TMDB থেকে লোড হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrossega per reordenar. Desactiva una secció per amagar-la de l’inici. Les llistes del catàleg es carreguen des de TMDB."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફરીથી ગોઠવવા માટે ખેંચો. સેક્શનને હોમથી છુપાવવા માટે તેને બંધ કરો. સૂચિ સૂચિઓ TMDB થી લોડ થાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮರುಕ್ರಮಗೊಳಿಸಲು ಎಳೆಯಿರಿ. ಮುಖಪುಟದಿಂದ ಮರೆಮಾಡಲು ವಿಭಾಗವನ್ನು ಆಫ್ ಮಾಡಿ. ಕ್ಯಾಟಲಾಗ್ ಪಟ್ಟಿಗಳು TMDB ನಿಂದ ಲೋಡ್ ಆಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുനഃക്രമീകരിക്കാൻ വലിച്ചിടുക. ഹോമിൽ നിന്ന് മറയ്ക്കാൻ ഒരു വിഭാഗം ഓഫാക്കുക. TMDB-ൽ നിന്നുള്ള കാറ്റലോഗ് ലിസ്റ്റ് ലോഡ്."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्क्रमित करण्यासाठी ड्रॅग करा. घरापासून लपवण्यासाठी विभाग बंद करा. कॅटलॉग सूची TMDB वरून लोड होते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ରେକର୍ଡ କରିବାକୁ ଡ୍ରାଗ୍ କରନ୍ତୁ | ଏହାକୁ ଘରୁ ଲୁଚାଇବା ପାଇଁ ଏକ ବିଭାଗ ବନ୍ଦ କରନ୍ତୁ | TMDB ରୁ କାଟାଲଗ୍ ତାଲିକା ଲୋଡ୍ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Desative uma seção para ocultá-la do Início. As listas do catálogo vêm do TMDB."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮੁੜ ਕ੍ਰਮਬੱਧ ਕਰਨ ਲਈ ਘਸੀਟੋ। ਕਿਸੇ ਸੈਕਸ਼ਨ ਨੂੰ ਘਰ ਤੋਂ ਲੁਕਾਉਣ ਲਈ ਇਸਨੂੰ ਬੰਦ ਕਰੋ। ਕੈਟਾਲਾਗ ਸੂਚੀਆਂ TMDB ਤੋਂ ਲੋਡ ਹੁੰਦੀਆਂ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci za prerazporeditev. Izklopi razdelek, da ga skriješ z Domova. Seznami kataloga se naložijo s TMDB."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறுவரிசைப்படுத்த இழுக்கவும். முகப்பில் இருந்து மறைக்க ஒரு பகுதியை அணைக்கவும். TMDB இலிருந்து பட்டியல் பட்டியல்கள் ஏற்றப்படுகின்றன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "క్రమాన్ని మార్చడానికి లాగండి. ఇంటి నుండి దాచడానికి విభాగాన్ని ఆఫ్ చేయండి. TMDB నుండి కేటలాగ్ జాబితాలు లోడ్ అవుతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเพื่อเรียงลำดับใหม่ ปิดส่วนเพื่อซ่อนจากหน้าแรก รายการแคตตาล็อกโหลดจาก TMDB"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوبارہ آرڈر کرنے کے لیے گھسیٹیں ۔ اسے گھر سے چھپانے کے لیے ایک سیکشن بند کر دیں ۔ کیٹلاگ میں TMDB سے لوڈ کی فہرست ہے ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo để sắp xếp lại. Tắt một phần để ẩn nó khỏi Trang chủ. Tải danh sách danh mục từ TMDB."
          }
        }
      }
    },
