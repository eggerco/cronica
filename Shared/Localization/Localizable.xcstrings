    "Add a movie or TV show to your Cronica watchlist.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف فيلمًا أو مسلسلًا إلى قائمة المشاهدة في Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte film nebo seriál do seznamu Cronica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en film eller serie til din Cronica-watchlist."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Film oder eine Serie zu deiner Cronica-Watchlist hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρόσθεσε μια ταινία ή σειρά στη λίστα του Cronica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a movie or TV show to your Cronica watchlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una película o serie a tu lista de Cronica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega una película o serie a tu lista de Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää elokuva tai sarja Cronican katselulistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un film ou une série à votre liste Cronica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף סרט או סדרה לרשימת הצפייה של Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica वॉचलिस्ट में कोई फ़िल्म या शो जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj film ili seriju na Cronica listu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj filmet vagy sorozatot a Cronica listádhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan film atau acara ke watchlist Cronica Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un film o una serie alla watchlist di Cronica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画やドラマをCronicaのウォッチリストに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화나 TV 프로그램을 Cronica 관심 목록에 추가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah filem atau rancangan ke senarai tontonan Cronica anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til en film eller serie i Cronica-ønskelisten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een film of serie toe aan je Cronica-watchlist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj film lub serial do listy Cronica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um filme ou série à sua lista do Cronica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă un film sau un serial pe lista Cronica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте фильм или сериал в список Cronica."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte film alebo seriál do zoznamu Cronica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en film eller serie i din Cronica-watchlist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica izleme listenize bir film veya dizi ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте фільм або серіал до списку Cronica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将电影或剧集添加到 Cronica 片单。"
          }
        },
