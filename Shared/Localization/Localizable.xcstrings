            "value": "మీ డేటా"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của bạn"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا"
          }
        }
      }
    },
    "Your data has been deleted from this device. Welcome will appear again the next time you open Cronica.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف بياناتك من هذا الجهاز. ستظهر شاشة الترحيب عند فتح Cronica مجدداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvá data byla z tohoto zařízení smazána. Při příštím otevření Cronica se znovu zobrazí uvítání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data er slettet fra denne enhed. Velkomst vises igen, næste gang du åbner Cronica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten wurden von diesem Gerät gelöscht. Willkommen erscheint beim nächsten Öffnen von Cronica wieder."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα δεδομένα σας διαγράφηκαν από αυτή τη συσκευή. Η οθόνη καλωσορίσματος θα εμφανιστεί ξανά την επόμενη φορά που ανοίξετε το Cronica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data has been deleted from this device. Welcome will appear again the next time you open Cronica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se han eliminado de este dispositivo. La pantalla de bienvenida aparecerá de nuevo la próxima vez que abras Cronica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se eliminaron de este dispositivo. Bienvenida aparecerá la próxima vez que abras Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietosi on poistettu tältä laitteelta. Tervetuloa-näkymä tulee uudelleen, kun avaat Cronica-sovelluksen seuraavan kerran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données ont été supprimées de cet appareil. L’accueil réapparaîtra la prochaine fois que tu ouvriras Cronica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים שלך נמחקו מהמכשיר. מסך ברוכים הבאים יופיע בפתיחה הבאה של Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा इस डिवाइस से हटा दिया गया। अगली बार Cronica खोलने पर स्वागत दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podaci su izbrisani s ovog uređaja. Pri sljedećem otvaranju Cronica ponovno će se prikazati dobrodošlica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adatai törölve lettek erről az eszközről. A következő Cronica-indításkor újra megjelenik az üdvözlő képernyő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data kamu dihapus dari perangkat ini. Selamat datang akan muncul saat kamu buka Cronica lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono stati eliminati da questo dispositivo. Benvenuto riapparirà la prossima volta che apri Cronica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからデータが削除されました。次回Cronicaを開くと、ようこそ画面が再表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 데이터가 삭제되었습니다. 다음에 Cronica를 열면 환영 화면이 다시 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data anda dipadamkan daripada peranti ini. Selamat datang akan muncul apabila anda buka Cronica lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene dine er slettet fra denne enheten. Velkommen vises igjen neste gang du åpner Cronica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens zijn verwijderd van dit apparaat. Welkom verschijnt opnieuw wanneer je Cronica opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane zostały usunięte z tego urządzenia. Przy następnym uruchomieniu Cronica pojawi się ekran powitalny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados foram excluídos deste dispositivo. Boas-vindas aparecerá novamente na próxima vez que você abrir Cronica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele tale au fost șterse de pe acest dispozitiv. La următoarea deschidere a Cronica va apărea din nou ecranul de bun venit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твои данные удалены с этого устройства. При следующем запуске Cronica снова появится приветствие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje údaje boli z tohto zariadenia odstránené. Vitaj sa zobrazí pri ďalšom otvorení Cronica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina data har raderats från den här enheten. Välkommen visas igen nästa gång du öppnar Cronica."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin bu cihazdan silindi. Cronica'yı bir sonraki açışında hoş geldin ekranı görünecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої дані видалено з цього пристрою. При наступному відкритті Cronica знову з’явиться вітання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据已从此设备删除。下次打开 Cronica 时将再次显示欢迎界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料已從此裝置刪除。下次開啟 Cronica 時將再次顯示歡迎畫面。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les teves dades s’han eliminat d’aquest dispositiu. La benvinguda tornarà a aparèixer la propera vegada que obris Cronica."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારો ડેટા આ ઉપકરણમાંથી કાઢી નાખવામાં આવ્યો છે. આગલી વખતે તમે Cronica ખોલશો ત્યારે સ્વાગત ફરીથી દેખાશે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा डेटा या डिव्हाइसवरून हटवला गेला आहे. पुढच्या वेळी तुम्ही Cronica उघडाल तेव्हा स्वागत पुन्हा दिसेल."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados foram excluídos deste dispositivo. Boas-vindas aparecerá novamente na próxima vez que tu abrir Cronica."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਡਿਵਾਈਸ ਤੋਂ ਤੁਹਾਡਾ ਡਾਟਾ ਮਿਟਾ ਦਿੱਤਾ ਗਿਆ ਹੈ। ਅਗਲੀ ਵਾਰ Cronica ਖੋਲ੍ਹਣ ’ਤੇ ਸਵਾਗਤ ਫਿਰ ਦਿਖੇਗਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podatki so bili izbrisani s te naprave. Pozdravni zaslon se bo znova prikazal, ko naslednjič odpreš Cronica."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลของคุณถูกลบออกจากอุปกรณ์นี้แล้ว ยินดีต้อนรับจะปรากฏขึ้นอีกครั้งในครั้งถัดไปที่คุณเปิด Cronica"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইস থেকে আপনার ডেটা মুছে ফেলা হয়েছে। পরের বার Cronica খুললে আবার স্বাগতম বার্তাটি দেখা যাবে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಈ ಸಾಧನದಿಂದ ಅಳಿಸಲಾಗಿದೆ. ನೀವು ಮುಂದಿನ ಬಾರಿ Cronica ತೆರೆದಾಗ ಸ್ವಾಗತ ಮತ್ತೆ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഉപകരണത്തിൽ നിന്ന് നിങ്ങളുടെ ഡാറ്റ ഇല്ലാതാക്കി. അടുത്ത തവണ നിങ്ങൾ Cronica തുറക്കുമ്പോൾ സ്വാഗതം വീണ്ടും ദൃശ്യമാകും."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଡିଭାଇସ୍‌ରୁ ଆପଣଙ୍କର ଡାଟା ଡିଲିଟ୍ କରିଦିଆଯାଇଛି। ପରବର୍ତ୍ତୀ ସମୟରେ ଯେତେବେଳେ ଆପଣ Cronica ଖୋଲିବେ ସେତେବେଳେ ସ୍ୱାଗତ ପୁଣି ଦେଖାଯିବ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் சாதனத்திலிருந்து உங்கள் தரவுகள் நீக்கப்பட்டுவிட்டன. அடுத்த முறை நீங்கள் Cronica-ஐத் திறக்கும்போது, 'வரவேற்பு' மீண்டும் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరం నుండి మీ డేటా తొలగించబడింది. మీరు తదుపరిసారి Cronicaను తెరిచినప్పుడు స్వాగతం మళ్ళీ కనిపిస్తుంది."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu của bạn đã bị xóa khỏi thiết bị này. Lời chào mừng sẽ xuất hiện lại vào lần tiếp theo bạn mở Cronica."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا اس ڈیوائس سے حذف کر دیا گیا ہے۔ اگلی بار جب آپ Cronica کھولیں گے تو خوش آمدید دوبارہ ظاہر ہوگا۔"
          }
        }
      }
    },
