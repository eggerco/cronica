    "Cronica added a reminder for the next release or episode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضاف Cronica تذكيرًا بالإصدار أو الحلقة التالية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica přidala připomínku dalšího vydání nebo epizody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica har tilføjet en påmindelse om næste udgivelse eller episode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica hat eine Erinnerung für die nächste Veröffentlichung oder Episode hinzugefügt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Cronica πρόσθεσε υπενθύμιση για την επόμενη κυκλοφορία ή επεισόδιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica added a reminder for the next release or episode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ha añadido un recordatorio para el próximo estreno o episodio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica agregó un recordatorio para el próximo estreno o episodio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica lisäsi muistutuksen seuraavasta julkaisusta tai jaksosta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica a ajouté un rappel pour la prochaine sortie ou le prochain épisode."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica הוסיף תזכורת להפצה או לפרק הבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ने अगली रिलीज़ या एपिसोड के लिए रिमाइंडर जोड़ा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica je dodala podsjetnik za sljedeće izdanje ili epizodu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica emlékeztetőt adott a következő megjelenéshez vagy epizódhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica menambahkan pengingat untuk rilis atau episode berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ha aggiunto un promemoria per la prossima uscita o episodio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronicaが次の公開またはエピソードのリマインダーを追加しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica가 다음 출시 또는 에피소드에 대한 미리 알림을 추가했습니다."
          }
        },
        "ms": {
          "stringUnit": {
