          "stringUnit": {
            "state": "translated",
            "value": "Estimeret seertid for titler markeret som set hver uge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzte Sehdauer für Titel, die jede Woche als gesehen markiert werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εκτιμώμενος χρόνος παρακολούθησης για τίτλους που σημειώνονται ως παρακολουθημένοι κάθε εβδομάδα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated viewing time for titles marked watched each week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de visionado estimado para los títulos marcados como vistos cada semana."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo de visionado estimado para títulos marcados como vistos cada semana."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvioitu katseluaika viikossa katsotuiksi merkityille nimikkeille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps de visionnage estimé pour les titres marqués comme vus chaque semaine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זמן צפייה משוער לכותרות שסומנו כנצפו בכל שבוע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सप्ताह देखा चिह्नित शीर्षकों के लिए अनुमानित देखने का समय।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Procijenjeno vrijeme gledanja naslova označenih kao pogledani svaki tjedan."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Becsült megtekintési idő a hetente megtekintettként jelölt címekhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan waktu menonton untuk judul ditandai ditonton setiap minggu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo di visione stimato per i titoli segnati come visti ogni settimana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎週視聴済みにした作品の推定視聴時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매주 시청함으로 표시한 작품의 예상 시청 시간."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggaran masa menonton untuk tajuk ditandakan ditonton setiap minggu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimert seertid for titler markert som sett hver uke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschatte kijktijd voor titels die wekelijks als bekeken zijn gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacowany czas oglądania tytułów oznaczonych jako obejrzane w każdym tygodniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo de exibição estimado para títulos marcados como assistidos a cada semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timp estimat de vizionare pentru titlurile marcate ca vizionate în fiecare săptămână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка времени просмотра названий, отмеченных просмотренными каждую неделю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadovaný čas sledovania titulov označených ako pozreté každý týždeň."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattad visningstid för titlar markerade som sedda varje vecka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hafta izlendi işaretlenen başlıklar için tahmini izleme süresi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка часу перегляду назв, позначених переглянутими щотижня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周标记为已观看的标题的估算观看时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每週標記為已觀看的標題的估算觀看時長。"
          }
        }
      }
    },
