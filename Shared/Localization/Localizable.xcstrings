        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ειδοποίηση όταν κυκλοφορεί ταινία από τη λίστα παρακολούθησής σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso cuando se estrene una película de tu lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun katselulistasi elokuva julkaistaan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודע כשסרט ברשימת הצפייה משוחרר."
