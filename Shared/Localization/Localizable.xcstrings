    "Watched titles grouped by type, with estimated viewing time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watched titles grouped by type, with estimated viewing time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesehene Titel nach Typ gruppiert, mit geschätzter Sehdauer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres vus regroupés par type, avec temps de visionnage estimé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli visti raggruppati per tipo, con tempo di visione stimato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos assistidos agrupados por tipo, com tempo de exibição estimado."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozreté tituly zoskupené podľa typu s odhadovaným časom sledovania."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos vistos agrupados por tipo, con tiempo de visionado estimado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عناوين مشاهدة مجمّعة حسب النوع، مع وقت مشاهدة مقدّر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zhlédnuté tituly seskupené podle typu s odhadovaným časem sledování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sete titler grupperet efter type med estimeret seertid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθημένοι τίτλοι ομαδοποιημένοι ανά τύπο, με εκτιμώμενο χρόνο παρακολούθησης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos vistos agrupados por tipo, con tiempo de visionado estimado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsotut nimikkeet tyypeittäin, arvioidulla katseluajalla."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרות שנצפו מקובצות לפי סוג, עם זמן צפייה משוער."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकार के अनुसार समूहीकृत देखे गए शीर्षक, अनुमानित देखने के समय के साथ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledani naslovi grupirani po vrsti s procijenjenim vremenom gledanja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megtekintett címek típus szerint csoportosítva, becsült megtekintési idővel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul ditonton dikelompokkan menurut jenis, dengan perkiraan waktu menonton."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイプ別にグループ化された視聴済み作品と推定視聴時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유형별로 그룹화된 시청한 작품과 예상 시청 시간."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk ditonton dikumpulkan mengikut jenis, dengan anggaran masa menonton."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sette titler gruppert etter type, med estimert seertid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekeken titels gegroepeerd op type, met geschatte kijktijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejrzane tytuły pogrupowane według typu ze szacowanym czasem oglądania."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titluri vizionate grupate pe tip, cu timp estimat de vizionare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотренные названия по типу с оценкой времени просмотра."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedda titlar grupperade efter typ med uppskattad visningstid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türe göre gruplanmış izlenen başlıklar, tahmini izleme süresiyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянуті назви згруповані за типом з оцінкою часу перегляду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按类型分组的已观看标题及估算观看时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依類型分組的已觀看標題及估算觀看時長。"
          }
        }
      }
    },
