    "%@, tap to open list options.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، اضغط لفتح خيارات القائمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, klepnutím otevřeš možnosti seznamu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tryk for at åbne listeindstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tippe, um die Listenoptionen zu öffnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, πατήστε για να ανοίξετε τις επιλογές λίστας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tap to open list options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, toca para abrir las opciones de la lista."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, toque para abrir las opciones de la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, napauta avataksesi listan asetukset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, appuyer pour ouvrir les options de la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, הקש לפתיחת אפשרויות הרשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, सूची विकल्प खोलने के लिए टैप करें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dodirni za opcije popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, koppintson a lista beállításainak megnyitásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ketuk untuk membuka opsi daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tocca per aprire la lista delle opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、タップしてリストのオプションを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, 탭하여 목록 옵션을 엽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ketik untuk buka pilihan senarai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, trykk for å åpne listealternativer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tik om lijstopties te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, dotknij, aby otworzyć opcje listy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, toque para abrir as opções da lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, atinge pentru opțiunile listei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, нажми, чтобы открыть параметры списка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ťuknutím otvoríš možnosti zoznamu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, tryck för att öppna listalternativ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, liste seçeneklerini açmak için dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, торкнись, щоб відкрити параметри списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，点按以打开列表选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，點按以開啟列表選項。"
          }
        }
      }
    },
