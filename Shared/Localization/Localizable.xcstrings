        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଯେତେବେଳେ ତୁମର ୱାଚଲିଷ୍ଟରେ ଏକ ଟିଭି ଶୋ’ରୁ ଏକ ନୂଆ ଏପିସୋଡ୍ ରିଲିଜ୍ ହେବ ତାହା ସୂଚିତ କର |"
