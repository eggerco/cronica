            "state": "translated",
            "value": "Guarda películas y series; Cronica las organiza por ti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna elokuvat ja sarjat — Cronica pitää ne järjestyksessä puolestasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez films et séries — Cronica les organise pour vous."
          }
