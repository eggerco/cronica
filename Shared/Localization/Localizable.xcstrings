            "value": "Toca per marcar l’episodi com a vist"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "એપિસોડને જોયો તરીકે ચિહ્નિત કરવા માટે ટૅપ કરો"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "भाग पाहिला म्हणून चिन्हांकित करण्यासाठी टॅप करा"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para marcar o episódio como assistido"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਐਪੀਸੋਡ ਨੂੰ ਦੇਖਿਆ ਗਿਆ ਵਜੋਂ ਚਿੰਨ੍ਹਿਤ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni, da označiš epizodo kot ogledano"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "എപ്പിസോഡ് കണ്ടതായി അടയാളപ്പെടുത്താൻ ടാപ്പ് ചെയ്യുക"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพื่อทำเครื่องหมายตอนว่าดูแล้ว"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn để đánh dấu tập là đã xem"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্বটি দেখা হয়েছে হিসেবে চিহ্নিত করতে ট্যাপ করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಚಿಕೆಯನ್ನು ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏପିସୋଡ୍ ଦେଖାଯାଇଛି ଭାବରେ ଚିହ୍ନଟ କରିବାକୁ ଟାପ୍ କରନ୍ତୁ"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அத்தியாயத்தைப் பார்த்ததாகக் குறிக்க தட்டவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఎపిసోడ్‌ను చూసినట్లుగా గుర్తించడానికి నొక్కండి"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپی سوڈ کو دیکھا گیا کے بطور نشان زد کرنے کے لیے تھپتھپائیں۔"
          }
        }
      }
