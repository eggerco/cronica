    "Pinned and in-progress titles from your watchlist.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين المثبتة وقيد المشاهدة من قائمة المشاهدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připnuté a rozdělané tituly z watchlistu."
          }
        },
        "da": {
