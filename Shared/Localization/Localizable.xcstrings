    "Downloads your TMDB watchlist, ratings, and favorites. Existing Cronica titles are updated; nothing is deleted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينزّل قائمة TMDB وتقييماتك ومفضلاتك. تُحدَّث عناوين Cronica الحالية؛ ولا يُحذف شيء."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne tvůj seznam, hodnocení a oblíbené z TMDB. Existující tituly v Cronice se aktualizují; nic se nemaže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Henter din TMDB-liste, vurderinger og favoritter. Eksisterende Cronica-titler opdateres; intet slettes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt deine TMDB-Merkliste, Bewertungen und Favoriten herunter. Vorhandene Cronica-Titel werden aktualisiert; nichts wird gelöscht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κατεβάζει τη λίστα, βαθμολογίες και αγαπημένα TMDB. Οι υπάρχοντες τίτλοι Cronica ενημερώνονται· τίποτα δεν διαγράφεται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads your TMDB watchlist, ratings, and favorites. Existing Cronica titles are updated; nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga tu lista, valoraciones y favoritos de TMDB. Los títulos de Cronica existentes se actualizan; no se elimina nada."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga tu lista, calificaciones y favoritos de TMDB. Los títulos de Cronica existentes se actualizan; no se elimina nada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lataa TMDB-watchlistan, arviot ja suosikit. Olemassa olevat Cronica-nimet päivitetään; mitään ei poisteta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge votre liste TMDB, notes et favoris. Les titres Cronica existants sont mis à jour ; rien n’est supprimé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוריד את רשימת TMDB, הדירוגים והמועדפים. כותרים קיימים ב‑Cronica מתעדכנים; דבר אינו נמחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी TMDB वॉचलिस्ट, रेटिंग और पसंदीदा डाउनलोड करता है। मौजूदा Cronica शीर्षक अपडेट होते हैं; कुछ भी हटाया नहीं जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzima tvoj TMDB popis, ocjene i favorite. Postojeći Cronica naslovi se ažuriraju; ništa se ne briše."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Letölti a TMDB-listát, értékeléseket és kedvenceket. A meglévő Cronica-címek frissülnek; semmi sem törlődik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh daftar tonton, rating, dan favorit TMDB. Judul Cronica yang ada diperbarui; tidak ada yang dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica watchlist, valutazioni e preferiti TMDB. I titoli Cronica esistenti vengono aggiornati; non si elimina nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDBのウォッチリスト、評価、お気に入りをダウンロードします。既存のCronicaタイトルは更新され、削除はされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB 워치리스트, 평점, 즐겨찾기를 다운로드합니다. 기존 Cronica 작품은 업데이트되며 삭제되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat turun senarai tontonan, rating dan kegemaran TMDB. Tajuk Cronica sedia ada dikemas kini; tiada yang dipadam."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laster ned TMDB-listen, vurderinger og favoritter. Eksisterende Cronica-titler oppdateres; ingenting slettes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt je TMDB-watchlist, beoordelingen en favorieten. Bestaande Cronica-titels worden bijgewerkt; er wordt niets verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera listę, oceny i ulubione z TMDB. Istniejące tytuły w Cronica są aktualizowane; nic nie jest usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa sua lista, avaliações e favoritos do TMDB. Títulos existentes no Cronica são atualizados; nada é excluído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarcă lista, evaluările și favoritele TMDB. Titlurile Cronica existente sunt actualizate; nimic nu este șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачивает список, оценки и избранное TMDB. Существующие названия в Cronica обновляются; ничего не удаляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiahne tvoj zoznam, hodnotenia a obľúbené z TMDB. Existujúce tituly v Cronice sa aktualizujú; nič sa nemáže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämtar din TMDB-lista, betyg och favoriter. Befintliga Cronica-titlar uppdateras; inget raderas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB izleme listenizi, puanlarınızı ve favorilerinizi indirir. Mevcut Cronica başlıkları güncellenir; hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує список, оцінки та вибране TMDB. Існуючі назви в Cronica оновлюються; нічого не видаляється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载你的 TMDB 待看列表、评分和收藏。已有 Cronica 标题会更新；不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載你的 TMDB 待看清單、評分和收藏。既有 Cronica 標題會更新；不會刪除任何內容。"
          }
        }
      }
    },
    "Drag to reorder. Turn off a section to hide it from Home. Catalog lists load from TMDB.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لإعادة الترتيب. أوقف قسماً لإخفائه من الرئيسية. قوائم الكatalog تُحمَّل من TMDB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přetáhni pro změnu pořadí. Vypni sekci, abys ji skryl z Domů. Katalogové seznamy se načítají z TMDB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at omarrangere. Slå en sektion fra for at skjule den fra startsiden. Kataloglister indlæses fra TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen zum Sortieren. Schalte einen Bereich aus, um ihn auf Home auszublenden. Kataloglisten werden von TMDB geladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύρετε για αναδιάταξη. Απενεργοποιήστε μια ενότητα για να την κρύψετε από την αρχική. Οι κατάλογοι φορτώνονται από TMDB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Turn off a section to hide it from Home. Catalog lists load from TMDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva una sección para ocultarla de Inicio. Las listas del catálogo se cargan desde TMDB."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desactiva una sección para ocultarla de Inicio. Las listas del catálogo se cargan desde TMDB."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Järjestä vetämällä. Piilota osio etusivulta poistamalla se käytöstä. Luettelolistat ladataan TMDB:stä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser. Désactive une section pour la masquer de l’accueil. Les listes du catalogue proviennent de TMDB."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור לסידור מחדש. כבה מקטע כדי להסתיר אותו מהבית. רשימות קטalog נטענות מ-TMDB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए खींचें। होम से छिपाने के लिए सेक्शन बंद करें। कैटलॉग सूचियाँ TMDB से लोड होती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za promjenu redoslijeda. Isključi odjeljak da ga sakriješ s Početne. Kataloški popisi učitavaju se iz TMDB."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza az átrendezéshez. Kapcsoljon ki egy szekciót, hogy elrejtse a kezdőlapról. A katalóguslisták a TMDB-ből töltődnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk mengurutkan ulang. Matikan bagian untuk menyembunyikannya dari Beranda. Daftar katalog dimuat dari TMDB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Disattiva una sezione per nasconderla da Home. Le liste del catalogo provengono da TMDB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。セクションをオフにするとホームから非表示になります。カタログリストはTMDBから読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하여 순서를 변경하세요. 섹션을 끄면 홈에서 숨겨집니다. 카탈로그 목록은 TMDB에서 불러옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret untuk susun semula. Matikan bahagian untuk sembunyikannya dari Laman Utama. Senarai katalog dimuatkan dari TMDB."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å endre rekkefølge. Slå av en seksjon for å skjule den fra hjem. Kataloglister lastes fra TMDB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herschikken. Schakel een sectie uit om deze te verbergen op Start. Cataloguslijsten worden geladen van TMDB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Wyłącz sekcję, aby ukryć ją na ekranie głównym. Listy katalogowe ładują się z TMDB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. Desative uma seção para ocultá-la do Início. As listas do catálogo vêm do TMDB."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pentru a reordona. Dezactivează o secțiune ca s-o ascunzi de pe Acasă. Listele din catalog se încarcă din TMDB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащи для изменения порядка. Отключи раздел, чтобы скрыть его с главной. Каталоги загружаются из TMDB."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahni pre zmenenie poradia. Vypni sekciu, ak ju chceš skryť z Domova. Katalógové zoznamy sa načítavajú z TMDB."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att ordna om. Stäng av en sektion för att dölja den från hem. Kataloglistor laddas från TMDB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden sıralamak için sürükle. Ana sayfadan gizlemek için bir bölümü kapat. Katalog listeleri TMDB'den yüklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягни, щоб змінити порядок. Вимкни розділ, щоб приховати його з головної. Каталожні списки завантажуються з TMDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序。关闭某个分区即可在首页隐藏。目录列表从 TMDB 加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳以重新排序。關閉某個區塊即可在首頁隱藏。目錄列表從 TMDB 載入。"
          }
        }
      }
    },
