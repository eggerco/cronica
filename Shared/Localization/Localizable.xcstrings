          "stringUnit": {
            "state": "translated",
            "value": "Upozorniť na vydanie filmu zo zoznamu sledovaných."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبلغني عند إصدار فيلم في قائمة المشاهدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornit, když film z watchlistu vyjde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når en film på din watchlist udkommer."
