    "Add upcoming movie releases from your watchlist to the Cronica calendar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف إصدارات الأفلام القادمة من قائمة المشاهدة إلى تقويم Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej nadcházející filmy z watchlistu do kalendáře Cronica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj kommende filmudgivelser fra din watchlist til Cronica-kalenderen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge kommende Filmstarts aus deiner Watchlist zum Cronica-Kalender hinzu."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε επερχόμενες κινηματογραφικές κυκλοφορίες από τη λίστα παρακολούθησης στο ημερολόγιο Cronica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add upcoming movie releases from your watchlist to the Cronica calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los estrenos de películas de tu lista al calendario de Cronica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega los próximos estrenos de películas de tu lista al calendario Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tulevat elokuvajulkaisut katselulistaltasi Cronica-kalenteriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les sorties de films à venir de ta liste au calendrier Cronica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף שחרורי סרטים קרובים מרשימת הצפייה ללוח השנה של Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी वॉचलिस्ट से आगामी फ़िल्म रिलीज़ Cronica कैलेंडर में जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nadolazeće filmove s popisa u Cronica kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá a figyelőlistáján szereplő közelgő filmmegjelenéseket a Cronica naptárhoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan rilis film mendatang dari watchlist ke kalender Cronica."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi le uscite cinematografiche in arrivo dalla tua lista al calendario Cronica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチリストの公開予定映画をCronicaカレンダーに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치리스트의 공개 예정 영화를 Cronica 캘린더에 추가합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah keluaran filem akan datang dari watchlist ke kalendar Cronica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til kommende filmutgivelser fra watchlisten din i Cronica-kalenderen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg aankomende filmreleases van je watchlist toe aan de Cronica-kalender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj nadchodzące premiery filmów z listy do kalendarza Cronica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione lançamentos de filmes futuros da sua lista ao calendário Cronica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă lansările viitoare de filme din watchlist în calendarul Cronica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь предстоящие фильмы из списка в календарь Cronica."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridaj nadchádzajúce filmové premiéry zo sledovaného do kalendára Cronica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till kommande filmreleaser från din watchlist i Cronica-kalendern."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme listendeki yaklaşan film yayınlarını Cronica takvimine ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай майбутні фільми зі списку до календаря Cronica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将观看清单中即将上映的电影添加到 Cronica 日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將觀看清單中即將上映的電影加入 Cronica 日曆。"
          }
        }
      }
    },
