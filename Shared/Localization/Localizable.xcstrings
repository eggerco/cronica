    "Open Search, find a movie or show, then tap Add to start tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح البحث، ابحث عن فيلم أو مسلسل، ثم اضغط إضافة لبدء التتبع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři Vyhledávání, najdi film nebo seriál a klepni na Přidat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Søgning, find en film eller serie, og tryk derefter på Tilføj for at begynde at spore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Suche, finde einen Film oder eine Serie und tippe auf Hinzufügen, um zu tracken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την Αναζήτηση, βρείτε ταινία ή σειρά και πατήστε Προσθήκη για να ξεκινήσετε την παρακολούθηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Search, find a movie or show, then tap Add to start tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Buscar, encuentra una película o serie y pulsa Añadir para empezar a seguirla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Buscar, encuentra una película o serie y toca Agregar para empezar a seguirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Haku, etsi elokuva tai sarja ja napauta sitten Lisää aloittaaksesi seurannan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Recherche, trouve un film ou une série, puis appuie sur Ajouter pour commencer le suivi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח חיפוש, מצא סרט או סדרה, ואז הקש הוסף כדי להתחיל לעקוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज खोलें, फ़िल्म या शो खोजें, फिर ट्रैकिंग शुरू करने के लिए जोड़ें टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Pretragu, pronađi film ili seriju i dodirni Dodaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a Keresést, találjon filmet vagy műsort, majd koppintson a Hozzáadás gombra a követés indításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pencarian, temukan film atau acara, lalu ketuk Tambah untuk mulai melacak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Cerca, trova un film o una serie, poi tocca Aggiungi per iniziare a tracciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を開き、映画や番組を見つけて、追加をタップしてトラッキングを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색을 열고 영화나 프로그램을 찾은 후 추가를 탭하여 추적을 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Carian, cari filem atau rancangan, kemudian ketik Tambah untuk mula menjejak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Søk, finn en film eller serie, og trykk deretter Legg til for å begynne å spore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Zoeken, zoek een film of serie en tik vervolgens op Toevoegen om te beginnen met volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Wyszukiwanie, znajdź film lub serial i dotknij Dodaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a Busca, encontre um filme ou série e toque em Adicionar para começar a acompanhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Căutare, găsește un film sau serial și atinge Adaugă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Поиск, найди фильм или сериал и нажми Добавить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvor Vyhľadávanie, nájdi film alebo seriál a klepni na Pridať, aby si začal sledovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Sök, hitta en film eller serie och tryck sedan på Lägg till för att börja spåra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama'yı aç, film veya dizi bul, sonra takip etmek için Ekle'ye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий Пошук, знайди фільм або серіал і натисни Додати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开搜索，找到电影或节目，然后点按“添加”开始跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟搜尋，找到電影或節目，然後點按「加入」開始追蹤。"
          }
        }
      }
    },
