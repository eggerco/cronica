          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati Cronica na X (Twitter) za novosti o novim značajkama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesse a Cronicát az X (Twitter) oldalon az új funkciókról szóló frissítésekért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikuti Cronica di X (Twitter) untuk update fitur baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segui Cronica su X (Twitter) per rimanere aggiornato sulle nuove funzionalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "X（Twitter）でCronicaをフォローして、新機能の情報を受け取りましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
