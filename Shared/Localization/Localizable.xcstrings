    "Open Search, find a movie or show, then tap Add to start tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح البحث، ابحث عن فيلم أو مسلسل، ثم اضغط إضافة لبدء التتبع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři Vyhledávání, najdi film nebo seriál a klepni na Přidat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Søgning, find en film eller serie, og tryk derefter på Tilføj for at begynde at spore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Suche, finde einen Film oder eine Serie und tippe auf Hinzufügen, um zu tracken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την Αναζήτηση, βρείτε ταινία ή σειρά και πατήστε Προσθήκη για να ξεκινήσετε την παρακολούθηση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Search, find a movie or show, then tap Add to start tracking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Buscar, encuentra una película o serie y pulsa Añadir para empezar a seguirla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Buscar, encuentra una película o serie y toca Agregar para empezar a seguirla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Haku, etsi elokuva tai sarja ja napauta sitten Lisää aloittaaksesi seurannan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Recherche, trouve un film ou une série, puis appuie sur Ajouter pour commencer le suivi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח חיפוש, מצא סרט או סדרה, ואז הקש הוסף כדי להתחיל לעקוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज खोलें, फ़िल्म या शो खोजें, फिर ट्रैकिंग शुरू करने के लिए जोड़ें टैप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori Pretragu, pronađi film ili seriju i dodirni Dodaj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a Keresést, találjon filmet vagy műsort, majd koppintson a Hozzáadás gombra a követés indításához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pencarian, temukan film atau acara, lalu ketuk Tambah untuk mulai melacak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Cerca, trova un film o una serie, poi tocca Aggiungi per iniziare a tracciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索を開き、映画や番組を見つけて、追加をタップしてトラッキングを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색을 열고 영화나 프로그램을 찾은 후 추가를 탭하여 추적을 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Carian, cari filem atau rancangan, kemudian ketik Tambah untuk mula menjejak."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Søk, finn en film eller serie, og trykk deretter Legg til for å begynne å spore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Zoeken, zoek een film of serie en tik vervolgens op Toevoegen om te beginnen met volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Wyszukiwanie, znajdź film lub serial i dotknij Dodaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a Busca, encontre um filme ou série e toque em Adicionar para começar a acompanhar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Căutare, găsește un film sau serial și atinge Adaugă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой Поиск, найди фильм или сериал и нажми Добавить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvor Vyhľadávanie, nájdi film alebo seriál a klepni na Pridať, aby si začal sledovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Sök, hitta en film eller serie och tryck sedan på Lägg till för att börja spåra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama'yı aç, film veya dizi bul, sonra takip etmek için Ekle'ye dokun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий Пошук, знайди фільм або серіал і натисни Додати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开搜索，找到电影或节目，然后点按“添加”开始跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟搜尋，找到電影或節目，然後點按「加入」開始追蹤。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুসন্ধান খুলুন, একটি চলচ্চিত্র বা শো খুঁজুন, তারপর ট্র্যাকিং শুরু করতে যোগ করুন আলতো চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre Cerca, troba una pel·lícula o sèrie i toca Afegeix per començar el seguiment."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શોધ ખોલો, મૂવી અથવા શો શોધો, પછી ટ્રેકિંગ શરૂ કરવા માટે ઉમેરો પર ટૅપ કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शोध उघडा, चित्रपट किंवा शो शोधा, त्यानंतर ट्रॅकिंग सुरू करण्यासाठी जोडा वर टॅप करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସନ୍ଧାନ ଖୋଲ, ଏକ ଚଳଚ୍ଚିତ୍ର କିମ୍ବା ଶୋ ଖୋଜ, ତାପରେ ଟ୍ରାକିଂ ଆରମ୍ଭ କରିବାକୁ ଆଡ୍ ଟ୍ୟାପ୍ କର |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a Busca, encontre um filme ou série e toque em Adicionar para começar a acompanhar."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਖੋਜ ਖੋਲ੍ਹੋ, ਕੋਈ ਫ਼ਿਲਮ ਜਾਂ ਸ਼ੋਅ ਲੱਭੋ, ਫਿਰ ਟਰੈਕਿੰਗ ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਸ਼ਾਮਲ ਕਰੋ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpri Iskanje, najdi film ali serijo, nato tapni Dodaj za sledenje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "തിരയൽ തുറക്കുക, ഒരു സിനിമ അല്ലെങ്കിൽ ഷോ കണ്ടെത്തുക, തുടർന്ന് ട്രാക്കിംഗ് ആരംഭിക്കാൻ ചേർക്കുക ടാപ്പ് ചെയ്യുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการค้นหา ค้นหาภาพยนตร์หรือรายการ จากนั้นแตะเพิ่มเพื่อเริ่มการติดตาม"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Tìm kiếm, tìm phim hoặc chương trình, sau đó nhấn Thêm để bắt đầu theo dõi."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹುಡುಕಾಟವನ್ನು ತೆರೆಯಿರಿ, ಚಲನಚಿತ್ರ ಅಥವಾ ಕಾರ್ಯಕ್ರಮವನ್ನು ಹುಡುಕಿ, ನಂತರ ಟ್ರ್ಯಾಕಿಂಗ್ ಪ್ರಾರಂಭಿಸಲು ಸೇರಿಸು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடலைத் திறந்து, ஒரு திரைப்படம் அல்லது நிகழ்ச்சியைக் கண்டுபிடித்து, பின்னர் கண்காணிக்கத் தொடங்க 'சேர்' என்பதைத் தட்டவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సెర్చ్ ఓపెన్ చేసి, ఒక సినిమా లేదా షోను కనుగొని, ఆపై ట్రాకింగ్ ప్రారంభించడానికి యాడ్ నొక్కండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تلاش کھولیں، فلم یا شو تلاش کریں، پھر ٹریکنگ شروع کرنے کے لیے شامل کریں پر ٹیپ کریں۔"
          }
        }
      }
    },
