        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉचलिस्ट की फ़िल्म रिलीज़ होने पर सूचित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
