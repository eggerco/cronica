          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvo dodaj ovaj naslov na popis, pa pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először adja hozzá ezt a címet a figyelőlistához, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
