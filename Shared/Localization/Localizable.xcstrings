    "Mark Episode %lld from season %lld of %@ as Watched?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد الحلقة %lld من الموسم %lld من %@ كمشاهدة؟"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označit epizodu %lld ze sezóny %lld pořadu %@ jako zhlédnutou?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér afsnit %lld fra sæson %lld af %@ som set?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Episode %1$lld aus Staffel %2$lld von %3$@ als gesehen markieren?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σήμανση επεισοδίου %lld της σεζόν %lld του %@ ως παρακολουθημένο;"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark Episode %lld from season %lld of %@ as Watched?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Marcar el episodio %lld de la temporada %lld de %@ como visto?"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Marcar el episodio %1$lld de la temporada %2$lld de %3$@ como Visto?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitäänkö jakso %lld kauden %lld sarjasta %@ katsotuksi?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer l'épisode %lld de la saison %lld de %@ comme regardé ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לסמן פרק %lld מעונה %lld של %@ כנצפה?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के सीज़न %lld के एपिसोड %lld को देखा हुआ चिह्नित करें?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označiti epizodu %lld iz sezone %lld serije %@ kao pogledanu?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld. évad %lld. epizód megtekintettként jelölése?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai Episode %lld dari musim %lld %@ sebagai Ditonton?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna Episodio %1$lld della Stagione %2$lld di %3$@ come visto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のシーズン%lldのエピソード%lldを視聴済みにしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시즌 %lld의 에피소드 %lld을(를) 시청함으로 표시할까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan Episod %lld daripada musim %lld %@ sebagai Ditonton?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Markere episode %lld fra sesong %lld av %@ som sett?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aflevering %lld uit seizoen %lld van %@ als bekeken markeren?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczyć odcinek %lld z sezonu %lld serialu %@ jako obejrzany?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar o episódio %1$lld da temporada %2$lld de %3$@ como Assistido?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchezi episodul %lld din sezonul %lld al serialului %@ ca vizionat?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметить эпизод %lld из сезона %lld сериала %@ как просмотренный?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označiť epizódu %1$lld od série %2$lld z %3$@ ako pozretú?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera avsnitt %lld från säsong %lld av %@ som sedd?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dizisinin %lld. sezonunun %lld. bölümü izlendi olarak işaretlensin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначити епізод %lld з сезону %lld серіалу %@ як переглянутий?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 第 %lld 季第 %lld 集标记为已观看？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 %@ 第 %lld 季第 %lld 集標記為已觀看？"
          }
        }
      }
    },
