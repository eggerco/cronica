        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica’da sonraki bölümünüzü izlendi olarak işaretleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте наступний епізод як переглянутий у Cronica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cronica 中将下一集标记为已看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Cronica 中將下一集標記為已看。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরবর্তী পর্বটি Cronica এ দেখা হিসাবে চিহ্নিত করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el teu proper episodi com a vist a Cronica."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા આગામી એપિસોડને Cronica માં જોયેલા તરીકે ચિહ્નિત કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा पुढील भाग Cronica मध्ये पाहिला म्हणून चिन्हांकित करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ରେ ଦେଖାଯାଇଥିବା ପରି ତୁମର ପରବର୍ତ୍ତୀ ଏପିସୋଡ୍ ଚିହ୍ନିତ କର |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque seu próximo episódio como assistido no Cronica."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਅਗਲੇ ਐਪੀਸੋਡ ਨੂੰ Cronica ਵਿੱਚ ਦੇਖੇ ਗਏ ਵਜੋਂ ਚਿੰਨ੍ਹਿਤ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite svojo naslednjo epizodo kot gledano v Cronica."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ അടുത്ത എപ്പിസോഡ് Cronica-ൽ കണ്ടതായി അടയാളപ്പെടുത്തുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายตอนต่อไปของคุณว่ารับชมใน Cronica"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica میں دیکھے گئے اپنے اگلے ایپی سوڈ کو نشان زد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu tập tiếp theo của bạn là đã xem trong Cronica."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಮುಂದಿನ ಸಂಚಿಕೆಯನ್ನು Cronica ನಲ್ಲಿ ವೀಕ್ಷಿಸಿದಂತೆ ಗುರುತಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் அடுத்த அத்தியாயத்தை Cronica-இல் பார்த்ததாகக் குறித்துக்கொள்ளுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ తదుపరి ఎపిసోడ్‌ను Cronicaలో చూసినట్లుగా గుర్తించండి."
          }
        }
      }
    },
