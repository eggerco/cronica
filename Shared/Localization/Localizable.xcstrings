    "You can mark this as watched after it has been released.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can mark this as watched after it has been released."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dies als gesehen markieren, sobald es veröffentlicht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pourras le marquer comme vu une fois qu’il sera sorti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi segnarlo come visto dopo che sarà uscito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode marcá-lo como assistido depois que for lançado."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžeš to označiť ako pozreté po uvedení."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes marcarlo como visto después de que se estrene."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تحديده كمشاهد بعد إصداره."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po vydání to můžeš označit jako zhlédnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere dette som set, efter det er udgivet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να το σημειώσετε ως παρακολουθημένο αφού κυκλοφορήσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes marcarlo como visto después de su estreno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit merkitä tämän katsotuksi sen julkaisun jälkeen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לסמן כנצפה אחרי ששוחרר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ होने के बाद इसे देखा चिह्नित कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakon izlaska možeš označiti kao pogledano."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenés után megtekintettként jelölheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu bisa tandai ditonton setelah dirilis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開後に視聴済みにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 후 시청함으로 표시할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh tandakan ditonton selepas dikeluarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere dette som sett etter at det er utgitt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit als bekeken markeren nadat het is uitgebracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po premierze możesz oznaczyć to jako obejrzane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Po lansare poți marca ca vizionat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После выхода можно отметить как просмотренное."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markera detta som sedd efter att det har släppts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlandıktan sonra izlendi olarak işaretleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після виходу можна позначити як переглянуте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上映后你可以将其标记为已观看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上映後你可以將其標記為已觀看。"
          }
        }
      }
    },
    "You can mark this episode as watched after it has aired.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can mark this episode as watched after it has aired."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
