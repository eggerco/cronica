    "SIMKL and TMDB are trademarks of their respective owners. Cronica uses these services only when you choose to connect or import.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL وTMDB علامتان تجاريتان لمالكيهما. يستخدم Cronica هذه الخدمات فقط عندما تختار الاتصال أو الاستيراد."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL a TMDB jsou ochranné známky jejich vlastníků. Cronica je používá jen tehdy, když se rozhodneš připojit nebo importovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL og TMDB er varemærker tilhørende deres respektive ejere. Cronica bruger kun disse tjenester, når du vælger at forbinde eller importere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL und TMDB sind Marken ihrer jeweiligen Inhaber. Cronica nutzt diese Dienste nur, wenn du dich verbindest oder importierst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα SIMKL και TMDB είναι εμπορικά σήματα των αντίστοιχων ιδιοκτητών τους. Το Cronica χρησιμοποιεί αυτές τις υπηρεσίες μόνο όταν επιλέγετε σύνδεση ή εισαγωγή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL and TMDB are trademarks of their respective owners. Cronica uses these services only when you choose to connect or import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL y TMDB son marcas de sus respectivos propietarios. Cronica usa estos servicios solo cuando eliges conectar o importar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL y TMDB son marcas de sus respectivos propietarios. Cronica usa estos servicios solo cuando eliges conectar o importar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ja TMDB ovat omistajiensa tavaramerkkejä. Cronica käyttää näitä palveluita vain, kun valitset yhdistämisen tai tuonnin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL et TMDB sont des marques de leurs propriétaires respectifs. Cronica n’utilise ces services que lorsque vous choisissez de vous connecter ou d’importer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ו‑TMDB הם סימנים מסחריים של בעליהם. Cronica משתמש בשירותים אלה רק כשאתה בוחר להתחבר או לייבא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL और TMDB अपने संबंधित स्वामियों के ट्रेडमार्क हैं। Cronica इन सेवाओं का उपयोग केवल तब करता है जब आप कनेक्ट या आयात करना चुनते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL i TMDB su žigovi svojih vlasnika. Cronica koristi te usluge samo kada odabereš povezivanje ili uvoz."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SIMKL és a TMDB a megfelelő tulajdonosok védjegyei. A Cronica csak akkor használja ezeket a szolgáltatásokat, ha te döntesz a csatlakozás vagy az import mellett."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL dan TMDB adalah merek dagang pemiliknya masing-masing. Cronica menggunakan layanan ini hanya saat Anda memilih untuk menghubungkan atau mengimpor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL e TMDB sono marchi dei rispettivi proprietari. Cronica usa questi servizi solo quando scegli di collegarti o importare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKLおよびTMDBは各所有者の商標です。Cronicaは、接続またはインポートを選んだ場合にのみこれらのサービスを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL과 TMDB는 각 소유자의 상표입니다. Cronica는 연결 또는 가져오기를 선택할 때만 이러한 서비스를 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL dan TMDB ialah tanda dagangan pemilik masing-masing. Cronica menggunakan perkhidmatan ini hanya apabila anda memilih untuk menyambung atau mengimport."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL og TMDB er varemerker tilhørende sine respektive eiere. Cronica bruker disse tjenestene bare når du velger å koble til eller importere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL en TMDB zijn handelsmerken van hun respectieve eigenaren. Cronica gebruikt deze diensten alleen wanneer je kiest om te verbinden of te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL i TMDB są znakami towarowymi ich właścicieli. Cronica korzysta z tych usług tylko, gdy zdecydujesz się połączyć lub zaimportować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL e TMDB são marcas de seus respectivos proprietários. O Cronica usa esses serviços apenas quando você escolhe conectar ou importar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL și TMDB sunt mărci ale proprietarilor lor. Cronica folosește aceste servicii doar când alegi să te conectezi sau să imporți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL и TMDB — товарные знаки своих владельцев. Cronica использует эти сервисы только когда вы подключаетесь или импортируете."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL a TMDB sú ochranné známky ich vlastníkov. Cronica ich používa len vtedy, keď sa rozhodneš pripojiť alebo importovať."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL och TMDB är varumärken som tillhör respektive ägare. Cronica använder dessa tjänster bara när du väljer att ansluta eller importera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ve TMDB ilgili sahiplerinin ticari markalarıdır. Cronica bu hizmetleri yalnızca bağlanmayı veya içe aktarmayı seçtiğinizde kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL і TMDB — торговельні марки своїх власників. Cronica використовує ці сервіси лише коли ви підключаєтеся або імпортуєте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL 和 TMDB 是其各自所有者的商标。仅在你选择连接或导入时，Cronica 才会使用这些服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL 和 TMDB 是其各自擁有者的商標。僅在你選擇連接或匯入時，Cronica 才會使用這些服務。"
          }
        }
      }
    },
    "SIMKL and TMDB can sync when connected. SIMKL supports incremental activity checks; TMDB re-downloads your account lists on Sync Now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ SIMKL وTMDB المزامنة عند الاتصال. يدعم SIMKL فحوصات النشاط التدريجية؛ ويعيد TMDB تنزيل قوائم حسابك عند «مزامنة الآن»."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL a TMDB se po připojení mohou synchronizovat. SIMKL podporuje přírůstkové kontroly aktivit; TMDB při Synchronizovat znovu stáhne seznamy účtu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL og TMDB kan synkronisere, når de er forbundet. SIMKL understøtter trinvis aktivitetstjek; TMDB henter dine kontolister igen ved Synkroniser nu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL und TMDB können bei Verbindung synchronisieren. SIMKL prüft Änderungen schrittweise; TMDB lädt deine Kontolisten bei „Jetzt synchronisieren“ erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα SIMKL και TMDB μπορούν να συγχρονίζονται όταν είναι συνδεδεμένα. Το SIMKL υποστηρίζει σταδιακούς ελέγχους δραστηριότητας· το TMDB ξανακατεβάζει τις λίστες λογαριασμού στο Συγχρονισμός τώρα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL and TMDB can sync when connected. SIMKL supports incremental activity checks; TMDB re-downloads your account lists on Sync Now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL y TMDB pueden sincronizarse al conectar. SIMKL comprueba la actividad de forma incremental; TMDB vuelve a descargar tus listas al sincronizar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL y TMDB pueden sincronizarse al conectar. SIMKL comprueba la actividad de forma incremental; TMDB vuelve a descargar tus listas al sincronizar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ja TMDB voivat synkronoida yhdistettyinä. SIMKL tukee asteittaisia aktiviteettitarkistuksia; TMDB lataa tililistasi uudelleen Synkronoi nyt -kohdassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL et TMDB peuvent se synchroniser une fois connectés. SIMKL vérifie l’activité de façon incrémentielle ; TMDB retélécharge vos listes au Sync Now."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ו‑TMDB יכולים לסנכרן כשמחוברים. SIMKL תומך בבדיקות פעילות מצטברות; TMDB מוריד מחדש את רשימות החשבון ב«סנכרן עכשיו»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्ट होने पर SIMKL और TMDB सिंक कर सकते हैं। SIMKL क्रमिक गतिविधि जाँच का समर्थन करता है; TMDB «अभी सिंक करें» पर आपकी खाता सूचियाँ फिर से डाउनलोड करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL i TMDB mogu se sinkronizirati kada su povezani. SIMKL podržava inkrementalne provjere aktivnosti; TMDB ponovno preuzima popise računa pri Sinkroniziraj sada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SIMKL és a TMDB csatlakoztatva szinkronizálhat. A SIMKL fokozatos aktivitásellenőrzést támogat; a TMDB a Szinkronizálás most gombbal újra letölti a fióklistákat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL dan TMDB dapat menyinkronkan saat terhubung. SIMKL mendukung pemeriksaan aktivitas bertahap; TMDB mengunduh ulang daftar akun Anda saat Sinkronkan sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL e TMDB possono sincronizzarsi quando collegati. SIMKL controlla l’attività in modo incrementale; TMDB riscarica gli elenchi account con Sincronizza ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続するとSIMKLとTMDBを同期できます。SIMKLは差分のアクティビティ確認に対応し、TMDBは「今すぐ同期」でアカウントのリストを再ダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결되면 SIMKL과 TMDB를 동기화할 수 있습니다. SIMKL은 증분 활동 확인을 지원하고, TMDB는 지금 동기화 시 계정 목록을 다시 다운로드합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL dan TMDB boleh disegerakkan apabila disambungkan. SIMKL menyokong semakan aktiviti berperingkat; TMDB memuat turun semula senarai akaun anda pada Segerakkan sekarang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL og TMDB kan synkronisere når de er tilkoblet. SIMKL støtter inkrementelle aktivitetssjekker; TMDB laster ned kontolistene på nytt ved Synkroniser nå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL en TMDB kunnen synchroniseren wanneer verbonden. SIMKL controleert activiteit incrementeel; TMDB downloadt je accountlijsten opnieuw bij Nu synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL i TMDB mogą synchronizować się po połączeniu. SIMKL sprawdza aktywność przyrostowo; TMDB ponownie pobiera listy konta przy Synchronizuj teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL e TMDB podem sincronizar quando conectados. O SIMKL verifica a atividade de forma incremental; o TMDB baixa novamente suas listas em Sincronizar agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL și TMDB se pot sincroniza când sunt conectate. SIMKL verifică activitatea incremental; TMDB redescarcă listele contului la Sincronizează acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL и TMDB могут синхронизироваться после подключения. SIMKL проверяет активность по частям; TMDB при «Синхронизировать» заново скачивает списки аккаунта."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL a TMDB sa môžu synchronizovať po pripojení. SIMKL podporuje priebežné kontroly aktivít; TMDB pri „Synchronizovať“ znova stiahne zoznamy účtu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL och TMDB kan synkas när de är anslutna. SIMKL stödjer inkrementella aktivitetskontroller; TMDB hämtar om dina kontolistor vid Synkronisera nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ve TMDB bağlandığında senkronize olabilir. SIMKL artımlı etkinlik kontrollerini destekler; TMDB, Şimdi senkronize et ile hesap listelerini yeniden indirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL і TMDB можуть синхронізуватися після підключення. SIMKL перевіряє активність поступово; TMDB під час «Синхронізувати» знову завантажує списки облікового запису."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接后，SIMKL 和 TMDB 可以同步。SIMKL 支持增量活动检查；TMDB 在「立即同步」时重新下载你的账户列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接後，SIMKL 和 TMDB 可以同步。SIMKL 支援增量活動檢查；TMDB 在「立即同步」時重新下載你的帳號列表。"
          }
        }
      }
    },
