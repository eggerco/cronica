          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg titels toe aan %1$@ via Zoeken of het detail scherm van een titel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
