    "Cached images and network responses will be removed. This cannot be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال الصور المخزنة مؤقتاً واستجابات الشبكة. لا يمكن التراجع عن ذلك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložené obrázky a síťové odpovědi budou odstraněny. Tuto akci nelze vrátit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachelagrede billeder og netværkssvar fjernes. Dette kan ikke fortrydes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeicherte Bilder und Netzwerkantworten werden entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι προσωρινά αποθηκευμένες εικόνες και οι απαντήσεις δικτύου θα αφαιρεθούν. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cached images and network responses will be removed. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán las imágenes en caché y las respuestas de red. Esto no se puede deshacer."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán las imágenes en caché y las respuestas de red. Esto no se puede deshacer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välimuistissa olevat kuvat ja verkkovastaukset poistetaan. Tätä ei voi perua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images en cache et les réponses réseau seront supprimées. Cette action est irréversible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות במטמון ותגובות רשת יוסרו. לא ניתן לבטל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैश की गई छवियाँ और नेटवर्क प्रतिक्रियाएँ हटा दी जाएँगी। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Predmemorirane slike i mrežni odgovori bit će uklonjeni. Ovo se ne može poništiti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A gyorsítótárazott képek és hálózati válaszok törlésre kerülnek. Ez nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar cache dan respons jaringan akan dihapus. Ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini in cache e le risposte di rete verranno rimosse. Non puoi annullare questa azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされた画像とネットワーク応答が削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 이미지와 네트워크 응답이 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imej cache dan respons rangkaian akan dibuang. Ini tidak boleh dibatalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bufrede bilder og nettverkssvar fjernes. Dette kan ikke angres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecachte afbeeldingen en netwerkreacties worden verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Buforowane obrazy i odpowiedzi sieciowe zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens em cache e respostas de rede serão removidas. Isso não pode ser desfeito."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginile și răspunsurile din cache vor fi eliminate. Acțiunea nu poate fi anulată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кэшированные изображения и сетевые ответы будут удалены. Это нельзя отменить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstránia sa uložené obrázky a sieťové odpovede. Toto nie je možné vrátiť späť."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachade bilder och nätverkssvar tas bort. Detta kan inte ångras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbelleğe alınmış görseller ve ağ yanıtları kaldırılacak. Bu geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кешовані зображення та мережеві відповіді будуть видалені. Це не можна скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓存的图片和网络响应将被移除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快取的圖片和網路回應將被移除。此操作無法復原。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যাশ করা ছবি এবং নেটওয়ার্ক প্রতিক্রিয়া মুছে ফেলা হবে। এটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’eliminaran les imatges i les respostes de xarxa en memòria cau. Aquesta acció no es pot desfer."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેશ્ડ છબીઓ અને નેટવર્ક પ્રતિસાદો દૂર કરવામાં આવશે. આ પૂર્વવત્ કરી શકાતું નથી."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಂಗ್ರಹಿಸಿದ ಚಿತ್ರಗಳು ಮತ್ತು ನೆಟ್‌ವರ್ಕ್ ಪ್ರತಿಕ್ರಿಯೆಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ. ಇದನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കാഷെ ചെയ്‌ത ചിത്രങ്ങളും നെറ്റ്‌വർക്ക് പ്രതികരണങ്ങളും നീക്കം ചെയ്യപ്പെടും. ഇത് പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅशे केलेल्या प्रतिमा आणि नेटवर्क प्रतिसाद काढले जातील. हे पूर्ववत केले जाऊ शकत नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "କ୍ୟାଚ୍ ହୋଇଥିବା ପ୍ରତିଛବି ଏବଂ ନେଟୱର୍କ ପ୍ରତିକ୍ରିୟାଗୁଡ଼ିକୁ ଅପସାରଣ କରାଯିବ | ଏହାକୁ ପୂର୍ବବତ୍ କରାଯାଇପାରିବ ନାହିଁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens em cache e respostas de rede serão removidas. Isso não pode ser desfeito."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੈਸ਼ ਕੀਤੀਆਂ ਤਸਵੀਰਾਂ ਅਤੇ ਨੈੱਟਵਰਕ ਜਵਾਬਾਂ ਨੂੰ ਹਟਾ ਦਿੱਤਾ ਜਾਵੇਗਾ। ਇਸਨੂੰ ਅਣਕੀਤਾ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predpomnjene slike in omrežni odgovori bodo odstranjeni. Dejanja ni mogoče razveljaviti."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்காலிகமாக சேமிக்கப்பட்ட படங்கள் மற்றும் நெட்வொர்க் பதில்கள் அகற்றப்படும். இதை செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కాష్ చేసిన చిత్రాలు మరియు నెట్‌వర్క్ ప్రతిస్పందనలు తీసివేయబడతాయి. ఇది రద్దు చేయబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพที่แคชไว้และการตอบกลับของเครือข่ายจะถูกลบออก สิ่งนี้ไม่สามารถยกเลิกได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh được lưu trong bộ nhớ cache và phản hồi mạng sẽ bị xóa. Không thể hoàn tác thao tác này."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیش شدہ تصاویر اور نیٹ ورک کے جوابات کو ہٹا دیا جائے گا ۔ اسے کالعدم نہیں کیا جا سکتا ۔"
          }
        }
      }
    },
