          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize os itens com novas informações, se disponíveis no TMDb."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizează elementele cu informații noi, dacă sunt disponibile pe TMDb"
