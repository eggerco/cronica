    "Delete %@? Items can stay on your watchlist or be removed with the list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف %@؟ يمكن أن تبقى العناصر في قائمة المشاهدة أو تُزال مع القائمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat %@? Položky mohou zůstat ve watchlistu nebo být odstraněny se seznamem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet %@? Elementer kan blive på din watchlist eller fjernes sammen med listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löschen? Titel können in deiner Watchlist bleiben oder mit der Liste entfernt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή %@; Τα στοιχεία μπορούν να παραμείνουν στη λίστα παρακολούθησης ή να αφαιρεθούν με τη λίστα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete %@? Items can stay on your watchlist or be removed with the list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Los elementos pueden permanecer en tu lista o eliminarse con la lista."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar %@? Los elementos pueden quedarse en tu lista o eliminarse con la lista."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistetaanko %@? Kohteet voivat jäädä katselulistallesi tai poistua listan mukana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %@ ? Les éléments peuvent rester dans ta liste ou être supprimés avec la liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למחוק %@? פריטים יכולים להישאר ברשימת הצפייה או להימחק עם הרשימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हटाएँ? आइटम आपकी वॉचलिस्ट में रह सकते हैं या सूची के साथ हटाए जा सकते हैं."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisati %@? Stavke mogu ostati na popisu ili biti uklonjene s popisom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ törlése? Az elemek maradhatnak a figyelőlistán, vagy a listával együtt törlődhetnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %@? Item bisa tetap di watchlist atau dihapus bersama daftar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare %@? Gli elementi possono rimanere nella tua lista o essere rimossi con la lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除しますか？作品はウォッチリストに残すか、リストと一緒に削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 삭제할까요? 작품은 워치리스트에 남기거나 목록과 함께 제거할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Padam %@? Item boleh kekal dalam watchlist atau dibuang bersama senarai."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slette %@? Elementer kan bli værende i watchlisten din eller fjernes sammen med listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwijderen? Items kunnen op je watchlist blijven of samen met de lijst worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %@? Pozycje mogą pozostać na liście do obejrzenia lub zostać usunięte wraz z listą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@? Os itens podem ficar na sua lista ou ser removidos com a lista."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ștergi %@? Elementele pot rămâne pe watchlist sau fi eliminate odată cu lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@? Элементы могут остаться в списке или быть удалены вместе со списком."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrániť %@? Položky môžu zostať v sledovanom alebo sa odstránia so zoznamom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera %@? Objekt kan stanna kvar i din watchlist eller tas bort tillsammans med listan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ silinsin mi? Öğeler izleme listenizde kalabilir veya listeyle birlikte kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити %@? Елементи можуть залишитися у списку або бути видалені разом із ним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除 %@？条目可保留在观看清单中，或随列表一并移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 %@？項目可保留在觀看清單中，或隨列表一併移除。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ মুছবেন? আইটেমগুলি আপনার ওয়াচলিস্টে থাকতে পারে বা তালিকার সাথে সরানো যেতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Vols eliminar %@? Els elements poden romandre a la Watchlist o eliminar-se amb la llista."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ કાઢી નાખીએ? આઇટમ્સ તમારી વોચલિસ્ટમાં રહી શકે છે અથવા સૂચિ સાથે દૂર કરી શકાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ಅಳಿಸುವುದೇ? ಐಟಂಗಳು ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಯಲ್ಲಿ ಉಳಿಯಬಹುದು ಅಥವಾ ಪಟ್ಟಿಯೊಂದಿಗೆ ತೆಗೆದುಹಾಕಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ഇല്ലാതാക്കണോ? ഇനങ്ങൾ നിങ്ങളുടെ വാച്ച്‌ലിസ്റ്റിൽ തുടരുകയോ ലിസ്‌റ്റിൽ നിന്ന് നീക്കം ചെയ്യുകയോ ചെയ്യാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हटवायचे? आयटम तुमच्या वॉचलिस्टमध्ये राहू शकतात किंवा सूचीसह काढून टाकले जाऊ शकतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ବିଲୋପ କରିବେ କି? ଆଇଟମଗୁଡିକ ଆପଣଙ୍କ ୱାଚଲିଷ୍ଟରେ ରହିପାରେ କିମ୍ବା ତାଲିକା ସହିତ ଅପସାରିତ ହୋଇପାରେ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@? Os itens podem ficar na sua lista ou ser removidos com a lista."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ %@ ਨੂੰ ਮਿਟਾਉਣਾ ਹੈ? ਆਈਟਮਾਂ ਤੁਹਾਡੀ ਨਿਗਰਾਨੀ ਸੂਚੀ ਵਿੱਚ ਰਹਿ ਸਕਦੀਆਂ ਹਨ ਜਾਂ ਸੂਚੀ ਦੇ ਨਾਲ ਹਟਾ ਦਿੱਤੀਆਂ ਜਾ ਸਕਦੀਆਂ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrisati %@? Elementi lahko ostanejo na watchlist ali se odstranijo s seznamom."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ஐ நீக்கவா? உருப்படிகள் உங்கள் கண்காணிப்புப் பட்டியலில் இருக்கும் அல்லது பட்டியலுடன் அகற்றப்படலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ని తొలగించాలా? అంశాలు మీ వీక్షణ జాబితాలో ఉండవచ్చు లేదా జాబితాతో తీసివేయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@? รายการสามารถอยู่ในรายการเฝ้าดูของคุณหรือถูกลบออกพร้อมกับรายการได้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ حذف کریں ؟ آئٹمز آپ کی واچ لسٹ میں رہ سکتے ہیں یا فہرست سے ہٹا دیے جا سکتے ہیں ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %@? Các mục có thể vẫn nằm trong danh sách theo dõi của bạn hoặc bị xóa cùng với danh sách."
          }
        }
      }
    },
