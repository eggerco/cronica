        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Pots marcar aquest episodi com a vist un cop s’hagi emès."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે આ એપિસોડ પ્રસારિત થયા પછી જોયેલા તરીકે ચિહ્નિત કરી શકો છો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही हा भाग प्रसारित झाल्यानंतर पाहिला म्हणून चिन्हांकित करू शकता."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pode marcar este episódio como assistido depois que for exibido."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪ੍ਰਸਾਰਿਤ ਹੋਣ ਤੋਂ ਬਾਅਦ ਤੁਸੀਂ ਇਸ ਐਪੀਸੋਡ ਨੂੰ ਵੇਖਿਆ ਚਿੰਨ੍ਹਿਤ ਕਰ ਸਕਦੇ ਹੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To epizodo lahko označiš kot ogledano, ko se predvaja."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถทำเครื่องหมายตอนนี้ว่าดูแล้วหลังจากออกอากาศแล้ว"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পর্বটি সম্প্রচারিত হওয়ার পর আপনি এটিকে দেখা হয়েছে বলে চিহ্নিত করতে পারেন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸಂಚಿಕೆ ಪ್ರಸಾರವಾದ ನಂತರ ನೀವು ಅದನ್ನು ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ എപ്പിസോഡ് സംപ്രേഷണം ചെയ്തുകഴിഞ്ഞാൽ, അത് കണ്ടതായി നിങ്ങൾക്ക് അടയാളപ്പെടുത്താം."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଏପିସୋଡ୍ ପ୍ରସାରିତ ହେବା ପରେ ଆପଣ ଏହାକୁ ଦେଖିସାରିଛି ଭାବରେ ଚିହ୍ନିତ କରିପାରିବେ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அத்தியாயம் ஒளிபரப்பான பிறகு, நீங்கள் அதைப் பார்த்ததாகக் குறித்துக்கொள்ளலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఎపిసోడ్ ప్రసారమైన తర్వాత మీరు దీనిని చూసినట్లుగా గుర్తించవచ్చు."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đánh dấu tập này là đã xem sau khi nó được phát sóng."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اس ایپی سوڈ کو نشر ہونے کے بعد دیکھا گیا کے بطور نشان زد کر سکتے ہیں۔"
          }
        }
      }
