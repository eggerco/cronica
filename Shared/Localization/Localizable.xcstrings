          "stringUnit": {
            "state": "translated",
            "value": "Añade títulos a %1$@ desde Buscar o la pantalla de detalles de cualquier título."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää nimikkeitä listaan %1$@ hausta tai minkä tahansa nimikkeen tietonäkymästä."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף כותרות ל-%1$@ מחיפוש או ממסך פרטי כל כותרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज या किसी भी शीर्षक की विवरण स्क्रीन से %1$@ में शीर्षक जोड़ें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj naslove u %1$@ iz Pretrage ili zaslona s detaljima."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá címeket a(z) %1$@ listához a Keresésből vagy bármely cím részletei képernyőjéről."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan judul ke %1$@ dari Pencarian atau layar detail judul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索または作品の詳細画面から%1$@に作品を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 또는 작품 상세 화면에서 %1$@에 작품을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tajuk ke %1$@ dari Carian atau skrin butiran mana-mana tajuk."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til titler i %1$@ fra Søk eller en titels detaljside."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg titels toe aan %1$@ via Zoeken of het detail scherm van een titel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj tytuły do %1$@ z Wyszukiwania lub ekranu szczegółów tytułu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă titluri în %1$@ din Căutare sau ecranul de detalii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляй названия в %1$@ из Поиска или экрана сведений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till titlar i %1$@ från Sök eller en titels detaljsida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama'dan veya herhangi bir başlığın ayrıntı ekranından %1$@ listesine başlık ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додавай назви до %1$@ з Пошуку або екрана деталей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从搜索或任意标题的详情页将标题添加到 %1$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從搜尋或任意標題的詳情頁將標題加入 %1$@。"
          }
        }
      }
    },
