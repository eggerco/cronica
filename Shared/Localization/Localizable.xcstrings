    "To add an item on a list, create a new one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة عنصر إلى قائمة، أنشئ قائمة جديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chceš-li přidat položku do seznamu, vytvoř nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tilføje et element til en liste skal du oprette en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Titel zu einer Liste hinzuzufügen, erstelle eine neue."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να προσθέσετε στοιχείο σε λίστα, δημιουργήστε μια νέα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add an item on a list, create a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir un elemento a una lista, crea una nueva."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar un elemento a una lista, crea una nueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisätäksesi kohteen listalle, luo uusi lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter un élément à une liste, crée-en une nouvelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף פריט לרשימה, צור רשימה חדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में आइटम जोड़ने के लिए, नई सूची बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dodavanje stavke na popis, stvori novi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elem hozzáadásához listához hozzon létre egy újat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah item ke daftar, buat daftar baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere un elemento a una lista, crea una nuova lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに項目を追加するには、新しいリストを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 항목을 추가하려면 새 목록을 만드세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah item ke senarai, cipta senarai baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til et element i en liste, opprett en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nieuwe lijst om een item toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać pozycję do listy, utwórz nową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar um item a uma lista, crie uma nova."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
