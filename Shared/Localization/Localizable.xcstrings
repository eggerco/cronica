    "“Mark my next episode as watched”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«علّم الحلقة التالية كمشاهَدة»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Označ mou další epizodu jako zhlédnutou“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Markér min næste episode som set”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Markiere meine nächste Episode als gesehen“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«Μάρκαρε το επόμενο επεισόδιό μου ως προβληθέν»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mark my next episode as watched”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marca mi próximo episodio como visto”"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marca mi próximo episodio como visto”"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Merkitse seuraava jaksoni katsotuksi”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Marque mon prochain épisode comme vu »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״סמן את הפרק הבא שלי כנצפה״"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“मेरा अगला एपिसोड देखा गया चिह्नित करें”"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Označi moju sljedeću epizodu kao pogledanu”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jelöld megnézettként a következő epizódomat”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tandai episode berikutnya saya sebagai ditonton”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Segna il mio prossimo episodio come visto”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次のエピソードを視聴済みにする」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“다음 에피소드를 시청함으로 표시해”"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tanda episod seterusnya saya sebagai ditonton”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "“Merk neste episode som sett”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Markeer mijn volgende aflevering als bekeken”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Oznacz mój następny odcinek jako obejrzany”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marcar meu próximo episódio como assistido”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Marchează următorul meu episod ca vizionat”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отметь следующий эпизод как просмотренный»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Označ moju ďalšiu epizódu ako pozretú“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Markera mitt nästa avsnitt som sett”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonraki bölümümü izlendi olarak işaretle”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Познач наступний епізод як переглянутий»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“将下一集标记为已看”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「將下一集標記為已看」"
          }
        }
      }
    },
