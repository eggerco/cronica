        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una cuenta TMDB opcional para sincronizar tu lista, valoraciones y favoritos con Cronica. Cronica ya usa TMDB para el catálogo; CloudKit sigue sincronizando tus dispositivos Apple."
          }
        },
        "es-MX": {
