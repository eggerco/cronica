    "The app will adapt watch providers based on your region": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتكيف التطبيق مع مزودي المشاهدة حسب منطقتك"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace přizpůsobí poskytovatele sledování podle tvého regionu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Appen tilpasser streamingtjenester baseret på din region"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App passt die Streaming-Anbieter je nach deiner Region an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή θα προσαρμόσει τους παρόχους παρακολούθησης ανάλογα με την περιοχή σας"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
