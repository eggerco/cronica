    "Pull to refresh or try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للتحديث أو حاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potáhni dolů pro obnovení nebo to zkus znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at opdatere, eller prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aktualisieren ziehen oder erneut versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε για ανανέωση ή δοκιμάστε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull to refresh or try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para actualizar o inténtalo de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para actualizar o inténtalo de nuevo."
          }
        },
