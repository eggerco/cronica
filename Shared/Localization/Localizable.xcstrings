    "Watch more titles to receive recommendations.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich weitere Titel an, um Empfehlungen zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch more titles to receive recommendations."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira más títulos para recibir recomendaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez plus de titres pour recevoir des recommandations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda altri titoli per ricevere consigli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assista a mais títulos para receber recomendações."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozrite si ďalšie tituly a získajte odporúčania."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد المزيد من العناوين للحصول على توصيات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj více titulů a získej doporučení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se flere titler for at modtage anbefalinger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε περισσότερους τίτλους για προτάσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve más títulos para recibir recomendaciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katso lisää nimikkeitä saadaksesi suosituksia."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפה ביותר כותרות כדי לקבל המלצות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिफ़ारिशें पाने के लिए और शीर्षक देखें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gledaj više naslova za preporuke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézzen meg több címet az ajánlásokért."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonton lebih banyak judul untuk dapat rekomendasi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おすすめを受け取るには、もっと作品を視聴してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천을 받으려면 더 많은 작품을 시청하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonton lebih banyak tajuk untuk dapat cadangan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se flere titler for å motta anbefalinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk meer titels om aanbevelingen te ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oglądaj więcej tytułów, aby otrzymać rekomendacje."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vizionează mai multe titluri pentru recomandări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотри больше названий, чтобы получать рекомендации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titta på fler titlar för att få rekommendationer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneriler almak için daha fazla başlık izle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дивись більше назв, щоб отримувати рекомендації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多看一些标题以获取推荐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多看一些標題以取得推薦。"
          }
        }
      }
