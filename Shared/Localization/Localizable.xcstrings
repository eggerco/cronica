    "Ask Confirmation To Mark as Watched": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب تأكيداً قبل تحديد كمشاهد"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdit označení jako zhlédnuté"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bed om bekræftelse for at markere som set"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Bestätigung bitten, um als gesehen zu markieren"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Να ζητείται επιβεβαίωση πριν τη σήμανση ως παρακολουθημένο"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask confirmation to mark as watched"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir confirmación para marcar como visto"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar confirmación para marcar como visto"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydä vahvistus merkitsemiseen katsotuksi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander une confirmation pour marquer comme regardé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקש אישור לפני סימון כנצפה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखा चिह्नित करने से पहले पुष्टि माँगें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdi označavanje kao pogledano"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megerősítés kérése megtekintettként jelölés előtt"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta konfirmasi sebelum tandai ditonton"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi conferma per contrassegnare come visto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴済みにする前に確認する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청함으로 표시 전 확인"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta pengesahan sebelum tandakan ditonton"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Be om bekreftelse for å markere som sett"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestiging vragen om als bekeken te markeren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź oznaczenie jako obejrzane"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça Confirmação Para Marcar como Assistido"
          }
        },
