        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme listenizi Cronica ile senkronize etmek için isteğe bağlı bir SIMKL hesabı bağlayın. CloudKit Apple cihazlarınızı senkronize etmeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть необов’язковий обліковий запис SIMKL, щоб синхронізувати список з Cronica. CloudKit надалі синхронізує пристрої Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接可选的 SIMKL 账户，将待看列表与 Cronica 同步。CloudKit 仍会同步你的 Apple 设备。"
