        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписывайся на Cronica в X (Twitter), чтобы узнавать о новых функциях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledujte Cronica na X (Twitter), aby ste boli informovaní o nových funkciách."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Följ Cronica på X (Twitter) för att hålla dig uppdaterad om nya funktioner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni özelliklerden haberdar olmak için X (Twitter)'da Cronica'yı takip et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слідкуй за Cronica в X (Twitter), щоб дізнаватися про нові функції."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 X (Twitter) 上关注 Cronica，获取新功能更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 X (Twitter) 上追蹤 Cronica，取得新功能更新。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন বৈশিষ্ট্য সম্পর্কে আপডেট থাকতে X (Twitter) এ Cronica অনুসরণ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Segueix Cronica a X (Twitter) per estar al dia de les novetats."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નવી સુવિધાઓ વિશે અપડેટ રહેવા માટે X (Twitter) પર Cronica ને અનુસરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹೊಸ ವೈಶಿಷ್ಟ್ಯಗಳ ಕುರಿತು ನವೀಕೃತವಾಗಿರಲು X (Twitter) ನಲ್ಲಿ Cronica ಅನ್ನು ಅನುಸರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുതിയ ഫീച്ചറുകളെ കുറിച്ച് അപ്‌ഡേറ്റായി തുടരാൻ X (Twitter)-ൽ Cronica പിന്തുടരുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन वैशिष्ट्यांबद्दल अपडेट राहण्यासाठी X (Twitter) वर Cronica फॉलो करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ନୂତନ ବ features ଶିଷ୍ଟ୍ୟଗୁଡିକ ବିଷୟରେ ଅଦ୍ୟତନ ରହିବାକୁ X (ଟ୍ୱିଟର) ରେ Cronica ଅନୁସରଣ କରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Siga o Cronica no X (Twitter) para se manter atualizado sobre novos recursos."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਵੀਆਂ ਵਿਸ਼ੇਸ਼ਤਾਵਾਂ ਬਾਰੇ ਅੱਪਡੇਟ ਰਹਿਣ ਲਈ X (Twitter) 'ਤੇ Cronica ਦੀ ਪਾਲਣਾ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledi Cronica na X (Twitter), da ostaneš na tekočem z novostmi."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய அம்சங்களைப் பற்றி தொடர்ந்து தெரிந்துகொள்ள X (Twitter) இல் Cronica ஐப் பின்தொடரவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొత్త ఫీచర్‌ల గురించి ఎప్పటికప్పుడు తెలుసుకోవడానికి X (Twitter)లో Cronicaని అనుసరించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตาม Cronica บน X (Twitter) เพื่อรับทราบข้อมูลอัปเดตเกี่ยวกับคุณสมบัติใหม่"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی خصوصیات کے بارے میں اپ ڈیٹ رہنے کے لیے X (Twitter) پر Cronica کو فالو کریں ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi Cronica trên X (Twitter) để cập nhật về các tính năng mới."
          }
        }
      }
    },
