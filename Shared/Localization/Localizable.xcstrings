            "value": "चयनित शीर्षकों को आपकी वॉचलिस्ट से हटाता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo uklanja odabrane naslove s popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez eltávolítja a kijelölt címeket a figyelőlistáról."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus judul terpilih dari watchlist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した作品をウォッチリストから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 작품을 워치리스트에서 제거합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuang tajuk terpilih daripada watchlist."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner de valgte titlene fra watchlisten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert de geselecteerde titels van je watchlist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa wybrane tytuły z listy do obejrzenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta elimină titlurile selectate din watchlist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит выбранные названия из списка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort de valda titlarna från din watchlist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçili başlıkları izleme listenden kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить вибрані назви зі списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从观看清单中移除所选标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將從觀看清單中移除所選標題。"
          }
        }
      }
    },
    "This will open TMDb website with the links to each service.": {
      "localizations": {
