    "SIMKL is not configured for this build. Add SIMKL_CLIENT_ID in Secrets.xcconfig.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعدّ SIMKL لهذا البناء. أضف SIMKL_CLIENT_ID في Secrets.xcconfig."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL není v tomto buildu nakonfigurováno. Přidej SIMKL_CLIENT_ID do Secrets.xcconfig."
          }
