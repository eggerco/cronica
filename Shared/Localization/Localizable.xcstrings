          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette åpner TMDb-nettsiden med lenker til hver tjeneste."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit opent de TMDb-website met links naar elke dienst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
