        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter zlepšuje výsledky, ale môže predĺžiť vyhľadávanie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسّن الفلتر النتائج لكن قد يطيل البحث."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr zlepšuje výsledky, ale může prodloužit vyhledávání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filteret forbedrer resultater, men kan gøre søgning langsommere."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το φίλτρο βελτιώνει τα αποτελέσματα αλλά μπορεί να καθυστερήσει την αναζήτηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtro mejora los resultados, pero puede hacer que la búsqueda tarde más."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suodatin parantaa tuloksia, mutta voi hidastaa hakua."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסנן משפר תוצאות אך עלול להאריך חיפוש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्टर परिणाम बेहतर करता है लेकिन खोज धीमी हो सकती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtar poboljšava rezultate, ali može produljiti pretragu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szűrő javítja az eredményeket, de a keresés hosszabb időt vehet igénybe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter memperbaiki hasil tapi bisa memperlambat pencarian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターは結果を改善しますが、検索に時間がかかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터는 결과를 개선하지만 검색에 더 오래 걸릴 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penapis memperbaiki hasil tetapi boleh melambatkan carian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filteret forbedrer resultater, men kan gjøre søk tregere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het filter verbetert resultaten maar kan zoeken trager maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr poprawia wyniki, ale może wydłużyć wyszukiwanie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrul îmbunătățește rezultatele, dar poate încetini căutarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фильтр улучшает результаты, но может замедлить поиск."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtret förbättrar resultat men kan göra sökningen långsammare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtre sonuçları iyileştirir ama aramayı uzatabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фільтр покращує результати, але може уповільнити пошук."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "筛选可提升结果质量，但可能会使搜索耗时更长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "篩選可提升結果品質，但可能會使搜尋耗時更長。"
          }
        }
      }
    },
