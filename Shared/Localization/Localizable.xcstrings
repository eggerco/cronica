          "stringUnit": {
            "state": "translated",
            "value": "Nada a continuación. Agrega series en Cronica."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء في التالي. أضف مسلسلات TV في Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic dalšího na řadě. Přidej seriály v Cronica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet næste. Tilføj TV-serier i Cronica."
          }
        },
