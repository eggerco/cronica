        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para atualizar ou tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pentru reîmprospătare sau încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяни для обновления или попробуй снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite pre obnovenie alebo skúste znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att uppdatera eller försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilemek için çek veya tekrar dene."
          }
        },
        "uk": {
