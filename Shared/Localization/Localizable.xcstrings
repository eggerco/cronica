    "Turn on Live Activities for Cronica in Settings to track on the Lock Screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Live Activities لـ Cronica في الإعدادات للتتبع على شاشة القفل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni Live Activities pro Cronica v Nastavení pro sledování na Zamykací obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Live Activities til for Cronica i Indstillinger for at spore på låseskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Live-Aktivitäten für Cronica in den Einstellungen, um auf dem Sperrbildschirm zu tracken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τις Live Activities για το Cronica στις Ρυθμίσεις για παρακολούθηση στην οθόνη κλειδώματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Activities for Cronica in Settings to track on the Lock Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Live Activities para Cronica en Ajustes para hacer seguimiento en la pantalla de bloqueo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las Actividades en vivo de Cronica en Configuración para seguir en la pantalla de bloqueo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Live Activities käyttöön Cronicassa Asetuksissa seurataksesi lukitusnäytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les activités en direct pour Cronica dans Réglages pour suivre sur l’écran verrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל Live Activities ל-Cronica בהגדרות כדי לעקוב במסך נעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन पर ट्रैक करने के लिए सेटिंग्स में Cronica के Live Activities चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi Live Activities za Cronica u Postavkama za praćenje na Zaključanom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a Cronica Live Activities funkcióját a Beállításokban a zárolt képernyős követéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Live Activities untuk Cronica di Pengaturan untuk lacak di Layar Kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le Live Activity per Cronica in Impostazioni per tracciare sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面でトラッキングするには、設定でCronicaのライブアクティビティをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에서 추적하려면 설정에서 Cronica의 라이브 액티비티를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayakan Live Activities untuk Cronica dalam Tetapan untuk jejak pada Skrin Kunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Live Activities for Cronica i Innstillinger for å spore på låseskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Live Activities voor Cronica in via Instellingen om te volgen op het vergrendelscherm."
          }
        },
        "pl": {
