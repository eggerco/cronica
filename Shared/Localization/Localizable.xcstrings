            "value": "எனது கவனிப்புப் பட்டியலில் இணைப்பைச் சேர்க்கவும்"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నా వీక్షణ జాబితాకు లింక్‌ని జోడించండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มลิงก์ไปยังรายการเฝ้าดูของฉัน"
