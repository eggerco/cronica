        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ সোয়াইপ সেই প্রান্তের জন্য প্রাথমিক ক্রিয়া সক্রিয় করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El lliscament complet activa l’acció principal d’aquest costat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂર્ણ સ્વાઇપ તે ધાર માટે પ્રાથમિક ક્રિયાને સક્રિય કરે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪೂರ್ಣ ಸ್ವೈಪ್ ಆ ಅಂಚಿನ ಪ್ರಾಥಮಿಕ ಕ್ರಿಯೆಯನ್ನು ಸಕ್ರಿಯಗೊಳಿಸುತ್ತದೆ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण स्वाइप त्या काठासाठी प्राथमिक क्रिया सक्रिय करते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପୂର୍ଣ୍ଣ ସ୍ୱାଇପ୍ ସେହି ଧାର ପାଇଁ ପ୍ରାଥମିକ କାର୍ଯ୍ୟକୁ ସକ୍ରିୟ କରିଥାଏ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um deslize completo ativa a ação principal desse lado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੂਰਾ ਸਵਾਈਪ ਉਸ ਕਿਨਾਰੇ ਲਈ ਪ੍ਰਾਇਮਰੀ ਐਕਸ਼ਨ ਨੂੰ ਸਰਗਰਮ ਕਰਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polni podrs aktivira primarno dejanje za ta rob."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழு ஸ்வைப் அந்த விளிம்பிற்கான முதன்மை செயலை செயல்படுத்துகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పూర్తి స్వైప్ ఆ అంచు కోసం ప్రాథమిక చర్యను సక్రియం చేస్తుంది."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പൂർണ്ണ സ്വൈപ്പ് ആ അരികിലെ പ്രാഥമിക പ്രവർത്തനം സജീവമാക്കുന്നു."
