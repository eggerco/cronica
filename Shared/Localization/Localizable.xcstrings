        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先將此標題加入觀看清單，然後再試一次。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রথমে আপনার ওয়াচলিস্টে এই শিরোনাম যোগ করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix primer aquest títol a la teva Watchlist i torna-ho a provar."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ શીર્ષકને પહેલા તમારી વોચલિસ્ટમાં ઉમેરો, પછી ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಶೀರ್ಷಿಕೆಯನ್ನು ಮೊದಲು ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಗೆ ಸೇರಿಸಿ, ನಂತರ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആദ്യം ഈ ശീർഷകം നിങ്ങളുടെ വാച്ച്‌ലിസ്റ്റിലേക്ക് ചേർക്കുക, തുടർന്ന് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे शीर्षक प्रथम तुमच्या वॉचलिस्टमध्ये जोडा, नंतर पुन्हा प्रयत्न करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରଥମେ ତୁମର ୱାଚଲିଷ୍ଟରେ ଏହି ଟାଇଟଲ୍ ଯୋଡ, ତାପରେ ପୁନର୍ବାର ଚେଷ୍ଟା କର |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione este título à sua lista primeiro e tente novamente."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਸਿਰਲੇਖ ਨੂੰ ਪਹਿਲਾਂ ਆਪਣੀ ਵਾਚਲਿਸਟ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰੋ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej dodaj ta naslov na watchlist, nato poskusi znova."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதலில் இந்தத் தலைப்பை உங்கள் கவனிப்புப் பட்டியலில் சேர்த்து, பிறகு மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందుగా ఈ శీర్షికను మీ వీక్షణ జాబితాకు జోడించి, ఆపై మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มชื่อนี้ลงในรายการเฝ้าดูของคุณก่อน จากนั้นลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiêu đề này vào danh sách theo dõi của bạn trước, sau đó thử lại."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عنوان کو پہلے اپنی واچ لسٹ میں شامل کریں، پھر دوبارہ کوشش کریں ۔"
          }
        }
      }
    },
    "Add titles on iPhone, then they appear here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
