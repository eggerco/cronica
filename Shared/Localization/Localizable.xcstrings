    "SIMKL is busy. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL مشغول. حاول مرة أخرى بعد لحظات."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL je zaneprázdněné. Zkus to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL er optaget. Prøv igen om et øjeblik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ist ausgelastet. Versuch es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το SIMKL είναι απασχολημένο. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL is busy. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL está ocupado. Inténtalo de nuevo en un momento."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL está ocupado. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL on varattu. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL est occupé. Réessayez dans un instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL עמוס. נסה שוב בעוד רגע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL व्यस्त है। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL je zauzet. Pokušaj ponovo za trenutak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SIMKL foglalt. Próbáld újra egy pillanat múlva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL sedang sibuk. Coba lagi sebentar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL è occupato. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKLが混み合っています。しばらくしてから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL이 바쁩니다. 잠시 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL sedang sibuk. Cuba lagi sebentar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL er opptatt. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL is bezet. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL jest zajęty. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SIMKL está ocupado. Tente novamente em instantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL este ocupat. Încearcă din nou imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL занят. Попробуйте снова через минуту."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL je zaneprázdnené. Skús to o chvíľu znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL är upptagen. Försök igen om en stund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL meşgul. Biraz sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL зайнятий. Спробуйте знову за мить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL 正忙。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL 正忙。請稍後再試。"
          }
        }
      }
