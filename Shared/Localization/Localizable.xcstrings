    "“Mark my next episode as watched”": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«علّم الحلقة التالية كمشاهَدة»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„Označ mou další epizodu jako zhlédnutou“"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "“Markér min næste episode som set”"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Markiere meine nächste Episode als gesehen“"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "«Μάρκαρε το επόμενο επεισόδιό μου ως προβληθέν»"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Mark my next episode as watched”"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marca mi próximo episodio como visto”"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marca mi próximo episodio como visto”"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "”Merkitse seuraava jaksoni katsotuksi”"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Marque mon prochain épisode comme vu »"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״סמן את הפרק הבא שלי כנצפה״"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“मेरा अगला एपिसोड देखा गया चिह्नित करें”"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Označi moju sljedeću epizodu kao pogledanu”"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Jelöld megnézettként a következő epizódomat”"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tandai episode berikutnya saya sebagai ditonton”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Segna il mio prossimo episodio come visto”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「次のエピソードを視聴済みにする」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“다음 에피소드를 시청함으로 표시해”"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tanda episod seterusnya saya sebagai ditonton”"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "“Merk neste episode som sett”"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“Markeer mijn volgende aflevering als bekeken”"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Oznacz mój następny odcinek jako obejrzany”"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marcar meu próximo episódio como assistido”"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Marchează următorul meu episod ca vizionat”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Отметь следующий эпизод как просмотренный»"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "„Označ moju ďalšiu epizódu ako pozretú“"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "“Markera mitt nästa avsnitt som sett”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sonraki bölümümü izlendi olarak işaretle”"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Познач наступний епізод як переглянутий»"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“将下一集标记为已看”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「將下一集標記為已看」"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "«Marca el meu proper episodi com a vist»"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "\"મારો આગામી એપિસોડ જોયો તરીકે ચિહ્નિત કરો\""
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ನನ್ನ ಮುಂದಿನ ಸಂಚಿಕೆಯನ್ನು ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಿ\""
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "\"എൻ്റെ അടുത്ത എപ്പിസോഡ് കണ്ടതായി അടയാളപ്പെടുത്തുക\""
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "“माझा पुढचा भाग पाहिला म्हणून चिन्हांकित करा”"
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "“ମୋର ପରବର୍ତ୍ତୀ ଏପିସୋଡ୍ ଦେଖାଗଲା”"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "“Marcar meu próximo episódio como assistido”"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "\"ਮੇਰੇ ਅਗਲੇ ਐਪੀਸੋਡ ਨੂੰ ਦੇਖੇ ਗਏ ਵਜੋਂ ਚਿੰਨ੍ਹਿਤ ਕਰੋ\""
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»Označi mojo naslednjo epizodo kot ogledano«"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "\"எனது அடுத்த அத்தியாயத்தைப் பார்த்ததாகக் குறி\""
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "\"నా తదుపరి ఎపిసోడ్ చూసినట్లుగా గుర్తించండి\""
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "“ทำเครื่องหมายตอนถัดไปของฉันว่าดูแล้ว”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Đánh dấu tập tiếp theo của tôi là đã xem\""
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"میری اگلی قسط کو دیکھنے کے طور پر نشان زد کریں\""
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমার পরবর্তী পর্বটি দেখা হয়েছে হিসেবে চিহ্নিত করুন।"
          }
        }
      }
    },
