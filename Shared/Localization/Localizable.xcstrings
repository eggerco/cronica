          "stringUnit": {
            "state": "translated",
            "value": "Твій список синхронізується на iPhone, iPad, Mac, Apple Watch та Apple TV."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的列表会在 iPhone、iPad、Mac、Apple Watch 和 Apple TV 之间保持同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的列表會在 iPhone、iPad、Mac、Apple Watch 和 Apple TV 之間保持同步。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "La teva llista es manté sincronitzada a l’iPhone, l’iPad, el Mac, l’Apple Watch i l’Apple TV."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી સૂચિ સમગ્ર iPhone, iPad, Mac, Apple Watch અને Apple TV પર સમન્વયિત રહે છે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची सूची iPhone, iPad, Mac, Apple Watch आणि Apple TV वर समक्रमित राहते."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua lista fica sincronizada no iPhone, iPad, Mac, Apple Watch e Apple TV."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਸੂਚੀ iPhone, iPad, Mac, Apple Watch ਅਤੇ Apple TV ’ਤੇ ਸਿੰਕ ਰਹਿੰਦੀ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj seznam ostane sinhroniziran na iPhonu, iPadu, Macu, Apple Watch in Apple TV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการของคุณยังคงซิงค์ระหว่าง iPhone, iPad, Mac, Apple Watch และ Apple TV"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার তালিকাটি iPhone, iPad, Mac, Apple Watch, এবং Apple TV জুড়ে সমন্বিত থাকে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪಟ್ಟಿಯು iPhone, iPad, Mac, Apple Watch, ಮತ್ತು Apple TV ನಾದ್ಯಂತ ಸಿಂಕ್‌ನಲ್ಲಿ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ലിസ്റ്റ് iPhone, iPad, Mac, Apple Watch, Apple TV എന്നിവയിലുടനീളം സമന്വയിപ്പിച്ചിരിക്കുന്നു."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ତାଲିକା iPhone, iPad, Mac, Apple Watch, ଏବଂ Apple TV ରେ ସିଙ୍କ୍ ରେ ରହିଥାଏ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பட்டியல் iPhone, iPad, Mac, Apple Watch மற்றும் Apple TV முழுவதும் ஒத்திசைந்து இருக்கும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ జాబితా iPhone, iPad, Mac, Apple Watch మరియు Apple TV అంతటా సమకాలీకరించబడుతుంది."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách của bạn được đồng bộ hóa trên iPhone, iPad, Mac, Apple Watch và Apple TV."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی فہرست iPhone، iPad، Mac، Apple Watch، اور Apple TV پر مطابقت پذیر رہتی ہے۔"
          }
        }
      }
    },
