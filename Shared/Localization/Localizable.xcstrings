          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את אפליקציית קיצורי הדרך כדי לעיין בפעולות Cronica ולהוסיף אותן ל־Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica क्रियाएँ देखने और उन्हें Siri में जोड़ने के लिए शॉर्टकट ऐप खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori aplikaciju Prečaci za pregled Cronica radnji i dodavanje u Siri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Parancsok appot a Cronica műveletek böngészéséhez és Sirihez adásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka app Pintasan untuk menelusuri tindakan Cronica dan menambahkannya ke Siri."
          }
        },
        "it": {
          "stringUnit": {
