    "Titles marked watched in the last eight weeks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين المحددة كمشاهدة في آخر ثمانية أسابيع."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly označené jako zhlédnuté za posledních osm týdnů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler markeret som set de seneste otte uger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel, die in den letzten acht Wochen als gesehen markiert wurden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίτλοι που σημειώθηκαν ως παρακολουθημένοι τις τελευταίες οκτώ εβδομάδες."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles marked watched in the last eight weeks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos marcados como vistos en las últimas ocho semanas."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos marcados como vistos en las últimas ocho semanas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeisten kahdeksan viikon aikana katsotuiksi merkityt nimikkeet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres marqués comme vus au cours des huit dernières semaines."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרות שסומנו כנצפו בשמונה השבועות האחרונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले आठ सप्ताह में देखा चिह्नित शीर्षक।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi označeni kao pogledani u zadnjih osam tjedana."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az elmúlt nyolc hétben megtekintettként jelölt címek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul ditandai ditonton dalam delapan minggu terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Titoli segnati come visti nelle ultime otto settimane."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去8週間に視聴済みにした作品。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 8주간 시청함으로 표시한 작품."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk ditandakan ditonton dalam lapan minggu lepas."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler markert som sett de siste åtte ukene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Titels die in de afgelopen acht weken als bekeken zijn gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły oznaczone jako obejrzane w ostatnich ośmiu tygodniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos marcados como assistidos nas últimas oito semanas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titluri marcate ca vizionate în ultimele opt săptămâni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Названия, отмеченные просмотренными за последние восемь недель."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly označené ako pozreté za posledných osem týždňov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar markerade som sedda de senaste åtta veckorna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son sekiz haftada izlendi işaretlenen başlıklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назви, позначені переглянутими за останні вісім тижнів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去八周内标记为已观看的标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過去八週內標記為已觀看的標題。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Títols marcats com a vistos les darreres vuit setmanes."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "છેલ્લા આઠ અઠવાડિયામાં જોવાયા ચિહ્નિત શીર્ષકો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "गेल्या आठ आठवड्यांमध्ये पाहिलेली चिन्हांकित शीर्षके."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos marcados como assistidos nas últimas oito semanas."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪਿਛਲੇ ਅੱਠ ਹਫ਼ਤਿਆਂ ਵਿੱਚ ਦੇਖੇ ਗਏ ਸਿਰਲੇਖਾਂ ਦੀ ਨਿਸ਼ਾਨਦੇਹੀ ਕੀਤੀ ਗਈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi, označeni kot ogledani v zadnjih osmih tednih."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കഴിഞ്ഞ എട്ട് ആഴ്‌ചയിൽ കണ്ടതായി അടയാളപ്പെടുത്തിയ ശീർഷകങ്ങൾ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องที่มีการทำเครื่องหมายดูในช่วงแปดสัปดาห์ที่ผ่านมา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tựa phim được đánh dấu đã xem trong tám tuần qua."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত আট সপ্তাহে দেখা শিরোনামগুলো।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕಳೆದ ಎಂಟು ವಾರಗಳಲ್ಲಿ ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಲಾದ ಶೀರ್ಷಿಕೆಗಳು."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଗତ ଆଠ ସପ୍ତାହ ମଧ୍ୟରେ ଦେଖାଯାଇଥିବା ଭାବରେ ଚିହ୍ନିତ ଟାଇଟଲଗୁଡ଼ିକ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கடந்த எட்டு வாரங்களில் பார்க்கப்பட்டதாகக் குறிக்கப்பட்ட தலைப்புகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "గత ఎనిమిది వారాల్లో వీక్షించినట్లుగా గుర్తించబడిన టైటిల్స్."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلے آٹھ ہفتوں میں دیکھے گئے عنوانات کو نشان زد کیا گیا ہے۔"
          }
        }
      }
    },
    "Titles removed on SIMKL stay in Cronica. Delete them here if you no longer want them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين المحذوفة على SIMKL تبقى في Cronica. احذفها هنا إن لم تعد تريدها."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly odstraněné na SIMKL zůstávají v Cronice. Smaž je zde, pokud je už nechceš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler fjernet på SIMKL forbliver i Cronica. Slet dem her, hvis du ikke længere vil have dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf SIMKL entfernte Titel bleiben in Cronica. Lösche sie hier, wenn du sie nicht mehr brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι τίτλοι που αφαιρέθηκαν στο SIMKL μένουν στο Cronica. Διαγράψτε τους εδώ αν δεν τους θέλετε πλέον."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles removed on SIMKL stay in Cronica. Delete them here if you no longer want them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos eliminados en SIMKL permanecen en Cronica. Elimínalos aquí si ya no los quieres."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos eliminados en SIMKL permanecen en Cronica. Elimínalos aquí si ya no los quieres."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL:stä poistetut nimet jäävät Cronicaan. Poista ne täältä, jos et enää halua niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres retirés sur SIMKL restent dans Cronica. Supprimez-les ici si vous n’en voulez plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרים שהוסרו ב‑SIMKL נשארים ב‑Cronica. מחק אותם כאן אם אינך רוצה אותם יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL पर हटाए गए शीर्षक Cronica में रहते हैं। यदि आप उन्हें नहीं चाहते तो यहाँ हटाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi uklonjeni na SIMKL-u ostaju u Cronica. Obriši ih ovdje ako ih više ne želiš."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A SIMKL-ről eltávolított címek a Cronicában maradnak. Töröld őket itt, ha már nem kellenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Judul yang dihapus di SIMKL tetap di Cronica. Hapus di sini jika tidak lagi diinginkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I titoli rimossi su SIMKL restano in Cronica. Eliminali qui se non li vuoi più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKLで削除したタイトルはCronicaに残ります。不要ならここで削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL에서 제거한 작품은 Cronica에 남습니다. 더 이상 원하지 않으면 여기서 삭제하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tajuk yang dialih keluar di SIMKL kekal dalam Cronica. Padamnya di sini jika anda tidak mahukannya lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Titler fjernet på SIMKL blir i Cronica. Slett dem her hvis du ikke vil ha dem lenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op SIMKL verwijderde titels blijven in Cronica. Verwijder ze hier als je ze niet meer wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tytuły usunięte w SIMKL pozostają w Cronica. Usuń je tutaj, jeśli ich nie chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos removidos no SIMKL permanecem no Cronica. Exclua-os aqui se não quiser mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlurile eliminate pe SIMKL rămân în Cronica. Șterge-le aici dacă nu le mai vrei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые в SIMKL названия остаются в Cronica. Удалите их здесь, если они больше не нужны."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tituly odstránené na SIMKL zostávajú v Cronice. Vymaž ich tu, ak ich už nechceš."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Titlar borttagna på SIMKL finns kvar i Cronica. Ta bort dem här om du inte vill ha dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL’de kaldırılan başlıklar Cronica’da kalır. İstemiyorsanız burada silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалені в SIMKL назви залишаються в Cronica. Видаліть їх тут, якщо вони більше не потрібні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 SIMKL 上移除的标题仍会留在 Cronica。若不再需要，请在此删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 SIMKL 上移除的標題仍會留在 Cronica。若不再需要，請在此刪除。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els títols eliminats a SIMKL es queden a Cronica. Elimina’ls aquí si ja no els vols."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL પર દૂર કરાયેલા શીર્ષકો Cronica માં રહે છે. જો તમે તેમને હવે જોઈતા ન હોવ તો તેમને અહીં કાઢી નાખો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL वर काढलेली शीर्षके Cronica मध्ये राहतील. तुम्हाला ते यापुढे नको असल्यास ते येथे हटवा."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos removidos no SIMKL permanecem no Cronica. Exclua-os aqui se não quiser mais."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL 'ਤੇ ਹਟਾਏ ਗਏ ਟਾਈਟਲ Cronica ਵਿੱਚ ਰਹਿੰਦੇ ਹਨ। ਜੇਕਰ ਤੁਸੀਂ ਹੁਣ ਉਹਨਾਂ ਨੂੰ ਨਹੀਂ ਚਾਹੁੰਦੇ ਹੋ ਤਾਂ ਉਹਨਾਂ ਨੂੰ ਇੱਥੇ ਮਿਟਾਓ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslovi, odstranjeni na SIMKL, ostanejo v Cronica. Izbriši jih tukaj, če jih ne želiš več."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL-ൽ നീക്കംചെയ്ത ശീർഷകങ്ങൾ Cronica-ൽ തുടരും. നിങ്ങൾക്ക് ഇനി ആവശ്യമില്ലെങ്കിൽ അവ ഇവിടെ ഇല്ലാതാക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อที่ถูกลบบน SIMKL จะยังคงอยู่ใน Cronica ลบได้ที่นี่หากคุณไม่ต้องการอีกต่อไป"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tiêu đề bị xóa trên SIMKL vẫn ở lại Cronica. Xóa chúng ở đây nếu bạn không còn muốn chúng nữa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL থেকে মুছে ফেলা টাইটেলগুলো Cronica-এ থেকে যায়। যদি আপনি সেগুলো আর না চান, তাহলে এখান থেকে মুছে ফেলুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ನಲ್ಲಿ ತೆಗೆದುಹಾಕಲಾದ ಶೀರ್ಷಿಕೆಗಳು Cronica ನಲ್ಲಿ ಉಳಿಯುತ್ತವೆ. ನಿಮಗೆ ಅವು ಇನ್ನು ಮುಂದೆ ಬೇಡವಾದರೆ ಇಲ್ಲಿ ಅಳಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL ରେ ଅପସାରିତ ଶୀର୍ଷକଗୁଡ଼ିକ Cronica ରେ ରହିବ। ଯଦି ଆପଣ ଆଉ ସେଗୁଡ଼ିକୁ ଚାହାଁନ୍ତି ନାହିଁ, ତେବେ ଏଠାରେ ସେଗୁଡ଼ିକୁ ଡିଲିଟ୍ କରନ୍ତୁ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL-இல் நீக்கப்பட்ட தலைப்புகள் Cronica-இல் அப்படியே இருக்கும். அவை உங்களுக்கு இனி தேவையில்லை என்றால், அவற்றை இங்கேயே நீக்கிவிடவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKLలో తొలగించబడిన శీర్షికలు Cronicaలో ఉంటాయి. మీకు అవి ఇకపై వద్దు అనుకుంటే, వాటిని ఇక్కడ తొలగించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL پر ہٹائے گئے عنوانات Cronica میں رہتے ہیں۔ اگر آپ انہیں مزید نہیں چاہتے ہیں تو انہیں یہاں حذف کریں۔"
          }
        }
      }
    },
