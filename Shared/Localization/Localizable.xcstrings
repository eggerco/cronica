    "Save movies and shows — Cronica keeps them organized for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الأفلام والمسلسلات — Cronica ينظمها لك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládej filmy a seriály — Cronica je za tebe udržuje v pořádku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem film og serier — Cronica holder dem organiseret for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere Filme und Serien — Cronica hält sie für dich organisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε ταινίες και σειρές — το Cronica τα οργανώνει για εσάς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save movies and shows — Cronica keeps them organized for you."
          }
        },
