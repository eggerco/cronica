        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csatlakoztass opcionális SIMKL-fiókot a lista Cronica-val való szinkronizálásához. A CloudKit továbbra is szinkronizálja az Apple-eszközeidet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan akun SIMKL opsional untuk menyinkronkan daftar tonton dengan Cronica. CloudKit tetap menyinkronkan perangkat Apple Anda."
