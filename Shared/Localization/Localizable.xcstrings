            "value": "Spara filmer och serier — Cronica håller dem organiserade åt dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmleri ve dizileri kaydet — Cronica senin için düzenler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігай фільми та серіали — Cronica все організує за тебе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
