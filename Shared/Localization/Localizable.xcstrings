          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உருவாக்கத்திற்கு TMDB உள்ளமைக்கப்படவில்லை. Secrets.xcconfig-இல் TMDB_API_KEY-ஐச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ బిల్డ్ కోసం TMDB కాన్ఫిగర్ చేయబడలేదు. Secrets.xcconfigలో TMDB_API_KEYని జోడించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB اس تعمیر کے لیے کنفیگر نہیں ہے۔ Secrets.xcconfig میں TMDB_API_KEY شامل کریں۔"
          }
        }
      }
    },
