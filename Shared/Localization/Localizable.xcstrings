    "Get notified when new movies and episodes arrive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إشعار عند وصول أفلام وحلقات جديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávej upozornění, když dorazí nové filmy a epizody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når nye film og afsnit udkommer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich benachrichtigen, wenn neue Filme und Episoden erscheinen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λάβετε ειδοποίηση όταν φτάνουν νέες ταινίες και επεισόδια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get notified when new movies and episodes arrive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos cuando lleguen nuevas películas y episodios."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos cuando lleguen nuevas películas y episodios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat ilmoituksen, kun uusia elokuvia ja jaksoja julkaistaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez des notifications pour les nouveautés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל התראה כשמגיעים סרטים ופרקים חדשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई फ़िल्में और एपिसोड आने पर सूचना पाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primaj obavijesti o novim filmovima i epizodama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítést kap, amikor új filmek és epizódok érkeznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan notifikasi saat film dan episode baru tiba."
          }
        },
