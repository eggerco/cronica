    "Your list stays in sync across iPhone, iPad, Mac, Apple Watch, and Apple TV.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى قائمتك متزامنة عبر iPhone وiPad وMac وApple Watch وApple TV."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj seznam zůstává synchronizovaný na iPhonu, iPadu, Macu, Apple Watch a Apple TV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din liste forbliver synkroniseret på iPhone, iPad, Mac, Apple Watch og Apple TV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Liste bleibt auf iPhone, iPad, Mac, Apple Watch und Apple TV synchron."
          }
