        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sovellus mukauttaa suoratoistopalvelut alueesi mukaan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application adaptera les fournisseurs de contenus en fonction de votre région"
