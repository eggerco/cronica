        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad அல்லது Mac இலிருந்து TMDB கணக்கை இணைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone, iPad లేదా Mac నుండి TMDB ఖాతాను కనెక్ట్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อบัญชี TMDB จาก iPhone, iPad หรือ Mac"
