    "Pin titles or start watching to see them here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت العناوين أو ابدأ المشاهدة لتراها هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připni tituly nebo začni sledovat, aby se zobrazily tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastgør titler eller begynd at se for at se dem her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinne Titel an oder beginne zu schauen, um sie hier zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καρφιτσώστε τίτλους ή ξεκινήστε παρακολούθηση για να τους δείτε εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin titles or start watching to see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija títulos o empieza a verlos para que aparezcan aquí."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija títulos o empieza a verlos para que aparezcan aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitä nimikkeitä tai aloita katselu nähdäksesi ne täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Épingle des titres ou commence à regarder pour les voir ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמד כותרות או התחל לצפות כדי לראות אותן כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक पिन करें या देखना शुरू करें, यहाँ दिखेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikvači naslove ili počni gledati da bi se ovdje prikazali."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzítsen címeket vagy kezdjen el nézni, hogy itt megjelenjenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sematkan judul atau mulai menonton untuk melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fissa titoli o inizia a guardare per vederli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作品をピン留めするか視聴を開始すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작품을 고정하거나 시청을 시작하면 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semat tajuk atau mula menonton untuk melihatnya di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fest titler eller begynn å se for å se dem her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin titels of begin met kijken om ze hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypnij tytuły lub zacznij oglądać, aby zobaczyć je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe títulos ou comece a assistir para vê-los aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixează titluri sau începe vizionarea ca să le vezi aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрепи названия или начни смотреть, чтобы увидеть их здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripni tituly alebo začni sledovať, aby sa tu zobrazili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fäst titlar eller börja titta för att se dem här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlıkları sabitle veya burada görmek için izlemeye başla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріпи назви або почни дивитися, щоб побачити їх тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "置顶标题或开始观看后，将显示在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釘選標題或開始觀看後，將顯示於此處。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixa títols o comença a mirar-los per veure’ls aquí."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શીર્ષકો પિન કરો અથવા તેમને અહીં જોવા માટે જોવાનું શરૂ કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षके पिन करा किंवा ती येथे पाहण्यासाठी पाहणे सुरू करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟାଇଟଲ୍ ପିନ୍ କରନ୍ତୁ କିମ୍ବା ସେମାନଙ୍କୁ ଏଠାରେ ଦେଖିବା ଆରମ୍ଭ କରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixe títulos ou comece a assistir para vê-los aqui."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਲੇਖਾਂ ਨੂੰ ਪਿੰਨ ਕਰੋ ਜਾਂ ਉਹਨਾਂ ਨੂੰ ਇੱਥੇ ਦੇਖਣ ਲਈ ਦੇਖਣਾ ਸ਼ੁਰੂ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripnite naslove ali začnite gledati, da jih vidite tukaj."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശീർഷകങ്ങൾ പിൻ ചെയ്യുക അല്ലെങ്കിൽ അവ ഇവിടെ കാണുന്നതിന് കാണാൻ തുടങ്ങുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปักหมุดชื่อหรือเริ่มดูเพื่อดูได้ที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghim tiêu đề hoặc bắt đầu xem để xem chúng tại đây."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনামগুলো পিন করুন অথবা এখানে দেখতে দেখা শুরু করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಶೀರ್ಷಿಕೆಗಳನ್ನು ಇಲ್ಲಿ ನೋಡಲು ಪಿನ್ ಮಾಡಿ ಅಥವಾ ವೀಕ್ಷಿಸಲು ಪ್ರಾರಂಭಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்புகளைப் பின் செய்யவும் அல்லது அவற்றை இங்கே காண பார்க்கத் தொடங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శీర్షికలను పిన్ చేయండి లేదా వాటిని ఇక్కడ చూడటం ప్రారంభించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوانات کو پن کریں یا انہیں یہاں دیکھنے کے لیے دیکھنا شروع کریں۔"
          }
        }
      }
    },
