          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengingatkan tajuk tertentu, guna Tambah ke Peringatan pada halaman butiran."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å minne deg på en bestemt tittel, bruk Legg til i Påminnelser på detaljsiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor een herinnering aan een specifieke titel gebruik je Toevoegen aan Herinneringen op de detailpagina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby przypomnieć sobie o konkretnym tytule, użyj Dodaj do Przypomnień na stronie szczegółów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lembrar de um título específico, use Adicionar aos Lembretes na página de detalhes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a-ți aminti un titlu anume, folosește Adaugă în Memento-uri pe pagina de detalii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы напомнить о конкретном названии, используйте «Добавить в Напоминания» на странице подробностей."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pripomenutie konkrétneho titulu použite Pridať do Pripomienok na stránke podrobností."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att påminna dig om en specifik titel, använd Lägg till i Påminnelser på detaljsidan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirli bir yapım için hatırlatıcı oluşturmak üzere ayrıntı sayfasında Anımsatıcılara ekle’yi kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб нагадати собі про конкретну назву, скористайтеся «Додати до Нагадувань» на сторінці деталей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若要提醒自己关注某部作品，请在详情页使用“添加到提醒事项”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要提醒自己關注某部作品，請在詳細頁使用「加入提醒事項」。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per recordar-te un títol concret, utilitza Afegeix a Recordatoris a la seva pàgina de detalls."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચોક્કસ શીર્ષક વિશે તમારી જાતને યાદ કરાવવા માટે, તેના વિગતવાર પૃષ્ઠ પર રીમાઇન્ડર્સમાં ઉમેરોનો ઉપયોગ કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विशिष्ट शीर्षकाबद्दल स्वतःला आठवण करून देण्यासाठी, त्याच्या तपशील पृष्ठावरील स्मरणपत्रांमध्ये जोडा वापरा."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para lembrar de um título específico, use Adicionar aos Lembretes na página de detalhes."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਖਾਸ ਸਿਰਲੇਖ ਬਾਰੇ ਆਪਣੇ ਆਪ ਨੂੰ ਯਾਦ ਕਰਾਉਣ ਲਈ, ਇਸ ਦੇ ਵੇਰਵੇ ਵਾਲੇ ਪੰਨੇ 'ਤੇ ਰੀਮਾਈਂਡਰਾਂ ਵਿੱਚ ਸ਼ਾਮਲ ਕਰੋ ਦੀ ਵਰਤੋਂ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za opomnik o določenem naslovu uporabi Dodaj med opomnike na strani s podrobnostmi."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു നിർദ്ദിഷ്‌ട ശീർഷകത്തെക്കുറിച്ച് സ്വയം ഓർമ്മപ്പെടുത്തുന്നതിന്, അതിൻ്റെ വിശദാംശ പേജിൽ ഓർമ്മപ്പെടുത്തലുകളിലേക്ക് ചേർക്കുക ഉപയോഗിക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการเตือนตัวเองเกี่ยวกับเรื่องใดเรื่องหนึ่ง ให้ใช้เพิ่มในการเตือนความจำในหน้ารายละเอียด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhắc nhở bản thân về một tiêu đề cụ thể, hãy sử dụng Thêm vào Lời nhắc trên trang chi tiết của tiêu đề đó."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো নির্দিষ্ট শিরোনাম সম্পর্কে নিজেকে মনে করিয়ে দিতে, সেটির বিস্তারিত পৃষ্ঠায় থাকা ‘অ্যাড টু রিমাইন্ডারস’ (Add to Reminders) ব্যবহার করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿರ್ದಿಷ್ಟ ಶೀರ್ಷಿಕೆಯ ಬಗ್ಗೆ ನಿಮ್ಮನ್ನು ನೆನಪಿಸಿಕೊಳ್ಳಲು, ಅದರ ವಿವರ ಪುಟದಲ್ಲಿ ಜ್ಞಾಪನೆಗಳಿಗೆ ಸೇರಿಸಿ ಬಳಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏକ ନିର୍ଦ୍ଦିଷ୍ଟ ଶୀର୍ଷକ ବିଷୟରେ ନିଜକୁ ମନେ ପକାଇବା ପାଇଁ, ଏହାର ବିବରଣୀ ପୃଷ୍ଠାରେ \"ରିମାଇଣ୍ଡରରେ ଯୋଡନ୍ତୁ\" ବ୍ୟବହାର କରନ୍ତୁ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு குறிப்பிட்ட தலைப்பை உங்களுக்கு நினைவூட்டிக்கொள்ள, அதன் விவரப் பக்கத்தில் உள்ள 'நினைவூட்டல்களில் சேர்' என்பதைப் பயன்படுத்தவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నిర్దిష్ట శీర్షికను మీకు మీరు గుర్తు చేసుకోవడానికి, దాని వివరాల పేజీలో 'రిమైండర్‌లకు జోడించు' (Add to Reminders) ను ఉపయోగించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے آپ کو کسی مخصوص عنوان کے بارے میں یاد دلانے کے لیے، اس کے تفصیلی صفحہ پر یاد دہانیوں میں شامل کریں کا استعمال کریں۔"
          }
        }
      }
    },
