        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף כותרות עם תאריכי שחרור עתידיים לרשימת הצפייה כדי לראות אותן כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भविष्य की रिलीज़ तिथियों वाले शीर्षक यहाँ देखने के लिए अपनी वॉचलिस्ट में जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj naslove s budućim datumom izlaska na popis kako bi ih vidio ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá jövőbeli megjelenési dátummal rendelkező címeket a figyelőlistához, hogy itt megjelenjenek."
          }
        },
        "id": {
          "stringUnit": {
