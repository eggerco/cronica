    "Save movies and shows — Cronica keeps them organized for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere Filme und Serien — Cronica hält sie für dich organisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save movies and shows — Cronica keeps them organized for you."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda películas y series; Cronica las organiza por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez films et séries — Cronica les organise pour vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva film e serie — Cronica li organizza per te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve filmes e séries — a Cronica organiza por você."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukladaj filmy a seriály — Cronica ich pre teba usporiada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ الأفلام والمسلسلات — Cronica ينظمها لك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládej filmy a seriály — Cronica je za tebe udržuje v pořádku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem film og serier — Cronica holder dem organiseret for dig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε ταινίες και σειρές — το Cronica τα οργανώνει για εσάς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda películas y series — Cronica las mantiene organizadas por ti."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna elokuvat ja sarjat — Cronica pitää ne järjestyksessä puolestasi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור סרטים וסדרות — Cronica מארגן אותם בשבילך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्में और शो सहेजें — Cronica उन्हें व्यवस्थित रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremi filmove i serije — Cronica ih organizira za tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentse el a filmeket és műsorokat — a Cronica rendszerezi őket Önnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan film dan acara — Cronica mengaturnya untukmu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画と番組を保存 — Cronicaが整理してくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화와 프로그램을 저장하세요 — Cronica가 정리해 드립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan filem dan rancangan — Cronica susunkan untuk anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre filmer og serier — Cronica holder dem organisert for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar films en series — Cronica houdt ze voor je georganiseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj filmy i seriale — Cronica utrzymuje je w porządku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează filme și seriale — Cronica le organizează pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняй фильмы и сериалы — Cronica всё организует за тебя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara filmer och serier — Cronica håller dem organiserade åt dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmleri ve dizileri kaydet — Cronica senin için düzenler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігай фільми та серіали — Cronica все організує за тебе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存电影和节目 — Cronica 会为你整理得井井有条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存電影和節目 — Cronica 會為你整理得井井有條。"
          }
        }
      }
