    "Reduce some UI elements size to accommodate more items on the screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige UI-Elemente verkleinern, um mehr Elemente auf dem Bildschirm unterzubringen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce the size of some UI elements to fit more items on screen."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzca el tamaño de algunos elementos de la interfaz de usuario para acomodar más elementos en la pantalla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire la taille de certains éléments de l'interface utilisateur pour accueillir plus d'éléments à l'écran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci le dimensioni di alcuni elementi dell'interfaccia per ospitare più elementi sullo schermo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o tamanho de alguns elementos da interface do usuário para acomodar mais itens na tela"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenšenie veľkosti niektorých prvkov rozhrania, aby sa na obrazovku zmestilo viac položiek"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصغير بعض عناصر الواجهة لعرض المزيد من العناصر على الشاشة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenšit některé prvky rozhraní, aby se na obrazovku vešlo více položek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducer størrelsen på nogle UI-elementer for at få plads til flere elementer på skærmen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείωση μεγέθους ορισμένων στοιχείων UI για να χωρέσουν περισσότερα στην οθόνη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el tamaño de algunos elementos de la interfaz para mostrar más contenido en pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienennä joidenkin käyttöliittymäelementtien kokoa, jotta ruudulle mahtuu enemmän kohteita."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטן חלק מאלמנטי הממשק כדי להציג יותר פריטים על המסך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर अधिक आइटम दिखाने के लिए कुछ UI तत्व छोटे करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smanji neke elemente sučelja kako bi stalo više stavki na zaslon"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csökkentse egyes felületelemek méretét, hogy több elem férjen el a képernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkecil beberapa elemen UI agar lebih banyak item muat di layar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のUI要素のサイズを縮小して、画面により多くの項目を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 UI 요소 크기를 줄여 화면에 더 많은 항목을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecilkan beberapa elemen UI untuk muat lebih banyak item pada skrin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduser størrelsen på noen UI-elementer for å få plass til flere elementer på skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verklein enkele UI-elementen om meer items op het scherm te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz niektóre elementy interfejsu, aby zmieścić więcej pozycji na ekranie"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce dimensiunea unor elemente UI pentru a încăpea mai multe pe ecran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшить некоторые элементы интерфейса, чтобы поместить больше элементов на экран"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska storleken på vissa UI-element för att få plats med fler objekt på skärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranda daha fazla öğe göstermek için bazı arayüz öğelerini küçült"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшити деякі елементи інтерфейсу, щоб вмістити більше на екрані"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小部分界面元素以在屏幕上显示更多内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小部分介面元素以在畫面上顯示更多內容。"
          }
        }
      }
    },
