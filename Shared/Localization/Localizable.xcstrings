        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಶೀರ್ಷಿಕೆಗೆ ಮುಂಬರುವ ಬಿಡುಗಡೆ ಅಥವಾ ಸಂಚಿಕೆಯ ದಿನಾಂಕವಿಲ್ಲ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଟାଇଟଲ୍ ପାଇଁ କୌଣସି ଆଗାମୀ ରିଲିଜ୍ କିମ୍ବା ଏପିସୋଡ୍ ତାରିଖ ନାହିଁ।"
