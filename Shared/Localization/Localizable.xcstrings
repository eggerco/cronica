    "Open the Shortcuts app to browse Cronica actions and add them to Siri.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الاختصارات لتصفح إجراءات Cronica وإضافتها إلى Siri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete aplikaci Zkratky a procházejte akce Cronica a přidejte je do Siri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn appen Genveje for at se Cronica-handlinger og tilføje dem til Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Kurzbefehle-App, um Cronica-Aktionen zu durchsuchen und zu Siri hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε την εφαρμογή Συντομεύσεις για να περιηγηθείς στις ενέργειες Cronica και να τις προσθέσεις στο Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Shortcuts app to browse Cronica actions and add them to Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Atajos para ver las acciones de Cronica y añadirlas a Siri."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
