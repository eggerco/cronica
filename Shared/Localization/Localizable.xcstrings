        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica nepoužíva účty. Tvoje sledované, hodnotenia, poznámky a predvoľby sú uložené na tomto zariadení a, ak je zapnuté, v tvojom súkromnom iCloud účte."
          }
