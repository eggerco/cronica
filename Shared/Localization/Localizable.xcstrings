          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarkista yhteys ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את החיבור ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना कनेक्शन जाँचें और दोबारा कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeri vezu i pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ellenőrizze a kapcsolatot, majd próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa koneksi dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 확인하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak sambungan anda dan cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk tilkoblingen din og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверь подключение и попробуй снова."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Skontrolujte pripojenie a skúste to znova."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera din anslutning och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantını kontrol et ve tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевір з’єднання і спробуй знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查網路連線後再試一次。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprova la connexió i torna-ho a provar."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું કનેક્શન તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಹಾಗೂ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे कनेक्शन तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ସଂଯୋଗ ଯାଞ୍ଚ କରନ୍ତୁ ଏବଂ ପୁନର୍ବାର ଚେଷ୍ଟା କରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a tua ligação e tenta novamente."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਕਨੈਕਸ਼ਨ ਦੀ ਜਾਂਚ ਕਰੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverite povezavo in poskusite znova."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்."
