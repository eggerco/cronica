        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ಮುಂದಿನ ಬಿಡುಗಡೆ ಅಥವಾ ಸಂಚಿಕೆಗಾಗಿ ಜ್ಞಾಪನೆಯನ್ನು ಸೇರಿಸಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica അടുത്ത റിലീസിനോ എപ്പിസോഡിനോ വേണ്ടി ഒരു ഓർമ്മപ്പെടുത്തൽ ചേർത്തു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ने पुढील प्रकाशन किंवा भागासाठी स्मरणपत्र जोडले."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରବର୍ତ୍ତୀ ପ୍ରକାଶନ କିମ୍ବା ଏପିସୋଡ୍ ପାଇଁ Cronica ଏକ ସ୍ମାରକପତ୍ର ଯୋଗ କଲା |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Cronica adicionou um lembrete para o próximo lançamento ou episódio."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਨੇ ਅਗਲੀ ਰੀਲੀਜ਼ ਜਾਂ ਐਪੀਸੋਡ ਲਈ ਇੱਕ ਰੀਮਾਈਂਡਰ ਜੋੜਿਆ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica je dodal opomnik za naslednjo premiero ali epizodo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica அடுத்த வெளியீடு அல்லது அத்தியாயத்திற்கான நினைவூட்டலைச் சேர்த்தது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica తదుపరి విడుదల లేదా ఎపిసోడ్ కోసం రిమైండర్‌ని జోడించారు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica เพิ่มการแจ้งเตือนสำหรับรุ่นหรือตอนถัดไป"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica نے اگلی ریلیز یا قسط کے لیے ایک یاد دہانی شامل کی ۔"
