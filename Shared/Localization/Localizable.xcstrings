        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସନ୍ଧାନରୁ କିମ୍ବା ଯେକ title ଣସି ଟାଇଟଲ୍ ର ସବିଶେଷ ସ୍କ୍ରିନରୁ %1$@ ରେ ଟାଇଟଲ୍ ଯୋଡନ୍ତୁ |"
