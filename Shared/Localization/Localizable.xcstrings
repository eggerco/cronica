        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পর্বগুলো এখানে প্রদর্শিত হবে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸಂಚಿಕೆಗಳು ಇಲ್ಲಿ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ."
