        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேடல் அல்லது ஏதேனும் தலைப்பின் விவரங்கள் திரையில் இருந்து %1$@ இல் தலைப்புகளைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "శోధన లేదా ఏదైనా శీర్షిక వివరాల స్క్రీన్ నుండి %1$@కి శీర్షికలను జోడించండి."
          }
        },
        "th": {
