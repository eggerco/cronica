        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Türe göre gruplanmış izlenen başlıklar, tahmini izleme süresiyle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглянуті назви згруповані за типом з оцінкою часу перегляду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按类型分组的已观看标题及估算观看时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依類型分組的已觀看標題及估算觀看時長。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Títols vistos agrupats per tipus, amb el temps de visionat estimat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અંદાજિત જોવાના સમય સાથે, પ્રકાર દ્વારા જૂથબદ્ધ જોયેલા શીર્ષકો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अंदाजे पाहण्याच्या वेळेसह, प्रकारानुसार गटबद्ध केलेली शीर्षके पाहिली."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos assistidos agrupados por tipo, com tempo de exibição estimado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸਮ ਅਨੁਸਾਰ ਵੇਖੇ ਸਿਰਲੇਖ, ਅਨੁਮਾਨਿਤ ਵੇਖਣ ਸਮੇਂ ਸਮੇਤ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogledani naslovi, razvrščeni po vrsti, s predvidenim časom ogleda."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കണക്കാക്കിയ കാഴ്‌ച സമയം ഉപയോഗിച്ച് തരം അനുസരിച്ച് തരംതിരിച്ച തലക്കെട്ടുകൾ കണ്ടു."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อเรื่องที่ดูจัดกลุ่มตามประเภทพร้อมเวลาดูโดยประมาณ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখা শিরোনামগুলো ধরণ অনুযায়ী ভাগ করা হয়েছে, সাথে আনুমানিক দেখার সময় দেওয়া হলো।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂದಾಜು ವೀಕ್ಷಣಾ ಸಮಯದೊಂದಿಗೆ, ಪ್ರಕಾರದ ಪ್ರಕಾರ ಗುಂಪು ಮಾಡಲಾದ ವೀಕ್ಷಿಸಿದ ಶೀರ್ಷಿಕೆಗಳು."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଦେଖାଯାଇଥିବା ଶୀର୍ଷକଗୁଡ଼ିକୁ ପ୍ରକାର ଅନୁସାରେ ଗୋଷ୍ଠୀଭୁକ୍ତ କରାଯାଇଛି, ଦେଖିବାର ଆନୁମାନିକ ସମୟ ସହିତ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பார்த்த தலைப்புகள் வகை வாரியாக, மதிப்பிடப்பட்ட பார்வை நேரத்துடன் தொகுக்கப்பட்டுள்ளன."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చూసిన టైటిల్స్ రకాన్ని బట్టి, అంచనా వీక్షణ సమయంతో వర్గీకరించబడ్డాయి."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tựa phim đã xem được nhóm theo thể loại, kèm theo thời gian xem ước tính."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھے گئے عنوانات کو قسم کے لحاظ سے گروپ کیا گیا، دیکھنے کے اندازے کے ساتھ۔"
          }
        }
      }
    },
