          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, usa l'app su iPhone per creare nuove liste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいリストを作成するには、iPhoneアプリを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 목록을 만들려면 iPhone 앱을 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna aplikasi iPhone untuk mencipta senarai baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk iPhone-appen for å opprette nye lister."
