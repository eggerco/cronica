    "Smart Filters only works when 'Show All Items' is disabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الفلاتر الذكية فقط عند تعطيل 'عرض كل العناصر'."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chytré filtry fungují jen když je vypnuté ‚Zobrazit všechny položky‘."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Smarte filtre virker kun, når 'Vis alle elementer' er deaktiveret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelligente Filter funktionieren nur, wenn \"Alle Elemente anzeigen\" deaktiviert ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα έξυπνα φίλτρα λειτουργούν μόνο όταν η «Εμφάνιση όλων των στοιχείων» είναι απενεργοποιημένη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Filters only works when 'Show All Items' is disabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los filtros inteligentes solo funcionan cuando 'Mostrar todos los elementos' está desactivado."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los filtros inteligentes solo funcionan cuando \"Mostrar todos los elementos\" está desactivado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Älykkäät suodattimet toimivat vain, kun 'Näytä kaikki kohteet' on pois päältä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les filtres intelligents fonctionnent seulement quand \"Afficher tous les éléments\" est désactivé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסננים חכמים עובדים רק כש'הצג את כל הפריטים' כבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट फ़िल्टर केवल 'सभी आइटम दिखाएँ' बंद होने पर काम करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pametni filtri rade samo kad je onemogućeno „Prikaži sve stavke”."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az okos szűrők csak akkor működnek, ha az „Összes elem megjelenítése” ki van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter pintar hanya bekerja saat 'Tampilkan semua item' nonaktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Filtri Intelligenti funzionano solo quando 'Mostra tutti gli elementi' è disabilitato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフィルターは「すべての項目を表示」が無効の場合のみ機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스마트 필터는 '모든 항목 표시'가 비활성화된 경우에만 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penapis pintar hanya berfungsi apabila 'Tunjuk semua item' dimatikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Smarte filtre fungerer bare når 'Vis alle elementer' er deaktivert."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slimme filters werken alleen wanneer 'Alle items tonen' is uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inteligentne filtry działają tylko, gdy wyłączone jest „Pokaż wszystkie pozycje”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Filtros Inteligentes só funcionam quando 'Mostrar Todos os Itens' está desativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrele inteligente funcționează doar când „Afișează toate elementele” e dezactivat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Умные фильтры работают только когда отключено «Показать все элементы»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Inteligentné filtre fungujú iba vtedy, keď je vypnutá možnosť Zobraziť všetky položky."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Smarta filter fungerar bara när 'Visa alla objekt' är inaktiverat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akıllı Filtreler yalnızca 'Tüm Öğeleri Göster' kapalıyken çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розумні фільтри працюють лише коли вимкнено «Показати всі елементи»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能筛选仅在“显示所有项目”关闭时可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧篩選僅在「顯示所有項目」關閉時可用。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els filtres intel·ligents només funcionen quan «Mostra tots els elements» està desactivat."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જ્યારે 'બધી વસ્તુઓ બતાવો' અક્ષમ હોય ત્યારે જ સ્માર્ટ ફિલ્ટર્સ કામ કરે છે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मार्ट फिल्टर फक्त 'सर्व आयटम दाखवा' अक्षम केलेले असतानाच कार्य करते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍ମାର୍ଟ ଫିଲ୍ଟର୍ କେବଳ କାର୍ଯ୍ୟ କରେ ଯେତେବେଳେ 'ସମସ୍ତ ଆଇଟମ୍ ଦେଖାନ୍ତୁ' ଅକ୍ଷମ ହୋଇଥାଏ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Filtros Inteligentes só funcionam quando 'Mostrar Todos os Itens' está desativado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਮਾਰਟ ਫਿਲਟਰ ਸਿਰਫ਼ ਉਦੋਂ ਕੰਮ ਕਰਦੇ ਹਨ ਜਦੋਂ 'ਸਾਰੀਆਂ ਆਈਟਮਾਂ ਦਿਖਾਓ' ਅਯੋਗ ਹੋਵੇ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pametni filtri delujejo le, ko je »Prikaži vse« onemogočeno."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "'എല്ലാ ഇനങ്ങളും കാണിക്കുക' പ്രവർത്തനരഹിതമാക്കുമ്പോൾ മാത്രമേ സ്മാർട്ട് ഫിൽട്ടറുകൾ പ്രവർത്തിക്കൂ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวกรองอัจฉริยะจะทำงานเฉพาะเมื่อปิดใช้งาน 'แสดงรายการทั้งหมด' เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ lọc thông minh chỉ hoạt động khi 'Hiển thị tất cả các mục' bị tắt."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্মার্ট ফিল্টার শুধুমাত্র তখনই কাজ করে যখন 'সমস্ত আইটেম দেখান' বিকল্পটি নিষ্ক্রিয় থাকে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "'ಎಲ್ಲ ಐಟಂಗಳನ್ನು ತೋರಿಸು' ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದಾಗ ಮಾತ್ರ ಸ್ಮಾರ್ಟ್ ಫಿಲ್ಟರ್‌ಗಳು ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "'அனைத்து உருப்படிகளையும் காட்டு' முடக்கப்பட்டிருக்கும்போது மட்டுமே ஸ்மார்ட் வடிப்பான்கள் செயல்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "'షో ఆల్ ఐటమ్స్' డిసేబుల్ చేసినప్పుడు మాత్రమే స్మార్ట్ ఫిల్టర్లు పనిచేస్తాయి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمارٹ فلٹرز صرف اس وقت کام کرتے ہیں جب 'تمام آئٹمز دکھائیں' غیر فعال ہو۔"
          }
        }
      }
    },
