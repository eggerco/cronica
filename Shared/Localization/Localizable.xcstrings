            "value": "سيفتح موقع TMDb مع روابط كل خدمة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře se web TMDb s odkazy na jednotlivé služby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette åbner TMDb-webstedet med links til hver tjeneste."
          }
        },
