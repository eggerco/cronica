          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan markere denne episoden som sett etter at den er sendt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze aflevering als bekeken markeren nadat deze is uitgezonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po emisji możesz oznaczyć ten odcinek jako obejrzany."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După difuzare poți marca episodul ca vizionat."
