    "To add an item on a list, create a new one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Titel zu einer Liste hinzuzufügen, erstelle eine neue."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add an item on a list, create a new one."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para agregar un elemento a una lista, crea una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter un élément à une liste, crée-en une nouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere un elemento a una lista, crea una nuova lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar um item a uma lista, crie uma nova."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chceš pridať položku do zoznamu, vytvor nový."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة عنصر إلى قائمة، أنشئ قائمة جديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chceš-li přidat položku do seznamu, vytvoř nový."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at tilføje et element til en liste skal du oprette en ny."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να προσθέσετε στοιχείο σε λίστα, δημιουργήστε μια νέα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir un elemento a una lista, crea una nueva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisätäksesi kohteen listalle, luo uusi lista."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להוסיף פריט לרשימה, צור רשימה חדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची में आइटम जोड़ने के लिए, नई सूची बनाएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dodavanje stavke na popis, stvori novi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Elem hozzáadásához listához hozzon létre egy újat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah item ke daftar, buat daftar baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストに項目を追加するには、新しいリストを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 항목을 추가하려면 새 목록을 만드세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambah item ke senarai, cipta senarai baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å legge til et element i en liste, opprett en ny."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een nieuwe lijst om een item toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby dodać pozycję do listy, utwórz nową."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a adăuga un element pe o listă, creează una nouă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить элемент в список, создай новый."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att lägga till ett objekt i en lista, skapa en ny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listeye öğe eklemek için yeni bir liste oluştur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб додати елемент до списку, створи новий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要向列表添加项目，请先创建一个新列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要向列表加入項目，請先建立一個新列表。"
          }
        }
      }
    },
    "To avoid potential spoilers, you can hide thumbnails from unwatched episodes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mögliche Spoiler zu vermeiden, kannst du Miniaturansichten von nicht gesehenen Episoden ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To avoid potential spoilers, you can hide thumbnails from unwatched episodes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar posibles spoilers, puedes ocultar las miniaturas de los episodios no vistos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter les spoilers potentiels, vous pouvez masquer les vignettes des épisodes non regardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per evitare possibili spoiler, puoi nascondere l'anteprima dagli episodi non visti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar possíveis spoilers, você pode ocultar miniaturas de episódios não assistidos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vyhnutie sa potenciálnym spoilerom, môžeš skryť miniatúry z nepozretých epizód."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتجنب الحرق، يمكنك إخفاء صور الحلقات غير المشاهدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abys se vyhnul/a spoilerům, můžeš skrýt náhledy u nezhlédnutých epizod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at undgå potentielle spoilers kan du skjule miniaturebilleder fra usete afsnit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να αποφύγετε πιθανά spoilers, μπορείτε να κρύψετε μικρογραφίες από μη παρακολουθημένα επεισόδια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar posibles spoilers, puedes ocultar las miniaturas de los episodios no vistos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välttääksesi spoilerit voit piilottaa pikkukuvat katsomattomista jaksoista."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להימנע מספoilers, אפשר להסתיר תמונות מפרקים שלא נצפו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पoiler से बचने के लिए, न देखे एपिसोड के थंबनेल छिपा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da izbjegneš spoilere, možeš sakriti sličice nepogledanih epizoda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az esetleges spoilerek elkerülése érdekében elrejtheti a bélyegképeket a nem megtekintett epizódoknál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk hindari spoiler, kamu bisa sembunyikan thumbnail episode belum ditonton."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネタバレを避けるため、未視聴エピソードのサムネイルを非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스포일러를 피하려면 시청하지 않은 에피소드의 썸네일을 숨길 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk elak spoiler, anda boleh sembunyikan imej kecil episod belum ditonton."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å unngå potensielle spoilers kan du skjule miniatyrbilder fra usette episoder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om spoilers te vermijden kun je miniaturen van onbekeken afleveringen verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uniknąć spoilerów, możesz ukryć miniatury nieobejrzanych odcinków."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a evita spoilerele, poți ascunde miniaturile episoadelor nevizionate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы избежать спойлеров, можно скрыть миниатюры непросмотренных эпизодов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att undvika potentiella spoilers kan du dölja miniatyrer från osedda avsnitt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoiler'dan kaçınmak için izlenmemiş bölümlerin küçük resimlerini gizleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб уникнути спойлерів, можна приховати мініатюри непереглянутих епізодів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免潜在剧透，你可以隐藏未观看剧集的缩略图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為避免潛在劇透，你可以隱藏未觀看集數的縮圖。"
          }
        }
      }
    },
    "To avoid potential spoilers, you can hide titles and synopsis from unwatched episodes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mögliche Spoiler zu vermeiden, kannst du Titel und Zusammenfassung von nicht gesehenen Episoden ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To avoid potential spoilers, you can hide titles and synopsis from unwatched episodes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar posibles spoilers, puedes ocultar títulos y sinopsis de episodios no vistos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter les spoilers potentiels, vous pouvez masquer les titres et les synopsis des épisodes non regardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per evitare possibili spoiler, puoi nascondere i titoli e le sinossi dagli episodi non visti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar possíveis spoilers, você pode ocultar títulos e sinopse de episódios não assistidos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vyhnutie sa možným spoilerom, môžeš skryť názvy a prehľady z nepozretých epizód."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتجنب الحرق، يمكنك إخفاء العناوين والملخص من الحلقات غير المشاهدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Abys se vyhnul/a spoilerům, můžeš skrýt názvy a synopsi u nezhlédnutých epizod."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at undgå potentielle spoilers kan du skjule titler og synopsis fra usete afsnit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να αποφύγετε πιθανά spoilers, μπορείτε να κρύψετε τίτλους και σύνοψη από μη παρακολουθημένα επεισόδια."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar posibles spoilers, puedes ocultar títulos y sinopsis de los episodios no vistos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välttääksesi spoilerit voit piilottaa otsikot ja tiivistelmät katsomattomista jaksoista."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להימנע מספoilers, אפשר להסתיר כותרות ותקציר מפרקים שלא נצפו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पoiler से बचने के लिए, न देखे एपिसोड के शीर्षक और सार छिपा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da izbjegneš spoilere, možeš sakriti naslove i sažetke nepogledanih epizoda."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az esetleges spoilerek elkerülése érdekében elrejtheti a címeket és az összefoglalót a nem megtekintett epizódoknál."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk hindari spoiler, kamu bisa sembunyikan judul dan sinopsis episode belum ditonton."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネタバレを避けるため、未視聴エピソードのタイトルとあらすじを非表示にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스포일러를 피하려면 시청하지 않은 에피소드의 제목과 시놉시스를 숨길 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk elak spoiler, anda boleh sembunyikan tajuk dan sinopsis episod belum ditonton."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å unngå potensielle spoilers kan du skjule titler og synopsis fra usette episoder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om spoilers te vermijden kun je titels en synopsis van onbekeken afleveringen verbergen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby uniknąć spoilerów, możesz ukryć tytuły i streszczenia nieobejrzanych odcinków."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a evita spoilerele, poți ascunde titlurile și sinopsisul episoadelor nevizionate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы избежать спойлеров, можно скрыть названия и описания непросмотренных эпизодов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att undvika potentiella spoilers kan du dölja titlar och synopsis från osedda avsnitt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoiler'dan kaçınmak için izlenmemiş bölümlerin başlık ve özetini gizleyebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб уникнути спойлерів, можна приховати назви та синопсис непереглянутих епізодів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为避免潜在剧透，你可以隐藏未观看剧集的标题和简介。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為避免潛在劇透，你可以隱藏未觀看集數的標題和簡介。"
          }
        }
      }
    },
