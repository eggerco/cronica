    "Sync checks SIMKL for changes since your last pull. Full re-import downloads your entire library again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحقق المزامنة من تغييرات SIMKL منذ آخر جلب. تعيد الاستيراد الكامل تنزيل مكتبتك بالكامل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace zkontroluje změny na SIMKL od posledního stažení. Úplný reimport znovu stáhne celou knihovnu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync tjekker SIMKL for ændringer siden sidste hentning. Fuld genimport henter hele biblioteket igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync prüft SIMKL auf Änderungen seit dem letzten Abruf. Vollständiger Neuimport lädt die gesamte Bibliothek erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός ελέγχει αλλαγές στο SIMKL από την τελευταία ενημέρωση. Η πλήρης επανεισαγωγή ξανακατεβάζει ολόκληρη τη βιβλιοθήκη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync checks SIMKL for changes since your last pull. Full re-import downloads your entire library again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización comprueba cambios en SIMKL desde la última descarga. La reimportación completa vuelve a descargar toda la biblioteca."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización comprueba cambios en SIMKL desde la última descarga. La reimportación completa vuelve a descargar toda la biblioteca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi tarkistaa SIMKL-muutokset viimeisen noudon jälkeen. Täysi uudelleentuonti lataa koko kirjaston uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sync vérifie les changements SIMKL depuis le dernier tirage. Le réimport complet retélécharge toute la bibliothèque."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסנכרון בודק שינויים ב‑SIMKL מאז המשיכה האחרונה. ייבוא מחדש מלא מוריד שוב את כל הספרייה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिंक आपके पिछले पुल के बाद से SIMKL में बदलाव जाँचता है। पूर्ण पुनः आयात पूरी लाइब्रेरी फिर से डाउनलोड करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronizacija provjerava promjene na SIMKL-u od zadnjeg povlačenja. Potpuni uvoz ponovno preuzima cijelu biblioteku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szinkron ellenőrzi a SIMKL változásait az utolsó letöltés óta. A teljes újraimport újra letölti a teljes könyvtárat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkron memeriksa perubahan SIMKL sejak tarikan terakhir. Impor ulang penuh mengunduh seluruh pustaka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sync controlla le modifiche SIMKL dall’ultimo aggiornamento. Il reimport completo riscarica l’intera libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は前回の取得以降のSIMKLの変更を確認します。完全な再インポートはライブラリ全体を再ダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화는 마지막 가져오기 이후 SIMKL 변경을 확인합니다. 전체 재가져오기는 라이브러리 전체를 다시 다운로드합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segerak menyemak perubahan SIMKL sejak tarikan terakhir. Import semula penuh memuat turun keseluruhan pustaka sekali lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synk sjekker SIMKL for endringer siden siste henting. Full reimport laster ned hele biblioteket på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync controleert SIMKL op wijzigingen sinds de laatste pull. Volledige herimport downloadt je hele bibliotheek opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja sprawdza zmiany w SIMKL od ostatniego pobrania. Pełny reimport ponownie pobiera całą bibliotekę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização verifica mudanças no SIMKL desde a última atualização. A reimportação completa baixa toda a biblioteca novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea verifică modificările SIMKL de la ultima actualizare. Reimportul complet descarcă din nou întreaga bibliotecă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация проверяет изменения в SIMKL с последней загрузки. Полный реимпорт снова скачивает всю библиотеку."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia skontroluje zmeny na SIMKL od posledného stiahnutia. Úplný reimport znova stiahne celú knižnicu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synk kontrollerar SIMKL efter ändringar sedan senaste hämtningen. Full ominport hämtar hela biblioteket igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkronizasyon, son çekimden beri SIMKL değişikliklerini kontrol eder. Tam yeniden içe aktarma kitaplığın tamamını yeniden indirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізація перевіряє зміни в SIMKL з останнього завантаження. Повний реімпорт знову завантажує всю бібліотеку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步会检查自上次拉取以来 SIMKL 的更改。完整重新导入会再次下载整个媒体库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步會檢查自上次擷取以來 SIMKL 的變更。完整重新匯入會再次下載整個媒體庫。"
          }
        }
      }
    },
