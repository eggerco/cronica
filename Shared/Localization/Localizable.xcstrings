    "Mark what you’ve watched and pick up right where you left off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere, was du gesehen hast, und mach genau dort weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark what you’ve watched and pick up right where you left off."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo visto y continúa donde lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez ce que vous avez vu et reprenez où vous en étiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna ciò che hai visto e riprendi da dove avevi interrotto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que assistiu e continue de onde parou."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označ, čo si pozrel, a pokračuj presne tam, kde si skončil."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ما شاهدته وتابع من حيث توقفت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označuj, co jsi viděl/a, a pokračuj přesně tam, kde jsi skončil/a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér, hvad du har set, og fortsæt, hvor du slap."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε τι έχετε παρακολουθήσει και συνεχίστε από εκεί που σταματήσατε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo que has visto y retoma justo donde lo dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse katsomasi ja jatka siitä, mihin jäit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן מה צפית והמשך בדיוק מהמקום שעצרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो देखा है उसे चिह्नित करें और वहीं से जारी रखें जहाँ छोड़ा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označuj što si gledao i nastavi točno gdje si stao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg, amit megtekintett, és folytassa ott, ahol abbahagyta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai yang sudah ditonton dan lanjutkan dari tempat terakhir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴した作品を記録して、中断したところから再開しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청한 작품을 기록하고 중단한 곳에서 이어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan apa yang ditonton dan sambung dari tempat anda berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker det du har sett, og fortsett der du slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer wat je hebt bekeken en ga verder waar je was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczaj obejrzane tytuły i wracaj dokładnie tam, gdzie skończyłeś."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează ce ai vizionat și continuă de unde ai rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечай просмотренное и продолжай с того места, где остановился."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera vad du har sett och fortsätt där du slutade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediklerini işaretle ve kaldığın yerden devam et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначай переглянуте й продовжуй саме там, де зупинився."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你看过的内容，并从上次中断的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄你看過的內容，並從上次中斷的地方繼續。"
          }
        }
      }
    },
    "Marking this series as unwatched can clear watched episodes. Choose whether to reset progress or keep it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du diese Serie als ungesehen markierst, können gesehene Episoden gelöscht werden. Fortschritt zurücksetzen oder behalten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marking this series as unwatched can clear watched episodes. Choose whether to reset progress or keep it."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar esta serie como no vista puede borrar los episodios vistos. Elige si restablecer el progreso o conservarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquer cette série comme non vue peut effacer les épisodes vus. Choisissez de réinitialiser ou de conserver la progression."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnare questa serie come non vista può cancellare gli episodi visti. Scegli se reimpostare o mantenere i progressi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar esta série como não assistida pode limpar os episódios assistidos. Escolha redefinir o progresso ou mantê-lo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označenie série ako nepozeranej môže vymazať pozreté epizódy. Vyberte, či postup obnoviť alebo ponechať."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد هذا المسلسل كغير مشاهد قد يمسح الحلقات المشاهدة. اختر إعادة تعيين التقدم أو الاحتفاظ به."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označení tohoto seriálu jako nezhlédnutého může vymazat zhlédnuté epizody. Vyber, zda resetovat průběh nebo ho zachovat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du markerer denne serie som uset, kan sete afsnit ryddes. Vælg, om du vil nulstille fremskridt eller beholde det."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σήμανση αυτής της σειράς ως μη παρακολουθημένης μπορεί να διαγράψει τα παρακολουθημένα επεισόδια. Επιλέξτε αν θα επαναφέρετε την πρόοδο ή θα τη διατηρήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcar esta serie como no vista puede borrar los episodios vistos. Elige si restablecer el progreso o conservarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämän sarjan merkitseminen katsomattomaksi voi tyhjentää katsotut jaksot. Valitse, nollataanko edistyminen vai säilytetäänkö se."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סימון סדרה זו כלא נצפתה עלול לנקות פרקים שנצפו. בחר אם לאפס התקדמות או לשמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस श्रृंखला को न देखा चिह्नित करने से देखे गए एपिसोड साफ़ हो सकते हैं। प्रगति रीसेट करें या रखें, चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označavanje ove serije kao nepogledane može očistiti pogledane epizode. Odaberi hoće li se resetirati napredak ili zadržati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ezt a sorozatot nem megtekintettként jelöli, törlődhetnek a megtekintett epizódok. Válassza ki, hogy visszaállítja-e az előrehaladást vagy megtartja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandai serial ini belum ditonton dapat menghapus episode yang ditonton. Pilih reset progres atau pertahankan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシリーズを未視聴にすると、視聴済みエピソードがクリアされる場合があります。進捗をリセットするか保持するかを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시리즈를 시청하지 않음으로 표시하면 시청한 에피소드가 지워질 수 있습니다. 진행을 초기화할지 유지할지 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menandakan siri ini belum ditonton boleh kosongkan episod ditonton. Pilih set semula kemajuan atau kekalkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du markerer denne serien som usett, kan sette episoder slettes. Velg om du vil tilbakestille fremdrift eller beholde den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je deze serie als onbekeken markeert, kunnen bekeken afleveringen worden gewist. Kies of je de voortgang wilt resetten of behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczenie tego serialu jako nieobejranego może wyczyścić obejrzane odcinki. Wybierz, czy zresetować postęp, czy go zachować."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcarea serialului ca nevizionat poate șterge episoadele vizionate. Alege dacă resetezi progresul sau îl păstrezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметка сериала как непросмотренного может очистить просмотренные эпизоды. Выбери, сбросить прогресс или сохранить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du markerar den här serien som osedd kan sedda avsnitt rensas. Välj om du vill återställa framsteg eller behålla det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu diziyi izlenmedi işaretlemek izlenen bölümleri silebilir. İlerlemeyi sıfırlamayı veya korumayı seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначення серіалу як непереглянутого може очистити переглянуті епізоди. Обери, скинути прогрес чи зберегти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此剧集标记为未观看可能会清除已观看记录。请选择重置进度或保留进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此影集標記為未觀看可能會清除已觀看記錄。請選擇重設進度或保留進度。"
          }
        }
      }
    },
