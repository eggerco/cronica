          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Pikakomennot-sovellus selataksesi Cronican toimintoja ja lisätäksesi ne Siriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
