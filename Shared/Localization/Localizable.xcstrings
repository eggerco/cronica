    "Please, open the app of the service on your Apple TV to watch this content.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte öffnen Sie die App des Dienstes auf Ihrem Apple TV, um diesen Inhalt anzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, open the app of the service on your Apple TV to watch this content."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, abre la aplicación del servicio en tu Apple TV para ver este contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez ouvrir l'application du service sur votre Apple TV pour regarder ce contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, apri l'app del servizio sulla tua Apple TV per vedere questo contenuto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, abra o aplicativo do serviço na sua Apple TV para assistir a este conteúdo."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete sledovať tento obsah, otvorte si aplikáciu služby na Apple TV."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى فتح تطبيق الخدمة على Apple TV لمشاهدة هذا المحتوى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevři prosím aplikaci služby na Apple TV, abys mohl/a sledovat tento obsah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn venligst tjenestens app på dit Apple TV for at se dette indhold."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε την εφαρμογή της υπηρεσίας στο Apple TV σας για να παρακολουθήσετε αυτό το περιεχόμενο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app del servicio en tu Apple TV para ver este contenido."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa palvelun sovellus Apple TV:lläsi katsoaksesi tämän sisällön."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את אפליקציית השירות ב-Apple TV כדי לצפות בתוכן זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सामग्री देखने के लिए Apple TV पर सेवा का ऐप खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori aplikaciju usluge na Apple TV-u za gledanje ovog sadržaja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, nyissa meg a szolgáltatás alkalmazását Apple TV-jén a tartalom megtekintéséhez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi layanan di Apple TV untuk menonton konten ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツを視聴するには、Apple TVでサービスのアプリを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠를 시청하려면 Apple TV에서 서비스 앱을 열어주세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka aplikasi perkhidmatan pada Apple TV untuk menonton kandungan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst åpne tjenestens app på Apple TV-en din for å se dette innholdet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app van de dienst op je Apple TV om deze content te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz aplikację usługi na Apple TV, aby obejrzeć tę treść."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide aplicația serviciului pe Apple TV pentru a viziona acest conținut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открой приложение сервиса на Apple TV, чтобы смотреть этот контент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna tjänstens app på din Apple TV för att titta på det här innehållet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu içeriği izlemek için Apple TV'de hizmet uygulamasını aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрий застосунок сервісу на Apple TV, щоб дивитися цей контент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Apple TV 上打开相应服务的 App 来观看此内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Apple TV 上開啟相應服務的 App 來觀看此內容。"
          }
        }
      }
    },
    "Please, use the iPhone app to create new lists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte verwenden Sie die iPhone-App, um neue Listen zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please, use the iPhone app to create new lists."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, utilice la aplicación de iPhone para crear nuevas listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez utiliser l'application iPhone pour créer de nouvelles listes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, usa l'app su iPhone per creare nuove liste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, use o aplicativo para iPhone para criar novas listas."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vytvorenie nových zoznamov použite aplikáciu pre iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى استخدام تطبيق iPhone لإنشاء قوائم جديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro vytvoření nových seznamů použij aplikaci na iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug venligst iPhone-appen til at oprette nye lister."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε την εφαρμογή iPhone για να δημιουργήσετε νέες λίστες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la app de iPhone para crear nuevas listas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä iPhone-sovellusta uusien listojen luomiseen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש באפליקציית iPhone כדי ליצור רשימות חדשות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नई सूचियाँ बनाने के लिए iPhone ऐप का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi iPhone aplikaciju za stvaranje novih popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérjük, használja az iPhone-alkalmazást új listák létrehozásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan aplikasi iPhone untuk membuat daftar baru."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいリストを作成するには、iPhoneアプリを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 목록을 만들려면 iPhone 앱을 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Guna aplikasi iPhone untuk mencipta senarai baharu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk iPhone-appen for å opprette nye lister."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de iPhone-app om nieuwe lijsten te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj aplikacji na iPhone, aby utworzyć nowe listy."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește aplicația de pe iPhone pentru a crea liste noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используй приложение на iPhone для создания новых списков."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd iPhone-appen för att skapa nya listor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni listeler oluşturmak için iPhone uygulamasını kullan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуй застосунок на iPhone для створення нових списків."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用 iPhone App 创建新列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用 iPhone App 建立新列表。"
          }
        }
      }
