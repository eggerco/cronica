    "Start watching to get recommendations...": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit dem Ansehen, um Empfehlungen zu erhalten …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start watching to get recommendations..."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a mirar para obtener recomendaciones..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à regarder pour obtenir des recommandations..."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a guardare per ricevere consigli..."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a assistir para obter recomendações..."
          }
        },
        "sk": {
          "stringUnit": {
