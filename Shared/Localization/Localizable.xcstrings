    "Mark what you’ve watched and pick up right where you left off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ما شاهدته وتابع من حيث توقفت."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označuj, co jsi viděl/a, a pokračuj přesně tam, kde jsi skončil/a."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér, hvad du har set, og fortsæt, hvor du slap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere, was du gesehen hast, und mach genau dort weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σημειώστε τι έχετε παρακολουθήσει και συνεχίστε από εκεί που σταματήσατε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark what you’ve watched and pick up right where you left off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo que has visto y retoma justo donde lo dejaste."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo visto y continúa donde lo dejaste."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse katsomasi ja jatka siitä, mihin jäit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez ce que vous avez vu et reprenez où vous en étiez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן מה צפית והמשך בדיוק מהמקום שעצרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो देखा है उसे चिह्नित करें और वहीं से जारी रखें जहाँ छोड़ा था।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označuj što si gledao i nastavi točno gdje si stao."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg, amit megtekintett, és folytassa ott, ahol abbahagyta."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai yang sudah ditonton dan lanjutkan dari tempat terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna ciò che hai visto e riprendi da dove avevi interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴した作品を記録して、中断したところから再開しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청한 작품을 기록하고 중단한 곳에서 이어 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandakan apa yang ditonton dan sambung dari tempat anda berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker det du har sett, og fortsett der du slapp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer wat je hebt bekeken en ga verder waar je was gebleven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczaj obejrzane tytuły i wracaj dokładnie tam, gdzie skończyłeś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que assistiu e continue de onde parou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marchează ce ai vizionat și continuă de unde ai rămas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечай просмотренное и продолжай с того места, где остановился."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označ, čo si pozrel, a pokračuj presne tam, kde si skončil."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera vad du har sett och fortsätt där du slutade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediklerini işaretle ve kaldığın yerden devam et."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначай переглянуте й продовжуй саме там, де зупинився."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你看过的内容，并从上次中断的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄你看過的內容，並從上次中斷的地方繼續。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা দেখেছেন তা চিহ্নিত করুন এবং আপনি যেখান থেকে ছেড়েছিলেন সেখান থেকে শুরু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca el que has vist i continua just on ho vas deixar."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે જોયું છે તેને ચિહ્નિત કરો અને તમે જ્યાંથી છોડ્યું હતું ત્યાંથી જ પસંદ કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जे पाहिले ते चिन्हांकित करा आणि तुम्ही जेथून सोडले होते तेथून उचला."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଯାହା ଦେଖିଛନ୍ତି ତାହା ଚିହ୍ନଟ କରନ୍ତୁ ଏବଂ ଆପଣ ଯେଉଁଠାରେ ଛାଡିଛନ୍ତି ଠିକ୍ ସେହି ସ୍ଥାନକୁ ଉଠାନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque o que assistiu e continue de onde parou."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਜੋ ਦੇਖਿਆ ਹੈ ਉਸ 'ਤੇ ਨਿਸ਼ਾਨ ਲਗਾਓ ਅਤੇ ਉਥੋਂ ਹੀ ਸ਼ੁਰੂ ਕਰੋ ਜਿੱਥੇ ਤੁਸੀਂ ਛੱਡਿਆ ਸੀ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi, kar si videl, in nadaljuj tam, kjer si končal."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ കണ്ടത് അടയാളപ്പെടുത്തുക, നിങ്ങൾ നിർത്തിയിടത്ത് നിന്ന് എടുക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำเครื่องหมายสิ่งที่คุณได้ดูและดำเนินการต่อจากจุดที่คุณค้างไว้"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے جو دیکھا ہے اسے نشان زد کریں اور وہیں سے اٹھائیں جہاں سے آپ نے چھوڑا تھا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu những gì bạn đã xem và tiếp tục ngay từ nơi bạn đã dừng lại."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ವೀಕ್ಷಿಸಿದ್ದನ್ನು ಗುರುತಿಸಿ ಮತ್ತು ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದಲೇ ಮುಂದುವರಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பார்த்தவற்றைக் குறித்து வைத்துக்கொண்டு, விட்ட இடத்திலிருந்தே மீண்டும் தொடருங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు చూసినదాన్ని గుర్తుపెట్టుకుని, ఎక్కడ ఆపారో అక్కడి నుండే మళ్ళీ చూడటం కొనసాగించండి."
          }
        }
      }
    },
    "Mark your next episode as watched in Cronica.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم حلقتك التالية كمشاهَدة في Cronica."
