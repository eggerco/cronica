            "value": "Aby uniknąć spoilerów, możesz ukryć tytuły i streszczenia nieobejrzanych odcinków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar possíveis spoilers, você pode ocultar títulos e sinopse de episódios não assistidos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a evita spoilerele, poți ascunde titlurile și sinopsisul episoadelor nevizionate."
          }
