    "Events are saved to a dedicated Cronica calendar in the Calendar app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ الأحداث في تقويم Cronica مخصص في تطبيق التقويم."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Události se ukládají do vyhrazeného kalendáře Cronica v aplikaci Kalendář."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begivenheder gemmes i en dedikeret Cronica-kalender i Kalender-appen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine werden in einem eigenen Cronica-Kalender in der Kalender-App gespeichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα συμβάντα αποθηκεύονται σε ειδικό ημερολόγιο Cronica στην εφαρμογή Ημερολόγιο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events are saved to a dedicated Cronica calendar in the Calendar app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos se guardan en un calendario dedicado de Cronica en la app Calendario."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos se guardan en un calendario Cronica dedicado en la app Calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumat tallennetaan erilliseen Cronica-kalenteriin Kalenteri-sovelluksessa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements sont enregistrés dans un calendrier Cronica dédié dans l’app Calendrier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירועים נשמרים בלוח שנה ייעודי של Cronica באפליקציית היומן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इवेंट Calendar ऐप में समर्पित Cronica कैलेंडर में सहेजे जाते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Događaji se spremaju u namjenski Cronica kalendar u aplikaciji Kalendar."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az események egy dedikált Cronica-naptárba kerülnek a Naptár alkalmazásban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara disimpan ke kalender Cronica khusus di aplikasi Kalender."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi vengono salvati in un calendario Cronica dedicato nell’app Calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントはカレンダーアプリの専用Cronicaカレンダーに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트는 캘린더 앱의 전용 Cronica 캘린더에 저장됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara disimpan ke kalendar Cronica khusus dalam aplikasi Kalendar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hendelser lagres i en dedikert Cronica-kalender i Kalender-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebeurtenissen worden opgeslagen in een aparte Cronica-agenda in de app Agenda."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia są zapisywane w dedykowanym kalendarzu Cronica w aplikacji Kalendarz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos são salvos em um calendário Cronica dedicado no app Calendário."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Evenimentele se salvează într-un calendar Cronica dedicat în aplicația Calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "События сохраняются в отдельный календарь Cronica в приложении Календарь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Udalosti sa uložia do samostatného kalendára Cronica v aplikácii Kalendár."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Händelser sparas i en dedikerad Cronica-kalender i appen Kalender."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlikler Takvim uygulamasında özel bir Cronica takvimine kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події зберігаються в окремий календар Cronica в застосунку Календар."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动将保存到“日历”App 中的 Cronica 专属日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活動將儲存到「日曆」App 中的 Cronica 專屬日曆。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইভেন্টগুলি ক্যালেন্ডার অ্যাপে একটি ডেডিকেটেড Cronica ক্যালেন্ডারে সংরক্ষিত হয়৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els esdeveniments es desen en un calendari dedicat de Cronica a l’app Calendari."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇવેન્ટ્સ કૅલેન્ડર ઍપમાં સમર્પિત Cronica કૅલેન્ડરમાં સાચવવામાં આવે છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕ್ಯಾಲೆಂಡರ್ ಅಪ್ಲಿಕೇಶನ್‌ನಲ್ಲಿ ಮೀಸಲಾದ Cronica ಕ್ಯಾಲೆಂಡರ್‌ಗೆ ಈವೆಂಟ್‌ಗಳನ್ನು ಉಳಿಸಲಾಗಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇവൻ്റുകൾ കലണ്ടർ ആപ്പിലെ ഒരു സമർപ്പിത Cronica കലണ്ടറിലേക്ക് സംരക്ഷിച്ചിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कॅलेंडर ॲपमध्ये इव्हेंट समर्पित Cronica कॅलेंडरमध्ये सेव्ह केले जातात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଇଭେଣ୍ଟଗୁଡିକ କ୍ୟାଲେଣ୍ଡର ଆପରେ ଏକ ଉତ୍ସର୍ଗୀକୃତ Cronica କ୍ୟାଲେଣ୍ଡରରେ ସେଭ୍ ହୋଇଛି |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos são salvos em um calendário Cronica dedicado no app Calendário."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਵੈਂਟਾਂ ਨੂੰ ਕੈਲੰਡਰ ਐਪ ਵਿੱਚ ਇੱਕ ਸਮਰਪਿਤ Cronica ਕੈਲੰਡਰ ਵਿੱਚ ਸੁਰੱਖਿਅਤ ਕੀਤਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dogodki se shranijo v namenski koledar Cronica v aplikaciji Koledar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கேலெண்டர் பயன்பாட்டில் உள்ள பிரத்யேக Cronica காலெண்டரில் நிகழ்வுகள் சேமிக்கப்படும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈవెంట్‌లు క్యాలెండర్ యాప్‌లోని ప్రత్యేక Cronica క్యాలెండర్‌లో సేవ్ చేయబడతాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กิจกรรมจะถูกบันทึกลงในปฏิทิน Cronica เฉพาะในแอปปฏิทิน"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایونٹس کو کیلنڈر ایپ میں ایک سرشار Cronica کیلنڈر میں محفوظ کیا جاتا ہے ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các sự kiện được lưu vào lịch Cronica chuyên dụng trong ứng dụng Lịch."
          }
        }
      }
    },
