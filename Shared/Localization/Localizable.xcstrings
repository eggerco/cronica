    "There isn't an upcoming release or episode date for this title.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد تاريخ إصدار أو حلقة قادم لهذا العنوان."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tento titul není nadcházející datum vydání ani epizody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen kommende udgivelses- eller episodedato for denne titel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Titel gibt es kein bevorstehendes Veröffentlichungs- oder Episodendatum."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει επερχόμενη ημερομηνία κυκλοφορίας ή επεισοδίου για αυτόν τον τίτλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't an upcoming release or episode date for this title."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una fecha próxima de estreno o episodio para este título."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fecha próxima de estreno o episodio para este título."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle nimelle ei ole tulevaa julkaisu- tai jaksopäivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas de date de sortie ou d’épisode à venir pour ce titre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין תאריך יציאה או פרק קרוב עבור כותרת זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शीर्षक के लिए कोई आगामी रिलीज़ या एपिसोड तिथि नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovaj naslov nema nadolazećeg datuma izdanja ili epizode."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a címhez nincs közelgő megjelenési vagy epizóddátum."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tanggal rilis atau episode mendatang untuk judul ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c’è una data di uscita o di episodio imminente per questo titolo."
          }
        },
        "ja": {
