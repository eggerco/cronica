    "To avoid potential spoilers, you can hide thumbnails from unwatched episodes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mögliche Spoiler zu vermeiden, kannst du Miniaturansichten von nicht gesehenen Episoden ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To avoid potential spoilers, you can hide thumbnails from unwatched episodes."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar posibles spoilers, puedes ocultar las miniaturas de los episodios no vistos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour éviter les spoilers potentiels, vous pouvez masquer les vignettes des épisodes non regardés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per evitare possibili spoiler, puoi nascondere l'anteprima dagli episodi non visti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para evitar possíveis spoilers, você pode ocultar miniaturas de episódios não assistidos."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vyhnutie sa potenciálnym spoilerom, môžeš skryť miniatúry z nepozretých epizód."
          }
        }
      }
    },
    "To avoid potential spoilers, you can hide titles and synopsis from unwatched episodes.": {
      "localizations": {
        "de": {
          "stringUnit": {
