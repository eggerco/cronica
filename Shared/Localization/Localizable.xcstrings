    "See what episodes are up next in Cronica.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلع على الحلقات التالية في Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podívejte se, které epizody jsou další v Cronica."
          }
        },
