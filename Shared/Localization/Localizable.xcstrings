    "Cronica can only show where the content is streaming, it cannot link you to the content page on the service's app right now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica kann nur anzeigen, wo der Inhalt gestreamt wird, es kann Sie derzeit nicht mit der Inhaltsseite in der App des Dienstes verknüpfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica can only show where the content is streaming, it cannot link you to the content page on the service's app right now."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica solo puede mostrar dónde se transmite el contenido, no puede vincularlo a la página de contenido en la aplicación del servicio en este momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ne peut qu'indiquer l'endroit où le contenu est diffusé, il ne peut pas vous lier à la page du contenu sur l'app du service pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica può solo mostrare dove il contenuto è trasmesso, non può indirizzarti attualmente alla pagina del contenuto nell'applicazione che lo trasmette."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cronica só pode mostrar onde o conteúdo está sendo transmitido, não pode vinculá-lo à página de conteúdo no aplicativo do serviço no momento."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dokáže zobraziť iba miesto, kde sa obsah streamuje, momentálne vás nedokáže prepojiť so stránkou obsahu v aplikácii služby."
          }
        }
      }
    },
    "Cronica does not use accounts. Your watchlist, ratings, notes, and preferences are stored on this device and, if enabled, in your private iCloud account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Cronica does not use accounts. Your watchlist, ratings, notes, and preferences are stored on this device and, if enabled, in your private iCloud account."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica does not use accounts. Your watchlist, ratings, notes, and preferences are stored on this device and, if enabled, in your private iCloud account."
