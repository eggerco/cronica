            "value" : "Marquez ce que vous avez vu et reprenez où vous en étiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna ciò che hai visto e riprendi da dove avevi interrotto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque o que assistiu e continue de onde parou."
          }
