          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiinnitetyt ja kesken olevat nimikkeet katselulistaltasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titres épinglés et en cours depuis ta liste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרות מוצמדות ובתהליך מרשימת הצפייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी वॉचलिस्ट से पिन और प्रगति में शीर्षक।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikvačeni i u tijeku naslovi s popisa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzített és folyamatban lévő címek a figyelőlistájáról."
          }
        },
        "id": {
          "stringUnit": {
