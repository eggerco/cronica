          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα επόμενο. Προσθέστε σειρές TV στο Cronica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a continuación. Añade series de TV en Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei seuraavaa. Lisää TV-sarjoja Cronicaan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין הבא. הוסף סדרות TV ב-Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगला कुछ नहीं। Cronica में TV शो जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa sljedeće. Dodaj serije u Cronica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs következő tartalom. Adjon hozzá TV-műsorokat a Cronicában."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada berikutnya. Tambahkan acara TV di Cronica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に見る作品がありません。CronicaでTV番組を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 시청 항목이 없습니다. Cronica에서 TV 프로그램을 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada seterusnya. Tambah rancangan TV dalam Cronica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting neste. Legg til TV-serier i Cronica."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets hierna. Voeg tv-series toe in Cronica."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic w następnych. Dodaj seriale w Cronica."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimic urmează. Adaugă seriale în Cronica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего далее. Добавь сериалы в Cronica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget nästa. Lägg till TV-serier i Cronica."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki'de bir şey yok. Cronica'ya TV dizileri ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого далі. Додай серіали в Cronica."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无接下来观看的内容。请在 Cronica 中添加剧集。"
