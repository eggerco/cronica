          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso abrirá o site do TMDb com os links para cada serviço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se va deschide site-ul TMDb cu linkuri către fiecare serviciu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется сайт TMDb со ссылками на каждый сервис."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
