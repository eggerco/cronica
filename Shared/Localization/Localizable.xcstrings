        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připoj volitelný účet SIMKL pro synchronizaci seznamu s Cronicou. CloudKit stále synchronizuje tvá zařízení Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
