    "Stats are computed live on SIMKL and are expensive. Cronica only loads them when you tap this button.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب الإحصائيات مباشرة على SIMKL وهي مكلفة. يحمّلها Cronica فقط عند النقر على هذا الزر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiky se počítají živě na SIMKL a jsou náročné. Cronica je načte jen po klepnutí na toto tlačítko."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik beregnes live på SIMKL og er dyrt. Cronica henter dem kun, når du trykker på denne knap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiken werden live auf SIMKL berechnet und sind aufwendig. Cronica lädt sie nur, wenn du diesen Button tippst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα στατιστικά υπολογίζονται ζωντανά στο SIMKL και είναι ακριβά. Το Cronica τα φορτώνει μόνο όταν πατήσετε αυτό το κουμπί."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stats are computed live on SIMKL and are expensive. Cronica only loads them when you tap this button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas se calculan en vivo en SIMKL y son costosas. Cronica solo las carga al pulsar este botón."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estadísticas se calculan en vivo en SIMKL y son costosas. Cronica solo las carga al tocar este botón."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilastot lasketaan livenä SIMKL:ssä ja ovat raskaita. Cronica lataa ne vain, kun napautat tätä painiketta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les stats sont calculées en direct sur SIMKL et sont coûteuses. Cronica ne les charge que lorsque vous appuyez sur ce bouton."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסטטיסטיקות מחושבות בזמן אמת ב‑SIMKL והן יקרות. Cronica טוען אותן רק כשאתה לוחץ על הכפתור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आँकड़े SIMKL पर लाइव गणना होते हैं और महंगे हैं। Cronica उन्हें केवल तब लोड करता है जब आप इस बटन पर टैप करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistike se računaju uživo na SIMKL-u i skupe su. Cronica ih učitava samo kad dodirneš ovaj gumb."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A statisztikákat élőben számolja a SIMKL, és költségesek. A Cronica csak akkor tölti be őket, ha megérinted ezt a gombot."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik dihitung langsung di SIMKL dan mahal. Cronica hanya memuatnya saat Anda mengetuk tombol ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statistiche sono calcolate in tempo reale su SIMKL e sono costose. Cronica le carica solo quando tocchi questo pulsante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統計はSIMKL上でライブ計算され、負荷が高いです。Cronicaはこのボタンをタップしたときだけ読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통계는 SIMKL에서 실시간으로 계산되며 비용이 큽니다. Cronica는 이 버튼을 탭할 때만 불러옵니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik dikira secara langsung di SIMKL dan mahal. Cronica hanya memuatkannya apabila anda ketik butang ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistikk beregnes live på SIMKL og er kostbart. Cronica laster dem bare når du trykker på denne knappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistieken worden live op SIMKL berekend en zijn zwaar. Cronica laadt ze alleen als je op deze knop tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statystyki są liczone na żywo w SIMKL i są kosztowne. Cronica ładuje je tylko po naciśnięciu tego przycisku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas são calculadas ao vivo no SIMKL e são custosas. O Cronica só as carrega quando você toca neste botão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Statisticile sunt calculate live pe SIMKL și sunt costisitoare. Cronica le încarcă doar când apeși acest buton."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика считается на SIMKL в реальном времени и затратна. Cronica загружает её только при нажатии этой кнопки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Štatistiky sa počítajú naživo na SIMKL a sú náročné. Cronica ich načíta len po klepnutí na toto tlačidlo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistik beräknas live på SIMKL och är kostsam. Cronica laddar dem bara när du trycker på den här knappen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstatistikler SIMKL’de canlı hesaplanır ve maliyetlidir. Cronica bunları yalnızca bu düğmeye dokunduğunuzda yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статистика обчислюється на SIMKL у реальному часі й є затратною. Cronica завантажує її лише після натискання цієї кнопки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计在 SIMKL 上实时计算，成本较高。只有点按此按钮时，Cronica 才会加载它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統計在 SIMKL 上即時計算，成本較高。只有點按此按鈕時，Cronica 才會載入它們。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estadístiques es calculen en directe a SIMKL i són costoses. Cronica només les carrega quan toques aquest botó."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL પર આંકડાઓની લાઇવ ગણતરી કરવામાં આવે છે અને તે ખર્ચાળ છે. જ્યારે તમે આ બટનને ટેપ કરો છો ત્યારે જ Cronica તેમને લોડ કરે છે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL वर आकडेवारीची थेट गणना केली जाते आणि ती महाग असते. तुम्ही हे बटण टॅप करता तेव्हाच Cronica त्यांना लोड करते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପରିସଂଖ୍ୟାନ SIMKL ରେ ଲାଇଭ୍ ଗଣନା କରାଯାଏ ଏବଂ ମହଙ୍ଗା ଅଟେ | ଯେତେବେଳେ ଆପଣ ଏହି ବଟନ୍ ଟ୍ୟାପ୍ କରନ୍ତି Cronica କେବଳ ସେଗୁଡ଼ିକୁ ଲୋଡ୍ କରେ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As estatísticas são calculadas ao vivo no SIMKL e são custosas. O Cronica só as carrega quando tu toca neste botão."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅੰਕੜੇ SIMKL 'ਤੇ ਲਾਈਵ ਗਣਨਾ ਕੀਤੇ ਜਾਂਦੇ ਹਨ ਅਤੇ ਮਹਿੰਗੇ ਹੁੰਦੇ ਹਨ। Cronica ਉਹਨਾਂ ਨੂੰ ਸਿਰਫ਼ ਉਦੋਂ ਲੋਡ ਕਰਦਾ ਹੈ ਜਦੋਂ ਤੁਸੀਂ ਇਸ ਬਟਨ ਨੂੰ ਟੈਪ ਕਰਦੇ ਹੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistika se izračuna v živo na SIMKL in je zahtevna. Cronica jo naloži šele, ko tapneš ta gumb."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ഥിതിവിവരക്കണക്കുകൾ SIMKL-ൽ തത്സമയം കണക്കാക്കുകയും ചെലവേറിയതുമാണ്. നിങ്ങൾ ഈ ബട്ടൺ ടാപ്പുചെയ്യുമ്പോൾ മാത്രമേ Cronica അവ ലോഡുചെയ്യുകയുള്ളൂ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สถิติคำนวณสดบน SIMKL และมีราคาแพง Cronica จะโหลดเมื่อคุณแตะปุ่มนี้เท่านั้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số liệu thống kê được tính toán trực tiếp trên SIMKL và rất tốn kém. Cronica chỉ tải chúng khi bạn nhấn vào nút này."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKL-এ পরিসংখ্যান সরাসরি গণনা করা হয় এবং এটি ব্যয়বহুল। আপনি এই বোতামটি ট্যাপ করলেই কেবল Cronica সেগুলো লোড করে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಂಕಿಅಂಶಗಳನ್ನು SIMKL ನಲ್ಲಿ ಲೈವ್ ಆಗಿ ಲೆಕ್ಕಾಚಾರ ಮಾಡಲಾಗುತ್ತದೆ ಮತ್ತು ಅವು ದುಬಾರಿಯಾಗಿರುತ್ತವೆ. ನೀವು ಈ ಬಟನ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿದಾಗ ಮಾತ್ರ Cronica ಅವುಗಳನ್ನು ಲೋಡ್ ಮಾಡುತ್ತದೆ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புள்ளிவிவரங்கள் SIMKL-இல் நேரடியாகக் கணக்கிடப்படுகின்றன, மேலும் அவை அதிக நேரம் எடுத்துக்கொள்பவை. நீங்கள் இந்தப் பொத்தானைத் தட்டும்போது மட்டுமே Cronica அவற்றை ஏற்றுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "SIMKLలో గణాంకాలు ప్రత్యక్షంగా లెక్కించబడతాయి మరియు అవి ఖరీదైనవి. మీరు ఈ బటన్‌ను నొక్కినప్పుడు మాత్రమే Cronica వాటిని లోడ్ చేస్తుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اعدادوشمار SIMKL پر لائیو شمار کیے جاتے ہیں اور مہنگے ہوتے ہیں۔ Cronica انہیں صرف اس وقت لوڈ کرتا ہے جب آپ اس بٹن کو تھپتھپاتے ہیں۔"
          }
        }
      }
    },
