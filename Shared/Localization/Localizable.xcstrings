    "Update items with new information, if available on TMDb": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّث العناصر بمعلومات جديدة، إن وُجدت على TMDb"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizovat položky novými informacemi, pokud jsou k dispozici na TMDb"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opdater elementer med nye oplysninger, hvis tilgængeligt på TMDb"
          }
        },
        "de": {
