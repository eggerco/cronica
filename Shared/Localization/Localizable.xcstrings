            "value": "ウォッチリストの映画が公開されたら通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치리스트의 영화가 공개되면 알림을 보냅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklum apabila filem dalam watchlist dikeluarkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få varsel når en film i watchlisten din utgis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding wanneer een film op je watchlist wordt uitgebracht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadom, gdy film z listy zostanie wydany."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifică când se lansează un film din watchlist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомлять, когда выходит фильм из списка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få avisering när en film i din watchlist släpps."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme listendeki bir film yayınlandığında bildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщати, коли виходить фільм зі списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当观看清单中的电影上映时通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當觀看清單中的電影上映時通知你。"
          }
        }
      }
    },
    "Notify when a new episode from a TV Show on your watchlist is released.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn eine neue Episode einer TV-Sendung auf deiner Watchlist veröffentlicht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when a new episode from a TV show on your watchlist is released."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifique cuando se publique un nuevo episodio de un Serie de TV en su lista de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier la sortie d'un nouvel épisode d'une émission de télévision figurant sur votre liste de visionnage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
