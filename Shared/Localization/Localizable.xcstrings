    "Pull to refresh or try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Aktualisieren ziehen oder erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull to refresh or try again."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para actualizar o inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez pour actualiser ou réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per aggiornare o riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe para atualizar ou tente novamente."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Potiahnite pre obnovenie alebo skúste znova."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب للتحديث أو حاول مرة أخرى."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potáhni dolů pro obnovení nebo to zkus znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Træk for at opdatere, eller prøv igen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τραβήξτε για ανανέωση ή δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para actualizar o inténtalo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivitä vetämällä tai yritä uudelleen."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משוך לרענון או נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिफ्रेश करने के लिए खींचें या फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za osvježavanje ili pokušaj ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Húzza le a frissítéshez, vagy próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik untuk memperbarui atau coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引っ張って更新するか、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당겨서 새로고침하거나 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarik untuk muat semula atau cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å oppdatere, eller prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trek om te vernieuwen of probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby odświeżyć, lub spróbuj ponownie."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage pentru reîmprospătare sau încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потяни для обновления или попробуй снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra för att uppdatera eller försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenilemek için çek veya tekrar dene."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потягни для оновлення або спробуй зnovu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉刷新或重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下拉更新或再試一次。"
          }
        }
      }
    },
