    "Favorite lists appear first when adding titles and on Home.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر القوائم المفضلة أولاً عند إضافة العناوين وفي الرئيسية."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Oblíbené seznamy se zobrazí jako první při přidávání titulů a na Domů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritlister vises først, når du tilføjer titler og på startsiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritenlisten erscheinen zuerst beim Hinzufügen und auf dem Home-Bildschirm."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι αγαπημένες λίστες εμφανίζονται πρώτες κατά την προσθήκη τίτλων και στην αρχική."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorite lists appear first when adding titles and on Home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas favoritas aparecen primero al añadir títulos y en Inicio."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas favoritas aparecen primero al agregar títulos y en Inicio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suosikkilistat näkyvät ensin lisättäessä nimikkeitä ja etusivulla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes favorites apparaissent en premier lors de l’ajout et sur l’accueil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשימות מועדפות מופיעות ראשונות בעת הוספת כותרות ובבית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षक जोड़ते समय और होम पर पसंदीदा सूचियाँ पहले दिखती हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Omiljeni popisi pojavljuju se prvi pri dodavanju naslova i na Početnoj."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kedvenc listák elsőként jelennek meg címek hozzáadásakor és a kezdőlapon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar favorit muncul pertama saat menambahkan judul dan di Beranda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le liste preferite compaiono per prime quando aggiungi titoli e in Home."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りリストは作品追加時とホームで最初に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾는 목록은 작품 추가 시와 홈에서 먼저 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Senarai kegemaran muncul dahulu apabila menambah tajuk dan di Laman Utama."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorittlister vises først når du legger til titler og på hjem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoriete lijsten verschijnen eerst bij het toevoegen van titels en op Start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulubione listy pojawiają się jako pierwsze przy dodawaniu tytułów i na ekranie głównym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas favoritas aparecem primeiro ao adicionar títulos e na Início."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Listele favorite apar primele la adăugarea titlurilor și pe Acasă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избранные списки отображаются первыми при добавлении названий и на главной."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obľúbené zoznamy sa zobrazia ako prvé pri pridávaní titulov a na Domov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Favoritlistor visas först när du lägger till titlar och på hem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori listeler başlık eklerken ve Ana sayfada önce görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрані списки з’являються першими під час додавання назв і на головній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加标题和在首页时，收藏列表会优先显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入標題和在首頁時，收藏列表會優先顯示。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শিরোনাম যোগ করার সময় এবং হোমে প্রিয় তালিকাগুলি প্রথমে উপস্থিত হয়৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les llistes preferides apareixen primer en afegir títols i a l’inici."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "શીર્ષકો ઉમેરતી વખતે અને હોમ પર મનપસંદ યાદીઓ પહેલાં દેખાય છે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಶೀರ್ಷಿಕೆಗಳನ್ನು ಸೇರಿಸುವಾಗ ಮತ್ತು ಹೋಮ್‌ನಲ್ಲಿ ಮೆಚ್ಚಿನ ಪಟ್ಟಿಗಳು ಮೊದಲು ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ശീർഷകങ്ങൾ ചേർക്കുമ്പോഴും ഹോമിലും പ്രിയപ്പെട്ട ലിസ്റ്റുകൾ ആദ്യം ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "शीर्षके जोडताना आणि मुख्यपृष्ठावर आवडत्या सूची प्रथम दिसतात."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଟାଇଟଲ୍ ଯୋଡିବା ଏବଂ ହୋମ୍ ରେ ପ୍ରିୟ ତାଲିକା ପ୍ରଥମେ ଦେଖାଯାଏ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Listas favoritas aparecem primeiro ao adicionar títulos e na Início."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਿਰਲੇਖ ਜੋੜਨ ਵੇਲੇ ਅਤੇ ਹੋਮ 'ਤੇ ਮਨਪਸੰਦ ਸੂਚੀਆਂ ਪਹਿਲਾਂ ਦਿਖਾਈ ਦਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priljubljeni seznami so prikazani prvi pri dodajanju naslovov in na Domovu."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தலைப்புகளைச் சேர்க்கும்போதும் முகப்புப் பக்கத்திலும் பிடித்தமான பட்டியல்கள் முதலில் தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "టైటిల్‌లను జోడించేటప్పుడు మరియు హోమ్‌లో ఇష్టమైన జాబితాలు ముందుగా కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการโปรดจะปรากฏเป็นอันดับแรกเมื่อเพิ่มชื่อเรื่องและบนหน้าแรก"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوانات شامل کرتے وقت اور ہوم پر پسندیدہ فہرستیں سب سے پہلے ظاہر ہوتی ہیں ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách yêu thích xuất hiện đầu tiên khi thêm tiêu đề và trên Trang chủ."
          }
        }
      }
    },
