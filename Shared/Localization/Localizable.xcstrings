    "Choose what happens when you double-tap a cover or poster.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما يحدث عند النقر المزدوج على الغلاف أو الملصق."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber, co se stane při dvojitém klepnutí na obálku nebo plakát."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvad der sker, når du dobbelttrykker på et cover eller en plakat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, was beim Doppeltipp auf ein Cover oder Poster passiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε τι συμβαίνει όταν κάνετε διπλό πάτημα σε εξώφυλλο ή αφίσα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what happens when you double-tap a cover or poster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué ocurre al pulsar dos veces una carátula o un póster."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué pasa cuando tocas dos veces una portada o un póster."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse, mitä tapahtuu, kun kaksoisnapautat kansikuvaa tai julistetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ce qui se passe quand tu double-appuies sur une jaquette ou une affiche."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר מה קורה כשאתה מקיש פעמיים על כריכה או פוסטר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कवर या पोस्टर पर दो बार टैप करने पर क्या हो, चुनें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi što se događa kad dvaput dodirneš naslovnicu ili poster."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válassza ki, mi történjen, ha duplán koppint egy borítóra vagy poszterre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang terjadi saat mengetuk dua kali sampul atau poster."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa succede quando tocchi due volte una copertina o un poster."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カバーまたはポスターをダブルタップしたときの動作を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커버나 포스터를 두 번 탭할 때 동작을 선택하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih apa yang berlaku apabila ketik dua kali pada kulit atau poster."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg hva som skjer når du dobbelttrykker på et cover eller en plakat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wat er gebeurt wanneer je dubbeltikt op een cover of poster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, co się dzieje po dwukrotnym dotknięciu okładki lub plakatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que acontece quando você toca duas vezes em uma capa ou pôster."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege ce se întâmplă când atingi de două ori coperta sau posterul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери, что происходит при двойном нажатии на обложку или постер."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber, čo sa stane pri dvojitom ťuknutí na obal alebo plagát."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj vad som händer när du dubbeltrycker på ett omslag eller en affisch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak veya afişe çift dokunduğunda ne olacağını seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери, що відбувається при подвійному натисканні на обкладинку чи постер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择双击封面或海报时的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇點兩下封面或海報時的操作。"
          }
        }
      }
    },
