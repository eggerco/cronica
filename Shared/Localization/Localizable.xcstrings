    "Track what you watch. Never lose your place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع ما تشاهده. لا تفقد مكانك أبداً."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj, co sleduješ. Už nikdy neztratíš své místo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor, hvad du ser. Mist aldrig din plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte den Überblick. Verliere nie den Faden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακολουθήστε τι βλέπετε. Μην χάσετε ποτέ τη θέση σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track what you watch. Never lose your place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra lo que ves. No pierdas nunca tu progreso."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva el control de lo que ves. Nunca pierdas el hilo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraa katsomaasi. Älä koskaan menetä paikkaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez ce que vous regardez. Ne perdez jamais le fil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עקוב אחר מה שצפית. אל תאבד את המקום שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो देखते हैं उसे ट्रैक करें। अपनी जगह कभी न खोएँ।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prati što gledaš. Nikad ne izgubi svoje mjesto."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kövesse, amit néz. Soha ne veszítse el a helyét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lacak apa yang kamu tonton. Jangan pernah kehilangan tempatmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni traccia di ciò che guardi. Non perdere il filo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴を記録。中断したところを見失いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청한 작품을 추적하세요. 중단한 곳을 잃지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jejaki apa yang anda tonton. Jangan sesat tempat anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spor hva du ser. Mist aldri plassen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd bij wat je kijkt. Verlies nooit je plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledź, co oglądasz. Nigdy nie stracisz miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o que você assiste. Nunca perca o fio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Urmărește ce vizionezi. Nu-ți pierde niciodată locul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживай просмотры. Никогда не теряй своё место."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj, čo pozeráš. Už nikdy nestratíš miesto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spåra vad du tittar på. Tappa aldrig bort din plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlediklerini takip et. Yerini asla kaybetme."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежуй перегляди. Ніколи не втрачай своє місце."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你看的内容。再也不会丢失进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄你看的內容。再也不會遺失進度。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes seguiment del que mires. No perdis mai el fil."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જે જુઓ છો તેને ટ્રૅક કરો. તમારું સ્થાન ક્યારેય ગુમાવશો નહીં."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही काय पाहता याचा मागोवा घ्या. आपले स्थान कधीही गमावू नका."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Acompanhe o que tu assiste. Nunca perca o fio."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਜੋ ਦੇਖਦੇ ਹੋ ਉਸ ਨੂੰ ਟਰੈਕ ਕਰੋ। ਕਦੇ ਵੀ ਆਪਣਾ ਸਥਾਨ ਨਾ ਗੁਆਓ."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sledi temu, kar gledaš. Nikoli ne izgubi mesta."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ കാണുന്നത് ട്രാക്ക് ചെയ്യുക. നിങ്ങളുടെ സ്ഥാനം ഒരിക്കലും നഷ്ടപ്പെടുത്തരുത്."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตามสิ่งที่คุณรับชม ไม่เคยสูญเสียสถานที่ของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi những gì bạn xem. Không bao giờ mất vị trí của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যা দেখছেন তার হিসাব রাখুন। দেখার জায়গা কখনো হারাবেন না।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನೋಡುವುದನ್ನು ಟ್ರ್ಯಾಕ್ ಮಾಡಿ. ನಿಮ್ಮ ಸ್ಥಾನವನ್ನು ಎಂದಿಗೂ ಕಳೆದುಕೊಳ್ಳಬೇಡಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣ ଯାହା ଦେଖୁଛନ୍ତି ତାହା ଟ୍ରାକ୍ କରନ୍ତୁ। କେବେବି ନିଜର ସ୍ଥାନ ହରାନ୍ତୁ ନାହିଁ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் பார்ப்பதைக் கண்காணிக்கவும். நீங்கள் பார்க்கும் இடத்தை ஒருபோதும் தவறவிடாதீர்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు చూసేదాన్ని ట్రాక్ చేయండి. మీరు ఎక్కడున్నారో మర్చిపోకండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ جو دیکھتے ہیں اسے ٹریک کریں۔ کبھی اپنی جگہ مت کھونا۔"
          }
        }
      }
    },
