    "Add items with future release dates to your watchlist to see them here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عناوين بمواعيد إصدار مستقبلية إلى قائمة المشاهدة لتراها هنا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej do watchlistu tituly s budoucím datem vydání a uvidíš je tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj titler med fremtidige udgivelsesdatoer til din watchlist for at se dem her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Titel mit zukünftigen Veröffentlichungsdaten zu deiner Watchlist hinzu, um sie hier zu sehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε τίτλους με μελλοντικές ημερομηνίες κυκλοφορίας στη λίστα παρακολούθησης για να τους δείτε εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add items with future release dates to your watchlist to see them here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade títulos con fechas de estreno futuras a tu lista para verlos aquí."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega títulos con fechas de estreno futuras a tu lista para verlos aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää tulevilla julkaisupäivillä olevia kohteita katselulistallesi nähdäksesi ne täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des titres avec des dates de sortie futures à ta liste pour les voir ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף כותרות עם תאריכי שחרור עתידיים לרשימת הצפייה כדי לראות אותן כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भविष्य की रिलीज़ तिथियों वाले शीर्षक यहाँ देखने के लिए अपनी वॉचलिस्ट में जोड़ें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj naslove s budućim datumom izlaska na popis kako bi ih vidio ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjon hozzá jövőbeli megjelenési dátummal rendelkező címeket a figyelőlistához, hogy itt megjelenjenek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan judul dengan tanggal rilis mendatang ke watchlist untuk melihatnya di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi titoli con date di uscita future alla tua lista per vederli qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開予定の作品をウォッチリストに追加すると、ここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 예정 작품을 워치리스트에 추가하면 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambah tajuk dengan tarikh keluaran akan datang ke watchlist untuk melihatnya di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til titler med fremtidige lanseringsdatoer i watchlisten din for å se dem her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg items met toekomstige releasedata toe aan je watchlist om ze hier te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj tytuły z przyszłymi datami premiery do listy, aby zobaczyć je tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione títulos com datas de lançamento futuras à sua lista para ver aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă titluri cu date viitoare de lansare pe watchlist ca să le vezi aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь в список названия с будущей датой выхода, чтобы увидеть их здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridaj položky s budúcim dátumom vydania do sledovaného, aby sa zobrazili tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till titlar med framtida releasedatum i din watchlist för att se dem här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada görmek için izleme listene gelecekte yayınlanacak başlıklar ekle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай до списку назви з майбутньою датою виходу, щоб побачити їх тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将未来上映的条目添加到观看清单，即可在此查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將未來上映的項目加入觀看清單，即可在此查看。"
          }
        }
      }
    },
