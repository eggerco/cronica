        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica કૅલેન્ડરમાં આગામી ટીવી એપિસોડ્સ અને સિઝન પ્રીમિયર ઉમેરો."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂಬರುವ ಟಿವಿ ಸಂಚಿಕೆಗಳು ಮತ್ತು ಸೀಸನ್ ಪ್ರೀಮಿಯರ್‌ಗಳನ್ನು Cronica ಕ್ಯಾಲೆಂಡರ್‌ಗೆ ಸೇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica കലണ്ടറിലേക്ക് വരാനിരിക്കുന്ന ടിവി എപ്പിസോഡുകളും സീസൺ പ്രീമിയറുകളും ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica कॅलेंडरमध्ये आगामी टीव्ही भाग आणि सीझन प्रीमियर जोडा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica କ୍ୟାଲେଣ୍ଡରରେ ଆଗାମୀ ଟିଭି ଏପିସୋଡ୍ ଏବଂ season ତୁ ପ୍ରିମିୟର୍ ଯୋଡନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione episódios e temporadas futuras ao calendário Cronica."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica ਕੈਲੰਡਰ ਵਿੱਚ ਆਗਾਮੀ ਟੀਵੀ ਐਪੀਸੋਡ ਅਤੇ ਸੀਜ਼ਨ ਪ੍ਰੀਮੀਅਰ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj prihajajoče TV epizode in premiere sezon v koledar Cronica."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வரவிருக்கும் டிவி எபிசோடுகள் மற்றும் சீசன் பிரீமியர்களை Cronica காலெண்டரில் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica క్యాలెండర్‌కు రాబోయే టీవీ ఎపిసోడ్‌లు మరియు సీజన్ ప్రీమియర్‌లను జోడించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มตอนของรายการทีวีที่กำลังจะมาถึงและรอบปฐมทัศน์ของฤดูกาลลงในปฏิทิน Cronica"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm các tập phim truyền hình sắp tới và các buổi ra mắt mùa vào lịch Cronica."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica کیلنڈر میں آئندہ ٹی وی اقساط اور سیزن پریمیئرز شامل کریں ۔"
          }
