    "Reduce some UI elements size to accommodate more items on the screen": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصغير بعض عناصر الواجهة لعرض المزيد من العناصر على الشاشة"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenšit některé prvky rozhraní, aby se na obrazovku vešlo více položek"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Reducer størrelsen på nogle UI-elementer for at få plads til flere elementer på skærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige UI-Elemente verkleinern, um mehr Elemente auf dem Bildschirm unterzubringen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μείωση μεγέθους ορισμένων στοιχείων UI για να χωρέσουν περισσότερα στην οθόνη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce the size of some UI elements to fit more items on screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce el tamaño de algunos elementos de la interfaz para mostrar más contenido en pantalla."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzca el tamaño de algunos elementos de la interfaz de usuario para acomodar más elementos en la pantalla"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pienennä joidenkin käyttöliittymäelementtien kokoa, jotta ruudulle mahtuu enemmän kohteita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire la taille de certains éléments de l'interface utilisateur pour accueillir plus d'éléments à l'écran"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטן חלק מאלמנטי הממשק כדי להציג יותר פריטים על המסך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर अधिक आइटम दिखाने के लिए कुछ UI तत्व छोटे करें"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smanji neke elemente sučelja kako bi stalo više stavki na zaslon"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csökkentse egyes felületelemek méretét, hogy több elem férjen el a képernyőn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkecil beberapa elemen UI agar lebih banyak item muat di layar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduci le dimensioni di alcuni elementi dell'interfaccia per ospitare più elementi sullo schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のUI要素のサイズを縮小して、画面により多くの項目を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 UI 요소 크기를 줄여 화면에 더 많은 항목을 표시합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kecilkan beberapa elemen UI untuk muat lebih banyak item pada skrin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduser størrelsen på noen UI-elementer for å få plass til flere elementer på skjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verklein enkele UI-elementen om meer items op het scherm te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmniejsz niektóre elementy interfejsu, aby zmieścić więcej pozycji na ekranie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o tamanho de alguns elementos da interface do usuário para acomodar mais itens na tela"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce dimensiunea unor elemente UI pentru a încăpea mai multe pe ecran"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уменьшить некоторые элементы интерфейса, чтобы поместить больше элементов на экран"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmenšenie veľkosti niektorých prvkov rozhrania, aby sa na obrazovku zmestilo viac položiek"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minska storleken på vissa UI-element för att få plats med fler objekt på skärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranda daha fazla öğe göstermek için bazı arayüz öğelerini küçült"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зменшити деякі елементи інтерфейсу, щоб вмістити більше на екрані"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小部分界面元素以在屏幕上显示更多内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮小部分介面元素以在畫面上顯示更多內容。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Redueix la mida d’alguns elements de la interfície per encabir-ne més a la pantalla."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સ્ક્રીન પર વધુ આઇટમ્સ ફિટ કરવા માટે કેટલાક UI ઘટકોનું કદ ઘટાડો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीनवर अधिक आयटम बसवण्यासाठी काही UI घटकांचा आकार कमी करा."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ସ୍କ୍ରିନରେ ଅଧିକ ଆଇଟମ୍ ଫିଟ୍ କରିବା ପାଇଁ କିଛି UI ଉପାଦାନର ଆକାର ହ୍ରାସ କରନ୍ତୁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduza o tamanho de alguns elementos da interface do utilizador para acomodar mais itens na ecrã"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਕ੍ਰੀਨ 'ਤੇ ਹੋਰ ਆਈਟਮਾਂ ਫਿੱਟ ਕਰਨ ਲਈ ਕੁਝ UI ਤੱਤਾਂ ਦਾ ਆਕਾਰ ਘਟਾਓ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmanjšaj velikost nekaterih elementov vmesnika, da se jih več prilega na zaslon."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സ്ക്രീനിൽ കൂടുതൽ ഇനങ്ങൾക്ക് അനുയോജ്യമാക്കുന്നതിന് ചില UI ഘടകങ്ങളുടെ വലുപ്പം കുറയ്ക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลดขนาดขององค์ประกอบ UI บางส่วนเพื่อให้พอดีกับรายการบนหน้าจอมากขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giảm kích thước của một số thành phần trên giao diện người dùng để vừa với nhiều mục hơn trên màn hình."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্ক্রিনে আরও বেশি আইটেম দেখানোর জন্য কিছু UI উপাদানের আকার ছোট করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪರದೆಯ ಮೇಲೆ ಹೆಚ್ಚಿನ ಐಟಂಗಳನ್ನು ಹೊಂದಿಸಲು ಕೆಲವು UI ಅಂಶಗಳ ಗಾತ್ರವನ್ನು ಕಡಿಮೆ ಮಾಡಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரையில் அதிக உருப்படிகள் பொருந்தும் வகையில் சில UI கூறுகளின் அளவைக் குறைக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "స్క్రీన్‌పై మరిన్ని అంశాలు సరిపోయేలా కొన్ని UI ఎలిమెంట్‌ల పరిమాణాన్ని తగ్గించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکرین پر مزید آئٹمز فٹ کرنے کے لیے کچھ UI عناصر کا سائز کم کریں۔"
          }
        }
      }
    },
