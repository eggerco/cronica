          "stringUnit": {
            "state": "translated",
            "value": "%@ видалено з вашого списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已从片单移除%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已從片單移除%@。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ha eliminat %@ de la teva Watchlist."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી વોચલિસ્ટમાંથી %@ દૂર કર્યું."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या वॉचलिस्टमधून %@ काढले."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆପଣଙ୍କର ୱାଚଲିଷ୍ଟରୁ %@ ଅପସାରିତ ହୋଇଛି |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ removido da sua lista."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਨਿਗਰਾਨੀ ਸੂਚੀ ਵਿੱਚੋਂ %@ ਨੂੰ ਹਟਾਇਆ ਗਿਆ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranjen %@ s seznama za opazovanje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാച്ച്‌ലിസ്റ്റിൽ നിന്ന് %@ നീക്കം ചെയ്‌തു."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %@ ออกจากรายการเฝ้าดูของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xóa %@ khỏi danh sách theo dõi của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ওয়াচলিস্ট থেকে %@ সরিয়ে ফেলা হয়েছে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಯಿಂದ %@ ಅನ್ನು ತೆಗೆದುಹಾಕಲಾಗಿದೆ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கண்காணிப்புப் பட்டியலிலிருந்து %@ அகற்றப்பட்டது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాచ్‌లిస్ట్ నుండి %@ తొలగించబడింది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی واچ لسٹ سے %@ کو ہٹا دیا گیا۔"
          }
        }
      }
    },
