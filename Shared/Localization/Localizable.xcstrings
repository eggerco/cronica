          "stringUnit": {
            "state": "translated",
            "value": "Cronica heeft een herinnering toegevoegd voor de volgende release of aflevering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica dodała przypomnienie o kolejnej premierze lub odcinku."
          }
        },
