    "Internal error: Something went wrong, contact TMDB.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطأ داخلي: حدث خطأ ما، تواصل مع TMDB."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Interní chyba: Něco se pokazilo, kontaktuj TMDB."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intern fejl: Noget gik galt, kontakt TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interner Fehler: Etwas ist schiefgelaufen, kontaktiere TMDB."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εσωτερικό σφάλμα: Κάτι πήγε στραβά, επικοινωνήστε με TMDB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal error: Something went wrong, contact TMDB."
          }
        },
