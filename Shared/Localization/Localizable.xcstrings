        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור סרטים וסדרות — Cronica מארגן אותם בשבילך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िल्में और शो सहेजें — Cronica उन्हें व्यवस्थित रखता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremi filmove i serije — Cronica ih organizira za tebe."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentse el a filmeket és műsorokat — a Cronica rendszerezi őket Önnek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan film dan acara — Cronica mengaturnya untukmu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva film e serie — Cronica li organizza per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "映画と番組を保存 — Cronicaが整理してくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영화와 프로그램을 저장하세요 — Cronica가 정리해 드립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan filem dan rancangan — Cronica susunkan untuk anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre filmer og serier — Cronica holder dem organisert for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar films en series — Cronica houdt ze voor je georganiseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj filmy i seriale — Cronica utrzymuje je w porządku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve filmes e séries — a Cronica organiza por você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează filme și seriale — Cronica le organizează pentru tine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняй фильмы и сериалы — Cronica всё организует за тебя."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukladaj filmy a seriály — Cronica ich pre teba usporiada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara filmer och serier — Cronica håller dem organiserade åt dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmleri ve dizileri kaydet — Cronica senin için düzenler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігай фільми та серіали — Cronica все організує за тебе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存电影和节目 — Cronica 会为你整理得井井有条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存電影和節目 — Cronica 會為你整理得井井有條。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desa pel·lícules i sèries: Cronica les manté organitzades per a tu."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "મૂવીઝ અને શો સાચવો — Cronica તેમને તમારા માટે વ્યવસ્થિત રાખે છે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्रपट आणि शो जतन करा — Cronica त्यांना तुमच्यासाठी व्यवस्थित ठेवते."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଚଳଚ୍ଚିତ୍ର ଏବଂ ଶୋ ସଞ୍ଚୟ କରନ୍ତୁ - Cronica ସେମାନଙ୍କୁ ଆପଣଙ୍କ ପାଇଁ ସଂଗଠିତ ରଖେ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve filmes e séries — a Cronica organiza por tu."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਿਲਮਾਂ ਅਤੇ ਸ਼ੋਅ ਸੁਰੱਖਿਅਤ ਕਰੋ — Cronica ਉਹਨਾਂ ਨੂੰ ਤੁਹਾਡੇ ਲਈ ਵਿਵਸਥਿਤ ਰੱਖਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Shrani filme in serije — Cronica jih uredi zate."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സിനിമകളും ഷോകളും സംരക്ഷിക്കുക - Cronica നിങ്ങൾക്കായി അവയെ ഓർഗനൈസ് ചെയ്യുന്നു."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกภาพยนตร์และรายการต่างๆ — Cronica จัดระเบียบให้คุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu phim và chương trình — Cronica sắp xếp chúng cho bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিনেমা ও শো সংরক্ষণ করুন — Cronica সেগুলোকে আপনার জন্য সুসংগঠিত রাখে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಲನಚಿತ್ರಗಳು ಮತ್ತು ಕಾರ್ಯಕ್ರಮಗಳನ್ನು ಉಳಿಸಿ — Cronica ಅವುಗಳನ್ನು ನಿಮಗಾಗಿ ವ್ಯವಸ್ಥಿತವಾಗಿರಿಸುತ್ತದೆ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திரைப்படங்களையும் நிகழ்ச்சிகளையும் சேமித்து வையுங்கள் — Cronica அவற்றை உங்களுக்காக ஒழுங்கமைத்து வைக்கிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సినిమాలు మరియు షోలను భద్రపరచుకోండి — Cronica వాటిని మీ కోసం క్రమబద్ధంగా ఉంచుతుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "موویز اور شوز کو محفوظ کریں — Cronica انہیں آپ کے لیے منظم رکھتا ہے۔"
          }
        }
      }
    },
