        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन ट्रैकिंग शुरू नहीं हो सकी। थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nije moguće pokrenuti praćenje na Zaključanom zaslonu. Pokušaj uskoro ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
