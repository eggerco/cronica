        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre vyhnutie sa možným spoilerom, môžeš skryť názvy a prehľady z nepozretých epizód."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
