            "value": "Tempo de exibição estimado para títulos marcados como assistidos a cada semana."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Timp estimat de vizionare pentru titlurile marcate ca vizionate în fiecare săptămână."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка времени просмотра названий, отмеченных просмотренными каждую неделю."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odhadovaný čas sledovania titulov označených ako pozreté každý týždeň."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Uppskattad visningstid för titlar markerade som sedda varje vecka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her hafta izlendi işaretlenen başlıklar için tahmini izleme süresi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оцінка часу перегляду назв, позначених переглянутими щотижня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周标记为已观看的标题的估算观看时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每週標記為已觀看的標題的估算觀看時長。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি সপ্তাহে দেখা চিহ্নিত শিরোনামগুলির জন্য আনুমানিক দেখার সময়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps de visionat estimat dels títols marcats com a vistos cada setmana."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "દર અઠવાડિયે જોવાયેલ શીર્ષકો માટે અંદાજિત જોવાનો સમય."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರತಿ ವಾರ ವೀಕ್ಷಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಲಾದ ಶೀರ್ಷಿಕೆಗಳ ಅಂದಾಜು ವೀಕ್ಷಣೆ ಸಮಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓരോ ആഴ്‌ചയും കണ്ടതായി അടയാളപ്പെടുത്തിയ ശീർഷകങ്ങൾക്കായി കണക്കാക്കിയ വീക്ഷണ സമയം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक आठवड्यात पाहिलेल्या चिन्हांकित शीर्षकांसाठी अंदाजे पाहण्याची वेळ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ପ୍ରତି ସପ୍ତାହରେ ଦେଖାଯାଇଥିବା ଟାଇଟଲ୍ ପାଇଁ ଆନୁମାନିକ ଦର୍ଶନ ସମୟ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo de exibição estimado para títulos marcados como assistidos a cada semana."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਰ ਹਫ਼ਤੇ ਦੇਖੇ ਗਏ ਸਿਰਲੇਖਾਂ ਲਈ ਅਨੁਮਾਨਿਤ ਦੇਖਣ ਦਾ ਸਮਾਂ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Predvideni čas ogleda za naslove, označene kot ogledane vsak teden."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒவ்வொரு வாரமும் பார்த்ததாகக் குறிக்கப்பட்ட தலைப்புகளுக்கான மதிப்பிடப்பட்ட பார்வை நேரம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి వారం వీక్షించినట్లు గుర్తించబడిన శీర్షికల కోసం అంచనా వీక్షణ సమయం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาในการดูโดยประมาณสำหรับรายการที่มีการทำเครื่องหมายว่ารับชมในแต่ละสัปดาห์"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ہفتے دیکھے جانے والے عنوانات کے لیے دیکھنے کا تخمینہ شدہ وقت ۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian xem ước tính cho các tựa phim được đánh dấu đã xem mỗi tuần."
          }
        }
      }
    },
