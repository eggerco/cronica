          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez megnyitja a TMDb weboldalát az egyes szolgáltatásokhoz vezető hivatkozásokkal."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan membuka situs TMDb dengan tautan ke setiap layanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo aprirà il sito di TMDb con il collegamento a ciascun servizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各サービスへのリンクがあるTMDbウェブサイトが開きます。"
