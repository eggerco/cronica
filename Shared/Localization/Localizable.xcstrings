          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงภาพยนตร์และรายการทีวีที่กำลังได้รับความนิยมจาก TMDb"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các bộ phim và chương trình truyền hình theo xu hướng từ TMDb."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDb থেকে ট্রেন্ডিং সিনেমা ও টিভি শোগুলো দেখায়।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDb ನಿಂದ ಟ್ರೆಂಡಿಂಗ್‌ನಲ್ಲಿರುವ ಚಲನಚಿತ್ರಗಳು ಮತ್ತು ಟಿವಿ ಕಾರ್ಯಕ್ರಮಗಳನ್ನು ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDb-இலிருந்து பிரபலமாகி வரும் திரைப்படங்கள் மற்றும் தொலைக்காட்சி நிகழ்ச்சிகளைக் காட்டுகிறது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDb నుండి ట్రెండింగ్‌లో ఉన్న సినిమాలు మరియు టీవీ షోలను చూపుతుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDb سے موویز اور ٹی وی شوز ٹرینڈنگ دکھاتا ہے۔"
          }
        }
      }
    },
    "Shows titles paused on other SIMKL apps. Cronica does not run a full media player, so live start/pause scrobbling is not used.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض العناوين المتوقفة في تطبيقات SIMKL الأخرى. لا يشغّل Cronica مشغّل وسائط كاملًا، لذا لا يُستخدم scrobbling البدء/الإيقاف المباشر."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje tituly pozastavené v jiných aplikacích SIMKL. Cronica nemá plný přehrávač, proto se živé scrobblování start/pauza nepoužívá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser titler pauset i andre SIMKL-apps. Cronica har ikke en fuld mediaplayer, så live start/pause-scrobbling bruges ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt auf anderen SIMKL-Apps pausierte Titel. Cronica hat keinen vollständigen Mediaplayer, daher kein Live-Start/Pause-Scrobbling."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τίτλους σε παύση σε άλλες εφαρμογές SIMKL. Το Cronica δεν έχει πλήρη media player, οπότε δεν χρησιμοποιείται live start/pause scrobbling."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows titles paused on other SIMKL apps. Cronica does not run a full media player, so live start/pause scrobbling is not used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra títulos en pausa en otras apps de SIMKL. Cronica no tiene un reproductor completo, así que no usa scrobbling start/pause en vivo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra títulos en pausa en otras apps de SIMKL. Cronica no tiene un reproductor completo, así que no usa scrobbling start/pause en vivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää muissa SIMKL-sovelluksissa keskeytetyt nimet. Cronicassa ei ole täyttä mediasoitinta, joten live start/pause -scrobblausta ei käytetä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les titres en pause sur d’autres apps SIMKL. Cronica n’a pas de lecteur complet, donc pas de scrobbling start/pause en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג כותרים שהושהו באפליקציות SIMKL אחרות. Cronica אינו מפעיל נגן מדיה מלא, ולכן לא נעשה שימוש ב‑scrobbling חי של התחלה/השהיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य SIMKL ऐप्स पर रोके गए शीर्षक दिखाता है। Cronica पूर्ण मीडिया प्लेयर नहीं चलाता, इसलिए लाइव स्टार्ट/पॉज़ स्क्रॉबलिंग उपयोग नहीं होती।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikazuje naslove pauzirane u drugim SIMKL aplikacijama. Cronica nema potpuni reproduktor, pa se ne koristi live start/pause scrobbling."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Más SIMKL-appokban szüneteltetett címeket mutat. A Cronicának nincs teljes lejátszója, ezért nincs élő start/pause scrobbling."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan judul yang dijeda di aplikasi SIMKL lain. Cronica tidak menjalankan pemutar media penuh, jadi scrobbling mulai/jeda langsung tidak digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i titoli in pausa su altre app SIMKL. Cronica non ha un player completo, quindi non usa scrobbling start/pause in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のSIMKLアプリで一時停止されたタイトルを表示します。Cronicaはフルのメディアプレーヤーではないため、ライブの開始/一時停止スクロブルは使いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 SIMKL 앱에서 일시중지된 작품을 표시합니다. Cronica는 전체 미디어 플레이어가 아니므로 실시간 시작/일시중지 스크로블을 사용하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunjukkan tajuk yang dijeda pada apl SIMKL lain. Cronica tidak menjalankan pemain media penuh, jadi scrobbling mula/jeda langsung tidak digunakan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser titler pauset i andre SIMKL-apper. Cronica har ingen full mediaplayer, så live start/pause-scrobbling brukes ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont titels die in andere SIMKL-apps zijn gepauzeerd. Cronica heeft geen volledige mediaspeler, dus geen live start/pauze-scrobblen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje tytuły wstrzymane w innych aplikacjach SIMKL. Cronica nie ma pełnego odtwarzacza, więc nie używa live scrobblingu start/pauza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra títulos pausados em outros apps do SIMKL. O Cronica não tem um player completo, então não usa scrobbling de início/pausa ao vivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează titluri în pauză în alte aplicații SIMKL. Cronica nu are un player complet, deci nu folosește scrobbling start/pauză live."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает названия на паузе в других приложениях SIMKL. В Cronica нет полноценного плеера, поэтому live scrobbling start/pause не используется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje tituly pozastavené v iných aplikáciách SIMKL. Cronica nemá plný prehrávač, preto sa živé scrobblovanie štart/pauza nepoužíva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar titlar pausade i andra SIMKL-appar. Cronica har ingen fullständig mediaspelare, så live start/paus-scrobbling används inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer SIMKL uygulamalarında duraklatılan başlıkları gösterir. Cronica tam bir medya oynatıcı çalıştırmadığı için canlı start/pause scrobbling kullanılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує назви на паузі в інших застосунках SIMKL. У Cronica немає повноцінного плеєра, тому live scrobbling start/pause не використовується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示在其他 SIMKL 应用中已暂停的标题。Cronica 不是完整媒体播放器，因此不使用实时开始/暂停 scrobbling。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示在其他 SIMKL 應用程式中已暫停的標題。Cronica 不是完整媒體播放器，因此不使用即時開始/暫停 scrobbling。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra títols en pausa en altres apps de SIMKL. Cronica no executa un reproductor complet, així que no s’utilitza el scrobbling d’inici/pausa en directe."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અન્ય SIMKL એપ પર થોભાવેલા શીર્ષકો બતાવે છે. Cronica સંપૂર્ણ મીડિયા પ્લેયર ચલાવતું નથી, તેથી લાઇવ સ્ટાર્ટ/પોઝ સ્ક્રૉબલિંગનો ઉપયોગ થતો નથી."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इतर SIMKL ॲप्सवर थांबलेली शीर्षके दाखवते. Cronica पूर्ण मीडिया प्लेयर चालवत नाही, त्यामुळे लाइव्ह स्टार्ट/पॉज स्क्रोबलिंग वापरले जात नाही."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନ୍ୟ SIMKL ଆପ୍ସରେ ବିରାମ ହୋଇଥିବା ଟାଇଟଲ୍ ଦେଖାଏ | Cronica ଏକ ପୂର୍ଣ୍ଣ ମିଡିଆ ପ୍ଲେୟାର ଚଲାଇବ ନାହିଁ, ତେଣୁ ଲାଇଭ୍ ଷ୍ଟାର୍ଟ / ବିରାମ ସ୍କ୍ରବଲିଂ ବ୍ୟବହାର କରାଯାଏ ନାହିଁ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra títulos pausados em outros apps do SIMKL. O Cronica não tem um player completo, então não usa scrobbling de início/pausa ao vivo."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹੋਰ SIMKL ਐਪਾਂ 'ਤੇ ਰੋਕੇ ਗਏ ਸਿਰਲੇਖਾਂ ਨੂੰ ਦਿਖਾਉਂਦਾ ਹੈ। Cronica ਇੱਕ ਪੂਰਾ ਮੀਡੀਆ ਪਲੇਅਰ ਨਹੀਂ ਚਲਾਉਂਦਾ, ਇਸਲਈ ਲਾਈਵ ਸਟਾਰਟ/ਪੌਜ਼ ਸਕ੍ਰੌਬਲਿੰਗ ਦੀ ਵਰਤੋਂ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaže naslove, zaustavljene v drugih aplikacijah SIMKL. Cronica nima polnega predvajalnika, zato živega scrobblanja začetek/pavza ne uporablja."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റ് SIMKL ആപ്പുകളിൽ താൽക്കാലികമായി നിർത്തിയ ശീർഷകങ്ങൾ കാണിക്കുന്നു. Cronica ഒരു പൂർണ്ണ മീഡിയ പ്ലെയർ പ്രവർത്തിപ്പിക്കുന്നില്ല, അതിനാൽ ലൈവ് സ്റ്റാർട്ട്/പോസ് സ്ക്രോബ്ലിംഗ് ഉപയോഗിക്കുന്നില്ല."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงชื่อที่หยุดชั่วคราวบนแอป SIMKL อื่น ๆ Cronica ไม่ได้ใช้เครื่องเล่นสื่อเต็มรูปแบบ ดังนั้นจึงไม่ได้ใช้การเริ่ม/หยุดชั่วคราวแบบสด"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các tiêu đề bị tạm dừng trên các ứng dụng SIMKL khác. Cronica không chạy trình phát đa phương tiện đầy đủ, do đó, tính năng bắt đầu/tạm dừng trực tiếp không được sử dụng."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্যান্য SIMKL অ্যাপে পজ করা টাইটেলগুলো দেখায়। Cronica একটি পূর্ণাঙ্গ মিডিয়া প্লেয়ার চালায় না, তাই লাইভ স্টার্ট/পজ স্ক্রবলিং ব্যবহার করা হয় না।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇತರ SIMKL ಅಪ್ಲಿಕೇಶನ್‌ಗಳಲ್ಲಿ ವಿರಾಮಗೊಳಿಸಲಾದ ಶೀರ್ಷಿಕೆಗಳನ್ನು ತೋರಿಸುತ್ತದೆ. Cronica ಪೂರ್ಣ ಮೀಡಿಯಾ ಪ್ಲೇಯರ್ ಅನ್ನು ರನ್ ಮಾಡುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ಲೈವ್ ಸ್ಟಾರ್ಟ್/ಪಾಸ್ ಸ್ಕ್ರೋಬ್ಲಿಂಗ್ ಅನ್ನು ಬಳಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்ற SIMKL செயலிகளில் இடைநிறுத்தப்பட்ட தலைப்புகளைக் காட்டுகிறது. Cronica ஒரு முழுமையான மீடியா பிளேயரை இயக்காததால், நேரலைத் தொடக்கம்/இடைநிறுத்தம் ஸ்க்ராப்ளிங் பயன்படுத்தப்படுவதில்லை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇతర SIMKL యాప్‌లలో పాజ్ చేయబడిన టైటిల్‌లను చూపుతుంది. Cronica పూర్తి మీడియా ప్లేయర్‌ను నడపదు, కాబట్టి లైవ్ స్టార్ట్/పాజ్ స్క్రోబ్లింగ్ ఉపయోగించబడదు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیگر SIMKL ایپس پر رکے ہوئے عنوانات دکھاتا ہے۔ Cronica ایک مکمل میڈیا پلیئر نہیں چلاتا، اس لیے لائیو اسٹارٹ/پاز اسکروبلنگ کا استعمال نہیں کیا جاتا ہے۔"
          }
        }
      }
    },
    "Sign-in opens SIMKL in a secure browser session. Cronica never stores your SIMKL password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تسجيل الدخول SIMKL في جلسة متصفح آمنة. لا يخزّن Cronica كلمة مرور SIMKL أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení otevře SIMKL v zabezpečeném prohlížeči. Cronica nikdy neukládá tvé heslo SIMKL."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login åbner SIMKL i en sikker browsersession. Cronica gemmer aldrig din SIMKL-adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung öffnet SIMKL in einer sicheren Browser-Sitzung. Cronica speichert dein SIMKL-Passwort nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση ανοίγει το SIMKL σε ασφαλή περίοδο λειτουργίας προγράμματος περιήγησης. Το Cronica δεν αποθηκεύει ποτέ τον κωδικό SIMKL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in opens SIMKL in a secure browser session. Cronica never stores your SIMKL password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión abre SIMKL en una sesión segura del navegador. Cronica nunca guarda tu contraseña de SIMKL."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión abre SIMKL en una sesión segura del navegador. Cronica nunca guarda tu contraseña de SIMKL."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuminen avaa SIMKL:n suojatussa selainistunnossa. Cronica ei koskaan tallenna SIMKL-salasanaasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion ouvre SIMKL dans une session navigateur sécurisée. Cronica ne stocke jamais votre mot de passe SIMKL."
          }
        },
        "he": {
          "stringUnit": {
