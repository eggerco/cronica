    "Turn on Live Activities for Cronica in Settings to track on the Lock Screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل Live Activities لـ Cronica في الإعدادات للتتبع على شاشة القفل."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni Live Activities pro Cronica v Nastavení pro sledování na Zamykací obrazovce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Live Activities til for Cronica i Indstillinger for at spore på låseskærmen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Live-Aktivitäten für Cronica in den Einstellungen, um auf dem Sperrbildschirm zu tracken."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τις Live Activities για το Cronica στις Ρυθμίσεις για παρακολούθηση στην οθόνη κλειδώματος."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Activities for Cronica in Settings to track on the Lock Screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Live Activities para Cronica en Ajustes para hacer seguimiento en la pantalla de bloqueo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las Actividades en vivo de Cronica en Configuración para seguir en la pantalla de bloqueo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Live Activities käyttöön Cronicassa Asetuksissa seurataksesi lukitusnäytöllä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active les activités en direct pour Cronica dans Réglages pour suivre sur l’écran verrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל Live Activities ל-Cronica בהגדרות כדי לעקוב במסך נעילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन पर ट्रैक करने के लिए सेटिंग्स में Cronica के Live Activities चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključi Live Activities za Cronica u Postavkama za praćenje na Zaključanom zaslonu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja be a Cronica Live Activities funkcióját a Beállításokban a zárolt képernyős követéshez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Live Activities untuk Cronica di Pengaturan untuk lacak di Layar Kunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva le Live Activity per Cronica in Impostazioni per tracciare sulla schermata di blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面でトラッキングするには、設定でCronicaのライブアクティビティをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면에서 추적하려면 설정에서 Cronica의 라이브 액티비티를 켜세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayakan Live Activities untuk Cronica dalam Tetapan untuk jejak pada Skrin Kunci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Live Activities for Cronica i Innstillinger for å spore på låseskjermen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Live Activities voor Cronica in via Instellingen om te volgen op het vergrendelscherm."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Live Activities dla Cronica w Ustawieniach, aby śledzić na ekranie blokady."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as Atividades ao Vivo do Cronica em Ajustes para acompanhar na Tela de Bloqueio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Live Activities pentru Cronica în Setări pentru urmărire pe ecranul de blocare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включи Live Activities для Cronica в Настройках для отслеживания на экране блокировки."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapni Live Activities pre Cronica v Nastaveniach, aby si mohol sledovať na uzamknutej obrazovke."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera Live Activities för Cronica i Inställningar för att spåra på låsskärmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit Ekranında takip için Ayarlar'da Cronica için Live Activities'i aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкни Live Activities для Cronica в Налаштуваннях для відстеження на екрані блокування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“设置”中为 Cronica 开启实时活动，以便在锁定屏幕跟踪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「設定」中為 Cronica 開啟即時動態，以便在鎖定畫面追蹤。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa les Activitats en directe de Cronica a Configuració per fer seguiment a la pantalla de bloqueig."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લૉક સ્ક્રીન પર ટ્રૅક કરવા માટે સેટિંગ્સમાં Cronica માટે Live Activities ચાલુ કરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीनवर ट्रॅक करण्यासाठी सेटिंग्जमध्ये Cronica साठी Live Activities चालू करा."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as Atividades ao Vivo do Cronica em Ajustes para acompanhar na Ecrã de Bloqueio."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਕ ਸਕ੍ਰੀਨ 'ਤੇ ਟਰੈਕ ਕਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ Cronica ਲਈ Live Activities ਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V Nastavitvah vklopi Live Activities za Cronica za sledenje na zaklenjenem zaslonu."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോക്ക് സ്‌ക്രീനിൽ ട്രാക്ക് ചെയ്യുന്നതിന് ക്രമീകരണങ്ങളിൽ Cronica-നായി Live Activities ഓണാക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Live Activities สำหรับ Cronica ในการตั้งค่าเพื่อติดตามบนหน้าจอล็อค"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক স্ক্রিনে ট্র্যাক করার জন্য সেটিংসে Cronica-এর পরিবর্তে Live Activities চালু করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲಾಕ್ ಸ್ಕ್ರೀನ್‌ನಲ್ಲಿ ಟ್ರ್ಯಾಕ್ ಮಾಡಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ Cronica ಗಾಗಿ Live Activities ಆನ್ ಮಾಡಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଲକ୍ ସ୍କ୍ରିନରେ ଟ୍ରାକ୍ କରିବା ପାଇଁ ସେଟିଂସରେ Cronica ପାଇଁ Live Activities ଚାଲୁ କରନ୍ତୁ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பூட்டுத் திரையில் கண்காணிக்க, அமைப்புகளில் Cronica-க்கு பதிலாக Live Activities-ஐ இயக்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లాక్ స్క్రీన్‌పై ట్రాక్ చేయడానికి సెట్టింగ్స్‌లో Cronica కోసం Live Activitiesని ఆన్ చేయండి."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Live Activities cho Cronica trong Cài đặt để theo dõi trên Màn hình khóa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لاک اسکرین پر ٹریک کرنے کے لیے ترتیبات میں Cronica کے لیے Live Activities کو آن کریں۔"
          }
        }
      }
    },
