          "stringUnit": {
            "state": "translated",
            "value": "These titles stay off your main Watchlist until you unhide them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos títulos permanecen ocultos de tu lista hasta que los muestres de nuevo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos títulos permanecen fuera de tu lista principal hasta que los muestres de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä nimikkeet pysyvät piilotettuina katselulistaltasi, kunnes paljastat ne."
