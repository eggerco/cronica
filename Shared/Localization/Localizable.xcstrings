    "Follow Cronica on X (Twitter) to stay updated about new features.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تابع Cronica على X (Twitter) للبقاء على اطلاع بالميزات الجديدة."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleduj Cronica na X (Twitter), abys měl/a přehled o nových funkcích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Følg Cronica på X (Twitter) for at holde dig opdateret om nye funktioner."
          }
        },
        "de": {
