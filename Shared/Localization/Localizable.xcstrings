        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להזכיר לעצמך כותרת ספציפית, השתמש ב״הוסף לתזכורות״ בדף הפרטים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी विशिष्ट शीर्षक की याद दिलाने के लिए उसकी विवरण पृष्ठ पर रिमाइंडर में जोड़ें का उपयोग करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za podsjetnik o određenom naslovu koristi Dodaj u Podsjetnike na stranici detalja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egy adott cím emlékeztetőjéhez használd a Hozzáadás az Emlékeztetőkhöz gombot a részleteknél."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengingatkan judul tertentu, gunakan Tambahkan ke Pengingat di halaman detail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricordarti un titolo specifico, usa Aggiungi a Promemoria nella pagina dei dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "特定の作品のリマインダーは、詳細画面の「リマインダーに追加」を使います。"
