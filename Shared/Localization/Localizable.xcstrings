          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifique quando um filme na sua lista for lançado."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੁਹਾਡੀ ਵਾਚਲਿਸਟ ਵਿੱਚ ਕੋਈ ਫਿਲਮ ਰਿਲੀਜ਼ ਹੁੰਦੀ ਹੈ ਤਾਂ ਸੂਚਿਤ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obvesti, ko izide film na tvoji watchlist."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാച്ച് ലിസ്റ്റിലെ ഒരു സിനിമ റിലീസ് ചെയ്യുമ്പോൾ അറിയിക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แจ้งเตือนเมื่อมีภาพยนตร์ในรายการเฝ้าดูของคุณออกฉาย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo khi một bộ phim trong danh sách theo dõi của bạn được phát hành."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಯಲ್ಲಿರುವ ಚಲನಚಿತ್ರ ಬಿಡುಗಡೆಯಾದಾಗ ತಿಳಿಸಿ."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் பார்க்க வேண்டிய பட்டியலில் உள்ள திரைப்படம் வெளியாகும் போது அறிவிப்பைப் பெறுங்கள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాచ్‌లిస్ట్‌లోని సినిమా విడుదలైనప్పుడు మీకు తెలియజేయబడుతుంది."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کی واچ لسٹ میں کوئی فلم ریلیز ہوتی ہے تو مطلع کریں۔"
          }
        }
      }
    },
    "Notify when a new episode from a TV Show on your watchlist is released.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
