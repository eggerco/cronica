        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtre millora els resultats, però pot fer que la cerca trigui més."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફિલ્ટર પરિણામોને સુધારે છે પરંતુ શોધમાં વધુ સમય લાગી શકે છે."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फिल्टर परिणाम सुधारतो परंतु शोध अधिक वेळ घेऊ शकतो."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O filtro melhora os resultados, mas pode tornar a busca mais lenta."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫਿਲਟਰ ਨਤੀਜਿਆਂ ਵਿੱਚ ਸੁਧਾਰ ਕਰਦਾ ਹੈ ਪਰ ਖੋਜ ਵਿੱਚ ਜ਼ਿਆਦਾ ਸਮਾਂ ਲੈ ਸਕਦਾ ਹੈ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter izboljša rezultate, a lahko podaljša iskanje."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫിൽട്ടർ ഫലങ്ങൾ മെച്ചപ്പെടുത്തുന്നു, പക്ഷേ തിരയലിന് കൂടുതൽ സമയം എടുക്കാൻ കഴിയും."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวกรองช่วยปรับปรุงผลลัพธ์แต่สามารถทำให้การค้นหาใช้เวลานานขึ้น"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ lọc cải thiện kết quả nhưng có thể khiến việc tìm kiếm mất nhiều thời gian hơn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফিল্টারটি ফলাফল উন্নত করে, কিন্তু এর ফলে অনুসন্ধান করতে বেশি সময় লাগতে পারে।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಿಲ್ಟರ್ ಫಲಿತಾಂಶಗಳನ್ನು ಸುಧಾರಿಸುತ್ತದೆ ಆದರೆ ಹುಡುಕಾಟವು ಹೆಚ್ಚು ಸಮಯ ತೆಗೆದುಕೊಳ್ಳುವಂತೆ ಮಾಡುತ್ತದೆ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଏହି ଫିଲ୍ଟର ଫଳାଫଳକୁ ଉନ୍ନତ କରେ କିନ୍ତୁ ସନ୍ଧାନକୁ ଅଧିକ ସମୟ ନେଇପାରେ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வடிகட்டி முடிவுகளை மேம்படுத்துகிறது, ஆனால் தேடலுக்கு அதிக நேரம் எடுக்கக்கூடும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫిల్టర్ ఫలితాలను మెరుగుపరుస్తుంది, కానీ శోధనకు ఎక్కువ సమయం పట్టవచ్చు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
