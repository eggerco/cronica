            "value": "Titluri fixate și în curs din watchlist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённые и в процессе названия из списка."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripnuté a rozpracované tituly z tvojho zoznamu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fästa och pågående titlar från din watchlist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzleme listenden sabitlenmiş ve devam eden başlıklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закріплені та в процесі назви зі списку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观看清单中已置顶和正在观看的标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀看清單中已釘選和正在觀看的標題。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Títols fixats i en curs de la teva Watchlist."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી વૉચલિસ્ટમાંથી પિન કરેલા અને પ્રગતિમાં રહેલા શીર્ષકો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या वॉचलिस्टमधून पिन केलेली आणि प्रगतीपथावर असलेली शीर्षके."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ତୁମର ୱାଚଲିଷ୍ଟରୁ ପିନ୍ ଏବଂ ଅଗ୍ରଗତି ଶିରୋନାମା |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos fixados e em andamento da sua lista."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਵਾਚਲਿਸਟ ਤੋਂ ਪਿੰਨ ਕੀਤੇ ਅਤੇ ਪ੍ਰਗਤੀ ਅਧੀਨ ਸਿਰਲੇਖ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripeti in v teku naslovi s tvoje watchlist."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ വാച്ച്‌ലിസ്റ്റിൽ നിന്ന് പിൻ ചെയ്‌തതും പുരോഗതിയിലുള്ളതുമായ ശീർഷകങ്ങൾ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการที่ปักหมุดและอยู่ระหว่างดำเนินการจากรายการเฝ้าดูของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tiêu đề được ghim và đang được ghim từ danh sách theo dõi của bạn."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ওয়াচলিস্ট থেকে পিন করা এবং চলমান শিরোনামগুলো।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ವೀಕ್ಷಣಾ ಪಟ್ಟಿಯಿಂದ ಪಿನ್ ಮಾಡಲಾದ ಮತ್ತು ಪ್ರಗತಿಯಲ್ಲಿರುವ ಶೀರ್ಷಿಕೆಗಳು."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கண்காணிப்புப் பட்டியலில் உள்ள, நிலைப்படுத்தப்பட்ட மற்றும் முன்னேற்றத்தில் உள்ள தலைப்புகள்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ వాచ్‌లిస్ట్‌లోని పిన్ చేయబడిన మరియు పురోగతిలో ఉన్న శీర్షికలు."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی واچ لسٹ سے پن کیے ہوئے اور جاری عنوانات۔"
          }
        }
      }
    },
