        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اربط خدمات اختيارية لاستيراد مكتبتك أو مزامنتها مع Cronica. تستمر أجهزة Apple في المزامنة عبر iCloud عند تفعيلها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připoj volitelné služby pro import nebo synchronizaci knihovny s Cronicou. Tvá zařízení Apple se stále synchronizují přes iCloud, pokud je zapnutý."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilslut valgfrie tjenester for at importere eller synkronisere dit bibliotek med Cronica. Dine Apple-enheder synkroniserer stadig via iCloud, når det er slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde optionale Dienste, um deine Bibliothek mit Cronica zu importieren oder zu synchronisieren. Deine Apple-Geräte synchronisieren weiterhin über iCloud, wenn aktiviert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε προαιρετικές υπηρεσίες για εισαγωγή ή συγχρονισμό της βιβλιοθήκης με το Cronica. Οι συσκευές Apple εξακολουθούν να συγχρονίζονται μέσω iCloud όταν είναι ενεργό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect optional services to import or sync your library with Cronica. Your Apple devices still sync through iCloud when enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta servicios opcionales para importar o sincronizar tu biblioteca con Cronica. Tus dispositivos Apple siguen sincronizándose por iCloud si está activado."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta servicios opcionales para importar o sincronizar tu biblioteca con Cronica. Tus dispositivos Apple siguen sincronizándose por iCloud si está activado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistä valinnaisia palveluita tuodaksesi tai synkronoidaksesi kirjastosi Cronican kanssa. Apple-laitteesi synkronoituvat edelleen iCloudin kautta, jos se on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez des services optionnels pour importer ou synchroniser votre bibliothèque avec Cronica. Vos appareils Apple se synchronisent toujours via iCloud si activé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חבר שירותים אופציונליים לייבוא או סנכרון הספרייה עם Cronica. מכשירי Apple שלך עדיין מסתנכרנים דרך iCloud כשהוא מופעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronica के साथ अपनी लाइब्रेरी आयात या सिंक करने के लिए वैकल्पिक सेवाएँ कनेक्ट करें। सक्षम होने पर आपके Apple डिवाइस अभी भी iCloud से सिंक होते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poveži opcionalne usluge za uvoz ili sinkronizaciju biblioteke s Cronicom. Tvoji Apple uređaji i dalje se sinkroniziraju putem iClouda kada je uključeno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csatlakoztass opcionális szolgáltatásokat a könyvtár Cronica-ba importálásához vagy szinkronizálásához. Az Apple-eszközeid továbbra is iCloudon keresztül szinkronizálnak, ha be van kapcsolva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungkan layanan opsional untuk mengimpor atau menyinkronkan pustaka Anda dengan Cronica. Perangkat Apple Anda tetap tersinkron melalui iCloud saat diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega servizi opzionali per importare o sincronizzare la libreria con Cronica. I tuoi dispositivi Apple continuano a sincronizzarsi via iCloud se abilitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のサービスを接続して、ライブラリをCronicaにインポートまたは同期できます。有効な場合、Appleデバイスは引き続きiCloudで同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택 서비스를 연결해 라이브러리를 Cronica로 가져오거나 동기화하세요. 사용 중이면 Apple 기기는 계속 iCloud로 동기화됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungkan perkhidmatan pilihan untuk mengimport atau menyegerakkan pustaka anda dengan Cronica. Peranti Apple anda masih disegerakkan melalui iCloud apabila didayakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble til valgfrie tjenester for å importere eller synkronisere biblioteket med Cronica. Apple-enhetene dine synkroniserer fortsatt via iCloud når det er aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel optionele diensten om je bibliotheek te importeren of te synchroniseren met Cronica. Je Apple-apparaten blijven via iCloud synchroniseren als dat is ingeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połącz opcjonalne usługi, aby importować lub synchronizować bibliotekę z Cronica. Twoje urządzenia Apple nadal synchronizują się przez iCloud, gdy jest włączone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte serviços opcionais para importar ou sincronizar sua biblioteca com o Cronica. Seus dispositivos Apple ainda sincronizam pelo iCloud quando ativado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectează servicii opționale pentru a importa sau sincroniza biblioteca cu Cronica. Dispozitivele tale Apple se sincronizează în continuare prin iCloud când este activat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите дополнительные сервисы, чтобы импортировать или синхронизировать библиотеку с Cronica. Устройства Apple по-прежнему синхронизируются через iCloud, если он включён."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pripoj voliteľné služby na import alebo synchronizáciu knižnice s Cronicou. Tvoje zariadenia Apple sa naďalej synchronizujú cez iCloud, ak je zapnutý."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslut valfria tjänster för att importera eller synka ditt bibliotek med Cronica. Dina Apple-enheter synkas fortfarande via iCloud när det är aktiverat."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitaplığınızı Cronica ile içe aktarmak veya senkronize etmek için isteğe bağlı hizmetleri bağlayın. Etkin olduğunda Apple cihazlarınız hâlâ iCloud üzerinden senkronize olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключіть додаткові сервіси, щоб імпортувати або синхронізувати бібліотеку з Cronica. Пристрої Apple надалі синхронізуються через iCloud, якщо його ввімкнено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接可选服务，将媒体库导入或同步到 Cronica。启用后，你的 Apple 设备仍通过 iCloud 同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接可選服務，將媒體庫匯入或同步到 Cronica。啟用後，你的 Apple 裝置仍透過 iCloud 同步。"
          }
        }
      }
    },
