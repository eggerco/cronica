    "Notify when a movie on your watchlist is released.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigen, wenn ein Film auf deiner Watchlist veröffentlicht wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when a movie on your watchlist is released."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifica cuando se estrene una película en tu lista de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifier la sortie d'un film figurant sur votre liste de visionnage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifica l'uscita di un Film nella tua Watchlist."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifique quando um filme na sua lista for lançado."
          }
        },
