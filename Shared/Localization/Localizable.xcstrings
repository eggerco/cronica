        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte uma conta SIMKL opcional para sincronizar sua lista com o Cronica. O CloudKit continua sincronizando seus dispositivos Apple."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectează un cont SIMKL opțional pentru a sincroniza lista cu Cronica. CloudKit sincronizează în continuare dispozitivele Apple."
