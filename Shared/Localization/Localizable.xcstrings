    "Open the Shortcuts app to browse Cronica actions and add them to Siri.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الاختصارات لتصفح إجراءات Cronica وإضافتها إلى Siri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete aplikaci Zkratky a procházejte akce Cronica a přidejte je do Siri."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn appen Genveje for at se Cronica-handlinger og tilføje dem til Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Kurzbefehle-App, um Cronica-Aktionen zu durchsuchen und zu Siri hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε την εφαρμογή Συντομεύσεις για να περιηγηθείς στις ενέργειες Cronica και να τις προσθέσεις στο Siri."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Shortcuts app to browse Cronica actions and add them to Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Atajos para ver las acciones de Cronica y añadirlas a Siri."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Atajos para ver las acciones de Cronica y agregarlas a Siri."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Pikakomennot-sovellus selataksesi Cronican toimintoja ja lisätäksesi ne Siriin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Raccourcis pour parcourir les actions Cronica et les ajouter à Siri."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את אפליקציית קיצורי הדרך כדי לעיין בפעולות Cronica ולהוסיף אותן ל־Siri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica क्रियाएँ देखने और उन्हें Siri में जोड़ने के लिए शॉर्टकट ऐप खोलें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvori aplikaciju Prečaci za pregled Cronica radnji i dodavanje u Siri."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyisd meg a Parancsok appot a Cronica műveletek böngészéséhez és Sirihez adásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka app Pintasan untuk menelusuri tindakan Cronica dan menambahkannya ke Siri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri l’app Comandi per esplorare le azioni di Cronica e aggiungerle a Siri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットアプリを開いてCronicaのアクションを確認し、Siriに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어 앱을 열어 Cronica 동작을 살펴보고 Siri에 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka app Pintasan untuk melihat tindakan Cronica dan menambahkannya ke Siri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Snarveier-appen for å bla gjennom Cronica-handlinger og legge dem til Siri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open de app Opdrachten om Cronica-acties te bekijken en aan Siri toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz aplikację Skróty, aby przeglądać działania Cronica i dodawać je do Siri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o app Atalhos para ver as ações do Cronica e adicioná-las à Siri."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide app-ul Comenzi rapide pentru a răsfoi acțiunile Cronica și a le adăuga la Siri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте приложение «Команды», чтобы просмотреть действия Cronica и добавить их в Siri."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte aplikáciu Skrátené príkazy na prehliadanie akcií Cronica a ich pridanie do Siri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna appen Genvägar för att bläddra bland Cronica-åtgärder och lägga till dem i Siri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica eylemlerine göz atmak ve Siri’ye eklemek için Kısayollar uygulamasını aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте програму «Команди», щоб переглянути дії Cronica та додати їх до Siri."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“快捷指令”应用以浏览 Cronica 操作并将其添加到 Siri。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「捷徑」App 以瀏覽 Cronica 操作並加入 Siri。"
          }
        }
      }
