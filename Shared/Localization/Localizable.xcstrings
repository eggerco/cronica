        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Afegeix títols a l’iPhone i apareixeran aquí."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone પર શીર્ષકો ઉમેરો, પછી તેઓ અહીં દેખાશે."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ನಲ್ಲಿ ಶೀರ್ಷಿಕೆಗಳನ್ನು ಸೇರಿಸಿ, ನಂತರ ಅವು ಇಲ್ಲಿ ಗೋಚರಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-ൽ ശീർഷകങ്ങൾ ചേർക്കുക, തുടർന്ന് അവ ഇവിടെ ദൃശ്യമാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone वर शीर्षके जोडा, नंतर ती येथे दिसतील."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଆଇଫୋନରେ ଟାଇଟଲ୍ ଯୋଡନ୍ତୁ, ତାପରେ ସେମାନେ ଏଠାରେ ଦେଖାଯିବେ |"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione títulos no iPhone e eles aparecerão aqui."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 'ਤੇ ਸਿਰਲੇਖ ਸ਼ਾਮਲ ਕਰੋ, ਫਿਰ ਉਹ ਇੱਥੇ ਦਿਖਾਈ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte naslove v iPhone, nato se prikažejo tukaj."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஐபோனில் தலைப்புகளைச் சேர்க்கவும், பின்னர் அவை இங்கே தோன்றும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneలో శీర్షికలను జోడించండి, ఆపై అవి ఇక్కడ కనిపిస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มชื่อเรื่องบน iPhone จากนั้นจะปรากฏที่นี่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiêu đề trên iPhone, sau đó chúng xuất hiện ở đây."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آئی فون پر عنوانات شامل کریں، پھر وہ یہاں ظاہر ہوں گے ۔"
          }
        }
      }
    },
    "Add titles to %@ from Search or any title’s details screen.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف عناوين إلى %1$@ من البحث أو من شاشة تفاصيل أي عنوان."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidávej tituly do %1$@ z Vyhledávání nebo z detailu titulu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj titler til %1$@ fra Søgning eller en titels detaljeside."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Titel zu %1$@ über die Suche oder die Detailansicht hinzu."
