    "Mark a movie or TV show as watched in Cronica.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "علّم فيلمًا أو مسلسلًا كمشاهَد في Cronica."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte film nebo seriál jako zhlédnutý v Cronica."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Markér en film eller serie som set i Cronica."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere einen Film oder eine Serie in Cronica als gesehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μάρκαρε μια ταινία ή σειρά ως προβληθείσα στο Cronica."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark a movie or TV show as watched in Cronica."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una película o serie como vista en Cronica."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca una película o serie como vista en Cronica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse elokuva tai sarja katsotuksi Cronicassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez un film ou une série comme vu dans Cronica."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סמן סרט או סדרה כנצפים ב־Cronica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronica में किसी फ़िल्म या शो को देखा गया चिह्नित करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi film ili seriju kao pogledane u Cronica."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
