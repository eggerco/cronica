          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試其他篩選，或從搜尋中加入更多標題。"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altre filtre o afegeix més títols des de Cerca."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બીજું ફિલ્ટર અજમાવો અથવા શોધમાંથી વધુ શીર્ષકો ઉમેરો."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "दुसरा फिल्टर वापरून पहा किंवा शोध मधून आणखी शीर्षके जोडा."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenta outro filtro ou adiciona mais títulos a partir da Pesquisa."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੋਈ ਹੋਰ ਫਿਲਟਰ ਅਜ਼ਮਾਓ, ਜਾਂ ਖੋਜ ਤੋਂ ਹੋਰ ਸਿਰਲੇਖ ਸ਼ਾਮਲ ਕਰੋ।"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskusi drug filter ali dodaj več naslovov iz Iskanja."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മറ്റൊരു ഫിൽട്ടർ പരീക്ഷിക്കുക, അല്ലെങ്കിൽ തിരയലിൽ നിന്ന് കൂടുതൽ ശീർഷകങ്ങൾ ചേർക്കുക."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองใช้ตัวกรองอื่นหรือเพิ่มชื่อเพิ่มเติมจากการค้นหา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy thử bộ lọc khác hoặc thêm tiêu đề khác từ Tìm kiếm."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন্য কোনো ফিল্টার ব্যবহার করে দেখুন, অথবা সার্চ থেকে আরও শিরোনাম যোগ করুন।"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಬೇರೆ ಫಿಲ್ಟರ್ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಹುಡುಕಾಟದಿಂದ ಹೆಚ್ಚಿನ ಶೀರ್ಷಿಕೆಗಳನ್ನು ಸೇರಿಸಿ."
          }
        },
        "or": {
          "stringUnit": {
            "state": "translated",
            "value": "ଅନ୍ୟ ଏକ ଫିଲ୍ଟର୍ ବ୍ୟବହାର କରି ଦେଖନ୍ତୁ, କିମ୍ବା ସନ୍ଧାନରୁ ଅଧିକ ଟାଇଟେଲ୍ ଯୋଗ କରନ୍ତୁ।"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றொரு வடிகட்டியைப் பயன்படுத்தவும், அல்லது தேடலில் இருந்து கூடுதல் தலைப்புகளைச் சேர்க்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వేరొక ఫిల్టర్‌ను ప్రయత్నించండి లేదా శోధన నుండి మరిన్ని శీర్షికలను జోడించండి."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دوسرا فلٹر آزمائیں، یا تلاش سے مزید عنوانات شامل کریں۔"
          }
        }
      }
    },
