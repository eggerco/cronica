        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDb-ൽ ലഭ്യമാണെങ്കിൽ, പുതിയ വിവരങ്ങൾ ഉപയോഗിച്ച് ഇനങ്ങൾ അപ്ഡേറ്റ് ചെയ്യുക"
          }
