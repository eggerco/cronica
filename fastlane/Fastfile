# App Store Connect platforms for this universal app (Watch ships with the iOS companion).
# Override with comma-separated STORE_PLATFORMS=ios,xros for partial retries.
STORE_PLATFORMS = (ENV["STORE_PLATFORMS"] || "ios,osx,appletvos,xros").split(",").map(&:strip).reject(&:empty?).freeze

# Binary archive destinations (Watch embeds with the iOS archive).
# Override with ARCHIVE_PLATFORMS=ios,osx for partial retries.
ARCHIVE_PLATFORMS = (ENV["ARCHIVE_PLATFORMS"] || "ios,osx,appletvos,xros").split(",").map(&:strip).reject(&:empty?).freeze
ARCHIVE_SCHEME = ENV.fetch("ARCHIVE_SCHEME", "Cronica (EN-US)")
ARCHIVE_OUTPUT_DIR = File.expand_path("build", __dir__)
ARCHIVE_DESTINATION = {
  "ios" => "generic/platform=iOS",
  "osx" => "generic/platform=macOS",
  "appletvos" => "generic/platform=tvOS",
  "xros" => "generic/platform=visionOS"
}.freeze

RELEASE_NOTES_DIR = File.expand_path("release_notes", __dir__)
DESCRIPTION_DIR = File.expand_path("description", __dir__)
KEYWORDS_DIR = File.expand_path("keywords", __dir__)
METADATA_DIR = File.expand_path("metadata", __dir__)
API_KEY_JSON = File.expand_path("api_key.json", __dir__)

# Same for every App Store locale.
MARKETING_URL = "https://www.cronica.watch"
SUPPORT_URL = "https://www.cronica.watch/support"

# Accept short aliases and map them to Fastlane's official ASC API key env names.
def normalize_asc_api_key_env!
  ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] ||= ENV["APP_STORE_CONNECT_KEY_ID"]
  ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] ||= ENV["APP_STORE_CONNECT_ISSUER_ID"]
  ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"] ||= ENV["APP_STORE_CONNECT_KEY_PATH"]
end

# Auth is App Store Connect API key only (no Apple ID / password / 2FA).
def ensure_app_store_api_key!
  normalize_asc_api_key_env!

  json_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  json_path = API_KEY_JSON if (json_path.nil? || json_path.empty?) && File.exist?(API_KEY_JSON)

  if json_path && !json_path.empty?
    data = JSON.parse(File.read(json_path))
    filepath = data["key_filepath"] || data["key_file"] || data["filepath"]

    if filepath && !filepath.to_s.empty?
      expanded = File.expand_path(filepath)
      UI.user_error!("API key file not found at #{expanded} (from #{json_path})") unless File.exist?(expanded)
      UI.message("Using App Store Connect API key file #{expanded}")
      return app_store_connect_api_key(
        key_id: data.fetch("key_id"),
        issuer_id: data.fetch("issuer_id"),
        key_filepath: expanded,
        duration: (data["duration"] || 1200).to_i,
        in_house: data.fetch("in_house", false)
      )
    end

    # Standard Fastlane JSON with inline "key" PEM content.
    UI.message("Using App Store Connect API key JSON at #{json_path}")
    return json_path
  end

  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"]

  unless key_id && !key_id.empty? && issuer_id && !issuer_id.empty? && ((key_filepath && !key_filepath.empty?) || (key_content && !key_content.empty?))
    UI.user_error!(
      "App Store Connect API key required. Either put credentials in fastlane/api_key.json " \
      "(prefer key_filepath to your .p8), set APP_STORE_CONNECT_API_KEY_PATH, or export " \
      "APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID, and " \
      "APP_STORE_CONNECT_API_KEY_KEY_FILEPATH. See Docs/FASTLANE.md."
    )
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath,
    key_content: key_content,
    is_key_content_base64: ENV["APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64"] == "true",
    duration: 1200,
    in_house: false
  )
end

def write_store_urls!
  STORE_LOCALES.each do |locale|
    dir = File.join(METADATA_DIR, locale)
    FileUtils.mkdir_p(dir)
    File.write(File.join(dir, "marketing_url.txt"), "#{MARKETING_URL}\n")
    File.write(File.join(dir, "support_url.txt"), "#{SUPPORT_URL}\n")
  end
end

def deliver_options(api:, download: false, platform:, metadata_path: nil)
  options = {
    platform: platform,
    skip_binary_upload: true,
    skip_screenshots: true,
    force: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
    submit_for_review: false,
    # "Automatically release this version" once Apple approves.
    automatic_release: true,
    # Don't sit in long ASC retries when a platform has no editable version yet.
    version_check_wait_retry_limit: 1
  }
  options[:metadata_path] = metadata_path if metadata_path

  if api.is_a?(String)
    options[:api_key_path] = api
  else
    options[:api_key] = api
  end

  options[:download_metadata] = true if download
  options
end

# Stage only already-activated locales so deliver does not try to create new App Store languages
# (that fails when the localized app name "Cronica" is already taken).
def stage_active_metadata_dir!
  staging = File.expand_path("metadata_upload", __dir__)
  FileUtils.rm_rf(staging)
  FileUtils.mkdir_p(staging)

  ACTIVE_STORE_LOCALES.each do |locale|
    source = File.join(METADATA_DIR, locale)
    UI.user_error!("Missing staged metadata for #{locale} at #{source} — run sync_release_notes first.") unless Dir.exist?(source)
    FileUtils.cp_r(source, File.join(staging, locale))
  end

  staging
end

def deliver_metadata!(download: false)
  api = ensure_app_store_api_key!

  if download
    # Pull from iOS only so platforms don't overwrite the same local metadata folder.
    UI.message("Downloading App Store metadata for platform=ios")
    deliver(deliver_options(api: api, download: true, platform: "ios"))
    return
  end

  pending = STORE_LOCALES - ACTIVE_STORE_LOCALES
  unless pending.empty?
    UI.important(
      "#{pending.length} locale(s) have translated release notes locally but are not in " \
      "ACTIVE_STORE_LOCALES yet (enable each language in App Store Connect with a unique " \
      "app name if needed, then add its code to ACTIVE_STORE_LOCALES): #{pending.join(', ')}"
    )
  end

  staging = stage_active_metadata_dir!
  failures = []
  begin
    STORE_PLATFORMS.each do |platform|
      UI.message("Uploading App Store metadata for platform=#{platform} (#{ACTIVE_STORE_LOCALES.length} active locales)")
      begin
        deliver(deliver_options(api: api, platform: platform, metadata_path: staging))
      rescue => error
        UI.error("Failed metadata upload for #{platform}: #{error.message}")
        failures << platform
      end
    end
  ensure
    FileUtils.rm_rf(staging)
  end

  unless failures.empty?
    UI.user_error!(
      "Metadata upload incomplete for: #{failures.join(', ')}. " \
      "Prepare an editable App Store version for those platforms (or upload a build), then re-run."
    )
  end
end

def archive_export_options
  {
    method: "app-store",
    signingStyle: "automatic",
    teamID: CredentialsManager::AppfileConfig.try_fetch_value(:team_id) || "S5A7774228"
  }
end

def archive_common_options(platform:)
  destination = ARCHIVE_DESTINATION.fetch(platform) do
    UI.user_error!("Unknown archive platform '#{platform}'. Expected one of: #{ARCHIVE_DESTINATION.keys.join(', ')}")
  end

  {
    project: "Cronica.xcodeproj",
    scheme: ARCHIVE_SCHEME,
    clean: true,
    configuration: "Release",
    destination: destination,
    output_directory: File.join(ARCHIVE_OUTPUT_DIR, platform),
    output_name: "Cronica-#{platform}",
    export_method: "app-store",
    export_options: archive_export_options,
    xcargs: "-allowProvisioningUpdates",
    export_xcargs: "-allowProvisioningUpdates",
    skip_profile_detection: true,
    result_bundle: false
  }
end

def archive_platform!(platform:)
  out_dir = File.join(ARCHIVE_OUTPUT_DIR, platform)
  FileUtils.mkdir_p(out_dir)
  # Drop prior IPA/PKG so a failed export cannot reuse yesterday's binary.
  FileUtils.rm_f(Dir[File.join(out_dir, "*.ipa")] + Dir[File.join(out_dir, "*.pkg")])
  UI.message("Archiving #{ARCHIVE_SCHEME} for platform=#{platform}")

  # Avoid leaking the previous platform's IPA/PKG into this upload.
  lane_context.delete(SharedValues::IPA_OUTPUT_PATH)
  lane_context.delete(SharedValues::PKG_OUTPUT_PATH) if defined?(SharedValues::PKG_OUTPUT_PATH)

  if platform == "osx"
    # Multiplatform Xcode projects need sdk=macosx so gym takes the PKG path
    # (otherwise it looks for an IPA after export and fails with "IPA invalid").
    # build_mac_app also does not accept skip_package_ipa (iOS-only).
    build_mac_app(archive_common_options(platform: platform).merge(
      skip_package_pkg: false,
      sdk: "macosx"
    ))
  else
    build_app(archive_common_options(platform: platform))
  end

  ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
  pkg = defined?(SharedValues::PKG_OUTPUT_PATH) ? lane_context[SharedValues::PKG_OUTPUT_PATH] : nil

  # Gym sometimes leaves Mac PKG only in a temp export folder — normalize into out_dir.
  if platform == "osx"
    pkg ||= Dir[File.join(out_dir, "*.pkg")].max_by { |p| File.mtime(p) }
    if (pkg.nil? || pkg.to_s.empty?) && ipa && File.extname(ipa).downcase == ".pkg"
      pkg = ipa
      ipa = nil
    end
    if pkg && File.exist?(pkg)
      dest = File.join(out_dir, "Cronica-osx.pkg")
      FileUtils.cp(pkg, dest) unless File.expand_path(pkg) == File.expand_path(dest)
      pkg = dest
    end
    ipa = nil
  else
    pkg = nil
    ipa ||= Dir[File.join(out_dir, "*.ipa")].max_by { |p| File.mtime(p) }
  end

  {
    platform: platform,
    ipa: ipa,
    pkg: pkg
  }
end

def upload_binary!(platform:, ipa: nil, pkg: nil, submit_for_review: false)
  api = ensure_app_store_api_key!
  options = deliver_options(api: api, platform: platform).merge(
    skip_binary_upload: false,
    skip_metadata: true,
    skip_screenshots: true,
    submit_for_review: submit_for_review,
    automatic_release: true
  )

  if platform == "osx"
    UI.user_error!("No PKG produced for osx") if pkg.nil? || pkg.to_s.empty? || !File.exist?(pkg)
    options[:pkg] = pkg
    options.delete(:ipa)
  else
    UI.user_error!("No IPA produced for #{platform}") if ipa.nil? || ipa.to_s.empty? || !File.exist?(ipa)
    options[:ipa] = ipa
    options.delete(:pkg)
  end

  UI.message("Uploading binary for platform=#{platform}")
  deliver(options)
end

desc "Upload an already-exported Mac PKG (path via PKG_PATH or fastlane/build/osx/Cronica-osx.pkg)"
lane :upload_osx_pkg do
  pkg = ENV["PKG_PATH"]
  pkg = File.join(ARCHIVE_OUTPUT_DIR, "osx", "Cronica-osx.pkg") if pkg.nil? || pkg.empty?
  upload_binary!(platform: "osx", pkg: pkg)
end

platform :ios do
  desc "Write marketing_url / support_url for every store locale"
  lane :sync_store_urls do
    UI.message("Syncing store URLs for #{STORE_LOCALES.length} locales")
    write_store_urls!
  end

  desc "Copy fastlane/release_notes/<locale>.txt into fastlane/metadata/"
  lane :sync_release_notes do
    UI.message("Syncing release notes for #{STORE_LOCALES.length} locales")

    STORE_LOCALES.each do |locale|
      source = File.join(RELEASE_NOTES_DIR, "#{locale}.txt")
      UI.user_error!("Missing #{source} — add a translated release note for #{locale}.") unless File.exist?(source)

      note = File.read(source, encoding: "UTF-8").strip
      dir = File.join(METADATA_DIR, locale)
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "release_notes.txt"), "#{note}\n")
    end

    write_store_urls!
  end

  desc "Copy fastlane/description/<locale>.txt into fastlane/metadata/<locale>/description.txt"
  lane :sync_descriptions do
    UI.message("Syncing App Store descriptions")

    # Active locales must be present for upload; remaining store locales sync when files exist.
    ACTIVE_STORE_LOCALES.each do |locale|
      source = File.join(DESCRIPTION_DIR, "#{locale}.txt")
      UI.user_error!("Missing #{source} required for ACTIVE_STORE_LOCALES.") unless File.exist?(source)
    end

    STORE_LOCALES.each do |locale|
      source = File.join(DESCRIPTION_DIR, "#{locale}.txt")
      next unless File.exist?(source)

      body = File.read(source, encoding: "UTF-8").strip
      UI.user_error!("#{source} exceeds App Store 4000-character limit (#{body.length}).") if body.length > 4000

      dir = File.join(METADATA_DIR, locale)
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "description.txt"), "#{body}\n")
    end
  end

  desc "Copy fastlane/keywords/<locale>.txt into fastlane/metadata/<locale>/keywords.txt"
  lane :sync_keywords do
    UI.message("Syncing App Store keywords")

    ACTIVE_STORE_LOCALES.each do |locale|
      source = File.join(KEYWORDS_DIR, "#{locale}.txt")
      UI.user_error!("Missing #{source} required for ACTIVE_STORE_LOCALES.") unless File.exist?(source)
    end

    STORE_LOCALES.each do |locale|
      source = File.join(KEYWORDS_DIR, "#{locale}.txt")
      next unless File.exist?(source)

      body = File.read(source, encoding: "UTF-8").strip
      UI.user_error!("#{source} exceeds App Store 100-character keywords limit (#{body.length}).") if body.length > 100

      dir = File.join(METADATA_DIR, locale)
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "keywords.txt"), "#{body}\n")
    end
  end

  desc "Upload metadata to iOS, macOS, tvOS, and visionOS (no binary, no screenshots)"
  lane :upload_metadata do
    deliver_metadata!
  end

  desc "Sync localized release notes and upload to all App Store platforms"
  lane :upload_release_notes do
    sync_release_notes
    upload_metadata
  end

  desc "Sync localized descriptions (+ keywords / release notes / URLs) and upload to all App Store platforms"
  lane :upload_descriptions do
    sync_descriptions
    sync_keywords
    sync_release_notes
    upload_metadata
  end

  desc "Sync localized keywords and upload to all App Store platforms"
  lane :upload_keywords do
    sync_keywords
    upload_metadata
  end

  desc "Download current App Store Connect metadata (iOS) into fastlane/metadata/"
  lane :download_metadata do
    deliver_metadata!(download: true)
  end

  desc "Archive Release builds for iOS, macOS, tvOS, and visionOS (no upload)"
  lane :archive_all do
    failures = []
    ARCHIVE_PLATFORMS.each do |platform|
      begin
        archive_platform!(platform: platform)
      rescue => error
        UI.error("Archive failed for #{platform}: #{error.message}")
        failures << "#{platform} (#{error.message})"
      end
    end

    unless failures.empty?
      UI.user_error!("Archive incomplete for: #{failures.join('; ')}")
    end
  end

  desc "Archive + upload binaries for all platforms (metadata unchanged unless RELEASE_UPLOAD_METADATA=1)"
  lane :release_all do
    ensure_app_store_api_key!
    submit = ENV.fetch("SUBMIT_FOR_REVIEW", "false").casecmp("true").zero?
    upload_metadata_too = ENV.fetch("RELEASE_UPLOAD_METADATA", "false").casecmp("true").zero?

    failures = []
    ARCHIVE_PLATFORMS.each do |platform|
      begin
        artifact = archive_platform!(platform: platform)
        upload_binary!(
          platform: platform,
          ipa: artifact[:ipa],
          pkg: artifact[:pkg],
          submit_for_review: false
        )
      rescue => error
        UI.error("Release failed for #{platform}: #{error.message}")
        failures << "#{platform} (#{error.message})"
      end
    end

    unless failures.empty?
      UI.user_error!("Binary release incomplete for: #{failures.join('; ')}")
    end

    if upload_metadata_too
      sync_release_notes
      upload_metadata
    end

    if submit
      UI.important(
        "SUBMIT_FOR_REVIEW=true requested. Submit each platform version from App Store Connect " \
        "or re-run deliver with submit_for_review once builds finish processing."
      )
    end

    UI.success("Archived and uploaded binaries for: #{ARCHIVE_PLATFORMS.join(', ')}")
  end
end
